{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "name": "clever-toys",
  "main": "./dist/_worker.js/index.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
