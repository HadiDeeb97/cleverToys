{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "clever-toys",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
