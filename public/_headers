# Browser caching rules for static files (Cloudflare reads this file).
#
# /_astro/* files have a content hash in their name, so they never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Storefront scripts are loaded with a ?v= version string (see src/middleware.ts), so browsers can
# keep them for a day and still get new versions as soon as the version changes.
/store-ui.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/branding-ui.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/visitor-analytics.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/admin-ui.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Default website icons (a custom icon from Admin → Branding is served from Supabase storage).
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
