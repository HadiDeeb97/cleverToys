---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content="Clever Toys Lebanon — fun, educational and exciting toys for children of all ages." />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>Clever Toys Lebanon</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const setFilter = (open) => {
          const toggle = document.getElementById('filter-toggle');
          const panel = document.getElementById('filter-panel');
          if (!toggle || !panel) return false;
          panel.hidden = !open;
          panel.style.display = open ? 'block' : '';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-pressed', String(open));
          return true;
        };

        document.addEventListener('click', (event) => {
          const element = event.target instanceof Element ? event.target : null;
          const toggle = element?.closest('#filter-toggle');
          const close = element?.closest('#filter-close');
          if (!toggle && !close) return;

          event.preventDefault();
          event.stopImmediatePropagation();

          if (toggle) {
            const panel = document.getElementById('filter-panel');
            setFilter(panel ? panel.hidden : true);
          } else {
            setFilter(false);
          }
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  @media (max-width: 1100px) and (pointer: coarse) {
    html { font-size: 17px; -webkit-text-size-adjust: 100%; }
    body { font-size: 17px; line-height: 1.55; overflow-x: hidden; }
    .container { width: calc(100% - 16px) !important; max-width: none !important; }

    .site-header .header-inner,.header-inner { min-height: 76px; gap: 10px; }
    .site-header .logo,.logo { font-size: 1.4rem; line-height: 1.1; max-width: 44%; }
    .site-header .site-logo-image,.site-logo-image { max-width: 120px; max-height: 42px; }
    .main-nav { gap: 6px; max-width: 56%; font-size: 1rem; overflow-x: auto; padding: 8px 0; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .main-nav::-webkit-scrollbar { display: none; }
    .main-nav a { padding: 10px 6px; white-space: nowrap; }
    .cart-link { min-height: 52px; padding: 8px; }
    .cart-icon { font-size: 1.55rem; }
    .cart-count-badge { min-width: 24px; height: 24px; font-size: .82rem; }

    .hero { padding: 58px 0 52px; }
    .hero h1,.shop-hero h1 { font-size: clamp(2.65rem,12vw,4.2rem) !important; line-height: .98; }
    .hero p,.shop-hero p:last-child { font-size: 1.14rem !important; line-height: 1.65; }
    .section { padding: 50px 0; }
    .section-header h1 { font-size: 2.45rem !important; }
    .section-header h2 { font-size: 2.05rem !important; }

    .category-grid,.product-grid,.shop-grid { grid-template-columns: repeat(2,minmax(0,1fr)) !important; gap: 12px !important; }
    .category-card { min-height: 145px; padding: 18px; border-radius: 18px; }
    .category-card strong { font-size: 1.2rem !important; }
    .category-card p { font-size: 1rem !important; }
    .product-card,.shop-card { border-radius: 18px; }
    .product-info { padding: 16px !important; }
    .product-info h3,.shop-card .product-info h2 { font-size: 1.14rem !important; line-height: 1.3; }
    .product-info p { font-size: 1rem !important; line-height: 1.5; }
    .price,.shop-price .price { font-size: 1.38rem !important; }
    .shop-original-price { font-size: 1rem !important; }

    .button,.small-button,.view-product,.search-button,.filter-button { min-height: 58px !important; font-size: 1.08rem !important; }
    .view-product { display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 13px; border-radius: 13px; }

    .form-card input,.form-card textarea,.form-card select,#product-search { min-height: 58px !important; padding: 15px 16px !important; font-size: 1.08rem !important; border-radius: 13px; }

    .shop-toolbar { display: grid !important; grid-template-columns: 1fr !important; width: 100%; gap: 12px !important; }
    .shop-toolbar .search-form { display: grid !important; grid-template-columns: 1fr !important; width: 100% !important; gap: 10px !important; }
    .shop-toolbar .search-form input[type="search"] { width: 100% !important; min-width: 0 !important; max-width: none !important; }
    .shop-toolbar .search-form .search-button,.shop-toolbar .search-form button[type="submit"] { width: 100% !important; min-width: 0 !important; margin: 0 !important; }
    .shop-toolbar .toolbar-actions { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 8px !important; width: 100% !important; }
    .shop-toolbar .filter-button { width: 100% !important; cursor: pointer; }
    .shop-toolbar .sort-form,.shop-toolbar .sort-form select { min-height: 58px !important; width: 100%; min-width: 0; }
    .shop-toolbar .sort-form { display: grid; grid-template-columns: 1fr; gap: 0; }
    .shop-toolbar .sort-form label { display: none; }

    .filter-panel { position: relative !important; z-index: 20 !important; margin: 0 0 18px !important; padding: 18px !important; border-radius: 18px !important; background: #fff !important; box-shadow: 0 12px 30px rgba(15,23,42,.08) !important; }
    .filter-panel[hidden] { display: none !important; }
    .filter-panel .filter-options { display: grid !important; grid-template-columns: repeat(2,minmax(0,1fr)) !important; gap: 10px !important; }
    .filter-panel .filter-options a { min-height: 52px; display: flex !important; align-items: center; justify-content: center; padding: 10px 12px; font-size: 1rem !important; text-align: center; }
    .filter-panel .filter-close { width: 46px; height: 46px; font-size: 27px; }
    .shop-result-row { font-size: 1rem !important; }

    .pagination a { min-height: 54px !important; font-size: 1rem !important; display: inline-flex; align-items: center; }
    .cart-item { grid-template-columns: 92px minmax(0,1fr) !important; gap: 13px; padding: 16px; }
    .cart-item img,.cart-placeholder { width: 92px !important; height: 92px !important; }
    .cart-item h2 { font-size: 1.2rem !important; }
    .quantity-control button { min-width: 50px !important; height: 50px !important; }

    .clever-floating-cart,.clever-floating-whatsapp { width: 62px !important; height: 62px !important; bottom: calc(14px + env(safe-area-inset-bottom)); }
    .clever-floating-cart { right: 10px !important; }
    .clever-floating-whatsapp { left: 10px !important; }
  }

  @media (max-width: 430px) and (pointer: coarse) {
    .container { width: calc(100% - 12px) !important; }
    .product-grid,.shop-grid,.category-grid { gap: 10px !important; }
    .product-info { padding: 14px !important; }
    .product-info h3,.shop-card .product-info h2 { font-size: 1.08rem !important; }
    .price,.shop-price .price { font-size: 1.32rem !important; }
  }
</style>
