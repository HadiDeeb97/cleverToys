<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content="Clever Toys Lebanon — fun, educational and exciting toys for children of all ages." />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>Clever Toys Lebanon</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  /* Mobile-first visual scaling and panel rearrangement. Desktop/tablet stay unchanged. */
  @media (max-width: 767px) {
    :root {
      --mobile-space: 16px;
      --mobile-radius: 16px;
      --mobile-touch: 50px;
    }

    body {
      font-size: 16px;
    }

    .container {
      width: min(100% - 24px, 680px);
    }

    .site-header .header-inner,
    .header-inner {
      min-height: 68px;
      gap: 12px;
    }

    .site-header .logo,
    .logo {
      font-size: 1.25rem;
      line-height: 1.1;
      max-width: 46%;
    }

    .site-header .site-logo-image,
    .site-logo-image {
      max-width: 120px;
      max-height: 40px;
    }

    .site-header .main-nav,
    .main-nav {
      max-width: 54%;
      gap: 5px;
      font-size: .88rem;
      overflow-x: auto;
      padding: 6px 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .main-nav::-webkit-scrollbar {
      display: none;
    }

    .main-nav a {
      padding: 8px 6px;
    }

    .hero {
      padding: 52px 0 46px;
    }

    .hero h1,
    .shop-hero h1 {
      font-size: clamp(2.35rem, 11vw, 3.5rem);
      line-height: 1;
    }

    .hero p,
    .shop-hero p:last-child {
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .button,
    .small-button,
    .view-product,
    .search-button {
      min-height: var(--mobile-touch);
      font-size: 1rem;
    }

    .button {
      padding: 0 20px;
    }

    .section {
      padding: 46px 0;
    }

    .section-header {
      margin-bottom: 24px;
    }

    .section-header h1 {
      font-size: 2.15rem;
    }

    .section-header h2 {
      font-size: 1.75rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .category-card {
      min-height: 132px;
      padding: 18px;
      border-radius: var(--mobile-radius);
    }

    .category-card strong {
      font-size: 1.08rem;
    }

    .category-card p {
      font-size: .92rem;
      line-height: 1.45;
    }

    .product-grid,
    .shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .product-card,
    .shop-card,
    .form-card,
    .cart-summary,
    .checkout-summary,
    .empty-state,
    .success-card {
      border-radius: var(--mobile-radius);
    }

    .product-info {
      padding: 15px;
    }

    .product-info h3,
    .shop-card .product-info h2 {
      font-size: 1.02rem;
      line-height: 1.35;
    }

    .product-info p {
      font-size: .9rem;
      line-height: 1.5;
      margin-bottom: 12px;
    }

    .price,
    .shop-price .price {
      font-size: 1.18rem;
    }

    .shop-original-price {
      font-size: .92rem;
    }

    .product-image-link .sale-badge,
    .product-image-link .stock-badge,
    .sale-badge,
    .stock-badge {
      top: 10px;
      font-size: .78rem;
      padding: 7px 10px;
    }

    .product-detail,
    .product-layout {
      width: 100%;
    }

    .product-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-details h1 {
      font-size: clamp(2rem, 9vw, 2.8rem);
      line-height: 1.05;
    }

    .detail-price {
      font-size: 2rem;
    }

    .purchase-box {
      padding: 18px;
      margin-top: 18px;
    }

    .purchase-row {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
    }

    .form-card {
      padding: 20px;
      gap: 18px;
    }

    .form-card label {
      font-size: 1rem;
      gap: 8px;
    }

    .form-card input,
    .form-card textarea,
    .form-card select,
    #product-search {
      min-height: var(--mobile-touch);
      padding: 13px 14px;
      font-size: 1rem;
    }

    .form-card textarea {
      min-height: 120px;
    }

    .form-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .form-actions .button,
    .view-product {
      width: 100%;
    }

    .cart-list {
      gap: 12px;
    }

    .cart-item {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 12px;
      padding: 14px;
      align-items: start;
    }

    .cart-item img,
    .cart-placeholder {
      width: 84px;
      height: 84px;
    }

    .cart-item h2 {
      font-size: 1.08rem;
      line-height: 1.35;
    }

    .cart-item-info p,
    .line-total {
      font-size: .95rem;
    }

    .quantity-control {
      gap: 8px;
      margin-top: 10px;
    }

    .quantity-control button {
      min-width: 44px;
      height: 44px;
      font-size: 1.05rem;
    }

    .quantity-control .remove-link {
      min-height: 44px;
    }

    .cart-summary,
    .checkout-summary {
      padding: 20px;
      margin-top: 16px;
    }

    .checkout-layout {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .checkout-summary {
      order: -1;
      position: static;
    }

    .summary-line,
    .cart-summary > div {
      font-size: 1rem;
      margin-bottom: 14px;
    }

    .shop-toolbar {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .search-form {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
    }

    .search-button {
      min-width: 96px;
    }

    .sort-form {
      width: 100%;
      min-height: var(--mobile-touch);
      justify-content: space-between;
    }

    .sort-form label {
      font-size: 1rem;
    }

    .sort-form select {
      flex: 1;
      min-height: var(--mobile-touch);
      font-size: 1rem;
    }

    .category-pills {
      gap: 9px;
      padding-bottom: 7px;
    }

    .category-pills a {
      padding: 11px 16px;
      font-size: .95rem;
    }

    .shop-result-row {
      margin-bottom: 20px;
      font-size: .94rem;
    }

    .pagination {
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
      font-size: .98rem;
    }

    .pagination a {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      padding: 0 14px;
    }

    .admin-head {
      align-items: stretch;
      flex-direction: column;
      gap: 14px;
    }

    .admin-tabs {
      gap: 6px;
      margin-bottom: 18px;
      padding-bottom: 2px;
    }

    .tab {
      min-height: 46px;
      padding: 10px 14px;
      font-size: .95rem;
    }

    .admin-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .panel-title {
      align-items: stretch;
      flex-direction: column;
      gap: 10px;
    }

    #product-search {
      max-width: none !important;
      width: 100%;
    }

    .admin-item {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px;
    }

    .item-actions {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item-actions .small-button {
      width: 100%;
    }

    .table-wrap {
      margin-inline: -2px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table {
      min-width: 680px;
    }

    th,
    td {
      padding: 13px 14px;
      font-size: .92rem;
    }

    .site-footer {
      padding: 34px 0;
    }

    .clever-floating-cart,
    .clever-floating-whatsapp {
      width: 58px;
      height: 58px;
      bottom: calc(14px + env(safe-area-inset-bottom));
    }

    .clever-floating-cart {
      right: 12px;
    }

    .clever-floating-whatsapp {
      left: 12px;
    }
  }

  @media (max-width: 430px) {
    .container {
      width: min(100% - 20px, 680px);
    }

    .site-header .logo,
    .logo {
      font-size: 1.16rem;
      max-width: 43%;
    }

    .site-header .site-logo-image,
    .site-logo-image {
      max-width: 105px;
      max-height: 36px;
    }

    .main-nav {
      max-width: 57%;
      font-size: .82rem;
    }

    .hero {
      padding: 44px 0 40px;
    }

    .section {
      padding: 40px 0;
    }

    .category-grid,
    .product-grid,
    .shop-grid {
      gap: 10px;
    }

    .category-card {
      min-height: 126px;
      padding: 15px;
    }

    .product-info {
      padding: 13px;
    }

    .product-info h3,
    .shop-card .product-info h2 {
      font-size: .98rem;
    }

    .search-button {
      min-width: 88px;
      padding-inline: 12px;
    }

    .cart-item {
      grid-template-columns: 76px minmax(0, 1fr);
    }

    .cart-item img,
    .cart-placeholder {
      width: 76px;
      height: 76px;
    }
  }
</style>
