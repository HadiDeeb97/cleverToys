<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content="Clever Toys Lebanon — fun, educational and exciting toys for children of all ages." />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="stylesheet" href="/mobile-search-fix.css" />
    <title>Clever Toys Lebanon</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  /* Mobile-only enlargement: desktop/tablet styles are left untouched. */
  @media (max-width: 767px) {
    :root {
      --mobile-radius: 18px;
      --mobile-touch: 56px;
    }

    html {
      font-size: 17px;
    }

    body {
      font-size: 17px;
      line-height: 1.55;
    }

    .container {
      width: min(100% - 20px, 700px);
    }

    .site-header .header-inner,
    .header-inner {
      min-height: 74px;
      gap: 12px;
    }

    .site-header .logo,
    .logo {
      font-size: 1.42rem;
      line-height: 1.1;
      max-width: 47%;
      gap: 8px;
    }

    .site-header .site-logo-image,
    .site-logo-image {
      max-width: 135px;
      max-height: 44px;
    }

    .site-header .main-nav,
    .main-nav {
      max-width: 53%;
      gap: 5px;
      font-size: .98rem;
      overflow-x: auto;
      padding: 7px 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .main-nav::-webkit-scrollbar {
      display: none;
    }

    .main-nav a {
      padding: 9px 7px;
    }

    .cart-link {
      min-height: 48px;
      padding: 7px 8px;
    }

    .cart-icon {
      font-size: 1.45rem;
    }

    .cart-count-badge {
      min-width: 22px;
      height: 22px;
      font-size: .78rem;
    }

    .hero {
      padding: 60px 0 54px;
    }

    .hero h1,
    .shop-hero h1 {
      font-size: clamp(2.55rem, 12vw, 4rem);
      line-height: 1;
    }

    .hero p,
    .shop-hero p:last-child {
      font-size: 1.12rem;
      line-height: 1.65;
    }

    .button,
    .small-button,
    .view-product,
    .search-button,
    .filter-button {
      min-height: var(--mobile-touch);
      font-size: 1.08rem;
    }

    .button {
      padding: 0 22px;
      border-radius: 14px;
    }

    .section {
      padding: 52px 0;
    }

    .section-header {
      margin-bottom: 28px;
    }

    .section-header h1 {
      font-size: 2.35rem;
    }

    .section-header h2 {
      font-size: 1.95rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .category-card {
      min-height: 146px;
      padding: 19px;
      border-radius: var(--mobile-radius);
    }

    .category-card strong {
      font-size: 1.18rem;
    }

    .category-card p {
      font-size: 1rem;
      line-height: 1.5;
    }

    /* Products are ALWAYS two columns on mobile. */
    .product-grid,
    .shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 14px;
    }

    .product-card,
    .shop-card,
    .form-card,
    .cart-summary,
    .checkout-summary,
    .empty-state,
    .success-card {
      border-radius: var(--mobile-radius);
    }

    .product-info {
      padding: 17px;
    }

    .product-info h3,
    .shop-card .product-info h2 {
      font-size: 1.12rem;
      line-height: 1.35;
      margin-bottom: 9px;
    }

    .product-info p {
      font-size: .98rem;
      line-height: 1.55;
      margin-bottom: 13px;
    }

    .price,
    .shop-price .price {
      font-size: 1.34rem;
      line-height: 1.2;
    }

    .shop-original-price {
      font-size: .98rem;
    }

    .product-image-link .sale-badge,
    .product-image-link .stock-badge,
    .sale-badge,
    .stock-badge {
      top: 10px;
      font-size: .84rem;
      padding: 8px 11px;
    }

    .view-product {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 14px;
      width: 100%;
      min-height: 52px;
      padding: 0 12px;
      border-radius: 12px;
      background: var(--brand-soft);
      font-size: 1rem;
      font-weight: 800;
    }

    .product-detail,
    .product-layout {
      width: 100%;
    }

    .product-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .product-details h1 {
      font-size: clamp(2.25rem, 10vw, 3rem);
      line-height: 1.05;
    }

    .detail-price {
      font-size: 2.25rem;
    }

    .purchase-box {
      padding: 20px;
      margin-top: 20px;
    }

    .purchase-row {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 13px;
    }

    .form-card {
      padding: 22px;
      gap: 20px;
    }

    .form-card label {
      font-size: 1.04rem;
      gap: 9px;
    }

    .form-card input,
    .form-card textarea,
    .form-card select,
    #product-search {
      min-height: var(--mobile-touch);
      padding: 14px 15px;
      font-size: 1.05rem;
      border-radius: 12px;
    }

    .form-card textarea {
      min-height: 130px;
    }

    .form-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 11px;
    }

    .form-actions .button,
    .view-product {
      width: 100%;
    }

    .cart-list {
      gap: 14px;
    }

    .cart-item {
      grid-template-columns: 94px minmax(0, 1fr);
      gap: 14px;
      padding: 16px;
      align-items: start;
    }

    .cart-item img,
    .cart-placeholder {
      width: 94px;
      height: 94px;
    }

    .cart-item h2 {
      font-size: 1.18rem;
      line-height: 1.35;
    }

    .cart-item-info p,
    .line-total {
      font-size: 1rem;
    }

    .quantity-control {
      gap: 9px;
      margin-top: 11px;
    }

    .quantity-control button {
      min-width: 48px;
      height: 48px;
      font-size: 1.15rem;
    }

    .quantity-control .remove-link {
      min-height: 48px;
      font-size: 1rem;
    }

    .cart-summary,
    .checkout-summary {
      padding: 22px;
      margin-top: 18px;
    }

    .checkout-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .checkout-summary {
      order: -1;
      position: static;
    }

    .summary-line,
    .cart-summary > div {
      font-size: 1.04rem;
      margin-bottom: 15px;
    }

    .shop-toolbar {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .search-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 9px;
      width: 100%;
    }

    .search-button {
      min-width: 105px;
      padding-inline: 15px;
    }

    .sort-form {
      width: 100%;
      min-height: var(--mobile-touch);
      justify-content: space-between;
      font-size: 1rem;
    }

    .sort-form label {
      font-size: 1.05rem;
    }

    .sort-form select {
      flex: 1;
      min-height: var(--mobile-touch);
      font-size: 1.05rem;
      padding-inline: 13px;
    }

    .category-pills {
      gap: 10px;
      padding-bottom: 8px;
    }

    .category-pills a {
      padding: 12px 17px;
      font-size: 1rem;
    }

    .shop-result-row {
      margin-bottom: 22px;
      font-size: 1rem;
    }

    .pagination {
      gap: 13px;
      flex-wrap: wrap;
      margin-top: 34px;
      font-size: 1rem;
    }

    .pagination a {
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      padding: 0 15px;
      border-radius: 12px;
    }

    .admin-head {
      align-items: stretch;
      flex-direction: column;
      gap: 15px;
    }

    .admin-tabs {
      gap: 7px;
      margin-bottom: 20px;
      padding-bottom: 2px;
    }

    .tab {
      min-height: 50px;
      padding: 11px 15px;
      font-size: 1rem;
    }

    .admin-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .panel-title {
      align-items: stretch;
      flex-direction: column;
      gap: 11px;
    }

    #product-search {
      max-width: none !important;
      width: 100%;
    }

    .admin-item {
      flex-direction: column;
      align-items: stretch;
      gap: 13px;
      padding: 17px;
    }

    .item-actions {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
    }

    .item-actions .small-button {
      width: 100%;
      min-height: 50px;
      font-size: 1rem;
    }

    .table-wrap {
      margin-inline: -2px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table {
      min-width: 700px;
    }

    th,
    td {
      padding: 14px 15px;
      font-size: .96rem;
    }

    .site-footer {
      padding: 38px 0;
    }

    .clever-floating-cart,
    .clever-floating-whatsapp {
      width: 62px;
      height: 62px;
      bottom: calc(16px + env(safe-area-inset-bottom));
    }

    .clever-floating-cart {
      right: 12px;
    }

    .clever-floating-whatsapp {
      left: 12px;
    }

    .clever-floating-cart .floating-cart-icon {
      font-size: 28px;
    }

    .clever-floating-whatsapp svg {
      width: 32px;
      height: 32px;
    }
  }

  @media (max-width: 430px) {
    .container {
      width: min(100% - 16px, 700px);
    }

    .site-header .logo,
    .logo {
      font-size: 1.3rem;
      max-width: 44%;
    }

    .site-header .site-logo-image,
    .site-logo-image {
      max-width: 112px;
      max-height: 40px;
    }

    .main-nav {
      max-width: 56%;
      font-size: .92rem;
    }

    .hero {
      padding: 50px 0 44px;
    }

    .section {
      padding: 44px 0;
    }

    .category-grid,
    .product-grid,
    .shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px;
    }

    .category-card {
      min-height: 136px;
      padding: 16px;
    }

    .product-info {
      padding: 14px;
    }

    .product-info h3,
    .shop-card .product-info h2 {
      font-size: 1.06rem;
    }

    .price,
    .shop-price .price {
      font-size: 1.26rem;
    }

    .search-button {
      min-width: 100px;
      padding-inline: 13px;
    }

    .cart-item {
      grid-template-columns: 82px minmax(0, 1fr);
    }

    .cart-item img,
    .cart-placeholder {
      width: 82px;
      height: 82px;
    }
  }
</style>
