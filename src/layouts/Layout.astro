<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content="Clever Toys Lebanon — fun, educational and exciting toys for children of all ages." />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>Clever Toys Lebanon</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const setFilter = (open) => {
          const toggle = document.getElementById('filter-toggle');
          const panel = document.getElementById('filter-panel');
          if (!toggle || !panel) return false;
          panel.hidden = !open;
          panel.style.display = open ? 'block' : '';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-pressed', String(open));
          return true;
        };
        document.addEventListener('click', (event) => {
          const element = event.target instanceof Element ? event.target : null;
          const toggle = element?.closest('#filter-toggle');
          const close = element?.closest('#filter-close');
          if (!toggle && !close) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          if (toggle) {
            const panel = document.getElementById('filter-panel');
            setFilter(panel ? panel.hidden : true);
          } else setFilter(false);
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body { margin: 0; width: 100%; min-height: 100%; }

  /* Responsive behavior is based on viewport width, not pointer/touch detection.
     This keeps real phones, Safari/Chrome mobile and Chrome Device Toolbar consistent. */
  @media (max-width: 1100px) {
    html { font-size: 18px; -webkit-text-size-adjust: 100%; }
    body { font-size: 18px; line-height: 1.55; overflow-x: hidden; }

    .container { width: calc(100% - 24px) !important; max-width: none !important; }

    .site-header { position: sticky; top: 0; z-index: 100; }
    .site-header .header-inner,
    .header-inner { min-height: 72px; gap: 10px; padding-block: 6px; }

    .site-header .logo,
    .logo { font-size: 1.45rem !important; line-height: 1.1; max-width: 48%; flex-shrink: 0; }
    .site-header .site-logo-image,
    .site-logo-image { max-width: 140px !important; max-height: 44px !important; }

    .main-nav { gap: 4px; max-width: 52%; font-size: 1rem !important; overflow-x: auto; padding: 8px 0; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .main-nav::-webkit-scrollbar { display: none; }
    .main-nav a { padding: 10px 7px; white-space: nowrap; }
    .cart-link { min-height: 50px; padding: 8px; }
    .cart-icon { font-size: 1.6rem !important; }
    .cart-count-badge { min-width: 24px; height: 24px; font-size: .82rem; }

    .hero { padding: 64px 0 58px !important; }
    .hero h1,
    .shop-hero h1 { font-size: clamp(2.8rem, 13vw, 4.5rem) !important; line-height: .98; }
    .hero p,
    .shop-hero p:last-child { font-size: 1.2rem !important; line-height: 1.65; }

    .section { padding: 56px 0 !important; }
    .section-header { margin-bottom: 30px; }
    .section-header h1 { font-size: 2.55rem !important; }
    .section-header h2 { font-size: 2.15rem !important; }
    .section-header p { font-size: 1.05rem !important; }

    .category-grid,
    .product-grid,
    .shop-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 14px !important; }

    .category-card { min-height: 154px !important; padding: 18px !important; border-radius: 20px !important; }
    .category-card strong { font-size: 1.2rem !important; }
    .category-card p { font-size: 1.02rem !important; }
    .product-card,
    .shop-card { border-radius: 20px !important; box-shadow: 0 4px 16px rgba(15,23,42,.06); }

    .product-info { padding: 17px !important; }
    .product-info h3,
    .shop-card .product-info h2 { font-size: 1.2rem !important; line-height: 1.28 !important; margin-bottom: 10px !important; }
    .product-info p { font-size: 1rem !important; line-height: 1.5 !important; }
    .price,
    .shop-price .price { font-size: 1.48rem !important; }
    .shop-original-price { font-size: 1rem !important; }

    .button,
    .small-button,
    .view-product,
    .search-button,
    .filter-button { min-height: 58px !important; font-size: 1.1rem !important; border-radius: 14px !important; }

    .view-product { display: flex !important; align-items: center; justify-content: center; width: 100% !important; margin-top: 14px; padding-inline: 10px; font-weight: 800; }

    .form-card { padding: 24px !important; border-radius: 20px !important; }
    .form-card label { font-size: 1.08rem !important; }
    .form-card input,
    .form-card textarea,
    .form-card select,
    #product-search { min-height: 58px !important; padding: 15px 16px !important; font-size: 1.1rem !important; border-radius: 14px !important; }

    .shop-toolbar { display: grid !important; grid-template-columns: 1fr !important; width: 100% !important; gap: 14px !important; }
    .shop-toolbar .search-form { display: grid !important; grid-template-columns: 1fr !important; width: 100% !important; gap: 10px !important; }
    .shop-toolbar .search-form input[type="search"] { width: 100% !important; min-width: 0 !important; max-width: none !important; min-height: 60px !important; font-size: 1.1rem !important; }
    .shop-toolbar .search-form .search-button,
    .shop-toolbar .search-form button[type="submit"] { width: 100% !important; min-width: 0 !important; min-height: 60px !important; margin: 0 !important; }
    .shop-toolbar .toolbar-actions { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 10px !important; width: 100% !important; }
    .shop-toolbar .filter-button { width: 100% !important; min-height: 60px !important; font-size: 1.08rem !important; cursor: pointer; }
    .shop-toolbar .sort-form,
    .shop-toolbar .sort-form select { min-height: 60px !important; width: 100%; min-width: 0; font-size: 1.08rem !important; }
    .shop-toolbar .sort-form { display: grid; grid-template-columns: 1fr; gap: 0; }
    .shop-toolbar .sort-form label { display: none; }

    .filter-panel { position: relative !important; z-index: 20 !important; margin: 0 0 20px !important; padding: 20px !important; border-radius: 20px !important; background: #fff !important; box-shadow: 0 14px 34px rgba(15,23,42,.1) !important; }
    .filter-panel[hidden] { display: none !important; }
    .filter-panel .filter-options { display: grid !important; grid-template-columns: repeat(2,minmax(0,1fr)) !important; gap: 10px !important; }
    .filter-panel .filter-options a { min-height: 54px !important; display: flex !important; align-items: center; justify-content: center; padding: 10px 12px !important; font-size: 1rem !important; text-align: center; border-radius: 14px !important; }
    .filter-panel .filter-close { width: 48px !important; height: 48px !important; font-size: 28px !important; }

    .shop-result-row { font-size: 1rem !important; line-height: 1.45; margin-bottom: 22px !important; }
    .sale-badge,
    .stock-badge,
    .product-image-link .sale-badge,
    .product-image-link .stock-badge { font-size: .9rem !important; padding: 8px 10px !important; }

    .cart-item { grid-template-columns: 96px minmax(0,1fr) !important; gap: 14px !important; padding: 17px !important; }
    .cart-item img,
    .cart-placeholder { width: 96px !important; height: 96px !important; }
    .cart-item h2 { font-size: 1.2rem !important; }
    .quantity-control button { min-width: 52px !important; height: 52px !important; }

    .clever-floating-cart,
    .clever-floating-whatsapp { width: 64px !important; height: 64px !important; bottom: calc(16px + env(safe-area-inset-bottom)); }
    .clever-floating-cart { right: 10px !important; }
    .clever-floating-whatsapp { left: 10px !important; }
    .clever-floating-cart .floating-cart-icon { font-size: 30px !important; }
    .clever-floating-whatsapp svg { width: 34px !important; height: 34px !important; }
  }

  @media (max-width: 430px) {
    .container { width: calc(100% - 20px) !important; }
    .site-header .logo,
    .logo { font-size: 1.35rem !important; max-width: 48%; }
    .site-header .site-logo-image,
    .site-logo-image { max-width: 118px !important; }
    .main-nav { max-width: 52%; font-size: .96rem !important; }
    .hero { padding: 54px 0 48px !important; }
    .section { padding: 48px 0 !important; }
    .category-grid,
    .product-grid,
    .shop-grid { grid-template-columns: repeat(2,minmax(0,1fr)) !important; gap: 10px !important; }
    .product-info { padding: 15px !important; }
    .product-info h3,
    .shop-card .product-info h2 { font-size: 1.16rem !important; }
    .product-info p { font-size: .98rem !important; }
    .price,
    .shop-price .price { font-size: 1.4rem !important; }
    .toolbar-actions { grid-template-columns: 1fr 1fr !important; }
    .filter-panel .filter-options { grid-template-columns: 1fr 1fr !important; }
  }
</style>
