---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

const pageSize = 24;
const parsedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const requestedPage = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const search = Astro.url.searchParams.get('q')?.trim() || '';
const selectedCategorySlugs = [...new Set(Astro.url.searchParams.getAll('category').map(v => v.trim()).filter(Boolean))];
const selectedVariantFilters = [...new Set(Astro.url.searchParams.getAll('variant').map(v => v.trim()).filter(Boolean))];
const ageMinParam = Astro.url.searchParams.get('age_min')?.trim() || '';
const ageMaxParam = Astro.url.searchParams.get('age_max')?.trim() || '';
const ageMin = ageMinParam !== '' && Number.isFinite(Number(ageMinParam)) ? Math.max(0, Number(ageMinParam)) : null;
const ageMax = ageMaxParam !== '' && Number.isFinite(Number(ageMaxParam)) ? Math.max(0, Number(ageMaxParam)) : null;
const sort = Astro.url.searchParams.get('sort') || 'newest';

const [categoriesResult, variantsResult] = await Promise.all([
  supabase.from('categories').select('id, name, slug').eq('is_active', true).order('sort_order', { ascending: true }),
  supabase.from('product_variants').select('name').eq('is_active', true).order('name', { ascending: true })
]);

const categories = categoriesResult.data || [];
const variantOptions = [...new Set((variantsResult.data || []).map(v => String(v.name || '').trim()).filter(Boolean))];
const selectedCategoryIds = categories.filter(c => selectedCategorySlugs.includes(c.slug)).map(c => c.id);
const selectedCategoryNames = categories.filter(c => selectedCategorySlugs.includes(c.slug)).map(c => c.name);
const activeCategoryTitle = selectedCategoryNames.length === 1 ? selectedCategoryNames[0] : selectedCategoryNames.length > 1 ? 'Filtered toys' : '';

const variantProductIdsByFilter = new Set();
let variantFilterError = null;
if (selectedVariantFilters.length) {
  const variantRows = await supabase.from('product_variants').select('product_id').eq('is_active', true).in('name', selectedVariantFilters);
  variantFilterError = variantRows.error;
  for (const row of variantRows.data || []) variantProductIdsByFilter.add(row.product_id);
}

let categoryProductIds = null;
let categoryFilterError = null;
if (selectedCategoryIds.length) {
  const categoryRows = await supabase.from('product_categories').select('product_id').in('category_id', selectedCategoryIds);
  categoryFilterError = categoryRows.error;
  categoryProductIds = new Set((categoryRows.data || []).map(row => row.product_id));
}

const from = (requestedPage - 1) * pageSize;
const to = from + pageSize - 1;

const buildProductsQuery = (head = false) => {
  let query = supabase.from('products').select('id, name, slug, price, sale_price, stock_quantity, primary_image_url, short_description, category_id, age_min, age_max', { count: 'exact', head }).eq('is_active', true);
  if (search) query = query.ilike('name', `%${search}%`);
  if (selectedCategoryIds.length) {
    const ids = [...(categoryProductIds || [])];
    query = ids.length ? query.in('id', ids) : query.in('id', ['00000000-0000-0000-0000-000000000000']);
  }
  if (selectedVariantFilters.length) {
    const ids = [...variantProductIdsByFilter];
    query = ids.length ? query.in('id', ids) : query.in('id', ['00000000-0000-0000-0000-000000000000']);
  }
  if (ageMin !== null) query = query.or(`age_max.gte.${ageMin},age_max.is.null`);
  if (ageMax !== null) query = query.or(`age_min.lte.${ageMax},age_min.is.null`);
  return query;
};

let query = buildProductsQuery();
if (sort === 'price-asc') query = query.order('price', { ascending: true });
else if (sort === 'price-desc') query = query.order('price', { ascending: false });
else if (sort === 'name') query = query.order('name', { ascending: true });
else query = query.order('created_at', { ascending: false });

const { data: products, count, error } = await query.range(from, to);
// Pages past the end (e.g. after products are removed) make the range query fail; send them to the last valid page.
if (requestedPage > 1 && (error || !products?.length)) {
  const { count: availableCount, error: countError } = await buildProductsQuery(true);
  const lastPage = Math.max(1, Math.ceil((availableCount ?? 0) / pageSize));
  if (!countError && requestedPage > lastPage) return Astro.redirect(pageUrl(lastPage));
}
const totalProducts = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalProducts / pageSize));
const currentPage = Math.min(requestedPage, totalPages);

function pageUrl(page: number) {
  const params = new URLSearchParams();
  if (search) params.set('q', search);
  selectedCategorySlugs.forEach(slug => params.append('category', slug));
  selectedVariantFilters.forEach(variant => params.append('variant', variant));
  if (ageMinParam) params.set('age_min', ageMinParam);
  if (ageMaxParam) params.set('age_max', ageMaxParam);
  if (sort !== 'newest') params.set('sort', sort);
  if (page > 1) params.set('page', String(page));
  const queryString = params.toString();
  return `/products${queryString ? `?${queryString}` : ''}`;
}

const hasFilters = Boolean(selectedCategorySlugs.length || selectedVariantFilters.length || ageMinParam || ageMaxParam);
const title = activeCategoryTitle ? `${activeCategoryTitle} Toys | Clever Toys` : search ? `Search results for ${search} | Clever Toys` : 'Shop Toys | Clever Toys';
const description = activeCategoryTitle ? `Shop ${activeCategoryTitle.toLowerCase()} toys at Clever Toys.` : 'Shop toys for children of all ages at Clever Toys. Discover fun, educational and exciting toys.';
const canonicalUrl = new URL('/products', Astro.site ?? Astro.url.origin).href;
---

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#111827" />
  <meta name="format-detection" content="telephone=no" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
</head>

<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav" aria-label="Main navigation"><a href="/">Home</a><a href="/products" aria-current="page">Shop</a><a href="/categories">Categories</a><a href="/cart" aria-label="Shopping cart">Cart</a></nav></div></header>

<main>
  <section class="shop-hero"><div class="container"><p class="shop-eyebrow">Clever Toys</p><h1>{activeCategoryTitle || (search ? 'Search results' : 'Shop all toys')}</h1><p>Find fun, educational and exciting toys for every child.</p></div></section>
  <section class="section shop-section"><div class="container">
    <div class="shop-toolbar">
      <form class="search-form" method="get" action="/products">
        <label class="sr-only" for="product-search">Search toys</label>
        <input id="product-search" name="q" value={search} placeholder="Search toys..." type="search" />
        {selectedCategorySlugs.map(slug => <input type="hidden" name="category" value={slug} />)}
        {selectedVariantFilters.map(variant => <input type="hidden" name="variant" value={variant} />)}
        {ageMinParam && <input type="hidden" name="age_min" value={ageMinParam} />}
        {ageMaxParam && <input type="hidden" name="age_max" value={ageMaxParam} />}
        {sort !== 'newest' && <input type="hidden" name="sort" value={sort} />}
        <button class="button search-button" type="submit">Search</button>
      </form>
      <div class="toolbar-actions">
        <button class="button filter-button" type="button" id="filter-toggle" aria-expanded="false" aria-controls="filter-panel" aria-label="Open filters"><span class="filter-icon" aria-hidden="true">☰</span><span>Filter{hasFilters ? ` (${selectedCategorySlugs.length + selectedVariantFilters.length + (ageMinParam ? 1 : 0) + (ageMaxParam ? 1 : 0)})` : ''}</span></button>
        <form method="get" action="/products" class="sort-form">
          {search && <input type="hidden" name="q" value={search} />}
          {selectedCategorySlugs.map(slug => <input type="hidden" name="category" value={slug} />)}
          {selectedVariantFilters.map(variant => <input type="hidden" name="variant" value={variant} />)}
          {ageMinParam && <input type="hidden" name="age_min" value={ageMinParam} />}
          {ageMaxParam && <input type="hidden" name="age_max" value={ageMaxParam} />}
          <label for="sort">Sort</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="newest" selected={sort === 'newest'}>Newest</option><option value="price-asc" selected={sort === 'price-asc'}>Price: Low to High</option><option value="price-desc" selected={sort === 'price-desc'}>Price: High to Low</option><option value="name" selected={sort === 'name'}>Name: A–Z</option></select>
        </form>
      </div>
    </div>

    <div class="category-pills" aria-label="Shop categories"><a class:list={{ active: !selectedCategorySlugs.length }} href="/products">All Toys</a>{categories?.map(item => <a class:list={{ active: selectedCategorySlugs.includes(item.slug) }} href={`/products?category=${encodeURIComponent(item.slug)}`}>{item.name}</a>)}</div>

    <form class="filter-panel" id="filter-panel" hidden method="get" action="/products">
      {search && <input type="hidden" name="q" value={search} />}
      {sort !== 'newest' && <input type="hidden" name="sort" value={sort} />}
      <div class="filter-panel-head"><div><strong>Filter toys</strong><span class="filter-panel-subtitle">Select as many options as you need.</span></div><button type="button" class="filter-close" id="filter-close" aria-label="Close filters">×</button></div>
      <div class="filter-groups">
        <fieldset class="filter-group"><legend>Categories</legend><div class="filter-check-grid">{categories.map(item => <label class="filter-check"><input type="checkbox" name="category" value={item.slug} checked={selectedCategorySlugs.includes(item.slug)} /><span>{item.name}</span></label>)}</div></fieldset>
        {variantOptions.length > 0 && <fieldset class="filter-group"><legend>Variants / options</legend><div class="filter-check-grid">{variantOptions.map(item => <label class="filter-check"><input type="checkbox" name="variant" value={item} checked={selectedVariantFilters.includes(item)} /><span>{item}</span></label>)}</div></fieldset>}
        <fieldset class="filter-group age-filter-group"><legend>Age range</legend><div class="age-grid"><label>From age<input name="age_min" type="number" min="0" step="1" value={ageMinParam} placeholder="Any" /></label><label>To age<input name="age_max" type="number" min="0" step="1" value={ageMaxParam} placeholder="Any" /></label></div></fieldset>
      </div>
      <div class="filter-actions"><a class="button secondary-button" href="/products">Clear all</a><button class="button" type="submit">Apply filters</button></div>
    </form>

    <div class="shop-result-row"><p>{categoryFilterError || variantFilterError ? 'Some filters could not be loaded.' : totalProducts === 0 ? 'No toys found.' : `Showing ${from + 1}–${Math.min(from + (products?.length ?? 0), totalProducts)} of ${totalProducts} toys`}</p>{hasFilters && <a href="/products">Clear filters</a>}</div>
    {error ? <div class="empty-state"><h2>We couldn't load the toys</h2><p>Please try again in a moment.</p></div> : products?.length ? <div class="product-grid shop-grid">{products.map(product => {
      const displayPrice=Number(product.sale_price??product.price);
      const originalPrice=product.sale_price!=null?Number(product.price):null;
      const inStock=product.stock_quantity>0;
      return <article class="product-card shop-card">
        <a href={`/product/${product.slug}`} class="product-image-link">
          <div class="quick-view-label" aria-hidden="true">Quick view</div>
          {product.primary_image_url?<img class="product-image" src={product.primary_image_url} alt={product.name} loading="lazy" decoding="async" width="400" height="400"/>:<div class="product-placeholder"><span>No image yet</span></div>}
          {product.sale_price!=null&&<span class="sale-badge">Sale</span>}
          {!inStock&&<span class="stock-badge">Out of stock</span>}
          <button type="button" class="quick-view-trigger" aria-label={`Quick view ${product.name}`}>Quick view</button>
        </a>
        <div class="product-info">
          <h2><a href={`/product/${product.slug}`}>{product.name}</a></h2>
          {product.short_description&&<p>{product.short_description}</p>}
          <div class="shop-price"><span class="price">${displayPrice.toFixed(2)}</span>{originalPrice!=null&&<span class="shop-original-price">${originalPrice.toFixed(2)}</span>}</div>
          <a class="view-product" href={`/product/${product.slug}`}>{inStock?'View product':'View details'}</a>
        </div>
      </article>;
    })}</div> : <div class="empty-state"><h2>No toys found</h2><p>Try another search or browse all of our toys.</p><a class="button" href="/products">View all toys</a></div>}
    {totalPages > 1 && <nav class="pagination" aria-label="Product pagination">{currentPage > 1 && <a href={pageUrl(currentPage - 1)}>← Previous</a>}<span>Page {currentPage} of {totalPages}</span>{currentPage < totalPages && <a href={pageUrl(currentPage + 1)}>Next →</a>}</nav>}
  </div></section>
</main>

<div class="quick-view-modal" id="quick-view-modal" aria-hidden="true" inert><div class="quick-view-backdrop" data-quick-view-close></div><section class="quick-view-dialog" role="dialog" aria-modal="true" aria-labelledby="quick-view-title"><button class="quick-view-close" type="button" aria-label="Close quick view" data-quick-view-close>×</button><div class="quick-view-media"><img id="quick-view-image" src="" alt="" /></div><div class="quick-view-content"><p class="quick-view-kicker">Quick view</p><h2 id="quick-view-title"></h2><p id="quick-view-description" class="quick-view-description"></p><div class="quick-view-price"><strong id="quick-view-price"></strong><span id="quick-view-original"></span></div><p id="quick-view-stock" class="quick-view-stock"></p><a id="quick-view-link" class="button" href="#">View product</a></div></section></div>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>

<style>
.shop-hero{padding:58px 0 48px;background:var(--page-hero-bg);border-bottom:1px solid var(--line)}.shop-eyebrow{margin:0 0 10px;color:var(--muted);font-size:.8rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.shop-hero h1{margin:0 0 12px;font-size:clamp(2.3rem,6vw,4rem);letter-spacing:-.02em}.shop-hero p:last-child{margin:0;color:var(--muted);font-size:1.05rem}.shop-section{padding-top:36px}.shop-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:stretch;margin-bottom:20px}.search-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;min-width:0}.search-form input,.sort-form select,.filter-group input[type=number]{min-height:48px;border:1px solid var(--line-strong);border-radius:12px;background:#fff;padding:0 14px;font:inherit}.search-form input{min-width:0;width:100%}.search-button{min-height:48px;border:0;cursor:pointer;font:inherit;white-space:nowrap;min-width:96px}.toolbar-actions{display:grid;grid-template-columns:auto auto;gap:10px;align-items:center}.filter-button{min-height:48px;border:0;cursor:pointer;font:inherit;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:8px}.filter-icon{font-size:.95em}.sort-form{display:flex;align-items:center;gap:8px;white-space:nowrap}.sort-form label{font-size:.9rem;font-weight:700}.sort-form select{min-width:170px}.category-pills{display:none;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:20px;scrollbar-width:thin}.category-pills a{flex:0 0 auto;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:.88rem;font-weight:700}.category-pills a:hover,.category-pills a.active{background:var(--brand-primary);color:var(--brand-text-on-primary);border-color:var(--brand-primary)}.filter-panel{margin:0 0 20px;padding:20px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(15,23,42,.06)}.filter-panel[hidden]{display:none}.filter-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}.filter-panel-head strong{display:block;font-size:1.1rem}.filter-panel-subtitle{display:block;margin-top:4px;color:var(--muted);font-size:.86rem}.filter-close{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:#fff;font-size:22px;line-height:1;cursor:pointer}.filter-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.filter-group{min-width:0;margin:0;padding:16px;border:1px solid var(--line);border-radius:14px}.filter-group legend{padding:0 6px;font-weight:800}.filter-check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:8px;max-height:240px;overflow:auto;padding-right:2px}.filter-check{display:flex;align-items:center;gap:9px;min-width:0;padding:9px 10px;border-radius:10px;background:var(--surface-2);font-size:.9rem;cursor:pointer}.filter-check:hover{background:var(--surface-2)}.filter-check input{width:17px;height:17px;flex:0 0 auto;accent-color:var(--brand-primary)}.filter-check span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.age-filter-group{min-width:0}.age-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:8px;min-width:0}.age-grid label{display:grid;gap:7px;min-width:0;font-size:.84rem;font-weight:700;color:var(--muted)}.age-grid input{width:100%;min-width:0;max-width:100%;padding-inline:10px}.filter-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}.filter-actions .button{min-height:46px}.shop-result-row{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px;color:var(--muted);font-size:.9rem}.shop-result-row p{margin:0}.shop-result-row a{font-weight:700;color:var(--primary-strong)}.shop-grid{margin-top:0}.shop-card{position:relative}.product-image-link{position:relative;display:block;cursor:pointer}.quick-view-label{display:none}.quick-view-trigger{position:absolute;left:50%;bottom:14px;z-index:4;transform:translate(-50%,8px);padding:9px 14px;border:0;border-radius:999px;background:var(--brand-primary);color:var(--brand-text-on-primary);font:inherit;font-size:.76rem;font-weight:800;opacity:0;pointer-events:auto;transition:opacity .18s,transform .18s;white-space:nowrap;cursor:pointer;box-shadow:0 4px 14px rgba(15,23,42,.18)}.product-image-link:hover .quick-view-trigger,.product-image-link:focus-within .quick-view-trigger{opacity:1;transform:translate(-50%,0)}.sale-badge,.stock-badge{position:absolute;top:12px;padding:6px 9px;border-radius:999px;font-size:.72rem;font-weight:800;background:#fff;box-shadow:0 4px 12px rgba(15,23,42,.1)}.sale-badge{left:12px}.stock-badge{right:12px}.shop-card .product-info h2{margin:0 0 8px;font-size:1rem}.shop-price{display:flex;align-items:baseline;gap:8px;margin-top:10px}.shop-original-price{color:var(--subtle);font-size:.9rem;text-decoration:line-through}.view-product{display:inline-block;margin-top:12px;font-size:.88rem;font-weight:800}.empty-state{padding:64px 20px;border:1px dashed var(--line-strong);border-radius:18px;text-align:center}.empty-state h2{margin:0 0 8px}.empty-state p{margin:0 0 20px;color:var(--muted)}.pagination{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:40px;font-size:.92rem}.pagination a{padding:10px 14px;border:1px solid var(--line);border-radius:10px;font-weight:700}.pagination span{color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.quick-view-modal{position:fixed;inset:0;z-index:18000;display:none;align-items:center;justify-content:center;padding:20px}.quick-view-modal.is-open{display:flex}.quick-view-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.62);backdrop-filter:blur(5px)}.quick-view-dialog{position:relative;z-index:1;width:min(920px,100%);display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:0;overflow:hidden;border-radius:22px;background:#fff;box-shadow:0 28px 80px rgba(15,23,42,.28)}.quick-view-media{min-height:420px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;padding:24px}.quick-view-media img{width:100%;height:100%;max-height:600px;object-fit:contain;border-radius:14px}.quick-view-content{padding:34px;display:flex;flex-direction:column;justify-content:center}.quick-view-kicker{margin:0 0 8px;color:var(--muted);font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.quick-view-content h2{margin:0 0 12px;font-size:clamp(1.4rem,3vw,2.2rem);line-height:1.15}.quick-view-description{margin:0 0 18px;color:var(--muted);line-height:1.6}.quick-view-price{display:flex;align-items:baseline;gap:10px;margin-bottom:10px}.quick-view-price strong{font-size:1.5rem}.quick-view-price span{text-decoration:line-through;color:var(--subtle)}.quick-view-stock{margin:0 0 20px;color:var(--muted)}.quick-view-close{position:absolute;top:12px;right:12px;z-index:3;width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,255,255,.92);font-size:24px;cursor:pointer}
@media (max-width:900px){.shop-toolbar{grid-template-columns:1fr}.toolbar-actions{grid-template-columns:1fr 1fr}.sort-form{display:grid;grid-template-columns:1fr;gap:6px}.sort-form label{display:none}.sort-form select{width:100%}.filter-groups{grid-template-columns:1fr}.quick-view-dialog{grid-template-columns:1fr;max-height:90vh;overflow:auto}.quick-view-media{min-height:240px;max-height:44vh}.quick-view-content{padding:22px}}
@media (max-width:767px){.category-pills{display:flex}.shop-toolbar{margin-bottom:14px}.search-form{grid-template-columns:1fr}.search-button{width:100%}.toolbar-actions{grid-template-columns:1fr 1fr}.filter-panel{padding:14px}.filter-groups{gap:10px}.filter-group{padding:12px}.filter-check-grid{grid-template-columns:1fr 1fr}.age-grid{grid-template-columns:1fr 1fr}.filter-actions{display:grid;grid-template-columns:1fr 1fr}.filter-actions .button{width:100%}.shop-result-row{align-items:flex-start}.shop-card .product-info h2{font-size:.9rem}.product-image{aspect-ratio:1/1;object-fit:cover;width:100%}.quick-view-trigger{opacity:1;transform:translate(-50%,0)}}
@media (max-width:430px){.shop-hero{padding:42px 0 32px}.shop-section{padding-top:22px}.category-pills{margin-bottom:14px}.filter-check-grid{gap:7px}.filter-check{padding:8px;font-size:.78rem}.quick-view-dialog{border-radius:16px}.quick-view-media{padding:14px}.quick-view-content{padding:17px}}
</style>

<script>
const filterToggle = document.querySelector('#filter-toggle');
const filterPanel = document.querySelector('#filter-panel');
const filterClose = document.querySelector('#filter-close');
const setFilterOpen = (open) => {
  if (!filterPanel || !filterToggle) return;
  filterPanel.hidden = !open;
  filterPanel.style.display = open ? 'block' : '';
  filterToggle.setAttribute('aria-expanded', String(open));
  filterToggle.setAttribute('aria-pressed', String(open));
};
filterToggle?.addEventListener('click', () => setFilterOpen(filterPanel?.hidden !== false));
filterClose?.addEventListener('click', () => setFilterOpen(false));

const modal = document.querySelector('#quick-view-modal');
const modalImage = document.querySelector('#quick-view-image');
const modalTitle = document.querySelector('#quick-view-title');
const modalDescription = document.querySelector('#quick-view-description');
const modalPrice = document.querySelector('#quick-view-price');
const modalOriginal = document.querySelector('#quick-view-original');
const modalStock = document.querySelector('#quick-view-stock');
const modalLink = document.querySelector('#quick-view-link');
let restoreFocus = null;

const closeQuickView = () => {
  if (!(modal instanceof HTMLElement)) return;
  modal.classList.remove('is-open');
  modal.setAttribute('aria-hidden', 'true');
  modal.setAttribute('inert', '');
  if (restoreFocus instanceof HTMLElement) restoreFocus.focus();
};

const openQuickView = (card, trigger) => {
  if (!(modal instanceof HTMLElement) || !(card instanceof HTMLElement)) return;
  const image = card.querySelector('.product-image');
  const titleEl = card.querySelector('.shop-card .product-info h2');
  const descEl = card.querySelector('.product-info p');
  const priceEl = card.querySelector('.shop-price .price');
  const originalEl = card.querySelector('.shop-original-price');
  const link = card.querySelector('.view-product');
  const stockBadge = card.querySelector('.stock-badge');
  const name = titleEl?.textContent?.trim() || 'Toy';

  if (modalImage instanceof HTMLImageElement) {
    modalImage.src = image instanceof HTMLImageElement ? image.src : '';
    modalImage.alt = name;
  }
  if (modalTitle) modalTitle.textContent = name;
  if (modalDescription) modalDescription.textContent = descEl?.textContent?.trim() || 'Discover more details about this toy.';
  if (modalPrice) modalPrice.textContent = priceEl?.textContent?.trim() || '';
  if (modalOriginal) modalOriginal.textContent = originalEl?.textContent?.trim() || '';
  if (modalStock) modalStock.textContent = stockBadge?.textContent?.trim() || 'In stock';
  if (modalLink instanceof HTMLAnchorElement) modalLink.href = link instanceof HTMLAnchorElement ? link.href : '#';

  restoreFocus = trigger instanceof HTMLElement ? trigger : null;
  modal.classList.add('is-open');
  modal.setAttribute('aria-hidden', 'false');
  modal.removeAttribute('inert');
  modal.querySelector('.quick-view-close')?.focus();
};

document.querySelectorAll('.quick-view-trigger').forEach(trigger => {
  trigger.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopImmediatePropagation();
    openQuickView(trigger.closest('.product-card'), trigger);
  });
});

document.querySelectorAll('[data-quick-view-close]').forEach(el => el.addEventListener('click', closeQuickView));
document.addEventListener('keydown', event => {
  if (event.key === 'Escape') closeQuickView();
});

document.addEventListener('click', event => {
  const target = event.target instanceof Element ? event.target : null;
  if (target?.closest('.quick-view-trigger')) return;
  const imageEl = target?.closest('.product-image-link img');
  if (!imageEl) return;
  const anchor = imageEl.closest('.product-image-link');
  if (!(anchor instanceof HTMLAnchorElement)) return;
  event.preventDefault();
  event.stopImmediatePropagation();
  location.href = anchor.href;
}, true);

</script>
