---
/**
 * Shop page: /products
 *
 * Lists active toys, 24 per page, with search (?q=), category (?category=), option (?variant=),
 * age (?age_min= / ?age_max=) filters and sorting (?sort=). Everything is done on the server
 * with plain links and forms, so filters work even before any JavaScript has loaded.
 * The listing (loading and markup) is shared with the category pages: src/lib/shop.ts and
 * src/components/ShopView.astro.
 */
import { loadShop } from '../lib/shop';
import ShopView from '../components/ShopView.astro';
import QuickView from '../components/QuickView.astro';
import { getPageData } from '../lib/page-data';
import '../styles/global.css';

const shop = await loadShop(Astro, { basePath: '/products' });
if ('redirect' in shop) return Astro.redirect(shop.redirect);
const { search, saleOnly, selectedCategorySlugs, categories } = shop;
const selectedCategoryNames = categories.filter(c => selectedCategorySlugs.includes(c.slug)).map(c => c.name);
const activeCategoryTitle = selectedCategoryNames.length === 1 ? selectedCategoryNames[0] : selectedCategoryNames.length > 1 ? 'Filtered toys' : '';
const title = saleOnly && !activeCategoryTitle && !search ? 'Toys on Sale | Clever Toys' : activeCategoryTitle ? `${activeCategoryTitle} Toys | Clever Toys` : search ? `Search results for ${search} | Clever Toys` : 'Shop Toys | Clever Toys';
const description = saleOnly && !activeCategoryTitle ? 'Toys on sale at Clever Toys: discounted prices, cash on delivery across Lebanon.' : activeCategoryTitle ? `Shop ${activeCategoryTitle.toLowerCase()} toys at Clever Toys.` : 'Shop toys for children of all ages at Clever Toys. Discover fun, educational and exciting toys.';
const canonicalUrl = new URL(saleOnly && !search && !selectedCategorySlugs.length ? '/products?sale=1' : '/products', Astro.site ?? Astro.url.origin).href;
// Started by the middleware for the header, so this is already loaded (no extra request).
const { hasSale } = await getPageData(Astro);
const heading = saleOnly && !activeCategoryTitle && !search ? 'Toys on sale' : activeCategoryTitle || (search ? `Results for “${search}”` : 'Shop all toys');
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
</head>
<header class="site-header"></header>
<main>
  <section class="page-hero shop-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Shop</span></nav>
      <h1>{heading}</h1>
      <p>Fun, educational and exciting toys for every child, with cash on delivery across Lebanon.</p>
    </div>
  </section>

  <ShopView shop={shop} hasSale={hasSale} />
</main>
<QuickView />
<footer class="site-footer"></footer>

