---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

const [{ data: categories, error: categoriesError }, { data: featuredProducts, error: productsError }] = await Promise.all([
  supabase.from('categories').select('id,name,slug,description').eq('is_active', true).order('sort_order', { ascending: true }),
  supabase.from('products').select('id,name,slug,price,sale_price,primary_image_url,short_description').eq('is_active', true).eq('is_featured', true).order('created_at', { ascending: false }).limit(8)
]);
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const title = 'Clever Toys Lebanon | Educational & Fun Toys for Kids';
const description = 'Shop fun, educational and exciting toys in Lebanon. Discover quality toys for babies, kids and growing learners at Clever Toys.';
const webSiteSchema = {
  '@context':'https://schema.org',
  '@type':'WebSite',
  name:'Clever Toys',
  url:siteUrl,
  potentialAction:{'@type':'SearchAction',target:`${new URL('/products', Astro.site ?? Astro.url.origin).href}?q={search_term_string}`, 'query-input':'required name=search_term_string'}
};
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:site_name" content="Clever Toys" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav" aria-label="Main navigation"><a href="/" aria-current="page">Home</a><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart" class="cart-link" aria-label="Shopping cart"></a></nav></div></header>
<main>
  <section class="hero home-hero"><div class="container hero-content"><p class="home-eyebrow">Clever Toys • Lebanon</p><h1>Play. Learn. Discover.</h1><p>Fun, educational and exciting toys carefully selected for every stage of childhood.</p><div class="hero-actions"><a href="/products" class="button">Shop Toys</a><a href="/categories" class="button secondary-button">Browse Categories</a></div><div class="hero-points"><span>✓ Quality toys</span><span>✓ Cash on delivery</span><span>✓ Fast local delivery</span></div></div></section>
  <section class="section"><div class="container"><div class="section-header"><h2>Shop by Category</h2><p>Find something fun for every child.</p></div>{categoriesError ? <div class="empty-state"><h2>Categories are temporarily unavailable</h2><p>Please try again shortly.</p></div> : categories?.length ? <div class="category-grid">{categories.map(category => <a href={`/category/${category.slug}`} class="category-card"><strong>{category.name}</strong>{category.description && <p>{category.description}</p>}<span class="category-arrow">View toys →</span></a>)}</div> : <div class="empty-state"><h2>No categories yet</h2><p>New collections are coming soon.</p></div>}</div></section>
  <section class="section home-featured"><div class="container"><div class="section-header section-header-row"><div><h2>Featured Toys</h2><p>Popular picks from Clever Toys.</p></div><a href="/products" class="text-link">View all toys →</a></div>{productsError ? <div class="empty-state"><h2>We couldn't load featured toys</h2><p>Please refresh the page in a moment.</p></div> : featuredProducts?.length ? <div class="product-grid">{featuredProducts.map(product => { const price = Number(product.sale_price ?? product.price); const original = product.sale_price != null ? Number(product.price) : null; return <article class="product-card"><a href={`/product/${product.slug}`} class="home-product-link">{product.primary_image_url ? <img class="product-image" src={product.primary_image_url} alt={product.name} loading="lazy" decoding="async" /> : <div class="product-placeholder"><span>No image yet</span></div>}</a><div class="product-info"><h3><a href={`/product/${product.slug}`}>{product.name}</a></h3>{product.short_description && <p>{product.short_description}</p>}<div class="home-price"><span class="price">${price.toFixed(2)}</span>{original != null && <span class="shop-original-price">${original.toFixed(2)}</span>}</div><a href={`/product/${product.slug}`} class="view-product">View product →</a></div></article>; })}</div> : <div class="empty-state"><h2>No featured toys yet</h2><p>Browse our full collection to find your next favorite toy.</p><a href="/products" class="button">Shop all toys</a></div>}</div></section>
  <section class="section home-benefits"><div class="container benefit-grid"><div><strong>Easy ordering</strong><p>Simple checkout with cash on delivery.</p></div><div><strong>Made for families</strong><p>Fun picks for babies, kids and growing learners.</p></div><div><strong>Local support</strong><p>Need help? Message us directly on WhatsApp.</p></div></div></section>
</main>
<footer class="site-footer"><div class="container footer-inner"><div><strong>Clever Toys</strong><p>Fun toys for curious minds.</p></div><div class="footer-links"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a></div></div><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>
<style>
.home-hero{padding:88px 0 76px;background:linear-gradient(135deg,var(--brand-soft),#fff)}.home-eyebrow{margin:0 0 14px;color:#64748b;font-size:.82rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.hero-points{display:flex;gap:18px;flex-wrap:wrap;margin-top:24px;color:#475569;font-size:.9rem;font-weight:650}.category-card{position:relative}.category-arrow{margin-top:14px;color:#64748b;font-size:.82rem;font-weight:800}.section-header-row{display:flex;justify-content:space-between;align-items:end;gap:20px}.text-link{font-weight:800}.home-product-link{display:block}.home-price{display:flex;align-items:baseline;gap:8px;margin-top:8px}.view-product{display:inline-block;margin-top:12px;font-size:.88rem;font-weight:800}.home-benefits{padding-top:20px}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.benefit-grid>div{padding:22px;border:1px solid #e5e7eb;border-radius:16px;background:#fff}.benefit-grid strong{font-size:1rem}.benefit-grid p{margin:7px 0 0;color:#64748b;line-height:1.55}.footer-inner{display:flex;justify-content:space-between;gap:30px;align-items:flex-start;margin-bottom:22px}.footer-inner p{margin:6px 0 0}.footer-links{display:flex;gap:16px;flex-wrap:wrap;font-weight:650;font-size:.9rem}.footer-links a:hover{text-decoration:underline}@media(max-width:900px){.home-hero{padding:68px 0 58px}.benefit-grid{grid-template-columns:1fr}.footer-inner{flex-direction:column}}@media(max-width:640px){.home-hero{padding:52px 0 46px}.hero-actions .button{width:100%}.hero-points{gap:10px 14px;font-size:.82rem}.section-header-row{align-items:flex-start;flex-direction:column}.footer-links{gap:12px}.footer-inner{margin-bottom:18px}}
</style>