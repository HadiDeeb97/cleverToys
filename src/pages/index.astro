---
/**
 * Home page: /
 *
 * Built from sections that are switched on, ordered and written in Admin → Storefront:
 * hero, store promises, categories, featured toys, promotion banner, new arrivals, shop by age,
 * our story and "help choosing" (WhatsApp). Defaults live in src/lib/design.ts.
 * Styles: src/styles/global.css, section 6. Product cards: src/components/ProductCard.astro.
 */
import { supabase } from '../lib/supabase';
import { getPageData, DEFAULT_WHATSAPP_URL } from '../lib/page-data';
import { AGE_RANGES, placeholderFor } from '../lib/design';
import ProductCard, { type CardProduct } from '../components/ProductCard.astro';
import QuickView from '../components/QuickView.astro';
import '../styles/global.css';

const cardFields = 'id,name,slug,price,sale_price,stock_quantity,primary_image_url,short_description,age_min,age_max,created_at,product_variants(id,is_active,price,sale_price)';

// Settings, categories, featured toys and new arrivals all load at the same time.
const [pageData, featuredResult, newestResult, categoriesResult] = await Promise.all([
  getPageData(Astro),
  supabase.from('products').select(cardFields).eq('is_active', true).eq('is_featured', true).order('created_at', { ascending: false }).limit(8),
  supabase.from('products').select(cardFields).eq('is_active', true).order('created_at', { ascending: false }).limit(8),
  supabase.from('categories').select('id,name,slug,description,image_url').eq('is_active', true).order('sort_order', { ascending: true })
]);
const { design, storeSettings } = pageData;
const featured = (featuredResult.data ?? []) as unknown as CardProduct[];
const newest = (newestResult.data ?? []) as unknown as CardProduct[];
const categories = categoriesResult.data ?? [];
const sections = design.sections.filter((s) => s.enabled).map((s) => s.id);
const whatsappUrl = /^https:\/\//.test(String(storeSettings.whatsapp_url || '')) ? String(storeSettings.whatsapp_url) : DEFAULT_WHATSAPP_URL;

// Hero picture: the uploaded hero image, otherwise a composition of product photos or toy emoji tiles.
const heroPhotos = featured.map((p) => p.primary_image_url).filter(Boolean) as string[];

const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const title = 'Clever Toys Lebanon | Educational & Fun Toys for Kids';
const description = 'Shop fun, educational and exciting toys in Lebanon. Discover quality toys for babies, kids and growing learners at Clever Toys.';
const webSiteSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Clever Toys', url: siteUrl,
  potentialAction: { '@type': 'SearchAction', target: `${new URL('/products', Astro.site ?? Astro.url.origin).href}?q={search_term_string}`, 'query-input': 'required name=search_term_string' }
};
const tile = (name: string) => placeholderFor(name);
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:site_name" content="Clever Toys" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {design.hero.image && <link rel="preload" as="image" href={design.hero.image} fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
</head>
<header class="site-header"></header>
<main>
  {sections.map((id) => {
    /* ---------- Hero ---------- */
    if (id === 'hero') return (
      <section class="home-hero">
        <div class="container home-hero-inner">
          <div class="hero-copy">
            {design.hero.eyebrow && <p class="home-eyebrow">{design.hero.eyebrow}</p>}
            <h1>{design.hero.title} {design.hero.highlight && <span class="hero-highlight">{design.hero.highlight}</span>}</h1>
            {design.hero.text && <p>{design.hero.text}</p>}
            <div class="hero-actions">
              {design.hero.primary_label && <a href={design.hero.primary_link} class="button">{design.hero.primary_label} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>}
              {design.hero.secondary_label && <a href={design.hero.secondary_link} class="button secondary-button">{design.hero.secondary_label}</a>}
            </div>
            <div class="hero-proof" aria-hidden="true">
              <span class="hero-proof-dots"><span style="--h:40">🧸</span><span style="--h:200">🚀</span><span style="--h:330">🎨</span><span style="--h:145">🧩</span></span>
              <span>Delivered to families across Lebanon</span>
            </div>
          </div>
          <div class="hero-visual">
            {design.hero.image ? <img src={design.hero.image} alt="" fetchpriority="high" decoding="async" width="600" height="600" /> : (
              <div class="hero-art" aria-hidden="true">
                <div class="art-main">{heroPhotos[0] ? <img src={heroPhotos[0]} alt="" fetchpriority="high" decoding="async" /> : '🧸'}</div>
                <div class="art-a">{heroPhotos[1] ? <img src={heroPhotos[1]} alt="" loading="lazy" /> : '🚀'}</div>
                <div class="art-b">{heroPhotos[2] ? <img src={heroPhotos[2]} alt="" loading="lazy" /> : '🧩'}</div>
                <div class="art-card"><b>✓</b><span>Cash on delivery<small>Pay when it arrives</small></span></div>
              </div>
            )}
          </div>
        </div>
      </section>
    );

    /* ---------- Store promises ---------- */
    if (id === 'trust' && design.trust.length) return (
      <section class="trust-strip" aria-label="Why shop with us">
        <div class="container trust-grid" style={`--items:${design.trust.length}`}>
          {design.trust.map((item) => (
            <div class="trust-item"><span class="trust-icon" aria-hidden="true">{item.icon || '✓'}</span><span><strong>{item.title}</strong>{item.text && <span>{item.text}</span>}</span></div>
          ))}
        </div>
      </section>
    );

    /* ---------- Shop by category ---------- */
    if (id === 'categories' && categories.length) return (
      <section class="section">
        <div class="container">
          <div class="section-header section-header-row">
            <div><h2>{design.titles.categories.title}</h2><p>{design.titles.categories.subtitle}</p></div>
            <a href="/categories" class="text-link">All categories →</a>
          </div>
          <div class="category-tiles">
            {categories.map((category) => {
              const ph = tile(category.name);
              return (
                <a href={`/category/${category.slug}`} class="category-tile">
                  <span class="tile-media" style={`--ph-h:${ph.hue}`}>
                    {category.image_url ? <img src={category.image_url} alt="" loading="lazy" decoding="async" /> : <span aria-hidden="true">{ph.emoji}</span>}
                    <span class="tile-arrow" aria-hidden="true">→</span>
                  </span>
                  <span><strong>{category.name}</strong>{category.description && <small>{category.description}</small>}</span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    );

    /* ---------- Featured toys / New arrivals ---------- */
    if ((id === 'featured' && featured.length) || (id === 'new' && newest.length)) {
      const list = id === 'featured' ? featured : newest;
      const text = design.titles[id];
      return (
        <section class="section">
          <div class="container">
            <div class="section-header section-header-row">
              <div><h2>{text.title}</h2><p>{text.subtitle}</p></div>
              <a href={id === 'new' ? '/products?sort=newest' : '/products'} class="text-link">View all toys →</a>
            </div>
            <div class="product-grid home-rail">{list.map((product) => <ProductCard product={product} />)}</div>
          </div>
        </section>
      );
    }

    /* ---------- Promotion banner ---------- */
    if (id === 'promo') return (
      <section class="section tight">
        <div class="container">
          <div class:list={['promo-banner', `style-${design.promo.style}`]}>
            <div>
              {design.promo.eyebrow && <p class="eyebrow">{design.promo.eyebrow}</p>}
              <h2>{design.promo.title}</h2>
              {design.promo.text && <p>{design.promo.text}</p>}
              {design.promo.button_label && <a class="button" href={design.promo.button_link}>{design.promo.button_label}</a>}
            </div>
            <div class="promo-visual" aria-hidden="true">{design.promo.image ? <img src={design.promo.image} alt="" loading="lazy" decoding="async" /> : '🎁'}</div>
          </div>
        </div>
      </section>
    );

    /* ---------- Shop by age ---------- */
    if (id === 'ages') return (
      <section class="section">
        <div class="container">
          <div class="section-header center"><h2>{design.titles.ages.title}</h2><p>{design.titles.ages.subtitle}</p></div>
          <div class="age-grid-home">
            {AGE_RANGES.map((age) => (
              <a class="age-tile" href={`/products?age_min=${age.min}${age.max != null ? `&age_max=${age.max}` : ''}`}>
                <span class="age-icon" aria-hidden="true">{age.icon}</span>
                <strong>{age.label}</strong>
                <small>{age.note}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    );

    /* ---------- Our story ---------- */
    if (id === 'story') return (
      <section class="section">
        <div class="container story-block">
          <div class="story-visual" aria-hidden="true">{design.story.image ? <img src={design.story.image} alt="" loading="lazy" decoding="async" /> : '🎈'}</div>
          <div class="story-copy">
            {design.story.eyebrow && <p class="eyebrow">{design.story.eyebrow}</p>}
            <h2>{design.story.title}</h2>
            <p>{design.story.text}</p>
            {design.story.button_label && <a class="button secondary-button" href={design.story.button_link}>{design.story.button_label}</a>}
          </div>
        </div>
      </section>
    );

    /* ---------- Help choosing (WhatsApp) ---------- */
    if (id === 'help') return (
      <section class="section tight">
        <div class="container">
          <div class="help-card">
            <div>
              <span class="help-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41Z"/></svg></span>
              <div><h2>{design.help.title}</h2><p>{design.help.text}</p></div>
            </div>
            <a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">{design.help.button_label}</a>
          </div>
        </div>
      </section>
    );
    return null;
  })}
</main>
<QuickView />
<footer class="site-footer"></footer>
