---
/**
 * Admin → Products → "Download template": builds the Excel file used to import products in bulk.
 */
import '../../styles/global.css';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/admin" class="logo">Clever Toys Admin</a>
    <nav class="main-nav">
      <a href="/admin">Products</a>
      <a href="/admin/orders">Orders</a>
      <a href="/">Store</a>
    </nav>
  </div>
</header>

<main class="section">
  <div class="container narrow">
    <div class="section-header">
      <p class="eyebrow">Product import</p>
      <h1>Excel Product Template</h1>
      <p>Download the template, fill in your products, save the file, then import it from the Products &amp; Categories admin page.</p>
    </div>

    <div class="form-card">
      <h2>Download template</h2>
      <p>The file includes all supported product columns plus an example product and an Instructions sheet.</p>
      <button id="download-template" class="button" type="button">Download Excel Template</button>
      <p id="message" role="status"></p>
      <p><a href="/admin">← Back to Products &amp; Categories</a></p>
    </div>
  </div>
</main>

<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
  // The same template as Admin → Products → Excel import (src/scripts/import-template.ts).
  import { downloadImportTemplate } from '../../scripts/import-template';
  document.querySelector<HTMLButtonElement>('#download-template')!.onclick = () => {
    const message = document.querySelector<HTMLElement>('#message')!;
    const XLSX = (window as any).XLSX;
    if (!XLSX) { message.textContent = 'Excel tools are still loading. Please try again.'; return; }
    downloadImportTemplate(XLSX);
    message.textContent = 'Template downloaded.';
  };
</script>