.custom-theme{display:grid;gap:12px;margin-top:12px;padding:14px;border:2px dashed var(--line-strong);border-radius:18px;background:var(--surface-2)}
.custom-theme>div:first-child{display:grid;gap:3px}
.custom-theme small{color:var(--muted)}
.custom-theme-inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.gradient-switch{margin-bottom:12px}
.custom-theme-inputs label{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 8px 8px 14px;border:1.5px solid var(--line);border-radius:14px;background:var(--surface);font-size:.88rem}
.custom-theme-inputs input[type=color]{width:44px;height:36px;min-height:0;padding:2px;border:0;border-radius:10px;background:none;cursor:pointer}
.custom-note{margin:0;padding:8px 12px;border-radius:10px;background:var(--accent-soft);font-size:.85rem;font-weight:700}
.theme-preview-wrap{position:sticky;top:calc(var(--header-h) + 16px)}
.preview-label{margin:0 0 8px;color:var(--muted);font-size:.78rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
/* Live preview: its own copy of the theme colours, so picking a theme recolours only this box
   (the colours derived from them are re-declared here for the same reason). */
.theme-preview{--brand-gradient:linear-gradient(135deg,var(--brand-primary),var(--brand-primary-2));--primary-strong:color-mix(in srgb,var(--brand-primary) 78%,#000);--accent-soft:color-mix(in srgb,var(--theme-accent) 22%,#fff);--tp-ink:color-mix(in srgb,var(--brand-primary) 6%,#1b1822);--tp-bg:#fbf7f1;overflow:hidden;border:1.5px solid var(--line);border-radius:20px;background:var(--tp-bg);box-shadow:var(--shadow);font-family:var(--font-body);color:var(--tp-ink)}
.tp-ribbon{padding:6px;background:var(--tp-ink);color:#fff;font-size:.62rem;font-weight:700;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tp-header{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid rgba(0,0,0,.06)}
.tp-logo{font-family:var(--font-display);font-weight:var(--display-weight);letter-spacing:var(--display-tracking);font-size:1rem;white-space:nowrap}
.tp-nav{display:flex;gap:9px;font-size:.62rem;font-weight:700;color:color-mix(in srgb,var(--tp-ink) 80%,#fff)}
.tp-nav .tp-sale{color:var(--danger)}
.tp-search{margin-left:auto;padding:4px 10px;border:1px solid rgba(0,0,0,.1);border-radius:99px;background:#fff;color:#9b96a5;font-size:.58rem;white-space:nowrap}
.tp-cart{display:inline-flex;align-items:center;gap:4px;padding:5px 6px 5px 9px;border-radius:99px;background:var(--tp-ink);color:#fff;font-size:.62rem;font-weight:700}
.tp-cart em{display:grid;place-items:center;min-width:15px;height:15px;border-radius:99px;background:var(--theme-accent);color:var(--theme-text-on-accent);font-style:normal;font-size:.55rem;font-weight:800}
@media (max-width:520px){.tp-nav,.tp-search{display:none}.tp-cart{margin-left:auto}}
.tp-hero{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;gap:10px;padding:18px 14px;background:radial-gradient(circle at 85% 20%,var(--accent-soft),transparent 60%),radial-gradient(circle at 0% 100%,color-mix(in srgb,var(--brand-primary) 10%,transparent),transparent 55%)}
.tp-copy{display:grid;gap:8px;justify-items:start}
.tp-eyebrow{color:var(--primary-strong);font-size:.55rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.tp-copy strong{font-family:var(--font-display);font-weight:var(--display-weight);letter-spacing:var(--display-tracking);font-size:1.3rem;line-height:1.02}
.tp-copy strong i{color:var(--primary-strong)}
.tp-buttons{display:flex;gap:6px;flex-wrap:wrap}
.tp-primary,.tp-secondary{padding:6px 12px;border-radius:99px;font-size:.62rem;font-weight:700;white-space:nowrap}
.tp-primary{background:var(--brand-gradient);color:var(--brand-text-on-primary)}
.tp-secondary{background:#fff;box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.14)}
.tp-art{position:relative;display:grid;place-items:center;aspect-ratio:1;width:100%;max-width:130px;justify-self:end;border-radius:22px;background:var(--brand-gradient);font-size:2.6rem}
.tp-art em{position:absolute;right:-6px;bottom:-6px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--theme-accent);font-size:1rem;font-style:normal;box-shadow:0 4px 10px rgba(0,0,0,.15)}
.tp-products{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:4px 12px 14px}
.tp-card{display:grid;gap:3px;min-width:0}
.tp-image{position:relative;display:grid;place-items:center;aspect-ratio:1;border-radius:12px;background:hsl(var(--h) 70% 92%);font-size:1.7rem}
.tp-image em{position:absolute;left:5px;top:5px;padding:2px 6px;border-radius:99px;font-size:.5rem;font-style:normal;font-weight:800}
.tp-badge-sale{background:var(--danger);color:#fff}
.tp-badge-new{background:var(--theme-accent);color:var(--theme-text-on-accent)}
.tp-add{position:absolute;right:5px;bottom:5px;display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#fff;font-size:.7rem;font-weight:800;box-shadow:0 2px 6px rgba(0,0,0,.12)}
.tp-card small{font-size:.62rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tp-price{font-size:.66rem;font-weight:800}
.tp-price.on-sale{color:var(--danger)}
.tp-price s{color:#9b96a5;font-weight:600}
.theme-actions{display:flex;gap:10px;flex-wrap:wrap}
.publish-status{margin:0;padding:10px 14px;border-radius:12px;background:var(--surface-2);color:var(--muted);font-size:.9rem;font-weight:700}
.logo-preview{min-height:180px;display:grid;place-items:center;padding:26px;border:1px dashed var(--line-strong);border-radius:16px;background:linear-gradient(135deg,var(--surface-2),#fff)}
.logo-preview img{max-width:min(100%,420px);max-height:160px;object-fit:contain}
.icon-setup{padding:12px 14px;border:1.5px solid #f0b429;border-radius:12px;background:#fff9e8;color:#6b4a00;font-weight:600}
.icon-preview-row{display:flex;flex-wrap:wrap;gap:18px;align-items:stretch}
.icon-tab-preview{flex:1 1 280px;display:grid;align-content:end;min-height:96px;padding:14px 14px 0;border-radius:14px;background:#dfe3ea}
.icon-tab{display:flex;align-items:center;gap:8px;width:min(100%,240px);padding:9px 12px;border-radius:10px 10px 0 0;background:#fff;color:#202124;font-size:.8rem}
.icon-tab img{width:16px;height:16px;object-fit:contain}
.icon-tab span{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.icon-tab b{color:#5f6368;font-weight:400}
.icon-tab-bar{display:block;height:10px;background:#fff}
.icon-home-preview{flex:0 0 120px;display:grid;justify-items:center;align-content:center;gap:6px;padding:14px;border-radius:14px;background:linear-gradient(160deg,#1e3a8a,#7c3aed);color:#fff}
.icon-home-preview img{width:60px;height:60px;border-radius:14px;object-fit:cover;background:#fff}
.icon-home-preview small{font-size:.72rem}
.icon-bg-row{display:flex!important;align-items:center;gap:10px;font-weight:700}
.icon-options{margin:0;padding:0;border:0;min-width:0}
.icon-options legend{margin-bottom:8px;font-weight:700}
.icon-choice-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.icon-choice{position:relative;display:block!important}
.icon-choice input{position:absolute;opacity:0;pointer-events:none}
.icon-choice span{display:flex;align-items:center;gap:8px;padding:8px 14px;color:var(--ink);border:1.5px solid var(--line);border-radius:999px;background:var(--surface);font-weight:700;font-size:.88rem;cursor:pointer}
.icon-choice input:checked+span{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.icon-choice input:focus-visible+span{outline:2px solid var(--accent,#2563eb);outline-offset:2px}
.icon-choice i{display:block;width:18px;height:18px;background:var(--surface-2,#e5e7eb);border:1.5px solid currentColor}
.icon-choice i.shape-rounded{border-radius:5px}.icon-choice i.shape-circle{border-radius:50%}
.icon-choice i.line-none{border:1.5px dashed var(--muted)}.icon-choice i.line-thin{border-width:1.5px;border-radius:5px}.icon-choice i.line-thick{border-width:4px;border-radius:5px}
.icon-color{display:flex!important;align-items:center;gap:8px;font-weight:700;font-size:.88rem}
.icon-color input{width:40px;height:34px;padding:2px;border-radius:8px}
.icon-home-preview img{object-fit:contain}
.settings-actions{display:flex;gap:14px;align-items:center;justify-content:flex-start;padding-bottom:30px}
.settings-actions p,.branding-card>p{margin:0;color:var(--muted)}
.settings-actions .button{min-width:190px}
@media(max-width:900px){.theme-layout{grid-template-columns:minmax(0,1fr)}.theme-preview-wrap{position:static;order:-1}}@media(max-width:760px){.settings-grid,.feature-list{grid-template-columns:1fr}.theme-actions .button{width:100%}.cod-field{grid-template-columns:1fr}.section-heading{flex-direction:column}.status-text{white-space:normal}.theme-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.settings-actions{display:grid}.settings-actions .button{width:100%}}
@media(max-width:520px){.theme-grid{grid-template-columns:1fr}.custom-theme-inputs{grid-template-columns:1fr}.switch-row{align-items:flex-start}.switch-row input{margin-top:2px}}
</style>

<style is:global>
