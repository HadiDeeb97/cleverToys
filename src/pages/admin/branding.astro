---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
const logoUrl = supabaseUrl ? `${supabaseUrl.replace(/\/$/, '')}/storage/v1/object/public/product-images/branding/logo.webp` : '';
---
<header class="site-header"><div class="container header-inner"><a class="logo" href="/admin">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/dashboard">Dashboard</a><a href="/admin/orders">Orders</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container branding-page">
  <div class="admin-head"><div><p class="eyebrow">Store appearance</p><h1>Branding &amp; Theme</h1><p>Make Clever Toys feel bright, playful and friendly. Logo and theme changes apply to the storefront.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div>
  <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} data-logo={logoUrl} hidden></div>
  <div id="auth-status" class="admin-status" role="status">Checking admin access…</div>

  <div id="app">
    <section class="form-card branding-card">
      <div class="section-heading"><div><p class="eyebrow">Logo</p><h2>Store Logo</h2><p>Upload your Clever Toys logo. It is converted to WebP automatically.</p></div></div>
      <div class="logo-preview"><img id="preview" src={logoUrl} alt="Current Clever Toys logo" /></div>
      <label>Choose logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
      <button id="save" class="button" type="button" disabled>Upload &amp; Apply</button>
      <p id="message" role="status"></p>
    </section>

    <section class="form-card branding-card theme-card-panel">
      <div class="section-heading"><div><p class="eyebrow">Store theme</p><h2>Pick a playful style</h2><p>Choose a preset designed for a toy store. The selected style is remembered on this device.</p></div><span id="theme-status" class="theme-status" role="status"></span></div>
      <div id="theme-grid" class="theme-grid" aria-label="Store theme choices"></div>
      <div id="theme-preview" class="theme-preview"><div class="preview-scene"><span class="preview-cloud">☁️</span><span class="preview-sun">☀️</span><span class="preview-ball">⚽</span><span class="preview-cube">🧩</span></div><div class="preview-content"><span class="preview-badge">NEW TOYS</span><h3>Clever Toys</h3><p>Fun toys. Happy kids. Easy shopping.</p><div class="preview-actions"><span class="preview-button">Shop Toys</span><span class="preview-chip">Best sellers</span></div></div></div>
      <button id="reset-theme" type="button" class="button secondary-button">Reset to original</button>
    </section>
  </div>
</div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#cfg');
const url=cfg?.dataset.url || '';
const key=cfg?.dataset.key || '';
const logoUrl=cfg?.dataset.logo || '';
const authStatus=document.querySelector('#auth-status');
const message=document.querySelector('#message');
const preview=document.querySelector('#preview');
const saveButton=document.querySelector('#save');
let supabase=null;
let isAdmin=false;

const themes=[
  {id:'playroom',name:'Playroom',primary:'#7c3aed',soft:'#f3e8ff',accent:'#fbbf24',emoji:'🧸',desc:'Purple + sunny yellow'},
  {id:'candy',name:'Candy Pop',primary:'#ec4899',soft:'#fce7f3',accent:'#06b6d4',emoji:'🍭',desc:'Pink + playful cyan'},
  {id:'ocean',name:'Ocean Toys',primary:'#0284c7',soft:'#e0f2fe',accent:'#f59e0b',emoji:'🌊',desc:'Blue + warm orange'},
  {id:'sunny',name:'Sunny Day',primary:'#ea580c',soft:'#ffedd5',accent:'#eab308',emoji:'☀️',desc:'Orange + sunshine'},
  {id:'mint',name:'Minty Fun',primary:'#059669',soft:'#d1fae5',accent:'#f43f5e',emoji:'🪀',desc:'Mint + coral'},
  {id:'berry',name:'Berry Box',primary:'#be123c',soft:'#ffe4e6',accent:'#7c3aed',emoji:'🎈',desc:'Berry + violet'}
];

const grid=document.querySelector('#theme-grid');
const status=document.querySelector('#theme-status');
const themePreview=document.querySelector('#theme-preview');

function getThemeCookie(){return document.cookie.match(/(?:^|;\s*)cleverTheme=([^;]+)/)?.[1]||'';}
function setThemeCookie(hex){document.cookie='cleverTheme='+encodeURIComponent(hex)+'; Max-Age=31536000; Path=/; SameSite=Lax';}
function applyTheme(t){
  document.documentElement.style.setProperty('--brand-primary',t.primary);
  document.documentElement.style.setProperty('--brand-soft',t.soft);
  document.documentElement.style.setProperty('--theme-accent',t.accent);
  document.documentElement.style.setProperty('--brand-primary-hover',t.primary);
  themePreview?.style.setProperty('--preview-primary',t.primary);
  themePreview?.style.setProperty('--preview-soft',t.soft);
  themePreview?.style.setProperty('--preview-accent',t.accent);
  grid?.querySelectorAll('.theme-choice').forEach(el=>el.classList.toggle('selected',el.dataset.id===t.id));
  if(status)status.textContent=t.name+' active';
}
function renderThemes(){
  if(!grid)return;
  grid.innerHTML=themes.map(t=>`<button type="button" class="theme-choice" data-id="${t.id}" aria-label="Use ${t.name} theme"><span class="theme-colors" style="background:${t.soft}"><i style="background:${t.primary}"></i><i style="background:${t.accent}"></i><b>${t.emoji}</b></span><strong>${t.name}</strong><small>${t.desc}</small></button>`).join('');
  grid.querySelectorAll('.theme-choice').forEach(btn=>btn.onclick=()=>{const theme=themes.find(t=>t.id===btn.dataset.id);if(!theme)return;setThemeCookie(theme.primary);applyTheme(theme);});
  const saved=decodeURIComponent(getThemeCookie()).toLowerCase();
  const active=themes.find(t=>t.primary.toLowerCase()===saved)||themes[0];
  applyTheme(active);
}

renderThemes();

const toWebp=async(file)=>{
  const bmp=await createImageBitmap(file),max=1800,scale=Math.min(1,max/Math.max(bmp.width,bmp.height));
  const canvas=document.createElement('canvas');
  canvas.width=Math.max(1,Math.round(bmp.width*scale));
  canvas.height=Math.max(1,Math.round(bmp.height*scale));
  const ctx=canvas.getContext('2d');
  if(!ctx)throw new Error('Could not prepare the logo.');
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.drawImage(bmp,0,0,canvas.width,canvas.height);
  return await new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Could not convert the logo to WebP.')),'image/webp',.92));
};

async function initAuth(){
  try{
    if(!url||!key)throw new Error('Supabase configuration is missing.');
    supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
    const sessionResult=await Promise.race([
      supabase.auth.getSession(),
      new Promise((_,reject)=>setTimeout(()=>reject(new Error('Authentication check timed out. Please refresh the page.')),8000))
    ]);
    const session=sessionResult?.data?.session;
    if(!session?.user){location.href='/login?next=%2Fadmin%2Fbranding';return;}
    const adminResult=await supabase.rpc('is_admin');
    if(adminResult.error)throw new Error(adminResult.error.message);
    if(!adminResult.data)throw new Error('This account is not an administrator.');
    isAdmin=true;
    authStatus.textContent='Admin access verified.';
    authStatus.classList.add('ok');
    saveButton.disabled=false;
  }catch(e){
    authStatus.textContent=e?.message||'Unable to verify admin access.';
    authStatus.classList.add('error');
  }
}

initAuth();

document.querySelector('#logout').onclick=async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';};

document.querySelector('#save').onclick=async()=>{
  if(!isAdmin||!supabase){message.textContent='Admin access is required to change the logo.';return;}
  const file=document.querySelector('#logo-file').files?.[0];
  if(!file){message.textContent='Choose a logo file first.';return;}
  message.textContent='Uploading logo…';
  saveButton.disabled=true;
  try{
    const blob=await toWebp(file);
    const up=await supabase.storage.from('product-images').upload('branding/logo.webp',blob,{contentType:'image/webp',upsert:true,cacheControl:'0'});
    if(up.error)throw new Error(up.error.message);
    const src=`${logoUrl}?v=${Date.now()}`;
    preview.src=src;
    message.textContent='Logo updated successfully.';
  }catch(e){message.textContent=e?.message||'Unable to upload logo.';}
  finally{saveButton.disabled=!isAdmin;}
};

document.querySelector('#reset-theme').onclick=()=>{document.cookie='cleverTheme=; Max-Age=0; Path=/; SameSite=Lax';location.reload();};
</script>
<style>
.branding-page{max-width:860px}.branding-page .admin-head{margin-bottom:22px}.branding-page .admin-head h1{margin:0 0 7px}.branding-page .admin-head p{margin:0;color:#64748b}.admin-status{margin-bottom:18px;padding:10px 13px;border-radius:10px;background:#f8fafc;color:#64748b;font-size:.9rem}.admin-status.ok{background:#ecfdf5;color:#047857}.admin-status.error{background:#fef2f2;color:#b91c1c}.branding-page #app{display:grid;gap:20px}.branding-card{gap:16px}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.section-heading h2{margin:0 0 5px}.section-heading p:last-child{margin:0;color:#64748b}.logo-preview{min-height:190px;display:grid;place-items:center;padding:28px;border:1px dashed #cbd5e1;border-radius:16px;background:linear-gradient(135deg,#f8fafc,#fff)}.logo-preview img{max-width:min(100%,420px);max-height:160px;object-fit:contain}.theme-status{font-size:.84rem;font-weight:800;color:var(--brand-primary);white-space:nowrap}.theme-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.theme-choice{appearance:none;text-align:left;border:1px solid #e2e8f0;border-radius:16px;background:#fff;padding:0;overflow:hidden;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.theme-choice:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(15,23,42,.08)}.theme-choice.selected{border-color:var(--brand-primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand-primary) 15%,transparent)}.theme-colors{height:72px;display:flex;align-items:center;padding:14px;gap:7px}.theme-colors i{width:20px;height:20px;border-radius:50%;box-shadow:0 0 0 2px #fff}.theme-colors b{margin-left:auto;font-size:28px}.theme-choice strong,.theme-choice small{display:block;padding-left:14px;padding-right:14px}.theme-choice strong{padding-top:12px}.theme-choice small{padding-top:3px;padding-bottom:14px;color:#64748b}.theme-preview{overflow:hidden;border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(15,23,42,.06)}.preview-scene{height:115px;background:var(--preview-soft,#f3e8ff);position:relative;overflow:hidden}.preview-cloud{position:absolute;left:16%;top:25px;font-size:34px}.preview-sun{position:absolute;right:14%;top:16px;font-size:36px}.preview-ball{position:absolute;left:52%;bottom:-4px;font-size:38px}.preview-cube{position:absolute;right:28%;bottom:2px;font-size:34px}.preview-content{padding:22px}.preview-badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:var(--preview-accent,#fbbf24);color:#111827;font-size:.72rem;font-weight:800}.preview-content h3{margin:12px 0 5px;font-size:1.6rem}.preview-content p{margin:0;color:#64748b}.preview-actions{display:flex;gap:9px;align-items:center;margin-top:18px;flex-wrap:wrap}.preview-button{padding:10px 15px;border-radius:11px;background:var(--preview-primary,#7c3aed);color:#fff;font-weight:750}.preview-chip{padding:9px 12px;border:1px solid #e2e8f0;border-radius:999px;font-size:.84rem}
@media(max-width:700px){.theme-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.section-heading{flex-direction:column}.theme-status{white-space:normal}}@media(max-width:460px){.theme-grid{grid-template-columns:1fr}}
</style>
