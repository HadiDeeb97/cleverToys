---
/**
 * Admin → Branding & settings: theme colours, logo, website icon, WhatsApp/Instagram links,
 * announcement ribbon and delivery pricing. Everything is saved to the store_settings table and
 * applied to every page by src/middleware.ts.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
import { getPageData } from '../../lib/page-data';
import { FONT_PRESETS } from '../../lib/design';

const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
const logoUrl = supabaseUrl
  ? `${supabaseUrl.replace(/\/$/, '')}/storage/v1/object/public/product-images/branding/logo.webp`
  : '';

// The live preview uses the store's own fonts (Admin → Storefront → Style), not the admin panel's.
const { design } = await getPageData(Astro);
const PREVIEW_FONTS: Record<string, string> = {
  premium: '--font-body:"Plus Jakarta Sans",system-ui,sans-serif;--font-display:"Fraunces",Georgia,serif;--display-weight:600;--display-tracking:-.025em',
  modern: '--font-body:"Plus Jakarta Sans",system-ui,sans-serif;--font-display:"Plus Jakarta Sans",system-ui,sans-serif;--display-weight:800;--display-tracking:-.035em',
  playful: '--font-body:"Nunito",system-ui,sans-serif;--font-display:"Fredoka","Nunito",system-ui,sans-serif;--display-weight:600;--display-tracking:-.01em',
  classic: '--font-body:"DM Sans",system-ui,sans-serif;--font-display:"Playfair Display",Georgia,serif;--display-weight:600;--display-tracking:-.015em'
};
const previewFont = PREVIEW_FONTS[design.font] || PREVIEW_FONTS.premium;
const previewFontHref = FONT_PRESETS[design.font]?.href || FONT_PRESETS.premium.href;
---
<link rel="stylesheet" href={previewFontHref} media="print" onload="this.media='all'" />
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/admin">Clever Toys Admin</a>
    <nav class="main-nav">
      <a href="/admin">Products</a>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/analytics">Visitors</a>
      <a href="/admin/seo">SEO</a>
      <a href="/">Store</a>
    </nav>
  </div>
</header>

<main class="section">
  <div class="container branding-page">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Store control center</p>
        <h1>Branding &amp; Store Settings</h1>
        <p>Manage your theme, logo, social links, ribbon, WhatsApp ordering and delivery pricing from one place.</p>
      </div>
      <button id="logout" class="button secondary-button" type="button">Sign Out</button>
    </div>

    <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} data-logo={logoUrl} hidden></div>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Social media</p>
          <h2>Social links &amp; visibility</h2>
          <p>WhatsApp uses the same URL as the floating WhatsApp button.</p>
        </div>
        <span id="auth-status" class="status-text" role="status">Checking admin access…</span>
      </div>

      <div class="settings-grid">
        <div class="setting-box">
          <div class="field-heading"><label for="whatsapp-url">WhatsApp link</label><span class="sync-pill">Synced</span></div>
          <input id="whatsapp-url" type="url" placeholder="https://wa.me/961..." autocomplete="url" />
          <small>Paste a wa.me link or a phone number with country code. Add <code>?text=</code> to set the greeting.</small>
          <small class="wa-usage">Used by the floating WhatsApp button, the header WhatsApp icon, and product "Order on WhatsApp" orders (which send to this number with the full order).</small>
          <a id="test-whatsapp" class="small-button" href="#" target="_blank" rel="noopener">Test link ↗</a>
          <label class="switch-row compact">
            <span><strong>Show WhatsApp in top bar</strong><small>The floating WhatsApp button remains linked too.</small></span>
            <input id="show-whatsapp" type="checkbox" role="switch" />
          </label>
        </div>

        <div class="setting-box">
          <div class="field-heading"><label for="instagram-url">Instagram link</label></div>
          <input id="instagram-url" type="url" placeholder="https://instagram.com/yourstore" autocomplete="url" />
          <small>Use your full Instagram profile URL.</small>
          <label class="switch-row compact">
            <span><strong>Show Instagram in top bar</strong><small>Toggle it without removing the link.</small></span>
            <input id="show-instagram" type="checkbox" role="switch" />
          </label>
        </div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Promotion</p>
          <h2>Ribbon banner</h2>
          <p>The ribbon appears directly below the top bar on public pages.</p>
        </div>
      </div>
      <label for="ribbon-text">Ribbon content<textarea id="ribbon-text" rows="2" maxlength="180" placeholder="Free delivery on orders above $60"></textarea></label>
      <div class="preview-ribbon-wrap"><div id="ribbon-preview" class="ribbon-preview">Your ribbon preview will appear here.</div></div>
      <label class="switch-row">
        <span><strong>Show ribbon on website</strong><small>Updates apply on the next public page load.</small></span>
        <input id="show-ribbon" type="checkbox" role="switch" />
      </label>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Delivery pricing</p>
          <h2>Cash on delivery</h2>
          <p>Checkout and WhatsApp receipts use this live delivery fee.</p>
        </div>
      </div>
      <div class="cod-field">
        <label for="cod-price">COD delivery price (USD)<input id="cod-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="5.00" /></label>
        <div class="price-hint"><strong id="cod-preview">$0.00</strong><span>Standard delivery fee when the order does not qualify for free delivery.</span></div>
        <label for="free-delivery-threshold">Free delivery above (USD)<input id="free-delivery-threshold" type="number" min="0" step="0.01" inputmode="decimal" placeholder="60.00" /></label>
        <div class="price-hint"><strong id="free-delivery-preview">Disabled</strong><span>Set 0.00 to disable the free-delivery threshold.</span></div>
      </div>
      <p class="field-help">Different fee for some governorates? Set it in <a class="text-link" href="/admin/discounts#delivery">Discounts &amp; delivery</a>. Those fees replace this one for that governorate.</p>
      <div class="cod-field" id="low-stock-field" hidden>
        <label for="low-stock-threshold">Low-stock alert at<input id="low-stock-threshold" type="number" min="0" step="1" inputmode="numeric" placeholder="5" /></label>
        <div class="price-hint"><strong>Stock alerts</strong><span>Toys and options with this many or fewer left show as “Low stock” on the Dashboard and Products page.</span></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WhatsApp ordering</p>
          <h2>Buy Now on WhatsApp</h2>
          <p>Product cards support quantity, customer details, delivery cost and receipt-style totals.</p>
        </div>
      </div>
      <div class="feature-list">
        <div><span>✓</span><p>Product name, price and quantity</p></div>
        <div><span>✓</span><p>Customer details when already saved</p></div>
        <div><span>✓</span><p>Subtotal, COD delivery and total</p></div>
        <div><span>✓</span><p>Uses the WhatsApp number configured above</p></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Store theme</p>
          <h2>Colors &amp; theme</h2>
          <p>Pick a theme to preview it. The header, buttons, badges, prices, cards and backgrounds across the whole store follow it once you publish.</p>
        </div>
        <span id="theme-status" class="status-text" role="status"></span>
      </div>
      <div class="theme-layout">
        <div class="theme-picker">
          <label class="switch-row gradient-switch">
            <span><strong>Gradient style</strong><small>Buttons, the cart, the ribbon and highlights blend two colors. Turn off for solid colors.</small></span>
            <input id="use-gradient" type="checkbox" role="switch" checked />
          </label>
          <div id="theme-grid" class="theme-grid" role="radiogroup" aria-label="Store theme choices"></div>
          <div class="custom-theme">
            <div>
              <strong>Custom colors</strong>
              <small>Match your logo or brand. Text colors adjust automatically so everything stays readable.</small>
            </div>
            <div class="custom-theme-inputs">
              <label for="custom-primary">Main color<input id="custom-primary" type="color" value="#2563eb" /></label>
              <label for="custom-gradient">Gradient end<input id="custom-gradient" type="color" value="#7c3aed" /></label>
              <label for="custom-accent">Accent color<input id="custom-accent" type="color" value="#ffc53d" /></label>
            </div>
            <p id="custom-note" class="custom-note" hidden></p>
          </div>
        </div>
        <div class="theme-preview-wrap">
          <p class="preview-label">Live preview</p>
          {/* A small copy of the real store (same layout, fonts and badges), recoloured with the theme you pick. */}
          <div id="theme-preview" class="theme-preview" aria-hidden="true" style={previewFont}>
            <div class="tp-ribbon">Free delivery on orders above $60</div>
            <div class="tp-header">
              <b class="tp-logo">Clever Toys</b>
              <span class="tp-nav"><span>Shop</span><span class="tp-sale">Sale</span><span>About</span></span>
              <span class="tp-search">Search toys…</span>
              <span class="tp-cart"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>Cart <em>2</em></span>
            </div>
            <div class="tp-hero">
              <div class="tp-copy">
                <span class="tp-eyebrow">New arrivals</span>
                <strong>Toys that spark <i>big</i> imaginations</strong>
                <div class="tp-buttons"><span class="tp-primary">Shop toys →</span><span class="tp-secondary">Categories</span></div>
              </div>
              <span class="tp-art"><span>🧸</span><em>🚀</em></span>
            </div>
            <div class="tp-products">
              <div class="tp-card"><div class="tp-image" style="--h:48">🧩<em class="tp-badge-sale">Sale −20%</em><span class="tp-add">+</span></div><small>Rainbow Puzzle</small><b class="tp-price on-sale">$12.00 <s>$15.00</s></b></div>
              <div class="tp-card"><div class="tp-image" style="--h:145">🦖<em class="tp-badge-new">New</em><span class="tp-add">+</span></div><small>Dino Explorer</small><b class="tp-price">$24.99</b></div>
              <div class="tp-card"><div class="tp-image" style="--h:222">🚂<span class="tp-add">+</span></div><small>Wooden Train</small><b class="tp-price">$34.50</b></div>
            </div>
          </div>
        </div>
      </div>
      <div class="theme-actions">
        <button id="publish-theme" type="button" class="button" disabled>Publish theme</button>
        <button id="revert-theme" type="button" class="button secondary-button" disabled>Back to live theme</button>
      </div>
      <p id="publish-status" class="publish-status" role="status">Choose a theme to preview it here.</p>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Logo</p>
          <h2>Store Logo</h2>
          <p>Upload your Clever Toys logo. It is resized for the header and converted to WebP automatically.</p>
        </div>
      </div>
      <div class="logo-preview"><img id="preview" src={logoUrl} alt="Current Clever Toys logo" /></div>
      <label for="logo-file">Choose logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
      <button id="save-logo" class="button" type="button" disabled>Upload Logo</button>
      <p id="logo-message" role="status"></p>
    </section>

    {/* Website icon (favicon): shown in browser tabs, bookmarks and on phone home screens. */}
    <section class="form-card branding-card" aria-labelledby="icon-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Website icon</p>
          <h2 id="icon-title">Browser tab &amp; home screen icon</h2>
          <p>Upload a square image (at least 512 × 512). We make every size browsers and phones need.</p>
        </div>
      </div>
      <div id="icon-setup" class="icon-setup" hidden>To save a website icon, run <code>supabase/branding_assets.sql</code> once in the Supabase SQL Editor, then reload this page.</div>
      <div class="icon-preview-row">
        <div class="icon-tab-preview" aria-hidden="true">
          <span class="icon-tab"><img id="icon-preview-tab" src="/favicon.svg" alt="" width="16" height="16" /><span>Clever Toys Lebanon</span><b>×</b></span>
          <span class="icon-tab-bar"></span>
        </div>
        <div class="icon-home-preview" aria-hidden="true"><img id="icon-preview-home" src="/apple-touch-icon.png" alt="" width="60" height="60" /><small>Clever Toys</small></div>
      </div>
      <label for="icon-file">Choose icon image<input id="icon-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
      <label class="icon-bg-row"><input id="icon-white-bg" type="checkbox" class="toggle" /> Add a white background (for logos with transparent edges)</label>
      <fieldset class="icon-options">
        <legend>Icon shape</legend>
        <div class="icon-choice-row">
          <label class="icon-choice"><input type="radio" name="icon-shape" value="square" checked /><span><i class="shape-square"></i>Square</span></label>
          <label class="icon-choice"><input type="radio" name="icon-shape" value="rounded" /><span><i class="shape-rounded"></i>Rounded</span></label>
          <label class="icon-choice"><input type="radio" name="icon-shape" value="circle" /><span><i class="shape-circle"></i>Circle</span></label>
        </div>
      </fieldset>
      <fieldset class="icon-options">
        <legend>Border line</legend>
        <div class="icon-choice-row">
          <label class="icon-choice"><input type="radio" name="icon-border" value="none" checked /><span><i class="line-none"></i>None</span></label>
          <label class="icon-choice"><input type="radio" name="icon-border" value="thin" /><span><i class="line-thin"></i>Thin</span></label>
          <label class="icon-choice"><input type="radio" name="icon-border" value="thick" /><span><i class="line-thick"></i>Thick</span></label>
          <label class="icon-color">Colour<input id="icon-border-color" type="color" value="#1f2937" /></label>
        </div>
      </fieldset>
      <small class="wa-usage">The shape and border are added to the picture when you upload it. To change them later, choose the picture again and upload.</small>
      <div class="form-actions"><button id="save-icon" class="button" type="button" disabled>Upload icon</button><button id="remove-icon" class="small-button" type="button" hidden>Use default icon</button></div>
      <p id="icon-message" role="status"></p>
    </section>

    <div class="settings-actions">
      <button id="save-settings" class="button" type="button" disabled>Save Store Settings</button>
      <p id="settings-message" role="status">Changes are saved to your store settings.</p>
    </div>
  </div>
</main>

<script>
// This script was written as plain JavaScript (no type annotations). It is checked by the browser tests
// instead, so the TypeScript checker is switched off here to keep `astro check` useful for other files.
// @ts-nocheck
import { createClient } from '@supabase/supabase-js';
import { allowPage } from '../../scripts/admin-access';

const cfg = document.querySelector('#cfg');
const url = cfg?.dataset.url || '';
const key = cfg?.dataset.key || '';
const logoUrlValue = cfg?.dataset.logo || '';
const authStatus = document.querySelector('#auth-status');
const settingsMessage = document.querySelector('#settings-message');
const logoMessage = document.querySelector('#logo-message');
const saveSettingsButton = document.querySelector('#save-settings');
const saveLogoButton = document.querySelector('#save-logo');
const preview = document.querySelector('#preview');
const codInput = document.querySelector('#cod-price');
const codPreview = document.querySelector('#cod-preview');
const freeDeliveryInput = document.querySelector('#free-delivery-threshold');
const freeDeliveryPreview = document.querySelector('#free-delivery-preview');
const ribbonText = document.querySelector('#ribbon-text');
const ribbonPreview = document.querySelector('#ribbon-preview');
const grid = document.querySelector('#theme-grid');
const publishThemeButton = document.querySelector('#publish-theme');
const revertThemeButton = document.querySelector('#revert-theme');
const customPrimaryInput = document.querySelector('#custom-primary');
const customAccentInput = document.querySelector('#custom-accent');
const customGradientInput = document.querySelector('#custom-gradient');
const gradientToggle = document.querySelector('#use-gradient');
const customNote = document.querySelector('#custom-note');
const themePreview = document.querySelector('#theme-preview');
const themeStatus = document.querySelector('#theme-status');
const publishStatus = document.querySelector('#publish-status');
let supabase;
let adminReady = false;

const defaults = {
  whatsapp_url: 'https://wa.me/96171220251?text=Hello%20Clever%20Toys%21%20I%20have%20a%20question%20about%20your%20toys.',
  instagram_url: '',
  show_whatsapp: true,
  show_instagram: false,
  ribbon_text: '',
  show_ribbon: false,
  cod_delivery_price: 0,
  free_delivery_threshold: 0
};

// Each theme needs main and gradient colors that keep white text readable (WCAG AA) and a light accent for badges.
const themes = [
  { id: 'sky', name: 'Sky Blocks', primary: '#2563eb', gradient: '#7c3aed', soft: '#e8f0ff', accent: '#ffc53d', emoji: '🪁', desc: 'Bright blue + sunshine' },
  { id: 'bubblegum', name: 'Bubblegum', primary: '#db2777', gradient: '#a21caf', soft: '#ffe8f3', accent: '#ffd166', emoji: '🍭', desc: 'Pink + lemon' },
  { id: 'grape', name: 'Grape Soda', primary: '#7c3aed', gradient: '#db2777', soft: '#f1eaff', accent: '#5eead4', emoji: '🦄', desc: 'Violet + mint' },
  { id: 'jungle', name: 'Jungle Gym', primary: '#15803d', gradient: '#0f766e', soft: '#e3f6e8', accent: '#ffb627', emoji: '🦖', desc: 'Leafy green + mango' },
  { id: 'tangerine', name: 'Tangerine', primary: 'var(--danger)', gradient: '#be123c', soft: '#fff0e5', accent: '#7dd3fc', emoji: '🧡', desc: 'Orange + sky blue' },
  { id: 'ocean', name: 'Ocean Splash', primary: '#0e7490', gradient: '#1d4ed8', soft: '#e0f6f9', accent: '#ff9eb5', emoji: '🐳', desc: 'Teal + coral pink' },
  { id: 'cherry', name: 'Cherry Pop', primary: '#dc2626', gradient: 'var(--danger)', soft: '#ffeceb', accent: '#fcd34d', emoji: '🍒', desc: 'Toy red + yellow' },
  { id: 'midnight', name: 'Midnight Stars', primary: '#312e81', gradient: '#7c3aed', soft: '#ebeafd', accent: '#f9a8d4', emoji: '🌙', desc: 'Navy + candy pink' }
];
let useGradient = true;
// A preset with the current gradient setting applied: primary2 is the gradient end, or the main color when solid.
const styled = (preset) => ({ ...preset, primary2: useGradient ? preset.gradient : preset.primary });
const defaultTheme = styled(themes[0]);
let liveTheme = defaultTheme;
let previewTheme = defaultTheme;

function money(value) {
  return `$${Number(value || 0).toFixed(2)}`;
}

function hexToRgb(hex) {
  const n = parseInt(hex.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}

function rgbToHex(rgb) {
  return `#${rgb.map((value) => Math.round(Math.min(255, Math.max(0, value))).toString(16).padStart(2, '0')).join('')}`;
}

function mixHex(a, b, amountOfA) {
  const x = hexToRgb(a);
  const y = hexToRgb(b);
  return rgbToHex(x.map((value, i) => value * amountOfA + y[i] * (1 - amountOfA)));
}

function luminance(hex) {
  const channel = (value) => {
    const c = value / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  const [r, g, b] = hexToRgb(hex);
  return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
}

function contrastWithWhite(hex) {
  return 1.05 / (luminance(hex) + 0.05);
}

function readableText(hex) {
  const onWhite = contrastWithWhite(hex);
  const onInk = (luminance(hex) + 0.05) / (luminance('#1b1530') + 0.05);
  return onWhite >= 4.5 || onWhite >= onInk ? '#ffffff' : '#1b1530';
}

function isSameColors(a, b) {
  return a.primary === b.primary && a.soft === b.soft && a.accent === b.accent;
}

function isSameTheme(a, b) {
  return isSameColors(a, b) && (a.primary2 || a.primary) === (b.primary2 || b.primary);
}

function applyColors(theme) {
  const vars = {
    '--brand-primary': theme.primary,
    '--brand-primary-2': theme.primary2 || theme.primary,
    '--brand-primary-hover': `color-mix(in srgb,${theme.primary} 86%,#000)`,
    '--brand-soft': theme.soft,
    '--theme-accent': theme.accent,
    '--brand-text-on-primary': readableText(theme.primary),
    '--theme-text-on-accent': readableText(theme.accent)
  };
  // Only the preview box changes; the real store changes when the theme is published.
  const target = themePreview || document.documentElement;
  Object.entries(vars).forEach(([name, value]) => target.style.setProperty(name, value));
}

// Darken a color until white button text on it passes WCAG AA contrast.
function readableOnWhite(hex) {
  let color = hex;
  for (let i = 0; i < 20 && contrastWithWhite(color) < 4.5; i++) color = mixHex(color, '#000000', 0.92);
  return color;
}

function buildCustomTheme() {
  const pickedPrimary = String(customPrimaryInput?.value || '#2563eb').toLowerCase();
  const pickedGradient = String(customGradientInput?.value || '#7c3aed').toLowerCase();
  const accent = String(customAccentInput?.value || '#ffc53d').toLowerCase();
  const primary = readableOnWhite(pickedPrimary);
  const gradient = readableOnWhite(pickedGradient);
  const notes = [];
  if (primary !== pickedPrimary) notes.push(`main color darkened to ${primary}`);
  if (useGradient && gradient !== pickedGradient) notes.push(`gradient end darkened to ${gradient}`);
  if (customNote) {
    customNote.hidden = notes.length === 0;
    customNote.textContent = notes.length ? `To keep white text on buttons readable: ${notes.join(' and ')}.` : '';
  }
  return { id: 'custom', name: 'Custom colors', primary, gradient, primary2: useGradient ? gradient : primary, soft: mixHex(primary, '#ffffff', 0.1), accent, emoji: '🎨', desc: 'Your own colors' };
}

function updateThemeUI() {
  grid?.querySelectorAll('.theme-choice').forEach((element) => {
    const theme = themes.find((item) => item.id === element.dataset.id);
    const selected = Boolean(theme && isSameColors(theme, previewTheme));
    const live = Boolean(theme && isSameColors(theme, liveTheme));
    element.classList.toggle('selected', selected);
    element.setAttribute('aria-checked', String(selected));
    element.querySelector('.theme-live-tag')?.toggleAttribute('hidden', !live);
  });
  const changed = !isSameTheme(previewTheme, liveTheme);
  if (themeStatus) themeStatus.textContent = `Live: ${liveTheme.name}`;
  if (publishThemeButton) publishThemeButton.disabled = !adminReady || !changed;
  if (revertThemeButton) revertThemeButton.disabled = !changed;
}

function previewThemeChoice(theme) {
  previewTheme = theme;
  applyColors(theme);
  updateThemeUI();
  if (publishStatus && !isSameTheme(previewTheme, liveTheme)) publishStatus.textContent = `Previewing ${previewTheme.name}. Publish it to show it to every visitor.`;
}

function renderThemes() {
  if (!grid) return;
  grid.innerHTML = themes.map((theme) => `
    <button type="button" class="theme-choice" role="radio" aria-checked="false" data-id="${theme.id}" style="--c-primary:${theme.primary};--c-primary-2:${theme.gradient};--c-soft:${theme.soft};--c-accent:${theme.accent}">
      <span class="theme-swatch"><span class="swatch-bar"></span><span class="swatch-body"><i></i><b>${theme.emoji}</b></span></span>
      <span class="theme-meta"><strong>${theme.name}</strong><small>${theme.desc}</small></span>
      <span class="theme-live-tag" hidden>Live</span>
    </button>
  `).join('');
  grid.querySelectorAll('.theme-choice').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = themes.find((item) => item.id === button.dataset.id);
      if (theme) previewThemeChoice(styled(theme));
    });
  });
}

// Older databases may not have store_settings.theme yet (see supabase/theme_settings.sql).
function isMissingThemeColumn(error) {
  return /theme/i.test(String(error?.message || '')) && /column|schema cache/i.test(String(error?.message || ''));
}

async function publishThemeFile(payload) {
  // The product-images bucket only accepts image types, and supabase-js sends a Blob's own
  // type (not the contentType option), so the JSON must be labelled as an image.
  const blob = new Blob([JSON.stringify(payload)], { type: 'image/webp' });
  return supabase.storage.from('product-images').upload('branding/theme.json', blob, {
    contentType: 'image/webp',
    cacheControl: '0',
    upsert: true
  });
}

async function publishTheme(theme) {
  if (!supabase || !adminReady) return false;
  publishStatus.textContent = 'Publishing theme for all visitors…';
  publishThemeButton.disabled = true;
  const payload = {
    mode: 'theme',
    theme: { id: theme.id, name: theme.name, primary: theme.primary, primary2: theme.primary2 || theme.primary, soft: theme.soft, accent: theme.accent },
    updated_at: new Date().toISOString()
  };
  // The theme lives in store_settings, which the storefront reads on every page load.
  let result = await supabase.from('store_settings').upsert({ id: 'default', theme: payload, updated_at: payload.updated_at }, { onConflict: 'id' }).select('id').single();
  let note = '';
  if (result.error && isMissingThemeColumn(result.error)) {
    result = await publishThemeFile(payload);
    note = ' Run supabase/theme_settings.sql in Supabase to make theme publishing more reliable.';
  }
  if (result.error) {
    publishStatus.textContent = `Could not publish theme: ${result.error.message}`;
    updateThemeUI();
    return false;
  }
  liveTheme = theme;
  updateThemeUI();
  publishStatus.textContent = `${theme.name} is now live for all visitors. Refresh the store to see it.${note}`;
  return true;
}

function loadLiveTheme() {
  const published = window.__CLEVER_BRANDING__?.publishedTheme;
  if (!published?.primary) return defaultTheme;
  const primary2 = published.primary2 || published.primary;
  useGradient = primary2.toLowerCase() !== published.primary.toLowerCase();
  if (gradientToggle) gradientToggle.checked = useGradient;
  const match = themes.find((theme) => theme.primary.toLowerCase() === String(published.primary).toLowerCase() && theme.accent.toLowerCase() === String(published.accent).toLowerCase());
  if (match) return { ...match, primary2 };
  if (customPrimaryInput) customPrimaryInput.value = published.primary;
  if (customAccentInput) customAccentInput.value = published.accent;
  if (customGradientInput && useGradient) customGradientInput.value = primary2;
  return { id: 'custom', name: published.name || 'Custom colors', primary: published.primary, gradient: primary2, primary2, soft: published.soft, accent: published.accent };
}

function updateRibbonPreview() {
  const text = String(ribbonText?.value || '').trim();
  if (!ribbonPreview) return;
  ribbonPreview.textContent = text || 'Your ribbon preview will appear here.';
  ribbonPreview.classList.toggle('muted', !text);
  // Same text in the theme preview's ribbon.
  const tpRibbon = themePreview?.querySelector('.tp-ribbon');
  if (tpRibbon) { tpRibbon.textContent = text; tpRibbon.hidden = !text; }
}

function updateCodPreview() {
  if (codPreview) codPreview.textContent = money(codInput?.value || 0);
}
function updateFreeDeliveryPreview() {
  if (!freeDeliveryPreview) return;
  const value = Math.max(0, Number(freeDeliveryInput?.value || 0));
  freeDeliveryPreview.textContent = value > 0 ? 'Free above ' + money(value) : 'Disabled';
}

function normalizeWhatsapp(value) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (raw.startsWith('https://') || raw.startsWith('http://')) return raw;
  const digits = raw.replace(/[^0-9]/g, '');
  return digits ? `https://wa.me/${digits}` : raw;
}

function normalizeInstagram(value) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (raw.startsWith('https://') || raw.startsWith('http://')) return raw;
  return `https://instagram.com/${raw.replace(/^@/, '')}`;
}

// Keep the "Test link" button pointing at exactly what customers will open.
function syncWhatsappTest() {
  const link = document.querySelector('#test-whatsapp');
  const value = normalizeWhatsapp(document.querySelector('#whatsapp-url')?.value);
  if (!link) return;
  link.href = value || '#';
  link.toggleAttribute('aria-disabled', !value);
}
document.querySelector('#whatsapp-url')?.addEventListener('input', syncWhatsappTest);

async function loadSettings() {
  const result = await supabase.from('store_settings').select('*').eq('id', 'default').maybeSingle();
  if (result.error) throw new Error(`Store settings table is not ready. ${result.error.message}`);
  const settings = { ...defaults, ...(result.data || {}) };

  document.querySelector('#whatsapp-url').value = settings.whatsapp_url || '';
  syncWhatsappTest();
  document.querySelector('#instagram-url').value = settings.instagram_url || '';
  document.querySelector('#show-whatsapp').checked = Boolean(settings.show_whatsapp);
  document.querySelector('#show-instagram').checked = Boolean(settings.show_instagram);
  ribbonText.value = settings.ribbon_text || '';
  document.querySelector('#show-ribbon').checked = Boolean(settings.show_ribbon);
  codInput.value = Number(settings.cod_delivery_price || 0).toFixed(2);
  if (freeDeliveryInput) freeDeliveryInput.value = Number(settings.free_delivery_threshold || 0).toFixed(2);
  // Only after supabase/cms.sql adds the column.
  const hasLowStock = Boolean(result.data && 'low_stock_threshold' in result.data);
  document.querySelector('#low-stock-field').hidden = !hasLowStock;
  if (hasLowStock) document.querySelector('#low-stock-threshold').value = String(result.data.low_stock_threshold ?? 5);
  updateRibbonPreview();
  updateCodPreview();
  updateFreeDeliveryPreview();
  showIcon(result.data?.favicon_url || '', Boolean(result.data && 'favicon_url' in result.data));
  logoColumnReady = Boolean(result.data && 'logo_url' in result.data);
  if (result.data?.logo_url) preview.src = result.data.logo_url;
}

async function saveSettings() {
  const payload = {
    id: 'default',
    whatsapp_url: normalizeWhatsapp(document.querySelector('#whatsapp-url').value),
    instagram_url: normalizeInstagram(document.querySelector('#instagram-url').value),
    show_whatsapp: document.querySelector('#show-whatsapp').checked,
    show_instagram: document.querySelector('#show-instagram').checked,
    ribbon_text: String(ribbonText.value || '').trim(),
    show_ribbon: document.querySelector('#show-ribbon').checked,
    cod_delivery_price: Math.max(0, Number(codInput.value || 0)),
    free_delivery_threshold: Math.max(0, Number(freeDeliveryInput?.value || 0)),
    updated_at: new Date().toISOString()
  };
  if (!document.querySelector('#low-stock-field').hidden) payload.low_stock_threshold = Math.max(0, Math.floor(Number(document.querySelector('#low-stock-threshold').value || 5)));

  if (payload.show_whatsapp && !payload.whatsapp_url) throw new Error('Add a WhatsApp link or switch off WhatsApp top-bar visibility.');
  if (payload.show_instagram && !payload.instagram_url) throw new Error('Add an Instagram link or switch off Instagram top-bar visibility.');
  if (payload.show_ribbon && !payload.ribbon_text) throw new Error('Add ribbon text or switch off the ribbon.');

  settingsMessage.textContent = 'Saving store settings…';
  saveSettingsButton.disabled = true;
  const result = await supabase.from('store_settings').upsert(payload, { onConflict: 'id' }).select('*').single();
  if (result.error) throw new Error(result.error.message);

  document.querySelector('#whatsapp-url').value = result.data.whatsapp_url || '';
  document.querySelector('#instagram-url').value = result.data.instagram_url || '';
  settingsMessage.textContent = 'Store settings saved. New public page loads use the new values immediately.';
}

async function initAuth() {
  try {
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const sessionResult = await supabase.auth.getSession();
    if (sessionResult.error) throw new Error(sessionResult.error.message);
    if (!sessionResult.data.session?.user) {
      authStatus.textContent = 'Please sign in to manage branding.';
      location.href = '/login?next=%2Fadmin%2Fbranding';
      return;
    }
    const adminResult = await supabase.rpc('is_admin');
    if (adminResult.error) throw new Error(adminResult.error.message);
    if (!adminResult.data) {
      authStatus.textContent = 'Access denied.';
      return;
    }
    // Staff roles (supabase/cms.sql): delivery, contact and theme settings need the "settings" permission.
    if (!(await allowPage(supabase, 'settings', 'Branding & settings'))) { authStatus.textContent = 'Branding & settings is not part of your role.'; return; }
    adminReady = true;
    authStatus.textContent = 'Admin access verified';
    saveSettingsButton.disabled = false;
    saveLogoButton.disabled = false;
    updateThemeUI();
    await loadSettings();
  } catch (error) {
    authStatus.textContent = error?.message || 'Unable to verify admin access.';
  }
}

renderThemes();
liveTheme = loadLiveTheme();
grid?.classList.toggle('solid', !useGradient);
previewThemeChoice(liveTheme);
publishStatus.textContent = 'Choose a theme to preview it here.';
customPrimaryInput?.addEventListener('input', () => previewThemeChoice(buildCustomTheme()));
customAccentInput?.addEventListener('input', () => previewThemeChoice(buildCustomTheme()));
customGradientInput?.addEventListener('input', () => previewThemeChoice(buildCustomTheme()));
gradientToggle?.addEventListener('change', () => {
  useGradient = gradientToggle.checked;
  grid?.classList.toggle('solid', !useGradient);
  const preset = themes.find((theme) => theme.id === previewTheme.id);
  previewThemeChoice(preset ? styled(preset) : buildCustomTheme());
});
publishThemeButton?.addEventListener('click', () => publishTheme(previewTheme));
revertThemeButton?.addEventListener('click', () => {
  previewThemeChoice(liveTheme);
  publishStatus.textContent = 'Showing the live theme.';
});

updateRibbonPreview();
updateCodPreview();
ribbonText?.addEventListener('input', updateRibbonPreview);
codInput?.addEventListener('input', updateCodPreview);
freeDeliveryInput?.addEventListener('input', updateFreeDeliveryPreview);
updateFreeDeliveryPreview();
saveSettingsButton?.addEventListener('click', async () => {
  try {
    await saveSettings();
  } catch (error) {
    settingsMessage.textContent = error?.message || 'Unable to save store settings.';
  } finally {
    saveSettingsButton.disabled = !adminReady;
  }
});
document.querySelector('#logout')?.addEventListener('click', async () => {
  if (supabase) await supabase.auth.signOut();
  location.href = '/login';
});

// ---------- Logo ----------
// The logo is resized to header size (at most 600 × 200 px) and saved as WebP, which keeps it
// around 10–30 KB instead of hundreds. Each upload gets its own file name so browsers can cache it
// for a year and still show a new logo straight away (needs supabase/branding_assets.sql).
let logoColumnReady = false;
saveLogoButton?.addEventListener('click', async () => {
  const file = document.querySelector('#logo-file')?.files?.[0];
  if (!file) {
    logoMessage.textContent = 'Choose a logo file first.';
    return;
  }
  logoMessage.textContent = 'Uploading logo…';
  saveLogoButton.disabled = true;
  try {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 600 / bitmap.width, 200 / bitmap.height);
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Could not prepare the logo.');
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise((resolve, reject) => canvas.toBlob((value) => {
      if (value) resolve(value);
      else reject(new Error('Could not convert the logo to WebP.'));
    }, 'image/webp', 0.9));
    if (logoColumnReady) {
      const path = `branding/logo/${Date.now()}.webp`;
      const upload = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false, cacheControl: '31536000' });
      if (upload.error) throw new Error(upload.error.message);
      const logoUrl = supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;
      const saved = await supabase.from('store_settings').upsert({ id: 'default', logo_url: logoUrl, updated_at: new Date().toISOString() }, { onConflict: 'id' });
      if (saved.error) throw new Error(saved.error.message);
      preview.src = logoUrl;
    } else {
      // Before branding_assets.sql is run: overwrite the older fixed file.
      const upload = await supabase.storage.from('product-images').upload('branding/logo.webp', blob, { contentType: 'image/webp', upsert: true, cacheControl: '0' });
      if (upload.error) throw new Error(upload.error.message);
      preview.src = `${logoUrlValue}?v=${Date.now()}`;
    }
    logoMessage.textContent = `Logo updated (${Math.round(blob.size / 1024)} KB).`;
  } catch (error) {
    logoMessage.textContent = error?.message || 'Unable to upload the logo.';
  } finally {
    saveLogoButton.disabled = !adminReady;
  }
});

// ---------- Website icon ----------
// The uploaded image is squared and saved as PNGs in four sizes:
// 32 (browser tab), 180 (iPhone home screen), 192 and 512 (Android / "Add to Home Screen").
// Each upload goes into a new folder, so browsers pick up the new icon straight away.
const ICON_SIZES = [32, 180, 192, 512];
const iconMessage = document.querySelector('#icon-message');
const saveIconButton = document.querySelector('#save-icon');
const removeIconButton = document.querySelector('#remove-icon');
let iconColumnReady = false;

function showIcon(faviconUrl, columnReady) {
  iconColumnReady = columnReady;
  document.querySelector('#icon-setup').hidden = columnReady;
  const src = faviconUrl || '/favicon.svg';
  document.querySelector('#icon-preview-tab').src = src;
  document.querySelector('#icon-preview-home').src = faviconUrl ? faviconUrl.replace(/icon-32\.png$/, 'icon-180.png') : '/apple-touch-icon.png';
  removeIconButton.hidden = !faviconUrl;
  saveIconButton.disabled = !adminReady || !columnReady;
}

/** The shape and border chosen in the "Website icon" card. */
function iconStyle() {
  return {
    whiteBackground: document.querySelector('#icon-white-bg').checked,
    shape: document.querySelector('input[name=icon-shape]:checked')?.value || 'square',
    border: document.querySelector('input[name=icon-border]:checked')?.value || 'none',
    borderColor: document.querySelector('#icon-border-color').value || '#1f2937'
  };
}

/** Outline of the icon shape, inset by `inset` pixels from the canvas edge. */
function shapePath(ctx, size, shape, inset) {
  const s = size - inset * 2;
  ctx.beginPath();
  if (shape === 'circle') ctx.arc(size / 2, size / 2, s / 2, 0, Math.PI * 2);
  else if (shape === 'rounded') ctx.roundRect(inset, inset, s, s, s * 0.22);
  else ctx.rect(inset, inset, s, s);
}

/** Draws the image centred on a square canvas of the given size, in the chosen shape and border, and returns a PNG. */
async function iconPng(bitmap, size, style) {
  const { whiteBackground, shape, border, borderColor } = style;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('Could not prepare the icon.');
  // iPhones show transparent icons on black, so the home-screen size always gets a white background.
  if (size === 180) { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, size, size); }
  // Border width grows with the icon, but stays visible on the tiny browser-tab size.
  const line = border === 'none' ? 0 : Math.max(border === 'thick' ? 3 : 1.5, size * (border === 'thick' ? 0.07 : 0.035));
  ctx.save();
  shapePath(ctx, size, shape, 0);
  ctx.clip();
  if (whiteBackground || size === 180) { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, size, size); }
  const padding = (size >= 180 && (whiteBackground || size === 180) ? Math.round(size * 0.08) : 0) + (line ? line * 1.5 : 0);
  const box = size - padding * 2;
  const scale = Math.min(box / bitmap.width, box / bitmap.height);
  const w = bitmap.width * scale, h = bitmap.height * scale;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(bitmap, (size - w) / 2, (size - h) / 2, w, h);
  ctx.restore();
  if (line) {
    shapePath(ctx, size, shape, line / 2);
    ctx.lineWidth = line;
    ctx.strokeStyle = borderColor;
    ctx.stroke();
  }
  return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not create the icon.')), 'image/png'));
}

// Live preview: draws the chosen picture exactly as it will be published.
let previewUrls = [];
async function previewIcon() {
  const file = document.querySelector('#icon-file')?.files?.[0];
  if (!file) return;
  try {
    const bitmap = await createImageBitmap(file);
    const style = iconStyle();
    const [tab, home] = await Promise.all([iconPng(bitmap, 64, style), iconPng(bitmap, 180, style)]);
    previewUrls.forEach((u) => URL.revokeObjectURL(u));
    previewUrls = [URL.createObjectURL(tab), URL.createObjectURL(home)];
    document.querySelector('#icon-preview-tab').src = previewUrls[0];
    document.querySelector('#icon-preview-home').src = previewUrls[1];
  } catch {
    iconMessage.textContent = 'This picture could not be read. Try a PNG or JPG.';
  }
}
document.querySelectorAll('input[name=icon-shape], input[name=icon-border], #icon-border-color, #icon-white-bg').forEach((el) => el.addEventListener('input', previewIcon));

document.querySelector('#icon-file')?.addEventListener('change', (event) => {
  const file = event.target.files?.[0];
  if (!file) return;
  previewIcon();
  iconMessage.textContent = 'Preview only. Press "Upload icon" to publish it.';
});

saveIconButton?.addEventListener('click', async () => {
  const file = document.querySelector('#icon-file')?.files?.[0];
  if (!file) { iconMessage.textContent = 'Choose an image first.'; return; }
  if (!iconColumnReady) { iconMessage.textContent = 'Run supabase/branding_assets.sql first.'; return; }
  saveIconButton.disabled = true;
  iconMessage.textContent = 'Creating icon sizes…';
  try {
    const bitmap = await createImageBitmap(file);
    if (Math.min(bitmap.width, bitmap.height) < 180) iconMessage.textContent = 'Tip: this image is small, so the icon may look blurry. Uploading anyway…';
    const style = iconStyle();
    const folder = `branding/icons/${Date.now()}`;
    for (const size of ICON_SIZES) {
      const blob = await iconPng(bitmap, size, style);
      const upload = await supabase.storage.from('product-images').upload(`${folder}/icon-${size}.png`, blob, { contentType: 'image/png', upsert: true, cacheControl: '31536000' });
      if (upload.error) throw new Error(upload.error.message);
    }
    const faviconUrl = supabase.storage.from('product-images').getPublicUrl(`${folder}/icon-32.png`).data.publicUrl;
    const saved = await supabase.from('store_settings').upsert({ id: 'default', favicon_url: faviconUrl, updated_at: new Date().toISOString() }, { onConflict: 'id' });
    if (saved.error) throw new Error(saved.error.message);
    showIcon(faviconUrl, true);
    iconMessage.textContent = 'Website icon published. Browsers may take a few minutes to show it in open tabs.';
    window.adminToast?.('Website icon updated.');
  } catch (error) {
    iconMessage.textContent = error?.message || 'Unable to upload the icon.';
  } finally {
    saveIconButton.disabled = !adminReady || !iconColumnReady;
  }
});

removeIconButton?.addEventListener('click', async () => {
  if (!confirm('Go back to the default Clever Toys icon?')) return;
  removeIconButton.disabled = true;
  const saved = await supabase.from('store_settings').upsert({ id: 'default', favicon_url: null, updated_at: new Date().toISOString() }, { onConflict: 'id' });
  removeIconButton.disabled = false;
  if (saved.error) { iconMessage.textContent = saved.error.message; return; }
  showIcon('', true);
  iconMessage.textContent = 'The default icon is back.';
});

initAuth();
</script>

