---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';

const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
const logoUrl = supabaseUrl
  ? `${supabaseUrl.replace(/\/$/, '')}/storage/v1/object/public/product-images/branding/logo.webp`
  : '';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/admin">Clever Toys Admin</a>
    <nav class="main-nav">
      <a href="/admin">Products</a>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/analytics">Visitors</a>
      <a href="/admin/seo">SEO</a>
      <a href="/">Store</a>
    </nav>
  </div>
</header>

<main class="section">
  <div class="container branding-page">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Store control center</p>
        <h1>Branding &amp; Store Settings</h1>
        <p>Manage your theme, logo, social links, ribbon, WhatsApp ordering and delivery pricing from one place.</p>
      </div>
      <button id="logout" class="button secondary-button" type="button">Sign Out</button>
    </div>

    <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} data-logo={logoUrl} hidden></div>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Social media</p>
          <h2>Social links &amp; visibility</h2>
          <p>WhatsApp uses the same URL as the floating WhatsApp button.</p>
        </div>
        <span id="auth-status" class="status-text" role="status">Checking admin access…</span>
      </div>

      <div class="settings-grid">
        <div class="setting-box">
          <div class="field-heading"><label for="whatsapp-url">WhatsApp link</label><span class="sync-pill">Synced</span></div>
          <input id="whatsapp-url" type="url" placeholder="https://wa.me/961..." autocomplete="url" />
          <small>Paste a wa.me URL or a phone number with country code.</small>
          <label class="switch-row compact">
            <span><strong>Show WhatsApp in top bar</strong><small>The floating WhatsApp button remains linked too.</small></span>
            <input id="show-whatsapp" type="checkbox" role="switch" />
          </label>
        </div>

        <div class="setting-box">
          <div class="field-heading"><label for="instagram-url">Instagram link</label></div>
          <input id="instagram-url" type="url" placeholder="https://instagram.com/yourstore" autocomplete="url" />
          <small>Use your full Instagram profile URL.</small>
          <label class="switch-row compact">
            <span><strong>Show Instagram in top bar</strong><small>Toggle it without removing the link.</small></span>
            <input id="show-instagram" type="checkbox" role="switch" />
          </label>
        </div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Promotion</p>
          <h2>Ribbon banner</h2>
          <p>The ribbon appears directly below the top bar on public pages.</p>
        </div>
      </div>
      <label for="ribbon-text">Ribbon content<textarea id="ribbon-text" rows="2" maxlength="180" placeholder="Free delivery on orders above $60"></textarea></label>
      <div class="preview-ribbon-wrap"><div id="ribbon-preview" class="ribbon-preview">Your ribbon preview will appear here.</div></div>
      <label class="switch-row">
        <span><strong>Show ribbon on website</strong><small>Updates apply on the next public page load.</small></span>
        <input id="show-ribbon" type="checkbox" role="switch" />
      </label>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Delivery pricing</p>
          <h2>Cash on delivery</h2>
          <p>Checkout and WhatsApp receipts use this live delivery fee.</p>
        </div>
      </div>
      <div class="cod-field">
        <label for="cod-price">COD delivery price (USD)<input id="cod-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="5.00" /></label>
        <div class="price-hint"><strong id="cod-preview">$0.00</strong><span>Standard delivery fee when the order does not qualify for free delivery.</span></div>
        <label for="free-delivery-threshold">Free delivery above (USD)<input id="free-delivery-threshold" type="number" min="0" step="0.01" inputmode="decimal" placeholder="60.00" /></label>
        <div class="price-hint"><strong id="free-delivery-preview">Disabled</strong><span>Set 0.00 to disable the free-delivery threshold.</span></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WhatsApp ordering</p>
          <h2>Buy Now on WhatsApp</h2>
          <p>Product cards support quantity, customer details, delivery cost and receipt-style totals.</p>
        </div>
      </div>
      <div class="feature-list">
        <div><span>✓</span><p>Product name, price and quantity</p></div>
        <div><span>✓</span><p>Customer details when already saved</p></div>
        <div><span>✓</span><p>Subtotal, COD delivery and total</p></div>
        <div><span>✓</span><p>Uses the WhatsApp number configured above</p></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Store theme</p>
          <h2>Colors &amp; theme</h2>
          <p>Pick a theme to preview it. The header, buttons, badges, prices, cards and backgrounds across the whole store follow it once you publish.</p>
        </div>
        <span id="theme-status" class="status-text" role="status"></span>
      </div>
      <div class="theme-layout">
        <div class="theme-picker">
          <div id="theme-grid" class="theme-grid" role="radiogroup" aria-label="Store theme choices"></div>
          <div class="custom-theme">
            <div>
              <strong>Custom colors</strong>
              <small>Match your logo or brand. Text colors adjust automatically so everything stays readable.</small>
            </div>
            <div class="custom-theme-inputs">
              <label for="custom-primary">Main color<input id="custom-primary" type="color" value="#2563eb" /></label>
              <label for="custom-accent">Accent color<input id="custom-accent" type="color" value="#ffc53d" /></label>
            </div>
            <p id="custom-note" class="custom-note" hidden></p>
          </div>
        </div>
        <div class="theme-preview-wrap">
          <p class="preview-label">Live preview</p>
          <div id="theme-preview" class="theme-preview" aria-hidden="true">
            <div class="tp-header"><b>Clever Toys</b><span class="tp-nav"><i></i><i></i><i></i></span><span class="tp-cart">🛒 Cart <em>2</em></span></div>
            <div class="tp-ribbon">🚚 Free delivery on orders above $60</div>
            <div class="tp-hero">
              <span class="tp-eyebrow">NEW ARRIVALS</span>
              <strong>Play. Learn. Discover.</strong>
              <div class="tp-buttons"><span class="tp-primary">Shop Toys</span><span class="tp-secondary">Categories</span></div>
              <span class="tp-bubble tp-bubble-1">🧸</span><span class="tp-bubble tp-bubble-2">🚀</span>
            </div>
            <div class="tp-products">
              <div class="tp-card"><div class="tp-image">🧩<em>Sale</em></div><small>Rainbow Puzzle</small><b>$12.00</b></div>
              <div class="tp-card"><div class="tp-image">🦖</div><small>Dino Explorer</small><b>$24.99</b></div>
            </div>
          </div>
        </div>
      </div>
      <div class="theme-actions">
        <button id="publish-theme" type="button" class="button" disabled>Publish theme</button>
        <button id="revert-theme" type="button" class="button secondary-button" disabled>Back to live theme</button>
      </div>
      <p id="publish-status" class="publish-status" role="status">Choose a theme to preview it here.</p>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Logo</p>
          <h2>Store Logo</h2>
          <p>Upload your Clever Toys logo. It is converted to WebP automatically.</p>
        </div>
      </div>
      <div class="logo-preview"><img id="preview" src={logoUrl} alt="Current Clever Toys logo" /></div>
      <label for="logo-file">Choose logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
      <button id="save-logo" class="button" type="button" disabled>Upload Logo</button>
      <p id="logo-message" role="status"></p>
    </section>

    <div class="settings-actions">
      <button id="save-settings" class="button" type="button" disabled>Save Store Settings</button>
      <p id="settings-message" role="status">Changes are saved to your store settings.</p>
    </div>
  </div>
</main>

<script>
import { createClient } from '@supabase/supabase-js';

const cfg = document.querySelector('#cfg');
const url = cfg?.dataset.url || '';
const key = cfg?.dataset.key || '';
const logoUrlValue = cfg?.dataset.logo || '';
const authStatus = document.querySelector('#auth-status');
const settingsMessage = document.querySelector('#settings-message');
const logoMessage = document.querySelector('#logo-message');
const saveSettingsButton = document.querySelector('#save-settings');
const saveLogoButton = document.querySelector('#save-logo');
const preview = document.querySelector('#preview');
const codInput = document.querySelector('#cod-price');
const codPreview = document.querySelector('#cod-preview');
const freeDeliveryInput = document.querySelector('#free-delivery-threshold');
const freeDeliveryPreview = document.querySelector('#free-delivery-preview');
const ribbonText = document.querySelector('#ribbon-text');
const ribbonPreview = document.querySelector('#ribbon-preview');
const grid = document.querySelector('#theme-grid');
const publishThemeButton = document.querySelector('#publish-theme');
const revertThemeButton = document.querySelector('#revert-theme');
const customPrimaryInput = document.querySelector('#custom-primary');
const customAccentInput = document.querySelector('#custom-accent');
const customNote = document.querySelector('#custom-note');
const themePreview = document.querySelector('#theme-preview');
const themeStatus = document.querySelector('#theme-status');
const publishStatus = document.querySelector('#publish-status');
let supabase;
let adminReady = false;

const defaults = {
  whatsapp_url: 'https://wa.me/96171220251?text=Hello%2C%20I%27m%20interested%20with%20your%20product',
  instagram_url: '',
  show_whatsapp: true,
  show_instagram: false,
  ribbon_text: '',
  show_ribbon: false,
  cod_delivery_price: 0,
  free_delivery_threshold: 0
};

// Each theme needs a main color that keeps white text readable (WCAG AA) and a light accent for badges.
const themes = [
  { id: 'sky', name: 'Sky Blocks', primary: '#2563eb', soft: '#e8f0ff', accent: '#ffc53d', emoji: '🪁', desc: 'Bright blue + sunshine' },
  { id: 'bubblegum', name: 'Bubblegum', primary: '#db2777', soft: '#ffe8f3', accent: '#ffd166', emoji: '🍭', desc: 'Pink + lemon' },
  { id: 'grape', name: 'Grape Soda', primary: '#7c3aed', soft: '#f1eaff', accent: '#5eead4', emoji: '🦄', desc: 'Violet + mint' },
  { id: 'jungle', name: 'Jungle Gym', primary: '#15803d', soft: '#e3f6e8', accent: '#ffb627', emoji: '🦖', desc: 'Leafy green + mango' },
  { id: 'tangerine', name: 'Tangerine', primary: '#c2410c', soft: '#fff0e5', accent: '#7dd3fc', emoji: '🧡', desc: 'Orange + sky blue' },
  { id: 'ocean', name: 'Ocean Splash', primary: '#0e7490', soft: '#e0f6f9', accent: '#ff9eb5', emoji: '🐳', desc: 'Teal + coral pink' },
  { id: 'cherry', name: 'Cherry Pop', primary: '#dc2626', soft: '#ffeceb', accent: '#fcd34d', emoji: '🍒', desc: 'Toy red + yellow' },
  { id: 'midnight', name: 'Midnight Stars', primary: '#312e81', soft: '#ebeafd', accent: '#f9a8d4', emoji: '🌙', desc: 'Navy + candy pink' }
];
const defaultTheme = themes[0];
let liveTheme = defaultTheme;
let previewTheme = defaultTheme;

function money(value) {
  return `$${Number(value || 0).toFixed(2)}`;
}

function hexToRgb(hex) {
  const n = parseInt(hex.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}

function rgbToHex(rgb) {
  return `#${rgb.map((value) => Math.round(Math.min(255, Math.max(0, value))).toString(16).padStart(2, '0')).join('')}`;
}

function mixHex(a, b, amountOfA) {
  const x = hexToRgb(a);
  const y = hexToRgb(b);
  return rgbToHex(x.map((value, i) => value * amountOfA + y[i] * (1 - amountOfA)));
}

function luminance(hex) {
  const channel = (value) => {
    const c = value / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  const [r, g, b] = hexToRgb(hex);
  return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
}

function contrastWithWhite(hex) {
  return 1.05 / (luminance(hex) + 0.05);
}

function readableText(hex) {
  const onWhite = contrastWithWhite(hex);
  const onInk = (luminance(hex) + 0.05) / (luminance('#1b1530') + 0.05);
  return onWhite >= 4.5 || onWhite >= onInk ? '#ffffff' : '#1b1530';
}

function isSameTheme(a, b) {
  return a.primary === b.primary && a.soft === b.soft && a.accent === b.accent;
}

function applyColors(theme) {
  const vars = {
    '--brand-primary': theme.primary,
    '--brand-primary-hover': `color-mix(in srgb,${theme.primary} 86%,#000)`,
    '--brand-soft': theme.soft,
    '--theme-accent': theme.accent,
    '--brand-text-on-primary': readableText(theme.primary),
    '--theme-text-on-accent': readableText(theme.accent)
  };
  Object.entries(vars).forEach(([name, value]) => document.documentElement.style.setProperty(name, value));
}

function buildCustomTheme() {
  let primary = String(customPrimaryInput?.value || '#2563eb').toLowerCase();
  const accent = String(customAccentInput?.value || '#ffc53d').toLowerCase();
  const original = primary;
  // Darken the main color until white button text passes WCAG AA contrast.
  for (let i = 0; i < 20 && contrastWithWhite(primary) < 4.5; i++) primary = mixHex(primary, '#000000', 0.92);
  if (customNote) {
    customNote.hidden = primary === original;
    customNote.textContent = primary === original ? '' : `Main color darkened to ${primary} so white text on buttons stays readable.`;
  }
  return { id: 'custom', name: 'Custom colors', primary, soft: mixHex(primary, '#ffffff', 0.1), accent, emoji: '🎨', desc: 'Your own colors' };
}

function updateThemeUI() {
  grid?.querySelectorAll('.theme-choice').forEach((element) => {
    const theme = themes.find((item) => item.id === element.dataset.id);
    const selected = Boolean(theme && isSameTheme(theme, previewTheme));
    const live = Boolean(theme && isSameTheme(theme, liveTheme));
    element.classList.toggle('selected', selected);
    element.setAttribute('aria-checked', String(selected));
    element.querySelector('.theme-live-tag')?.toggleAttribute('hidden', !live);
  });
  const changed = !isSameTheme(previewTheme, liveTheme);
  if (themeStatus) themeStatus.textContent = `Live: ${liveTheme.name}`;
  if (publishThemeButton) publishThemeButton.disabled = !adminReady || !changed;
  if (revertThemeButton) revertThemeButton.disabled = !changed;
  if (publishStatus && changed) publishStatus.textContent = `Previewing ${previewTheme.name}. Publish it to show it to every visitor.`;
}

function previewThemeChoice(theme) {
  previewTheme = theme;
  applyColors(theme);
  updateThemeUI();
}

function renderThemes() {
  if (!grid) return;
  grid.innerHTML = themes.map((theme) => `
    <button type="button" class="theme-choice" role="radio" aria-checked="false" data-id="${theme.id}" style="--c-primary:${theme.primary};--c-soft:${theme.soft};--c-accent:${theme.accent}">
      <span class="theme-swatch"><span class="swatch-bar"></span><span class="swatch-body"><i></i><b>${theme.emoji}</b></span></span>
      <span class="theme-meta"><strong>${theme.name}</strong><small>${theme.desc}</small></span>
      <span class="theme-live-tag" hidden>Live</span>
    </button>
  `).join('');
  grid.querySelectorAll('.theme-choice').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = themes.find((item) => item.id === button.dataset.id);
      if (theme) previewThemeChoice(theme);
    });
  });
}

async function publishTheme(theme) {
  if (!supabase || !adminReady) return false;
  publishStatus.textContent = 'Publishing theme for all visitors…';
  publishThemeButton.disabled = true;
  const payload = {
    mode: 'theme',
    theme: { id: theme.id, name: theme.name, primary: theme.primary, soft: theme.soft, accent: theme.accent },
    updated_at: new Date().toISOString()
  };
  // The product-images bucket only accepts image types, and supabase-js sends a Blob's own
  // type (not the contentType option), so the JSON must be labelled as an image.
  const blob = new Blob([JSON.stringify(payload)], { type: 'image/webp' });
  const result = await supabase.storage.from('product-images').upload('branding/theme.json', blob, {
    contentType: 'image/webp',
    cacheControl: '0',
    upsert: true
  });
  if (result.error) {
    publishStatus.textContent = `Could not publish theme: ${result.error.message}`;
    updateThemeUI();
    return false;
  }
  liveTheme = theme;
  publishStatus.textContent = `${theme.name} is now live for all visitors.`;
  updateThemeUI();
  return true;
}

function loadLiveTheme() {
  const published = window.__CLEVER_BRANDING__?.publishedTheme;
  if (!published?.primary) return defaultTheme;
  const match = themes.find((theme) => theme.primary.toLowerCase() === String(published.primary).toLowerCase() && theme.accent.toLowerCase() === String(published.accent).toLowerCase());
  if (match) return match;
  if (customPrimaryInput) customPrimaryInput.value = published.primary;
  if (customAccentInput) customAccentInput.value = published.accent;
  return { id: 'custom', name: published.name || 'Custom colors', primary: published.primary, soft: published.soft, accent: published.accent };
}

function updateRibbonPreview() {
  const text = String(ribbonText?.value || '').trim();
  if (!ribbonPreview) return;
  ribbonPreview.textContent = text || 'Your ribbon preview will appear here.';
  ribbonPreview.classList.toggle('muted', !text);
}

function updateCodPreview() {
  if (codPreview) codPreview.textContent = money(codInput?.value || 0);
}
function updateFreeDeliveryPreview() {
  if (!freeDeliveryPreview) return;
  const value = Math.max(0, Number(freeDeliveryInput?.value || 0));
  freeDeliveryPreview.textContent = value > 0 ? 'Free above ' + money(value) : 'Disabled';
}

function normalizeWhatsapp(value) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (raw.startsWith('https://') || raw.startsWith('http://')) return raw;
  const digits = raw.replace(/[^0-9]/g, '');
  return digits ? `https://wa.me/${digits}` : raw;
}

function normalizeInstagram(value) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (raw.startsWith('https://') || raw.startsWith('http://')) return raw;
  return `https://instagram.com/${raw.replace(/^@/, '')}`;
}

async function loadSettings() {
  const result = await supabase.from('store_settings').select('*').eq('id', 'default').maybeSingle();
  if (result.error) throw new Error(`Store settings table is not ready. ${result.error.message}`);
  const settings = { ...defaults, ...(result.data || {}) };

  document.querySelector('#whatsapp-url').value = settings.whatsapp_url || '';
  document.querySelector('#instagram-url').value = settings.instagram_url || '';
  document.querySelector('#show-whatsapp').checked = Boolean(settings.show_whatsapp);
  document.querySelector('#show-instagram').checked = Boolean(settings.show_instagram);
  ribbonText.value = settings.ribbon_text || '';
  document.querySelector('#show-ribbon').checked = Boolean(settings.show_ribbon);
  codInput.value = Number(settings.cod_delivery_price || 0).toFixed(2);
  if (freeDeliveryInput) freeDeliveryInput.value = Number(settings.free_delivery_threshold || 0).toFixed(2);
  updateRibbonPreview();
  updateCodPreview();
  updateFreeDeliveryPreview();
}

async function saveSettings() {
  const payload = {
    id: 'default',
    whatsapp_url: normalizeWhatsapp(document.querySelector('#whatsapp-url').value),
    instagram_url: normalizeInstagram(document.querySelector('#instagram-url').value),
    show_whatsapp: document.querySelector('#show-whatsapp').checked,
    show_instagram: document.querySelector('#show-instagram').checked,
    ribbon_text: String(ribbonText.value || '').trim(),
    show_ribbon: document.querySelector('#show-ribbon').checked,
    cod_delivery_price: Math.max(0, Number(codInput.value || 0)),
    free_delivery_threshold: Math.max(0, Number(freeDeliveryInput?.value || 0)),
    updated_at: new Date().toISOString()
  };

  if (payload.show_whatsapp && !payload.whatsapp_url) throw new Error('Add a WhatsApp link or switch off WhatsApp top-bar visibility.');
  if (payload.show_instagram && !payload.instagram_url) throw new Error('Add an Instagram link or switch off Instagram top-bar visibility.');
  if (payload.show_ribbon && !payload.ribbon_text) throw new Error('Add ribbon text or switch off the ribbon.');

  settingsMessage.textContent = 'Saving store settings…';
  saveSettingsButton.disabled = true;
  const result = await supabase.from('store_settings').upsert(payload, { onConflict: 'id' }).select('*').single();
  if (result.error) throw new Error(result.error.message);

  document.querySelector('#whatsapp-url').value = result.data.whatsapp_url || '';
  document.querySelector('#instagram-url').value = result.data.instagram_url || '';
  settingsMessage.textContent = 'Store settings saved. New public page loads use the new values immediately.';
}

async function initAuth() {
  try {
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const sessionResult = await supabase.auth.getSession();
    if (sessionResult.error) throw new Error(sessionResult.error.message);
    if (!sessionResult.data.session?.user) {
      authStatus.textContent = 'Please sign in to manage branding.';
      location.href = '/login?next=%2Fadmin%2Fbranding';
      return;
    }
    const adminResult = await supabase.rpc('is_admin');
    if (adminResult.error) throw new Error(adminResult.error.message);
    if (!adminResult.data) {
      authStatus.textContent = 'Access denied.';
      return;
    }
    adminReady = true;
    authStatus.textContent = 'Admin access verified';
    saveSettingsButton.disabled = false;
    saveLogoButton.disabled = false;
    updateThemeUI();
    await loadSettings();
  } catch (error) {
    authStatus.textContent = error?.message || 'Unable to verify admin access.';
  }
}

renderThemes();
liveTheme = loadLiveTheme();
previewThemeChoice(liveTheme);
publishStatus.textContent = 'Choose a theme to preview it here.';
customPrimaryInput?.addEventListener('input', () => previewThemeChoice(buildCustomTheme()));
customAccentInput?.addEventListener('input', () => previewThemeChoice(buildCustomTheme()));
publishThemeButton?.addEventListener('click', () => publishTheme(previewTheme));
revertThemeButton?.addEventListener('click', () => {
  previewThemeChoice(liveTheme);
  publishStatus.textContent = 'Showing the live theme.';
});

updateRibbonPreview();
updateCodPreview();
ribbonText?.addEventListener('input', updateRibbonPreview);
codInput?.addEventListener('input', updateCodPreview);
freeDeliveryInput?.addEventListener('input', updateFreeDeliveryPreview);
updateFreeDeliveryPreview();
saveSettingsButton?.addEventListener('click', async () => {
  try {
    await saveSettings();
  } catch (error) {
    settingsMessage.textContent = error?.message || 'Unable to save store settings.';
  } finally {
    saveSettingsButton.disabled = !adminReady;
  }
});
document.querySelector('#logout')?.addEventListener('click', async () => {
  if (supabase) await supabase.auth.signOut();
  location.href = '/login';
});

saveLogoButton?.addEventListener('click', async () => {
  const file = document.querySelector('#logo-file')?.files?.[0];
  if (!file) {
    logoMessage.textContent = 'Choose a logo file first.';
    return;
  }
  logoMessage.textContent = 'Uploading logo…';
  saveLogoButton.disabled = true;
  try {
    const bitmap = await createImageBitmap(file);
    const max = 1800;
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Could not prepare the logo.');
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise((resolve, reject) => canvas.toBlob((value) => {
      if (value) resolve(value);
      else reject(new Error('Could not convert the logo to WebP.'));
    }, 'image/webp', 0.92));
    const upload = await supabase.storage.from('product-images').upload('branding/logo.webp', blob, {
      contentType: 'image/webp',
      upsert: true,
      cacheControl: '0'
    });
    if (upload.error) throw new Error(upload.error.message);
    preview.src = `${logoUrlValue}?v=${Date.now()}`;
    logoMessage.textContent = 'Logo updated successfully.';
  } catch (error) {
    logoMessage.textContent = error?.message || 'Unable to upload the logo.';
  } finally {
    saveLogoButton.disabled = !adminReady;
  }
});

initAuth();
</script>

