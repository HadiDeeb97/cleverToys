---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';

const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
const logoUrl = supabaseUrl
  ? `${supabaseUrl.replace(/\/$/, '')}/storage/v1/object/public/product-images/branding/logo.webp`
  : '';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/admin">Clever Toys Admin</a>
    <nav class="main-nav">
      <a href="/admin">Products</a>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/analytics">Visitors</a>
      <a href="/admin/seo">SEO</a>
      <a href="/">Store</a>
    </nav>
  </div>
</header>

<main class="section">
  <div class="container branding-page">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Store control center</p>
        <h1>Branding &amp; Store Settings</h1>
        <p>Manage your theme, logo, social links, ribbon, WhatsApp ordering and delivery pricing from one place.</p>
      </div>
      <button id="logout" class="button secondary-button" type="button">Sign Out</button>
    </div>

    <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} data-logo={logoUrl} hidden></div>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Social media</p>
          <h2>Social links &amp; visibility</h2>
          <p>These links power the slim top bar. WhatsApp uses the same URL as the floating WhatsApp button.</p>
        </div>
        <span id="auth-status" class="status-text" role="status">Checking admin access…</span>
      </div>

      <div class="settings-grid">
        <div class="setting-box">
          <div class="field-heading"><label for="whatsapp-url">WhatsApp link</label><span class="sync-pill">Synced</span></div>
          <input id="whatsapp-url" type="url" placeholder="https://wa.me/961..." autocomplete="url" />
          <small>Paste a wa.me / WhatsApp URL, or a phone number with country code.</small>
          <label class="switch-row compact"><span><strong>Show WhatsApp in top bar</strong><small>Floating WhatsApp stays available too.</small></span><input id="show-whatsapp" type="checkbox" role="switch" /></label>
        </div>

        <div class="setting-box">
          <div class="field-heading"><label for="instagram-url">Instagram link</label></div>
          <input id="instagram-url" type="url" placeholder="https://instagram.com/yourstore" autocomplete="url" />
          <small>Use your full Instagram profile URL.</small>
          <label class="switch-row compact"><span><strong>Show Instagram in top bar</strong><small>Turn it off anytime without deleting the link.</small></span><input id="show-instagram" type="checkbox" role="switch" /></label>
        </div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Promotion</p>
          <h2>Ribbon banner</h2>
          <p>A slim announcement banner appears directly below the top bar on every public page.</p>
        </div>
      </div>
      <label for="ribbon-text">Ribbon content<textarea id="ribbon-text" rows="2" maxlength="180" placeholder="Free delivery on orders above $60"></textarea></label>
      <div class="preview-ribbon-wrap"><div id="ribbon-preview" class="ribbon-preview">Your ribbon preview will appear here.</div></div>
      <label class="switch-row"><span><strong>Show ribbon on website</strong><small>Updates are applied on the next page load.</small></span><input id="show-ribbon" type="checkbox" role="switch" /></label>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Delivery pricing</p>
          <h2>Cash on delivery</h2>
          <p>Set the COD delivery fee once. Checkout orders and WhatsApp receipts use the same live value.</p>
        </div>
      </div>
      <div class="cod-field">
        <label for="cod-price">COD delivery price (USD)<input id="cod-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" /></label>
        <div class="price-hint"><strong id="cod-preview">$0.00</strong><span>Use 0.00 for free delivery.</span></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WhatsApp ordering</p>
          <h2>Buy Now on WhatsApp</h2>
          <p>Product cards include a quantity selector and a receipt-style WhatsApp message with customer details when they are already available on the device.</p>
        </div>
      </div>
      <div class="feature-list">
        <div><span>✓</span><p>Product name, unit price and selected quantity</p></div>
        <div><span>✓</span><p>Customer name, phone and address when saved</p></div>
        <div><span>✓</span><p>Subtotal, COD delivery cost and total</p></div>
        <div><span>✓</span><p>Your live WhatsApp number from this page</p></div>
      </div>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Color source</p>
          <h2>Choose your color source</h2>
          <p>Use logo colors or one of the toy-store themes below.</p>
        </div>
        <span id="theme-status" class="status-text" role="status"></span>
      </div>
      <label class="switch-row"><span><strong>Use logo colors</strong><small>ON = logo-based colors. OFF = selected theme.</small></span><input id="use-logo-colors" type="checkbox" role="switch" /></label>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Store theme</p>
          <h2>Pick a playful style</h2>
          <p>Click a theme to publish it for all visitors.</p>
        </div>
      </div>
      <div id="theme-grid" class="theme-grid" aria-label="Store theme choices"></div>
      <div id="theme-preview" class="theme-preview">
        <div class="preview-scene"><span>☁️</span><span>☀️</span><strong>⚽</strong><b>🧩</b></div>
        <div class="preview-content"><em>NEW TOYS</em><h3>Clever Toys</h3><p>Fun toys. Happy kids. Easy shopping.</p><div><span>Shop Toys</span><small>Best sellers</small></div></div>
      </div>
      <p id="publish-status" class="publish-status" role="status">Select a theme to publish it for everyone.</p>
      <button id="reset-theme" type="button" class="button secondary-button">Use logo colors</button>
    </section>

    <section class="form-card branding-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Logo</p>
          <h2>Store Logo</h2>
          <p>Upload your Clever Toys logo. It is converted to WebP automatically.</p>
        </div>
      </div>
      <div class="logo-preview"><img id="preview" src={logoUrl} alt="Current Clever Toys logo" /></div>
      <label for="logo-file">Choose logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
      <button id="save-logo" class="button" type="button" disabled>Upload Logo</button>
      <p id="logo-message" role="status"></p>
    </section>

    <div class="settings-actions">
      <button id="save-settings" class="button" type="button" disabled>Save Store Settings</button>
      <p id="settings-message" role="status">Changes are saved to your store settings.</p>
    </div>
  </div>
</main>

<script>
import { createClient } from '@supabase/supabase-js';

const cfg = document.querySelector('#cfg');
const url = cfg?.dataset.url || '';
const key = cfg?.dataset.key || '';
const logoUrl = cfg?.dataset.logo || '';
const authStatus = document.querySelector('#auth-status');
const settingsMessage = document.querySelector('#settings-message');
const logoMessage = document.querySelector('#logo-message');
const saveSettingsButton = document.querySelector('#save-settings');
const saveLogoButton = document.querySelector('#save-logo');
const preview = document.querySelector('#preview');
const codInput = document.querySelector('#cod-price');
const codPreview = document.querySelector('#cod-preview');
const ribbonText = document.querySelector('#ribbon-text');
const ribbonPreview = document.querySelector('#ribbon-preview');
const logoToggle = document.querySelector('#use-logo-colors');
const grid = document.querySelector('#theme-grid');
const themePreview = document.querySelector('#theme-preview');
const themeStatus = document.querySelector('#theme-status');
const publishStatus = document.querySelector('#publish-status');
let supabase;
let adminReady = false;

const defaults = {
  id: 'default',
  whatsapp_url: 'https://wa.me/96171220251?text=Hello%2C%20I%27m%20interested%20with%20your%20product',
  instagram_url: '',
  show_whatsapp: true,
  show_instagram: false,
  ribbon_text: '',
  show_ribbon: false,
  cod_delivery_price: 0
};

const themes = [
  {id:'playroom',name:'Playroom',primary:'#7c3aed',soft:'#f3e8ff',accent:'#fbbf24',emoji:'🧸',desc:'Purple + sunny yellow'},
  {id:'candy',name:'Candy Pop',primary:'#ec4899',soft:'#fce7f3',accent:'#06b6d4',emoji:'🍭',desc:'Pink + playful cyan'},
  {id:'ocean',name:'Ocean Toys',primary:'#0284c7',soft:'#e0f2fe',accent:'#f59e0b',emoji:'🌊',desc:'Blue + warm orange'},
  {id:'sunny',name:'Sunny Day',primary:'#ea580c',soft:'#ffedd5',accent:'#eab308',emoji:'☀️',desc:'Orange + sunshine'},
  {id:'mint',name:'Minty Fun',primary:'#059669',soft:'#d1fae5',accent:'#f43f5e',emoji:'🪀',desc:'Mint + coral'},
  {id:'berry',name:'Berry Box',primary:'#be123c',soft:'#ffe4e6',accent:'#7c3aed',emoji:'🎈',desc:'Berry + violet'}
];

function cookie(name){return document.cookie.match(new RegExp('(?:^|;\\s*)'+name.replace(/[.*+?^${}()|[\\]\\]/g,'\\$&')+'=([^;]+)'))?.[1]||'';}
function setCookie(name,value){document.cookie=`${name}=${encodeURIComponent(value)}; Max-Age=31536000; Path=/; SameSite=Lax`;}
function deleteCookie(name){document.cookie=`${name}=; Max-Age=0; Path=/; SameSite=Lax`;}
function money(value){return `$${Number(value||0).toFixed(2)}`;}
function applyColors(primary,soft,accent,label){
  document.documentElement.style.setProperty('--brand-primary',primary);
  document.documentElement.style.setProperty('--brand-soft',soft);
  document.documentElement.style.setProperty('--theme-accent',accent);
  document.documentElement.style.setProperty('--brand-primary-hover',primary);
  themePreview?.style.setProperty('--preview-primary',primary);
  themePreview?.style.setProperty('--preview-soft',soft);
  themePreview?.style.setProperty('--preview-accent',accent);
  if(themeStatus) themeStatus.textContent=label;
}
function updateRibbonPreview(){
  const text=String(ribbonText?.value||'').trim();
  if(ribbonPreview){ribbonPreview.textContent=text||'Your ribbon preview will appear here.';ribbonPreview.classList.toggle('muted',!text);}
}
function updateCodPreview(){if(codPreview)codPreview.textContent=money(codInput?.value||0);}
function normalizeWhatsapp(value){
  const raw=String(value||'').trim();
  if(!raw) return '';
  if(/^https?:\\/\\//i.test(raw)) return raw;
  const digits=raw.replace(/[^0-9]/g,'');
  return digits?`https://wa.me/${digits}`:raw;
}
function normalizeInstagram(value){
  const raw=String(value||'').trim();
  if(!raw) return '';
  if(/^https?:\\/\\//i.test(raw)) return raw;
  return `https://instagram.com/${raw.replace(/^@/,'')}`;
}

async function publishConfig(payload,successText,errorPrefix){
  if(!supabase||!adminReady) return false;
  publishStatus.textContent='Publishing store colors for all visitors…';
  const blob=new Blob([JSON.stringify(payload)],{type:'image/webp'});
  const r=await supabase.storage.from('product-images').upload('branding/theme.json',blob,{contentType:'image/webp',cacheControl:'0',upsert:true});
  if(r.error){publishStatus.textContent=`${errorPrefix}: ${r.error.message}`;return false;}
  publishStatus.textContent=successText;
  return true;
}
async function publishTheme(theme){return publishConfig({mode:'theme',theme:{id:theme.id,name:theme.name,primary:theme.primary,soft:theme.soft,accent:theme.accent},updated_at:new Date().toISOString()},`${theme.name} is now live for all visitors.`,'Could not publish theme');}
async function publishLogoMode(){return publishConfig({mode:'logo',theme:null,updated_at:new Date().toISOString()},'Logo colors are now live for all visitors.','Could not publish color mode');}
function selectTheme(theme, publish=true){
  logoToggle.checked=false;
  setCookie('cleverThemeMode','theme');
  setCookie('cleverTheme',theme.primary);
  setCookie('cleverUseLogoColors','false');
  applyColors(theme.primary,theme.soft,theme.accent,`${theme.name} active`);
  grid.querySelectorAll('.theme-choice').forEach(el=>el.classList.toggle('selected',el.dataset.id===theme.id));
  if(publish && adminReady) publishTheme(theme);
}
function renderThemes(){
  grid.innerHTML=themes.map(t=>`<button type="button" class="theme-choice" data-id="${t.id}" aria-label="Use ${t.name} theme"><span class="theme-colors" style="background:${t.soft}"><i style="background:${t.primary}"></i><i style="background:${t.accent}"></i><b>${t.emoji}</b></span><strong>${t.name}</strong><small>${t.desc}</small></button>`).join('');
  grid.querySelectorAll('.theme-choice').forEach(btn=>btn.addEventListener('click',()=>{const t=themes.find(x=>x.id===btn.dataset.id);if(t)selectTheme(t,true);}));
}
async function setLogoMode(enabled,publish=true){
  logoToggle.checked=enabled;
  setCookie('cleverUseLogoColors',enabled?'true':'false');
  if(enabled){
    deleteCookie('cleverThemeMode');
    grid.querySelectorAll('.theme-choice').forEach(el=>el.classList.remove('selected'));
    applyColors('#111827','#f3f4f6','#fbbf24','Logo colors active');
    if(publish && adminReady) await publishLogoMode();
  }else{
    const saved=decodeURIComponent(cookie('cleverTheme')||'').toLowerCase();
    const t=themes.find(x=>x.primary.toLowerCase()===saved)||themes[0];
    selectTheme(t,publish);
  }
}
async function loadSettings(){
  const result=await supabase.from('store_settings').select('*').eq('id','default').maybeSingle();
  if(result.error) throw new Error(`Store settings table is not ready. Run supabase/branding_settings.sql first. ${result.error.message}`);
  const s={...defaults,...(result.data||{})};
  document.querySelector('#whatsapp-url').value=s.whatsapp_url||'';
  document.querySelector('#instagram-url').value=s.instagram_url||'';
  document.querySelector('#show-whatsapp').checked=Boolean(s.show_whatsapp);
  document.querySelector('#show-instagram').checked=Boolean(s.show_instagram);
  ribbonText.value=s.ribbon_text||'';
  document.querySelector('#show-ribbon').checked=Boolean(s.show_ribbon);
  codInput.value=Number(s.cod_delivery_price||0).toFixed(2);
  updateRibbonPreview();
  updateCodPreview();
}
async function saveSettings(){
  const payload={
    id:'default',
    whatsapp_url:normalizeWhatsapp(document.querySelector('#whatsapp-url').value),
    instagram_url:normalizeInstagram(document.querySelector('#instagram-url').value),
    show_whatsapp:document.querySelector('#show-whatsapp').checked,
    show_instagram:document.querySelector('#show-instagram').checked,
    ribbon_text:String(ribbonText.value||'').trim(),
    show_ribbon:document.querySelector('#show-ribbon').checked,
    cod_delivery_price:Math.max(0,Number(codInput.value||0)),
    updated_at:new Date().toISOString()
  };
  if(payload.show_whatsapp && !payload.whatsapp_url) throw new Error('Add a WhatsApp link or switch off WhatsApp top-bar visibility.');
  if(payload.show_instagram && !payload.instagram_url) throw new Error('Add an Instagram link or switch off Instagram top-bar visibility.');
  if(payload.show_ribbon && !payload.ribbon_text) throw new Error('Add ribbon text or switch off the ribbon.');
  settingsMessage.textContent='Saving store settings…';
  saveSettingsButton.disabled=true;
  const result=await supabase.from('store_settings').upsert(payload,{onConflict:'id'}).select('*').single();
  if(result.error) throw new Error(result.error.message);
  document.querySelector('#whatsapp-url').value=result.data.whatsapp_url||'';
  document.querySelector('#instagram-url').value=result.data.instagram_url||'';
  settingsMessage.textContent='Store settings saved. New public page loads use the new values immediately.';
  window.__CLEVER_BRANDING__={...(window.__CLEVER_BRANDING__||{}),whatsappUrl:result.data.whatsapp_url,instagramUrl:result.data.instagram_url,showWhatsapp:Boolean(result.data.show_whatsapp),showInstagram:Boolean(result.data.show_instagram),ribbonText:result.data.ribbon_text||'',showRibbon:Boolean(result.data.show_ribbon),codDeliveryPrice:Number(result.data.cod_delivery_price||0)};
}

async function initAuth(){
  try{
    if(!url||!key) throw new Error('Supabase browser configuration is missing.');
    supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
    const sessionResult=await supabase.auth.getSession();
    if(sessionResult.error) throw new Error(sessionResult.error.message);
    if(!sessionResult.data.session?.user){authStatus.textContent='Please sign in to manage branding.';location.href='/login?next=%2Fadmin%2Fbranding';return;}
    const adminResult=await supabase.rpc('is_admin');
    if(adminResult.error) throw new Error(adminResult.error.message);
    if(!adminResult.data){authStatus.textContent='Access denied.';return;}
    adminReady=true;
    authStatus.textContent='Admin access verified';
    saveSettingsButton.disabled=false;
    saveLogoButton.disabled=false;
    await loadSettings();
  }catch(error){authStatus.textContent=error?.message||'Unable to verify admin access.';}
}

renderThemes();
const savedLogo=cookie('cleverUseLogoColors');
const savedTheme=decodeURIComponent(cookie('cleverTheme')||'').toLowerCase();
const initial=themes.find(t=>t.primary.toLowerCase()===savedTheme)||themes[0];
if(savedLogo==='true') setLogoMode(true,false); else selectTheme(initial,false);
updateRibbonPreview();
updateCodPreview();
ribbonText.addEventListener('input',updateRibbonPreview);
codInput.addEventListener('input',updateCodPreview);
logoToggle.addEventListener('change',()=>setLogoMode(logoToggle.checked,true));
document.querySelector('#reset-theme').addEventListener('click',()=>setLogoMode(true,true));
saveSettingsButton.addEventListener('click',async()=>{try{await saveSettings();}catch(error){settingsMessage.textContent=error?.message||'Unable to save store settings.';}finally{saveSettingsButton.disabled=!adminReady;}});
document.querySelector('#logout').addEventListener('click',async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';});

saveLogoButton.addEventListener('click',async()=>{
  const file=document.querySelector('#logo-file').files?.[0];
  if(!file){logoMessage.textContent='Choose a logo file first.';return;}
  logoMessage.textContent='Uploading logo…';
  saveLogoButton.disabled=true;
  try{
    const bmp=await createImageBitmap(file);
    const max=1800;
    const scale=Math.min(1,max/Math.max(bmp.width,bmp.height));
    const canvas=document.createElement('canvas');
    canvas.width=Math.max(1,Math.round(bmp.width*scale));
    canvas.height=Math.max(1,Math.round(bmp.height*scale));
    const ctx=canvas.getContext('2d');
    if(!ctx) throw new Error('Could not prepare the logo.');
    ctx.drawImage(bmp,0,0,canvas.width,canvas.height);
    const blob=await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('Could not convert the logo to WebP.')),'image/webp',.92));
    const up=await supabase.storage.from('product-images').upload('branding/logo.webp',blob,{contentType:'image/webp',upsert:true,cacheControl:'0'});
    if(up.error) throw new Error(up.error.message);
    preview.src=`${logoUrl}?v=${Date.now()}`;
    logoMessage.textContent='Logo updated successfully.';
  }catch(error){logoMessage.textContent=error?.message||'Unable to upload the logo.';}
  finally{saveLogoButton.disabled=!adminReady;}
});

initAuth();
</script>

<style>
