---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
const logoUrl = supabaseUrl ? `${supabaseUrl.replace(/\/$/, '')}/storage/v1/object/public/product-images/branding/logo.webp` : '';
---
<header class="site-header"><div class="container header-inner"><a class="logo" href="/admin">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/dashboard">Dashboard</a><a href="/admin/orders">Orders</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container branding-page">
  <div class="admin-head"><div><p class="eyebrow">Store appearance</p><h1>Branding</h1><p>Upload your Clever Toys logo. The storefront will automatically build its color theme from the logo.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div>
  <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} data-logo={logoUrl} hidden></div>
  <div id="guard" class="empty-state">Checking admin access…</div>
  <section id="app" class="form-card" hidden>
    <h2>Store Logo</h2>
    <div class="logo-preview"><img id="preview" src={logoUrl} alt="Current Clever Toys logo" /></div>
    <label>Choose logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
    <small>PNG, JPG, WebP or SVG are accepted. The uploaded logo is converted to WebP and stored as the permanent storefront logo.</small>
    <button id="save" class="button" type="button">Upload &amp; Apply Theme</button>
    <p id="message" role="status"></p>
  </section>
</div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#cfg');const url=cfg?.dataset.url,key=cfg?.dataset.key,logoUrl=cfg?.dataset.logo||'';const guard=document.querySelector('#guard'),app=document.querySelector('#app'),message=document.querySelector('#message'),preview=document.querySelector('#preview');let supabase;
const toWebp=async(file)=>{const bmp=await createImageBitmap(file),max=1800,scale=Math.min(1,max/Math.max(bmp.width,bmp.height)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bmp.width*scale));canvas.height=Math.max(1,Math.round(bmp.height*scale));const ctx=canvas.getContext('2d');if(!ctx)throw new Error('Could not prepare the logo.');ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(bmp,0,0,canvas.width,canvas.height);return await new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Could not convert the logo to WebP.')),'image/webp',.92));};
const init=async()=>{try{if(!url||!key)throw new Error('Supabase configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const s=await supabase.auth.getSession();if(!s.data.session?.user){location.href='/login?next=%2Fadmin%2Fbranding';return;}const a=await supabase.rpc('is_admin');if(a.error)throw new Error(a.error.message);if(!a.data)throw new Error('This account is not an administrator.');guard.hidden=true;app.hidden=false;}catch(e){guard.textContent=e?.message||'Unable to verify admin access.';}};
document.querySelector('#logout').onclick=async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';};
document.querySelector('#save').onclick=async()=>{const file=document.querySelector('#logo-file').files?.[0];if(!file){message.textContent='Choose a logo file first.';return;}message.textContent='Uploading logo…';try{const blob=await toWebp(file);const up=await supabase.storage.from('product-images').upload('branding/logo.webp',blob,{contentType:'image/webp',upsert:true,cacheControl:'0'});if(up.error)throw new Error(up.error.message);const src=`${logoUrl}?v=${Date.now()}`;preview.src=src;message.textContent='Logo updated. Your site theme will now follow the logo colors.';setTimeout(()=>location.reload(),700);}catch(e){message.textContent=e?.message||'Unable to upload logo.';}};
init();
</script>
<style>.branding-page{max-width:760px}.logo-preview{min-height:220px;display:grid;place-items:center;padding:28px;border:1px dashed #cbd5e1;border-radius:16px;background:#f8fafc;margin-bottom:8px}.logo-preview img{max-width:min(100%,420px);max-height:180px;object-fit:contain}.branding-page .form-card{max-width:760px}</style>
