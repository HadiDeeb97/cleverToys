---
/**
 * Admin → Orders: every order with search and status filters; change status, see items and customer details.
 * Edit an order (items, quantities, prices, delivery, discount) and add orders taken outside the website
 * (supabase/order_editing.sql).
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Orders | Clever Toys Admin</title>
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Sales</p>
        <h1>Orders</h1>
        <p id="orders-summary">Loading orders…</p>
      </div>
      <div class="quick-actions">
        <button id="enable-alerts" class="button secondary-button" type="button" title="Show a pop-up on this computer when a new order arrives">🔔 Order alerts</button>
        <button id="export-xlsx" class="button secondary-button" type="button" title="The orders shown (with your filters), and their items">Export Excel</button>
        <button id="refresh" class="button secondary-button" type="button">Refresh</button>
        <button id="new-order-open" class="button" type="button" title="An order from WhatsApp, Instagram, a phone call or the shop">＋ New order</button>
      </div>
    </div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>
    <div id="orders-app" hidden>
      <div class="orders-toolbar admin-panel">
        <div id="status-tabs" class="chip-row" role="tablist" aria-label="Filter by status"></div>
        <div class="orders-filters">
          <label class="sr-only" for="order-search">Search orders</label>
          <input id="order-search" class="admin-input" type="search" placeholder="Search order #, name, phone or email" />
          <label class="date-filter">From<input id="date-from" class="admin-input" type="date" /></label>
          <label class="date-filter">To<input id="date-to" class="admin-input" type="date" /></label>
          <label class="sr-only" for="order-sort">Sort orders</label>
          <select id="order-sort" class="admin-input"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="total">Highest total</option></select>
        </div>
      </div>
      <div id="orders-list" class="orders-list"></div>
      <div class="load-more-wrap"><button id="load-more" class="button secondary-button" type="button" hidden>Show more orders</button></div>
    </div>
    <dialog id="new-order" class="wa-dialog new-order-dialog" aria-labelledby="new-order-title">
      <form id="new-order-form" class="wa-dialog-form" novalidate>
        <div class="new-order-head"><div><p class="eyebrow">Order from outside the website</p><h2 id="new-order-title">New order</h2></div><button type="button" class="small-button" id="new-order-close" aria-label="Close">✕</button></div>
        <div class="new-order-grid">
          <label>Where from<select name="source" class="admin-input"><option value="whatsapp">WhatsApp</option><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="phone">Phone call</option><option value="in_store">In store</option><option value="other">Other</option></select></label>
          <label>Status<select id="new-order-status" name="status" class="admin-input"></select></label>
          <label>Date &amp; time<input name="created_at" class="admin-input" type="datetime-local" /></label>
          <label>Customer name *<input name="customer_name" class="admin-input" maxlength="120" required autocomplete="off" /></label>
          <label>Phone<input name="customer_phone" class="admin-input" type="tel" autocomplete="off" /></label>
          <label>Email<input name="customer_email" class="admin-input" type="email" maxlength="200" autocomplete="off" /></label>
          <label>Governorate<input id="new-order-governorate" name="governorate" class="admin-input" list="governorate-list" maxlength="80" autocomplete="off" /></label>
          <label>City<input name="city" class="admin-input" maxlength="80" autocomplete="off" /></label>
          <label>Area<input name="area" class="admin-input" maxlength="80" autocomplete="off" /></label>
          <label class="wide">Address<input name="address" class="admin-input" maxlength="300" autocomplete="off" /></label>
          <label class="wide">Notes<textarea name="notes" class="admin-input" rows="2" maxlength="1000"></textarea></label>
        </div>
        <datalist id="governorate-list"></datalist>
        <div><h3 class="new-order-items">Items</h3><div data-draft-box="new"></div></div>
        <p class="new-order-note">The items are taken from stock, like a website order. The delivery fee follows the governorate (Admin → Discounts &amp; delivery) until you change it.</p>
        <div class="new-order-actions"><button type="submit" class="button" id="new-order-save">Add order</button><button type="button" class="button secondary-button" id="new-order-cancel">Cancel</button></div>
      </form>
    </dialog>
  </div>
</main>

<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { allowPage, enableOrderNotifications, markOrdersSeen } from '../../scripts/admin-access';
import { smartFilter } from '../../scripts/smart-search';
import { exportXlsxSheets, exportName } from '../../scripts/table-export';

const STATUSES = ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'];
const LABELS: Record<string, string> = { pending: 'Pending', confirmed: 'Confirmed', processing: 'Preparing', shipped: 'On the way', delivered: 'Delivered', cancelled: 'Cancelled' };
// Where an order came from (orders.source); website orders show no badge.
const SOURCES: Record<string, string> = { website: 'Website', whatsapp: '💬 WhatsApp', instagram: '📸 Instagram', facebook: '📘 Facebook', phone: '📞 Phone call', in_store: '🏬 In store', other: '✍️ Other' };
const PAGE_SIZE = 25;
// Order fields come from anonymous checkout input, so everything rendered as HTML is escaped.
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const money = (n: unknown) => `$${Number(n || 0).toFixed(2)}`;
const toast = (message: string, tone = 'success') => (window as any).adminToast?.(message, tone);
const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let orders: any[] = [];
const itemsByOrder = new Map<string, any[]>();
const params = new URLSearchParams(location.search);
let statusFilter = STATUSES.includes(params.get('status') || '') ? String(params.get('status')) : 'all';
let visible = PAGE_SIZE;
const expanded = new Set<string>();
// Only owners and managers may delete orders (also enforced by the database: supabase/order_delete.sql).
let canDelete = false;
// Orders being edited (and the New order form, under NEW) with the changes not saved yet, kept when the list redraws.
type Line = { key: string; id?: string; product_id: string; variant_id: string | null; name: string; variant_name: string | null; sku: string | null; quantity: string; price: string };
type Draft = { lines: Line[]; discount: string; initialDiscount: string; delivery: string; deliveryTouched: boolean; search: string };
const drafts = new Map<string, Draft>();
const NEW = 'new';
let lineCount = 0;
const round2 = (n: number) => Math.round(n * 100) / 100;
$<HTMLInputElement>('#order-search').value = params.get('q') || '';

// wa.me needs an international number; Lebanese numbers without a country code get 961.
const whatsappNumber = (phone: string) => {
  let digits = String(phone || '').replace(/\D/g, '').replace(/^00/, '');
  if (digits.length <= 8) digits = `961${digits.replace(/^0/, '')}`;
  return digits;
};
const trackingLink = (order: any) => `${location.origin}/track-order?order=${encodeURIComponent(order.order_number)}`;
const whatsappMessage = (order: any) => `Hi ${order.customer_name}, this is Clever Toys. Your order ${order.order_number} (${money(order.total)}) is now: ${LABELS[order.status] || order.status}. Track it here: ${trackingLink(order)}`;

function filtered() {
  const q = $<HTMLInputElement>('#order-search').value.trim().toLowerCase();
  const from = $<HTMLInputElement>('#date-from').value;
  const to = $<HTMLInputElement>('#date-to').value;
  const sort = $<HTMLSelectElement>('#order-sort').value;
  // Status and dates first, then smart search: any word order, typos, phone however typed (src/scripts/smart-search.ts).
  const list = smartFilter(orders.filter((o) => {
    if (statusFilter !== 'all' && o.status !== statusFilter) return false;
    if (from && new Date(o.created_at) < new Date(`${from}T00:00:00`)) return false;
    if (to && new Date(o.created_at) > new Date(`${to}T23:59:59`)) return false;
    return true;
  }), q, (o: any) => [[o.order_number, 3], [o.customer_name, 3], [o.customer_email, 1], [o.governorate, 1], [o.city, 1]], (o: any) => [o.customer_phone]);
  if (sort === 'oldest') list.sort((a, b) => a.created_at.localeCompare(b.created_at));
  else if (sort === 'total') list.sort((a, b) => Number(b.total) - Number(a.total));
  else list.sort((a, b) => b.created_at.localeCompare(a.created_at));
  return list;
}

function renderTabs() {
  const counts: Record<string, number> = { all: orders.length };
  for (const s of STATUSES) counts[s] = orders.filter((o) => o.status === s).length;
  $('#status-tabs').innerHTML = ['all', ...STATUSES].map((s) => `<button type="button" role="tab" class="chip${statusFilter === s ? ' active' : ''}" aria-selected="${statusFilter === s}" data-status-tab="${s}">${s === 'all' ? 'All' : LABELS[s]} <b>${counts[s]}</b></button>`).join('');
}

function detailsHtml(o: any) {
  const items = itemsByOrder.get(o.id);
  const editing = drafts.has(o.id);
  const itemRows = items ? (items.length ? items.map((i) => `<tr><td>${esc(i.product_name)}${i.variant_name ? `<small> · ${esc(i.variant_name)}</small>` : ''}${i.sku ? `<br><small>SKU ${esc(i.sku)}</small>` : ''}</td><td>${Number(i.quantity)}</td><td>${money(i.unit_price)}</td><td>${money(i.total_price)}</td></tr>`).join('') : '<tr><td colspan="4">No items recorded.</td></tr>') : '<tr><td colspan="4">Loading items…</td></tr>';
  const table = editing ? `<div data-draft-box="${o.id}">${editorHtml(o.id)}</div>` : `<table class="items-table"><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>${itemRows}</tbody>
    <tfoot><tr><td colspan="3">Subtotal</td><td>${money(o.subtotal)}</td></tr><tr><td colspan="3">Delivery</td><td>${Number(o.delivery_fee) ? money(o.delivery_fee) : 'Free'}</td></tr>${Number(o.discount) ? `<tr><td colspan="3">Discount ${discountPercent(o)}%${o.coupon_code ? ` (${esc(o.coupon_code)})` : ''}</td><td>−${money(o.discount)}</td></tr>` : ''}<tr class="grand"><td colspan="3">Total (cash on delivery)</td><td>${money(o.total)}</td></tr></tfoot></table>`;
  return `<div class="order-details">
    <div class="order-detail-grid">
      <div><h3>Customer</h3><p><strong>${esc(o.customer_name)}</strong></p><p><a href="tel:${esc(o.customer_phone)}">${esc(o.customer_phone)}</a></p>${o.customer_email ? `<p><a href="mailto:${esc(o.customer_email)}">${esc(o.customer_email)}</a></p>` : ''}</div>
      <div><h3>Delivery address</h3><p>${esc([o.governorate, o.city, o.area].filter(Boolean).join(', '))}</p><p>${esc(o.address)}</p></div>
      <div><h3>Notes</h3><p>${o.notes ? esc(o.notes) : '<span class="muted">No notes</span>'}</p></div>
    </div>
    ${table}
    ${editing ? `<div class="price-edit-bar"><span>Change quantities and prices, remove items with ✕ or add toys, set the delivery fee and the discount %, then save. ${o.status === 'cancelled' ? 'Stock does not change (the order is cancelled).' : 'Stock follows the change: removed items go back into stock, added items are taken from it.'}</span><button type="button" class="button" data-save-order="${o.id}">Save changes</button><button type="button" class="button secondary-button" data-cancel-edit="${o.id}">Cancel</button></div>` : ''}
    <div class="order-actions">
      <a class="button whatsapp-action" target="_blank" rel="noopener" href="https://api.whatsapp.com/send?phone=${whatsappNumber(o.customer_phone)}&text=${encodeURIComponent(whatsappMessage(o))}">💬 Message on WhatsApp</a>
      ${!editing && items ? `<button class="button secondary-button" type="button" data-edit-order="${o.id}">✏️ Edit order</button>` : ''}
      <button class="button secondary-button" type="button" data-print="${o.id}">🧾 Print invoice</button>
      <button class="button secondary-button" type="button" data-copy-link="${o.id}">🔗 Copy tracking link</button>
      ${canDelete && !editing ? `<button class="button delete-order-button" type="button" data-delete-order="${o.id}">🗑️ Delete order</button>` : ''}
    </div>
  </div>`;
}

function render() {
  renderTabs();
  const list = filtered();
  const revenue = list.filter((o) => o.status !== 'cancelled').reduce((s, o) => s + Number(o.total || 0), 0);
  $('#orders-summary').textContent = `${list.length} order${list.length === 1 ? '' : 's'} · ${money(revenue)} excluding cancelled`;
  const page = list.slice(0, visible);
  $('#orders-list').innerHTML = page.length ? page.map((o) => `<article class="order-card${expanded.has(o.id) ? ' open' : ''}" data-order="${o.id}">
    <div class="order-row">
      <button type="button" class="order-toggle" aria-expanded="${expanded.has(o.id)}" data-toggle="${o.id}"><span class="chev" aria-hidden="true">›</span><span><strong>${esc(o.order_number)}</strong><small>${new Date(o.created_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })}</small>${o.source && o.source !== 'website' ? `<small class="order-source">${esc(SOURCES[o.source] || o.source)}</small>` : ''}</span></button>
      <div class="order-customer"><strong>${esc(o.customer_name)}</strong><small>${esc(o.customer_phone)} · ${esc(o.city || o.governorate || '')}</small></div>
      <strong class="order-total">${money(o.total)}${o.coupon_code ? `<small class="order-coupon" title="Discount code">🏷️ ${esc(o.coupon_code)}</small>` : ''}</strong>
      <span class="status-pill status-${esc(o.status)}">${esc(LABELS[o.status] || o.status)}</span>
      <div class="order-status-edit">
        <label class="sr-only" for="status-${o.id}">Status for ${esc(o.order_number)}</label>
        <select id="status-${o.id}" class="admin-input" data-status="${o.id}">${STATUSES.map((s) => `<option value="${s}"${o.status === s ? ' selected' : ''}>${LABELS[s]}</option>`).join('')}</select>
        ${o.status === 'pending' ? `<button type="button" class="small-button" data-confirm="${o.id}">Confirm</button>` : ''}
      </div>
    </div>
    ${expanded.has(o.id) ? detailsHtml(o) : ''}
  </article>`).join('') : '<div class="empty-state"><h2>No orders match</h2><p>Try another status, search or date range.</p></div>';
  $('#load-more').hidden = list.length <= visible;
}

async function loadItems(orderId: string) {
  if (itemsByOrder.has(orderId)) return;
  const r = await supabase.from('order_items').select('id,order_id,product_id,variant_id,product_name,variant_name,sku,quantity,unit_price,total_price').eq('order_id', orderId).order('created_at');
  itemsByOrder.set(orderId, (r.data ?? []) as any[]);
}

/** The order's discount as a percentage of its subtotal ("10", "12.5"), for the discount field. */
function discountPercent(o: any) {
  const subtotal = Number(o.subtotal || 0), discount = Number(o.discount || 0);
  return subtotal > 0 && discount > 0 ? String(Math.round(discount / subtotal * 10000) / 100) : '0';
}

// ---------- Editing items (an open order, or the New order form) ----------

/** Starts editing an order: its items, delivery fee and discount % as they are now. */
function startEdit(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  if (!o) return;
  drafts.set(orderId, {
    lines: (itemsByOrder.get(orderId) ?? []).map((i) => ({ key: `l${++lineCount}`, id: i.id, product_id: i.product_id, variant_id: i.variant_id, name: i.product_name, variant_name: i.variant_name, sku: i.sku, quantity: String(i.quantity), price: Number(i.unit_price).toFixed(2) })),
    discount: discountPercent(o), initialDiscount: discountPercent(o), delivery: Number(o.delivery_fee || 0).toFixed(2), deliveryTouched: true, search: ''
  });
  render();
}

// Delivery fees for the New order form: the same rules as checkout (public.delivery_fee_for).
let deliveryInfo: { fee: number; threshold: number; zones: any[] } | null = null;
async function loadDeliveryInfo() {
  if (deliveryInfo) return;
  const [settings, zones] = await Promise.all([
    supabase.from('store_settings').select('cod_delivery_price,free_delivery_threshold').eq('id', 'default').maybeSingle(),
    supabase.from('delivery_zones').select('governorate,fee,is_active').order('governorate')
  ]);
  deliveryInfo = { fee: Math.max(0, Number(settings.data?.cod_delivery_price || 0)), threshold: Math.max(0, Number(settings.data?.free_delivery_threshold || 0)), zones: (zones.data ?? []) as any[] };
  $('#governorate-list').innerHTML = deliveryInfo.zones.filter((z) => z.is_active).map((z) => `<option value="${esc(z.governorate)}"></option>`).join('');
}
function autoDelivery(subtotal: number) {
  if (!deliveryInfo) return 0;
  const governorate = $<HTMLInputElement>('#new-order-governorate').value.trim().toLowerCase();
  const zone = deliveryInfo.zones.find((z) => String(z.governorate).toLowerCase() === governorate);
  const fee = zone?.is_active ? Number(zone.fee || 0) : deliveryInfo.fee;
  return deliveryInfo.threshold > 0 && subtotal >= deliveryInfo.threshold ? 0 : fee;
}

/** The totals with what is typed (the same sums the database does when saving). */
function draftTotals(id: string) {
  const d = drafts.get(id)!;
  const o = id === NEW ? null : orders.find((x) => x.id === id);
  const line = (l: Line) => round2(Math.max(0, Number(l.price) || 0)) * Math.max(0, Math.floor(Number(l.quantity) || 0));
  const subtotal = round2(d.lines.reduce((sum, l) => sum + line(l), 0));
  const percent = Math.min(100, Math.max(0, Number(d.discount) || 0));
  // An untouched discount on an unchanged subtotal keeps its exact amount (no rounding to the percentage).
  const unchanged = o && d.discount.trim() === d.initialDiscount && Math.abs(subtotal - Number(o.subtotal || 0)) < 0.005;
  const discount = Math.min(unchanged ? Number(o.discount || 0) : Math.round(subtotal * percent) / 100, subtotal);
  if (id === NEW && !d.deliveryTouched) d.delivery = autoDelivery(subtotal).toFixed(2);
  const delivery = round2(Math.max(0, Number(d.delivery) || 0));
  return { line, subtotal, discount, delivery, total: Math.max(0, subtotal - discount) + delivery };
}

function editorHtml(id: string) {
  const d = drafts.get(id)!;
  const o = id === NEW ? null : orders.find((x) => x.id === id);
  const t = draftTotals(id);
  const rows = d.lines.length ? d.lines.map((l) => `<tr>
      <td>${esc(l.name)}${l.variant_name ? `<small> · ${esc(l.variant_name)}</small>` : ''}${l.sku ? `<br><small>SKU ${esc(l.sku)}</small>` : ''}${id !== NEW && !l.id ? ' <span class="new-line">added</span>' : ''}</td>
      <td><input class="admin-input qty-input" type="number" inputmode="numeric" min="1" max="1000" step="1" value="${esc(l.quantity)}" aria-label="Quantity of ${esc(l.name)}" data-draft="${id}" data-line-qty="${l.key}" /></td>
      <td><input class="admin-input price-input" type="number" inputmode="decimal" min="0" step="0.01" value="${esc(l.price)}" aria-label="Price of ${esc(l.name)}" data-draft="${id}" data-line-price="${l.key}" /></td>
      <td data-line-total="${l.key}">${money(t.line(l))}</td>
      <td><button type="button" class="remove-line" title="Remove this item" aria-label="Remove ${esc(l.name)}" data-draft="${id}" data-line-remove="${l.key}">✕</button></td>
    </tr>`).join('') : `<tr><td colspan="5" class="muted">${id === NEW ? 'No items yet: add a toy below.' : 'All items removed. Add a toy below, or cancel. To remove the whole order, delete it instead.'}</td></tr>`;
  return `<div class="table-scroll"><table class="items-table edit-table"><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th><th><span class="sr-only">Remove</span></th></tr></thead><tbody>${rows}</tbody>
    <tfoot>
      <tr class="picker-row"><td colspan="5"><label class="sr-only" for="pick-${id}">Add a toy</label><input id="pick-${id}" class="admin-input" type="search" autocomplete="off" placeholder="＋ Add a toy: type its name or SKU" value="${esc(d.search)}" data-draft="${id}" data-picker="${id}" /><div class="picker-results" data-picker-results="${id}"></div></td></tr>
      <tr><td colspan="3">Subtotal</td><td data-sum="subtotal">${money(t.subtotal)}</td><td></td></tr>
      <tr class="discount-edit"><td colspan="3"><label for="delivery-${id}">Delivery fee</label> <span class="percent-field"><b aria-hidden="true">$</b><input id="delivery-${id}" class="admin-input price-input" type="number" inputmode="decimal" min="0" step="0.01" value="${esc(d.delivery)}" data-draft="${id}" data-delivery="${id}" /></span></td><td data-sum="delivery">${t.delivery ? money(t.delivery) : 'Free'}</td><td></td></tr>
      <tr class="discount-edit"><td colspan="3"><label for="discount-${id}">Discount${o?.coupon_code ? ` (code ${esc(o.coupon_code)})` : ''}</label> <span class="percent-field"><input id="discount-${id}" class="admin-input price-input" type="number" inputmode="decimal" min="0" max="100" step="any" value="${esc(d.discount)}" data-draft="${id}" data-discount="${id}" /><b aria-hidden="true">%</b></span></td><td data-sum="discount">−${money(t.discount)}</td><td></td></tr>
      <tr class="grand"><td colspan="3">Total (cash on delivery)</td><td data-sum="total">${money(t.total)}</td><td></td></tr>
    </tfoot></table></div>`;
}
/** Redraws the items of one draft (after adding or removing an item). */
function renderDraft(id: string, focusPicker = false) {
  const box = document.querySelector(`[data-draft-box="${id}"]`);
  if (!box || !drafts.has(id)) return;
  box.innerHTML = editorHtml(id);
  if (focusPicker) box.querySelector<HTMLInputElement>('[data-picker]')?.focus();
}
/** Updates the line totals and the sums while typing (without redrawing the fields). */
function updateTotals(id: string) {
  const box = document.querySelector(`[data-draft-box="${id}"]`);
  const d = drafts.get(id);
  if (!box || !d) return;
  const t = draftTotals(id);
  for (const l of d.lines) { const cell = box.querySelector(`[data-line-total="${l.key}"]`); if (cell) cell.textContent = money(t.line(l)); }
  const set = (key: string, text: string) => { const el = box.querySelector(`[data-sum="${key}"]`); if (el) el.textContent = text; };
  set('subtotal', money(t.subtotal)); set('delivery', t.delivery ? money(t.delivery) : 'Free'); set('discount', `−${money(t.discount)}`); set('total', money(t.total));
  const deliveryInput = box.querySelector<HTMLInputElement>('[data-delivery]');
  if (deliveryInput && !d.deliveryTouched && document.activeElement !== deliveryInput) deliveryInput.value = d.delivery;
}

// The toys to add, loaded the first time the search is used.
let catalog: Promise<any[]> | null = null;
function loadCatalog() {
  catalog ??= Promise.resolve(supabase.from('products').select('id,name,sku,price,sale_price,stock_quantity,is_active,product_variants(id,name,sku,price,sale_price,stock_quantity,is_active)').order('name').limit(5000))
    .then((r) => { if (r.error) { catalog = null; toast(`Could not load the toys: ${r.error.message}`, 'error'); return []; } return (r.data ?? []) as any[]; });
  return catalog;
}
/** The price the product page shows for a toy or one of its options. */
const shownPrice = (p: any, v: any) => Number((v ? (v.sale_price ?? v.price ?? p.sale_price ?? p.price) : (p.sale_price ?? p.price)) || 0);
async function showPicker(id: string) {
  const d = drafts.get(id);
  const results = document.querySelector(`[data-picker-results="${id}"]`);
  if (!d || !results) return;
  const q = d.search.trim();
  if (!q) { results.innerHTML = ''; return; }
  const products = await loadCatalog();
  if (d.search.trim() !== q) return;   // typed more while loading
  const found = smartFilter(products, q, (p: any) => [[p.name, 3], [p.sku, 2], ...(p.product_variants ?? []).flatMap((v: any) => [[v.name, 1], [v.sku, 2]] as Array<[unknown, number]>)]).slice(0, 8);
  const choice = (p: any, v: any) => {
    const stock = Number(v ? v.stock_quantity : p.stock_quantity) || 0;
    return `<button type="button" class="picker-option" data-draft="${id}" data-pick-product="${p.id}" data-pick-variant="${v?.id ?? ''}"><span>${esc(p.name)}${v ? ` · <b>${esc(v.name)}</b>` : ''}${p.is_active ? '' : ' <em>(hidden)</em>'}</span><small>${money(shownPrice(p, v))} · ${stock > 0 ? `${stock} in stock` : '<em>out of stock</em>'}</small></button>`;
  };
  results.innerHTML = found.length ? found.map((p) => {
    const options = (p.product_variants ?? []).filter((v: any) => v.is_active);
    return options.length ? options.map((v: any) => choice(p, v)).join('') : choice(p, null);
  }).join('') : '<p class="muted">No toy matches.</p>';
}
async function pick(id: string, productId: string, variantId: string) {
  const d = drafts.get(id);
  const p = (await loadCatalog()).find((x) => x.id === productId);
  if (!d || !p) return;
  const v = variantId ? (p.product_variants ?? []).find((x: any) => x.id === variantId) : null;
  // The same toy (and option) again adds one more to its line.
  const same = d.lines.find((l) => l.product_id === p.id && (l.variant_id || '') === (v?.id || ''));
  if (same) same.quantity = String(Math.min(1000, (Math.floor(Number(same.quantity)) || 0) + 1));
  else d.lines.push({ key: `l${++lineCount}`, product_id: p.id, variant_id: v?.id ?? null, name: p.name, variant_name: v?.name ?? null, sku: (v?.sku || p.sku) ?? null, quantity: '1', price: shownPrice(p, v).toFixed(2) });
  d.search = '';
  renderDraft(id, true);
}

/** The items to save, or null (with a message) when one is not valid. */
function draftItems(id: string) {
  const d = drafts.get(id)!;
  const box = document.querySelector(`[data-draft-box="${id}"]`);
  const fail = (message: string, selector?: string) => { if (selector) box?.querySelector<HTMLInputElement>(selector)?.focus(); toast(message, 'error'); return null; };
  if (!d.lines.length) return fail(id === NEW ? 'Add at least one toy.' : 'An order needs at least one item. To remove the whole order, delete it instead.', '[data-picker]');
  const items = [];
  for (const l of d.lines) {
    const quantity = Number(l.quantity), price = Number(l.price);
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 1000) return fail(`Enter a quantity from 1 to 1000 for ${l.name}.`, `[data-line-qty="${l.key}"]`);
    if (l.price.trim() === '' || !Number.isFinite(price) || price < 0) return fail(`Enter a valid price (0 or more) for ${l.name}.`, `[data-line-price="${l.key}"]`);
    items.push({ id: l.id ?? null, product_id: l.product_id, variant_id: l.variant_id, quantity, unit_price: round2(price) });
  }
  const percent = d.discount.trim() === '' ? 0 : Number(d.discount);
  if (!Number.isFinite(percent) || percent < 0 || percent > 100) return fail('Enter a discount between 0 and 100%.', '[data-discount]');
  const delivery = d.delivery.trim() === '' ? 0 : Number(d.delivery);
  if (!Number.isFinite(delivery) || delivery < 0) return fail('Enter a valid delivery fee (0 or more).', '[data-delivery]');
  return items;
}
const missingSql = (message: string) => /Could not find the function|does not exist/i.test(message);

async function saveOrder(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  if (!o || !drafts.has(orderId)) return;
  const items = draftItems(orderId);
  if (!items) return;
  const t = draftTotals(orderId);
  const button = document.querySelector<HTMLButtonElement>(`[data-save-order="${orderId}"]`);
  if (button) button.disabled = true;
  const r = await supabase.rpc('admin_update_order', { p_order_id: orderId, p_items: items, p_discount: t.discount, p_delivery_fee: t.delivery });
  if (r.error) {
    if (button) button.disabled = false;
    toast(missingSql(r.error.message) ? 'Run supabase/order_editing.sql in Supabase first.' : `Could not save: ${r.error.message}`, 'error');
    return;
  }
  Object.assign(o, r.data);
  drafts.delete(orderId);
  itemsByOrder.delete(orderId);
  catalog = null;   // stock changed
  await loadItems(orderId);
  render();
  toast(`${o.order_number} saved. New total ${money(o.total)}.`);
}

// ---------- New order (from WhatsApp, Instagram, a phone call, the shop…) ----------
const newOrderDialog = $<HTMLDialogElement>('#new-order');
const newOrderForm = $<HTMLFormElement>('#new-order-form');
$('#new-order-status').innerHTML = STATUSES.map((s) => `<option value="${s}"${s === 'confirmed' ? ' selected' : ''}>${LABELS[s]}</option>`).join('');
/** Opens the form; a form closed without adding the order opens again as it was left. */
async function openNewOrder() {
  if (!drafts.has(NEW)) {
    newOrderForm.reset();
    const now = new Date();
    // Now, in local time (what datetime-local shows).
    (newOrderForm.elements.namedItem('created_at') as HTMLInputElement).value = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    drafts.set(NEW, { lines: [], discount: '0', initialDiscount: '0', delivery: '0.00', deliveryTouched: false, search: '' });
  }
  renderDraft(NEW);
  newOrderDialog.showModal();
  (newOrderForm.elements.namedItem('customer_name') as HTMLInputElement).focus();
  await loadDeliveryInfo();
  updateTotals(NEW);
}
async function addOrder(event: SubmitEvent) {
  event.preventDefault();
  const form = new FormData(newOrderForm);
  const text = (key: string) => String(form.get(key) ?? '').trim();
  if (!text('customer_name')) { (newOrderForm.elements.namedItem('customer_name') as HTMLInputElement).focus(); toast('Enter the customer\'s name.', 'error'); return; }
  const items = draftItems(NEW);
  if (!items) return;
  const t = draftTotals(NEW);
  const when = text('created_at') ? new Date(text('created_at')) : new Date();
  if (Number.isNaN(when.getTime()) || when.getTime() > Date.now() + 60000) { toast('The order date cannot be in the future.', 'error'); return; }
  const button = $<HTMLButtonElement>('#new-order-save');
  button.disabled = true;
  const r = await supabase.rpc('admin_create_order', { p: {
    source: text('source'), status: text('status'), created_at: when.toISOString(),
    customer_name: text('customer_name'), customer_phone: text('customer_phone'), customer_email: text('customer_email'),
    governorate: text('governorate'), city: text('city'), area: text('area'), address: text('address'), notes: text('notes'),
    items: items.map(({ id: _id, ...item }) => item), delivery_fee: t.delivery, discount: t.discount
  } });
  button.disabled = false;
  if (r.error) { toast(missingSql(r.error.message) ? 'Run supabase/order_editing.sql in Supabase first.' : `Could not add the order: ${r.error.message}`, 'error'); return; }
  const order = r.data as any;
  drafts.delete(NEW);
  newOrderDialog.close();
  catalog = null;   // stock changed
  orders.unshift(order);
  expanded.add(order.id);
  render();
  await loadItems(order.id);
  render();
  toast(`Order ${order.order_number} added (${money(order.total)}).`);
}
newOrderForm.addEventListener('submit', addOrder);
$('#new-order-open').addEventListener('click', openNewOrder);
