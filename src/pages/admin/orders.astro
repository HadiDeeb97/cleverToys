async function deleteOrder(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  if (!o) return;
  const restock = ['pending', 'confirmed', 'processing'].includes(o.status);
  const ok = confirm(`Delete order ${o.order_number} (${o.customer_name}, ${money(o.total)})?\n\n${restock ? 'Its items go back into stock.' : `Stock does not change (the order is ${(LABELS[o.status] || o.status).toLowerCase()}).`}${o.coupon_code ? `\nThe discount code ${o.coupon_code} gets this use back.` : ''}\n\nThis cannot be undone.`);
  if (!ok) return;
  const r = await supabase.rpc('admin_delete_order', { p_order_id: orderId });
  if (r.error) { toast(/Could not find the function/i.test(r.error.message) ? 'Run supabase/order_delete.sql in Supabase first.' : `Could not delete: ${r.error.message}`, 'error'); return; }
  orders = orders.filter((x) => x.id !== orderId);
  expanded.delete(orderId); drafts.delete(orderId); itemsByOrder.delete(orderId);
  render();
  const back = Number((r.data as any)?.restocked || 0);
  toast(`${o.order_number} deleted.${back ? ` ${back} item${back === 1 ? '' : 's'} back in stock.` : ''}`);
}

async function setStatus(id: string, status: string) {
  const order = orders.find((o) => o.id === id);
  if (!order || order.status === status) return;
  const previous = order.status;
  order.status = status;
  render();
  const r = await supabase.from('orders').update({ status, updated_at: new Date().toISOString() }).eq('id', id);
  if (r.error) { order.status = previous; render(); toast(`Could not update ${order.order_number}: ${r.error.message}`, 'error'); return; }
  toast(`${order.order_number} marked ${LABELS[status]}.`);
}

