---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<header class="site-header"><div class="container header-inner"><a href="/admin" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin">Products</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><h1>Orders</h1><p>View and update customer orders.</p></div><a class="button secondary-button" href="/admin">Back to Products</a></div><div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><div id="guard" class="empty-state">Checking admin access…</div><div id="orders-app" hidden><div id="orders-list"></div></div></div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const config=document.querySelector('#auth-config');const url=config?.dataset.url;const key=config?.dataset.key;const guard=document.querySelector('#guard');const app=document.querySelector('#orders-app');const list=document.querySelector('#orders-list');let supabase;
const statuses=['pending','confirmed','processing','shipped','delivered','cancelled'];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){const {data:orders,error}=await supabase.from('orders').select('id,order_number,customer_name,customer_phone,customer_email,governorate,city,area,address,total,payment_method,status,notes,created_at').order('created_at',{ascending:false});if(error){list.innerHTML=`<p>${esc(error.message)}</p>`;return;}if(!orders?.length){list.innerHTML='<div class="empty-state"><h2>No orders yet</h2></div>';return;}const ids=orders.map(o=>o.id);const {data:items}=await supabase.from('order_items').select('order_id,product_name,variant_name,quantity,unit_price,total_price').in('order_id',ids);const grouped=(items||[]).reduce((acc,item)=>{(acc[item.order_id]??=[]).push(item);return acc;},{});list.innerHTML=`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Location</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>${orders.map(o=>`<tr><td><strong>${esc(o.order_number)}</strong><br><small>${esc(o.payment_method)}</small></td><td>${esc(o.customer_name)}<br><small>${esc(o.customer_phone)}</small>${o.customer_email?`<br><small>${esc(o.customer_email)}</small>`:''}</td><td>${esc([o.governorate,o.city].filter(Boolean).join(', '))}<br><small>${esc(o.area||'')}${o.address?` · ${esc(o.address)}`:''}</small></td><td><div class="order-items">${(grouped[o.id]||[]).map(i=>`<div><strong>${esc(i.product_name)}</strong>${i.variant_name?` · ${esc(i.variant_name)}`:''} × ${i.quantity}<small>$${Number(i.total_price).toFixed(2)}</small></div>`).join('')||'<small>No item details</small>'}</div></td><td>$${Number(o.total).toFixed(2)}</td><td><select data-status="${o.id}">${statuses.map(s=>`<option value="${s}" ${o.status===s?'selected':''}>${s}</option>`).join('')}</select>${o.notes?`<small class="order-note">${esc(o.notes)}</small>`:''}</td><td>${new Date(o.created_at).toLocaleString()}</td></tr>`).join('')}</tbody></table></div>`;list.querySelectorAll('[data-status]').forEach(s=>s.onchange=async()=>{s.disabled=true;const {error}=await supabase.from('orders').update({status:s.value,updated_at:new Date().toISOString()}).eq('id',s.dataset.status);s.disabled=false;if(error)alert(error.message);});}
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const {data:{session},error:sessionError}=await supabase.auth.getSession();if(sessionError)throw new Error(sessionError.message);if(!session?.user){location.href=`/login?next=${encodeURIComponent('/admin/orders')}`;return;}const {data:isAdmin,error}=await supabase.rpc('is_admin');if(error)throw new Error(error.message);if(!isAdmin){guard.innerHTML='<h2>Access denied</h2><a class="button" href="/">Back to store</a>';return;}guard.hidden=true;app.hidden=false;await load();}catch(error){guard.textContent=error?.message||'Could not load orders.';}}
init();
</script>
<style>
.order-items{min-width:180px}.order-items>div{margin:3px 0}.order-items small{display:block;color:#64748b}.order-note{display:block;max-width:180px;margin-top:6px;color:#64748b}@media(max-width:900px){.order-items{min-width:140px}}
</style>