/** The orders on screen (status, dates and search applied) with their items, as an Excel file. */
async function exportExcel() {
  const rows = filtered();
  if (!rows.length) { toast('No orders to export with these filters.', 'error'); return; }
  const button = $<HTMLButtonElement>('#export-xlsx');
  button.disabled = true;
  try {
    const items: any[] = [];
    const ids = rows.map((o) => o.id);
    for (let i = 0; i < ids.length; i += 150) {
      const r = await supabase.from('order_items').select('order_id,product_name,variant_name,sku,quantity,unit_price,total_price').in('order_id', ids.slice(i, i + 150));
      if (r.error) throw new Error(r.error.message);
      items.push(...(r.data ?? []));
    }
    const byOrder = new Map<string, any[]>();
    for (const it of items) { const list = byOrder.get(it.order_id) || []; list.push(it); byOrder.set(it.order_id, list); }
    const number = new Map(rows.map((o) => [o.id, o.order_number]));
    const n = (v: unknown) => (v === null || v === undefined || v === '' ? null : Number(v));
    const date = (v: string) => new Date(v).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
    await exportXlsxSheets(exportName('orders'), [
      {
        name: 'Orders',
        columns: [{ header: 'Order', width: 22 }, { header: 'Date', width: 20 }, { header: 'Status', width: 12 }, { header: 'Source', width: 12 }, { header: 'Customer', width: 22 }, { header: 'Phone', width: 18 }, { header: 'Email', width: 26 }, { header: 'Governorate', width: 16 }, { header: 'City', width: 16 }, { header: 'Area', width: 16 }, { header: 'Address', width: 34 }, { header: 'Items', width: 50 }, { header: 'Subtotal' }, { header: 'Delivery' }, { header: 'Discount' }, { header: 'Discount code' }, { header: 'Total' }, { header: 'Notes', width: 34 }],
        rows: rows.map((o) => [o.order_number, date(o.created_at), o.status, o.source || 'website', o.customer_name, o.customer_phone, o.customer_email, o.governorate, o.city, o.area, o.address,
          (byOrder.get(o.id) || []).map((it) => `${it.quantity}× ${it.product_name}${it.variant_name ? ` (${it.variant_name})` : ''}`).join('; '),
          n(o.subtotal), n(o.delivery_fee), n(o.discount), o.coupon_code, n(o.total), o.notes])
      },
      {
        name: 'Items',
        columns: [{ header: 'Order', width: 22 }, { header: 'Product', width: 32 }, { header: 'Option', width: 18 }, { header: 'SKU' }, { header: 'Quantity', width: 10 }, { header: 'Unit price' }, { header: 'Line total' }],
        rows: items.sort((a, b) => String(number.get(a.order_id)).localeCompare(String(number.get(b.order_id)))).map((it) => [number.get(it.order_id), it.product_name, it.variant_name, it.sku, n(it.quantity), n(it.unit_price), n(it.total_price)])
      }
    ]);
    toast(`Exported ${rows.length} orders and ${items.length} items.`);
  } catch (error) {
    toast(error instanceof Error ? error.message : 'Export failed.', 'error');
  } finally {
    button.disabled = false;
  }
}

async function load() {
  const r = await supabase.from('orders').select('*').order('created_at', { ascending: false }).limit(1000);
  if (r.error) throw new Error(r.error.message);
  orders = (r.data ?? []) as any[];
  render();
}

document.addEventListener('click', async (event) => {
  const target = event.target instanceof Element ? event.target : null;
  const tab = target?.closest<HTMLElement>('[data-status-tab]');
  if (tab) { statusFilter = tab.dataset.statusTab || 'all'; visible = PAGE_SIZE; const u = new URL(location.href); if (statusFilter === 'all') u.searchParams.delete('status'); else u.searchParams.set('status', statusFilter); history.replaceState(null, '', u); render(); return; }
  const toggle = target?.closest<HTMLElement>('[data-toggle]');
  if (toggle) { const id = toggle.dataset.toggle!; if (expanded.has(id)) expanded.delete(id); else { expanded.add(id); render(); await loadItems(id); } render(); return; }
  const confirmBtn = target?.closest<HTMLElement>('[data-confirm]');
  if (confirmBtn) { await setStatus(confirmBtn.dataset.confirm!, 'confirmed'); return; }
  const edit = target?.closest<HTMLElement>('[data-edit-order]');
  if (edit) { startEdit(edit.dataset.editOrder!); return; }
  const cancelEdit = target?.closest<HTMLElement>('[data-cancel-edit]');
  if (cancelEdit) { drafts.delete(cancelEdit.dataset.cancelEdit!); render(); return; }
  const save = target?.closest<HTMLElement>('[data-save-order]');
  if (save) { await saveOrder(save.dataset.saveOrder!); return; }
  const remove = target?.closest<HTMLElement>('[data-line-remove]');
  if (remove) { const id = remove.dataset.draft!; const d = drafts.get(id); if (d) { d.lines = d.lines.filter((l) => l.key !== remove.dataset.lineRemove); renderDraft(id); } return; }
  const choice = target?.closest<HTMLElement>('[data-pick-product]');
  if (choice) { await pick(choice.dataset.draft!, choice.dataset.pickProduct!, choice.dataset.pickVariant || ''); return; }
  const del = target?.closest<HTMLElement>('[data-delete-order]');
  if (del) { await deleteOrder(del.dataset.deleteOrder!); return; }
  const print = target?.closest<HTMLElement>('[data-print]');
  if (print) { const o = orders.find((x) => x.id === print.dataset.print); if (o) { await loadItems(o.id); printInvoice(o); } return; }
  const copy = target?.closest<HTMLElement>('[data-copy-link]');
  if (copy) { const o = orders.find((x) => x.id === copy.dataset.copyLink); if (o) { try { await navigator.clipboard.writeText(trackingLink(o)); toast('Tracking link copied.'); } catch { toast(trackingLink(o)); } } }
});
document.addEventListener('change', (event) => {
  const select = event.target instanceof HTMLSelectElement && event.target.dataset.status ? event.target : null;
  if (select) setStatus(select.dataset.status!, select.value);
});
// Typing in an item editor: keep what is typed in its draft and update the totals.
document.addEventListener('input', (event) => {
  const input = event.target instanceof HTMLInputElement && event.target.dataset.draft ? event.target : null;
  const d = input ? drafts.get(input.dataset.draft!) : undefined;
  if (!input || !d) return;
  const id = input.dataset.draft!;
  if (input.dataset.picker) { d.search = input.value; showPicker(id); return; }
  const line = d.lines.find((l) => l.key === (input.dataset.lineQty || input.dataset.linePrice));
  if (line && input.dataset.lineQty) line.quantity = input.value;
  else if (line) line.price = input.value;
  else if (input.dataset.delivery) { d.delivery = input.value; d.deliveryTouched = true; }
  else if (input.dataset.discount) d.discount = input.value;
  updateTotals(id);
});
document.addEventListener('keydown', (event) => {
  const input = event.target instanceof HTMLInputElement && event.target.dataset.draft ? event.target : null;
  if (!input || (event.key !== 'Enter' && event.key !== 'Escape')) return;
  const id = input.dataset.draft!;
  if (input.dataset.picker) {
    // Enter adds the first toy found; Escape clears the search.
    event.preventDefault();
    if (event.key === 'Enter') document.querySelector<HTMLButtonElement>(`[data-picker-results="${id}"] [data-pick-product]`)?.click();
    else if (input.value) { event.stopPropagation(); input.value = ''; const d = drafts.get(id); if (d) d.search = ''; showPicker(id); }
    return;
  }
  if (event.key === 'Enter') { event.preventDefault(); if (id !== NEW) saveOrder(id); }
});
['#order-search', '#date-from', '#date-to', '#order-sort'].forEach((sel) => $(sel).addEventListener('input', () => { visible = PAGE_SIZE; render(); }));
$('#load-more').addEventListener('click', () => { visible += PAGE_SIZE; render(); });
$('#export-xlsx').addEventListener('click', exportExcel);
$('#refresh').addEventListener('click', async () => { itemsByOrder.clear(); await load(); markOrdersSeen(); toast('Orders refreshed.'); });
// Browser pop-ups for new orders (while any admin page is open). The badge and sound work without this.
const alertsButton = $<HTMLButtonElement>('#enable-alerts');
if ('Notification' in window && Notification.permission === 'granted') alertsButton.textContent = '🔔 Alerts on';
alertsButton.addEventListener('click', async () => {
  const ok = await enableOrderNotifications();
  alertsButton.textContent = ok ? '🔔 Alerts on' : '🔔 Order alerts';
  toast(ok ? 'You will get a pop-up here when a new order arrives.' : 'Your browser blocked notifications. Allow them in the site settings.', ok ? 'success' : 'error');
});

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#auth-config');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = `/login?next=${encodeURIComponent('/admin/orders')}`; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><a class="button" href="/">Back to store</a>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'orders', 'Orders'))) return;
    const can = await supabase.rpc('admin_can_delete_orders');
    canDelete = !can.error && can.data === true;
    guard.hidden = true;
    $('#orders-app').hidden = false;
    await load();
    markOrdersSeen();
  } catch (error) {
    guard.hidden = false;
    guard.textContent = error instanceof Error ? error.message : 'Could not load orders.';
  }
}
init();
