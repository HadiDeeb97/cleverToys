---
import '../../styles/global.css';
---
<header class="site-header"><div class="container header-inner"><a href="/admin" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Dashboard</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><h1>Orders</h1><p>View and update customer orders.</p></div><a class="button secondary-button" href="/admin">Back to Dashboard</a></div><div id="guard" class="empty-state">Checking admin access…</div><div id="orders-app" hidden><div id="orders-list"></div></div></div></main>
<script>
import { supabase } from '../../lib/supabase';
const guard=document.querySelector('#guard');const app=document.querySelector('#orders-app');const list=document.querySelector('#orders-list');
async function load(){const {data,error}=await supabase.from('orders').select('id,order_number,customer_name,customer_phone,customer_email,governorate,city,area,address,total,payment_method,status,notes,created_at').order('created_at',{ascending:false});if(error){list.innerHTML=`<p>${error.message}</p>`;return;}list.innerHTML=data?.length?`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Location</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>${data.map(o=>`<tr><td><strong>${o.order_number}</strong><br><small>${o.payment_method}</small></td><td>${o.customer_name}<br><small>${o.customer_phone}</small></td><td>${o.governorate||''}, ${o.city||''}<br><small>${o.area||''}</small></td><td>$${Number(o.total).toFixed(2)}</td><td><select data-status="${o.id}">${['pending','confirmed','processing','shipped','delivered','cancelled'].map(s=>`<option value="${s}" ${o.status===s?'selected':''}>${s}</option>`).join('')}</select></td><td>${new Date(o.created_at).toLocaleString()}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty-state"><h2>No orders yet</h2></div>';list.querySelectorAll('[data-status]').forEach(s=>s.onchange=async()=>{const {error}=await supabase.from('orders').update({status:s.value,updated_at:new Date().toISOString()}).eq('id',s.dataset.status);if(error)alert(error.message);});}
const {data:{user}}=await supabase.auth.getUser();if(!user){location.href='/login';}else{const {data:isAdmin,error}=await supabase.rpc('is_admin');if(error||!isAdmin){guard.innerHTML='<h2>Access denied</h2><a class="button" href="/">Back to store</a>';}else{guard.hidden=true;app.hidden=false;await load();}}
</script>