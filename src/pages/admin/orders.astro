---
/**
 * Admin → Orders: every order with search and status filters; change status, see items and customer details.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Orders | Clever Toys Admin</title>
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Sales</p>
        <h1>Orders</h1>
        <p id="orders-summary">Loading orders…</p>
      </div>
      <div class="quick-actions">
        <button id="enable-alerts" class="button secondary-button" type="button" title="Show a pop-up on this computer when a new order arrives">🔔 Order alerts</button>
        <button id="export-xlsx" class="button secondary-button" type="button" title="The orders shown (with your filters), and their items">Export Excel</button>
        <button id="refresh" class="button" type="button">Refresh</button>
      </div>
    </div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>
    <div id="orders-app" hidden>
      <div class="orders-toolbar admin-panel">
        <div id="status-tabs" class="chip-row" role="tablist" aria-label="Filter by status"></div>
        <div class="orders-filters">
          <label class="sr-only" for="order-search">Search orders</label>
          <input id="order-search" class="admin-input" type="search" placeholder="Search order #, name, phone or email" />
          <label class="date-filter">From<input id="date-from" class="admin-input" type="date" /></label>
          <label class="date-filter">To<input id="date-to" class="admin-input" type="date" /></label>
          <label class="sr-only" for="order-sort">Sort orders</label>
          <select id="order-sort" class="admin-input"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="total">Highest total</option></select>
        </div>
      </div>
      <div id="orders-list" class="orders-list"></div>
      <div class="load-more-wrap"><button id="load-more" class="button secondary-button" type="button" hidden>Show more orders</button></div>
    </div>
  </div>
</main>

<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { allowPage, enableOrderNotifications, markOrdersSeen } from '../../scripts/admin-access';
import { smartFilter } from '../../scripts/smart-search';
import { exportXlsxSheets, exportName } from '../../scripts/table-export';

const STATUSES = ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'];
const LABELS: Record<string, string> = { pending: 'Pending', confirmed: 'Confirmed', processing: 'Preparing', shipped: 'On the way', delivered: 'Delivered', cancelled: 'Cancelled' };
const PAGE_SIZE = 25;
// Order fields come from anonymous checkout input, so everything rendered as HTML is escaped.
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const money = (n: unknown) => `$${Number(n || 0).toFixed(2)}`;
const toast = (message: string, tone = 'success') => (window as any).adminToast?.(message, tone);
const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let orders: any[] = [];
const itemsByOrder = new Map<string, any[]>();
const params = new URLSearchParams(location.search);
let statusFilter = STATUSES.includes(params.get('status') || '') ? String(params.get('status')) : 'all';
let visible = PAGE_SIZE;
const expanded = new Set<string>();
// Orders whose prices are being edited, and prices typed but not saved yet (kept when the list redraws).
const editingPrices = new Set<string>();
// Only owners and managers may delete orders (also enforced by the database: supabase/order_delete.sql).
let canDelete = false;
const draftPrices = new Map<string, string>();
$<HTMLInputElement>('#order-search').value = params.get('q') || '';

// wa.me needs an international number; Lebanese numbers without a country code get 961.
const whatsappNumber = (phone: string) => {
  let digits = String(phone || '').replace(/\D/g, '').replace(/^00/, '');
  if (digits.length <= 8) digits = `961${digits.replace(/^0/, '')}`;
  return digits;
};
const trackingLink = (order: any) => `${location.origin}/track-order?order=${encodeURIComponent(order.order_number)}`;
const whatsappMessage = (order: any) => `Hi ${order.customer_name}, this is Clever Toys. Your order ${order.order_number} (${money(order.total)}) is now: ${LABELS[order.status] || order.status}. Track it here: ${trackingLink(order)}`;

function filtered() {
  const q = $<HTMLInputElement>('#order-search').value.trim().toLowerCase();
  const from = $<HTMLInputElement>('#date-from').value;
  const to = $<HTMLInputElement>('#date-to').value;
  const sort = $<HTMLSelectElement>('#order-sort').value;
  // Status and dates first, then smart search: any word order, typos, phone however typed (src/scripts/smart-search.ts).
  const list = smartFilter(orders.filter((o) => {
    if (statusFilter !== 'all' && o.status !== statusFilter) return false;
    if (from && new Date(o.created_at) < new Date(`${from}T00:00:00`)) return false;
    if (to && new Date(o.created_at) > new Date(`${to}T23:59:59`)) return false;
    return true;
  }), q, (o: any) => [[o.order_number, 3], [o.customer_name, 3], [o.customer_email, 1], [o.governorate, 1], [o.city, 1]], (o: any) => [o.customer_phone]);
  if (sort === 'oldest') list.sort((a, b) => a.created_at.localeCompare(b.created_at));
  else if (sort === 'total') list.sort((a, b) => Number(b.total) - Number(a.total));
  else list.sort((a, b) => b.created_at.localeCompare(a.created_at));
  return list;
}

function renderTabs() {
  const counts: Record<string, number> = { all: orders.length };
  for (const s of STATUSES) counts[s] = orders.filter((o) => o.status === s).length;
  $('#status-tabs').innerHTML = ['all', ...STATUSES].map((s) => `<button type="button" role="tab" class="chip${statusFilter === s ? ' active' : ''}" aria-selected="${statusFilter === s}" data-status-tab="${s}">${s === 'all' ? 'All' : LABELS[s]} <b>${counts[s]}</b></button>`).join('');
}

function detailsHtml(o: any) {
  const items = itemsByOrder.get(o.id);
  const editing = editingPrices.has(o.id) && Boolean(items?.length);
  const priceCell = (i: any) => editing
    ? `<label class="sr-only" for="price-${i.id}">Price for ${esc(i.product_name)}</label><input id="price-${i.id}" class="admin-input price-input" type="number" inputmode="decimal" min="0" step="0.01" value="${esc(draftPrices.get(i.id) ?? Number(i.unit_price).toFixed(2))}" data-price-item="${i.id}" data-price-order="${o.id}" data-qty="${Number(i.quantity)}" />`
    : money(i.unit_price);
  const itemRows = items ? (items.length ? items.map((i) => `<tr><td>${esc(i.product_name)}${i.variant_name ? `<small> · ${esc(i.variant_name)}</small>` : ''}${i.sku ? `<br><small>SKU ${esc(i.sku)}</small>` : ''}</td><td>${Number(i.quantity)}</td><td>${priceCell(i)}</td><td data-line-total="${i.id}">${money(i.total_price)}</td></tr>`).join('') : '<tr><td colspan="4">No items recorded.</td></tr>') : '<tr><td colspan="4">Loading items…</td></tr>';
  return `<div class="order-details">
    <div class="order-detail-grid">
      <div><h3>Customer</h3><p><strong>${esc(o.customer_name)}</strong></p><p><a href="tel:${esc(o.customer_phone)}">${esc(o.customer_phone)}</a></p>${o.customer_email ? `<p><a href="mailto:${esc(o.customer_email)}">${esc(o.customer_email)}</a></p>` : ''}</div>
      <div><h3>Delivery address</h3><p>${esc([o.governorate, o.city, o.area].filter(Boolean).join(', '))}</p><p>${esc(o.address)}</p></div>
      <div><h3>Notes</h3><p>${o.notes ? esc(o.notes) : '<span class="muted">No notes</span>'}</p></div>
    </div>
    <table class="items-table"><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>${itemRows}</tbody>
    <tfoot><tr><td colspan="3">Subtotal</td><td data-sum="subtotal">${money(o.subtotal)}</td></tr><tr><td colspan="3">Delivery</td><td>${Number(o.delivery_fee) ? money(o.delivery_fee) : 'Free'}</td></tr>${editing
      ? `<tr class="discount-edit"><td colspan="3"><label for="discount-${o.id}">Discount${o.coupon_code ? ` (code ${esc(o.coupon_code)})` : ''}</label> <span class="percent-field"><input id="discount-${o.id}" class="admin-input price-input" type="number" inputmode="decimal" min="0" max="100" step="any" value="${esc(draftPrices.get(`discount:${o.id}`) ?? discountPercent(o))}" data-initial="${discountPercent(o)}" data-discount-order="${o.id}" /><b aria-hidden="true">%</b></span></td><td data-sum="discount">−${money(o.discount)}</td></tr>`
      : Number(o.discount) ? `<tr><td colspan="3">Discount ${discountPercent(o)}%${o.coupon_code ? ` (${esc(o.coupon_code)})` : ''}</td><td data-sum="discount">−${money(o.discount)}</td></tr>` : ''}<tr class="grand"><td colspan="3">Total (cash on delivery)</td><td data-sum="total">${money(o.total)}</td></tr></tfoot></table>
    ${editing ? `<div class="price-edit-bar"><span>Change the prices or the discount %, then save. The discount is taken from the items (not delivery); the delivery fee stays the same.</span><button type="button" class="button" data-save-prices="${o.id}">Save</button><button type="button" class="button secondary-button" data-cancel-prices="${o.id}">Cancel</button></div>` : ''}
    <div class="order-actions">
      <a class="button whatsapp-action" target="_blank" rel="noopener" href="https://api.whatsapp.com/send?phone=${whatsappNumber(o.customer_phone)}&text=${encodeURIComponent(whatsappMessage(o))}">💬 Message on WhatsApp</a>
      ${!editing && items?.length ? `<button class="button secondary-button" type="button" data-edit-prices="${o.id}">✏️ Edit prices &amp; discount</button>` : ''}
      <button class="button secondary-button" type="button" data-print="${o.id}">🧾 Print invoice</button>
      <button class="button secondary-button" type="button" data-copy-link="${o.id}">🔗 Copy tracking link</button>
      ${canDelete && !editing ? `<button class="button delete-order-button" type="button" data-delete-order="${o.id}">🗑️ Delete order</button>` : ''}
    </div>
  </div>`;
}

function render() {
  renderTabs();
  const list = filtered();
  const revenue = list.filter((o) => o.status !== 'cancelled').reduce((s, o) => s + Number(o.total || 0), 0);
  $('#orders-summary').textContent = `${list.length} order${list.length === 1 ? '' : 's'} · ${money(revenue)} excluding cancelled`;
  const page = list.slice(0, visible);
  $('#orders-list').innerHTML = page.length ? page.map((o) => `<article class="order-card${expanded.has(o.id) ? ' open' : ''}" data-order="${o.id}">
    <div class="order-row">
      <button type="button" class="order-toggle" aria-expanded="${expanded.has(o.id)}" data-toggle="${o.id}"><span class="chev" aria-hidden="true">›</span><span><strong>${esc(o.order_number)}</strong><small>${new Date(o.created_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })}</small></span></button>
      <div class="order-customer"><strong>${esc(o.customer_name)}</strong><small>${esc(o.customer_phone)} · ${esc(o.city || o.governorate || '')}</small></div>
      <strong class="order-total">${money(o.total)}${o.coupon_code ? `<small class="order-coupon" title="Discount code">🏷️ ${esc(o.coupon_code)}</small>` : ''}</strong>
      <span class="status-pill status-${esc(o.status)}">${esc(LABELS[o.status] || o.status)}</span>
      <div class="order-status-edit">
        <label class="sr-only" for="status-${o.id}">Status for ${esc(o.order_number)}</label>
        <select id="status-${o.id}" class="admin-input" data-status="${o.id}">${STATUSES.map((s) => `<option value="${s}"${o.status === s ? ' selected' : ''}>${LABELS[s]}</option>`).join('')}</select>
        ${o.status === 'pending' ? `<button type="button" class="small-button" data-confirm="${o.id}">Confirm</button>` : ''}
      </div>
    </div>
    ${expanded.has(o.id) ? detailsHtml(o) : ''}
  </article>`).join('') : '<div class="empty-state"><h2>No orders match</h2><p>Try another status, search or date range.</p></div>';
  $('#load-more').hidden = list.length <= visible;
  for (const id of editingPrices) showEditedTotals(id);
}

async function loadItems(orderId: string) {
  if (itemsByOrder.has(orderId)) return;
  const r = await supabase.from('order_items').select('id,order_id,product_name,variant_name,sku,quantity,unit_price,total_price').eq('order_id', orderId).order('created_at');
  itemsByOrder.set(orderId, (r.data ?? []) as any[]);
}

/** The order's discount as a percentage of its subtotal ("10", "12.5"), for the discount field. */
function discountPercent(o: any) {
  const subtotal = Number(o.subtotal || 0), discount = Number(o.discount || 0);
  return subtotal > 0 && discount > 0 ? String(Math.round(discount / subtotal * 10000) / 100) : '0';
}
/** The order's totals with the prices and discount % typed in the open fields (same sums the database does). */
function editedTotals(o: any) {
  const inputs = [...document.querySelectorAll<HTMLInputElement>(`[data-price-order="${o.id}"]`)];
  const subtotal = inputs.reduce((sum, input) => sum + Math.round(Math.max(0, Number(input.value) || 0) * 100) / 100 * Number(input.dataset.qty || 0), 0);
  const discountInput = document.querySelector<HTMLInputElement>(`[data-discount-order="${o.id}"]`);
  const percent = Math.min(100, Math.max(0, Number(discountInput?.value) || 0));
  // An untouched discount on unchanged prices keeps its exact amount (no rounding to the percentage).
  const unchanged = !discountInput || (discountInput.value.trim() === discountInput.dataset.initial && Math.abs(subtotal - Number(o.subtotal || 0)) < 0.005);
  const wanted = unchanged ? Number(o.discount || 0) : Math.round(subtotal * percent) / 100;
  const discount = Math.min(wanted, subtotal);
  return { inputs, discountInput, subtotal, discount, total: Math.max(0, subtotal - discount) + Number(o.delivery_fee || 0) };
}
function showEditedTotals(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  const card = document.querySelector(`[data-order="${orderId}"]`);
  if (!o || !card) return;
  const t = editedTotals(o);
  for (const input of t.inputs) {
    const cell = card.querySelector(`[data-line-total="${input.dataset.priceItem}"]`);
    if (cell) cell.textContent = money((Math.max(0, Number(input.value) || 0)) * Number(input.dataset.qty || 0));
  }
  const set = (key: string, text: string) => { const el = card.querySelector(`[data-sum="${key}"]`); if (el) el.textContent = text; };
  set('subtotal', money(t.subtotal)); set('discount', `−${money(t.discount)}`); set('total', money(t.total));
}
async function savePrices(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  if (!o) return;
  const { inputs, discountInput, discount: discountAmount } = editedTotals(o);
  const prices: Record<string, number> = {};
  for (const input of inputs) {
    const value = Number(input.value);
    if (input.value.trim() === '' || !Number.isFinite(value) || value < 0) { input.focus(); toast('Enter a valid price (0 or more).', 'error'); return; }
    prices[input.dataset.priceItem!] = Math.round(value * 100) / 100;
  }
  let discount: number | null = null;
  if (discountInput) {
    const value = discountInput.value.trim() === '' ? 0 : Number(discountInput.value);
    if (!Number.isFinite(value) || value < 0 || value > 100) { discountInput.focus(); toast('Enter a discount between 0 and 100%.', 'error'); return; }
    discount = discountAmount;
  }
  const button = document.querySelector<HTMLButtonElement>(`[data-save-prices="${orderId}"]`);
  if (button) button.disabled = true;
  const r = await supabase.rpc('admin_set_order_prices', { p_order_id: orderId, p_prices: prices, p_discount: discount });
  if (r.error) {
    if (button) button.disabled = false;
    toast(/Could not find the function/i.test(r.error.message) ? 'Run supabase/order_price_edit.sql in Supabase first.' : `Could not save prices: ${r.error.message}`, 'error');
    return;
  }
  Object.assign(o, r.data);
  const items = itemsByOrder.get(orderId) ?? [];
  for (const item of items) if (item.id in prices) { item.unit_price = prices[item.id]; item.total_price = prices[item.id] * Number(item.quantity); draftPrices.delete(item.id); }
  editingPrices.delete(orderId);
  draftPrices.delete(`discount:${orderId}`);
  render();
  toast(`${o.order_number} saved. New total ${money(o.total)}.`);
}

async function deleteOrder(orderId: string) {
  const o = orders.find((x) => x.id === orderId);
  if (!o) return;
  const restock = ['pending', 'confirmed', 'processing'].includes(o.status);
  const ok = confirm(`Delete order ${o.order_number} (${o.customer_name}, ${money(o.total)})?\n\n${restock ? 'Its items go back into stock.' : `Stock does not change (the order is ${(LABELS[o.status] || o.status).toLowerCase()}).`}${o.coupon_code ? `\nThe discount code ${o.coupon_code} gets this use back.` : ''}\n\nThis cannot be undone.`);
  if (!ok) return;
  const r = await supabase.rpc('admin_delete_order', { p_order_id: orderId });
  if (r.error) { toast(/Could not find the function/i.test(r.error.message) ? 'Run supabase/order_delete.sql in Supabase first.' : `Could not delete: ${r.error.message}`, 'error'); return; }
  orders = orders.filter((x) => x.id !== orderId);
  expanded.delete(orderId); editingPrices.delete(orderId); itemsByOrder.delete(orderId);
  render();
  const back = Number((r.data as any)?.restocked || 0);
  toast(`${o.order_number} deleted.${back ? ` ${back} item${back === 1 ? '' : 's'} back in stock.` : ''}`);
}

async function setStatus(id: string, status: string) {
  const order = orders.find((o) => o.id === id);
  if (!order || order.status === status) return;
  const previous = order.status;
  order.status = status;
  render();
  const r = await supabase.from('orders').update({ status, updated_at: new Date().toISOString() }).eq('id', id);
  if (r.error) { order.status = previous; render(); toast(`Could not update ${order.order_number}: ${r.error.message}`, 'error'); return; }
  toast(`${order.order_number} marked ${LABELS[status]}.`);
}

function printInvoice(o: any) {
  const items = itemsByOrder.get(o.id) || [];
  const win = window.open('', '_blank', 'width=800,height=900');
  if (!win) { toast('Allow pop-ups to print invoices.', 'error'); return; }
  win.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${esc(o.order_number)}</title><style>body{font-family:system-ui,sans-serif;color:#1b1530;margin:40px}h1{margin:0}table{width:100%;border-collapse:collapse;margin-top:24px}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}td:last-child,th:last-child{text-align:right}.meta{display:flex;justify-content:space-between;gap:24px;margin-top:24px}.total td{font-weight:800;font-size:1.1em}small{color:#666}.order-coupon{display:block;color:var(--success);font-size:.72rem;font-weight:800}
</style></head><body>
    <h1>Clever Toys</h1><small>Invoice · Cash on delivery</small>
    <div class="meta"><div><strong>Bill to</strong><br>${esc(o.customer_name)}<br>${esc(o.customer_phone)}<br>${esc([o.governorate, o.city, o.area].filter(Boolean).join(', '))}<br>${esc(o.address)}</div><div><strong>Order ${esc(o.order_number)}</strong><br>${new Date(o.created_at).toLocaleString()}<br>Status: ${esc(LABELS[o.status] || o.status)}</div></div>
    <table><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>${items.map((i) => `<tr><td>${esc(i.product_name)}${i.variant_name ? ` · ${esc(i.variant_name)}` : ''}</td><td>${Number(i.quantity)}</td><td>${money(i.unit_price)}</td><td>${money(i.total_price)}</td></tr>`).join('')}</tbody>
    <tfoot><tr><td colspan="3">Subtotal</td><td>${money(o.subtotal)}</td></tr><tr><td colspan="3">Delivery</td><td>${Number(o.delivery_fee) ? money(o.delivery_fee) : 'Free'}</td></tr>${Number(o.discount) ? `<tr><td colspan="3">Discount${o.coupon_code ? ` (${esc(o.coupon_code)})` : ''}</td><td>−${money(o.discount)}</td></tr>` : ''}<tr class="total"><td colspan="3">Total due on delivery</td><td>${money(o.total)}</td></tr></tfoot></table>
    ${o.notes ? `<p><strong>Notes:</strong> ${esc(o.notes)}</p>` : ''}<p><small>Thank you for shopping with Clever Toys!</small></p></body></html>`);
  win.document.close();
  win.focus();
  win.print();
}

/** The orders on screen (status, dates and search applied) with their items, as an Excel file. */
async function exportExcel() {
  const rows = filtered();
  if (!rows.length) { toast('No orders to export with these filters.', 'error'); return; }
  const button = $<HTMLButtonElement>('#export-xlsx');
  button.disabled = true;
  try {
    const items: any[] = [];
    const ids = rows.map((o) => o.id);
    for (let i = 0; i < ids.length; i += 150) {
      const r = await supabase.from('order_items').select('order_id,product_name,variant_name,sku,quantity,unit_price,total_price').in('order_id', ids.slice(i, i + 150));
      if (r.error) throw new Error(r.error.message);
      items.push(...(r.data ?? []));
    }
    const byOrder = new Map<string, any[]>();
    for (const it of items) { const list = byOrder.get(it.order_id) || []; list.push(it); byOrder.set(it.order_id, list); }
    const number = new Map(rows.map((o) => [o.id, o.order_number]));
    const n = (v: unknown) => (v === null || v === undefined || v === '' ? null : Number(v));
    const date = (v: string) => new Date(v).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
    await exportXlsxSheets(exportName('orders'), [
      {
        name: 'Orders',
        columns: [{ header: 'Order', width: 22 }, { header: 'Date', width: 20 }, { header: 'Status', width: 12 }, { header: 'Customer', width: 22 }, { header: 'Phone', width: 18 }, { header: 'Email', width: 26 }, { header: 'Governorate', width: 16 }, { header: 'City', width: 16 }, { header: 'Area', width: 16 }, { header: 'Address', width: 34 }, { header: 'Items', width: 50 }, { header: 'Subtotal' }, { header: 'Delivery' }, { header: 'Discount' }, { header: 'Discount code' }, { header: 'Total' }, { header: 'Notes', width: 34 }],
        rows: rows.map((o) => [o.order_number, date(o.created_at), o.status, o.customer_name, o.customer_phone, o.customer_email, o.governorate, o.city, o.area, o.address,
          (byOrder.get(o.id) || []).map((it) => `${it.quantity}× ${it.product_name}${it.variant_name ? ` (${it.variant_name})` : ''}`).join('; '),
          n(o.subtotal), n(o.delivery_fee), n(o.discount), o.coupon_code, n(o.total), o.notes])
      },
      {
        name: 'Items',
        columns: [{ header: 'Order', width: 22 }, { header: 'Product', width: 32 }, { header: 'Option', width: 18 }, { header: 'SKU' }, { header: 'Quantity', width: 10 }, { header: 'Unit price' }, { header: 'Line total' }],
        rows: items.sort((a, b) => String(number.get(a.order_id)).localeCompare(String(number.get(b.order_id)))).map((it) => [number.get(it.order_id), it.product_name, it.variant_name, it.sku, n(it.quantity), n(it.unit_price), n(it.total_price)])
      }
    ]);
    toast(`Exported ${rows.length} orders and ${items.length} items.`);
  } catch (error) {
    toast(error instanceof Error ? error.message : 'Export failed.', 'error');
  } finally {
    button.disabled = false;
  }
}

async function load() {
  const r = await supabase.from('orders').select('*').order('created_at', { ascending: false }).limit(1000);
  if (r.error) throw new Error(r.error.message);
  orders = (r.data ?? []) as any[];
  render();
}

document.addEventListener('click', async (event) => {
  const target = event.target instanceof Element ? event.target : null;
  const tab = target?.closest<HTMLElement>('[data-status-tab]');
  if (tab) { statusFilter = tab.dataset.statusTab || 'all'; visible = PAGE_SIZE; const u = new URL(location.href); if (statusFilter === 'all') u.searchParams.delete('status'); else u.searchParams.set('status', statusFilter); history.replaceState(null, '', u); render(); return; }
  const toggle = target?.closest<HTMLElement>('[data-toggle]');
  if (toggle) { const id = toggle.dataset.toggle!; if (expanded.has(id)) expanded.delete(id); else { expanded.add(id); render(); await loadItems(id); } render(); return; }
  const confirmBtn = target?.closest<HTMLElement>('[data-confirm]');
  if (confirmBtn) { await setStatus(confirmBtn.dataset.confirm!, 'confirmed'); return; }
  const editPrices = target?.closest<HTMLElement>('[data-edit-prices]');
  if (editPrices) { editingPrices.add(editPrices.dataset.editPrices!); render(); document.querySelector<HTMLInputElement>(`[data-price-order="${editPrices.dataset.editPrices}"]`)?.focus(); return; }
  const cancelPrices = target?.closest<HTMLElement>('[data-cancel-prices]');
  if (cancelPrices) { const id = cancelPrices.dataset.cancelPrices!; editingPrices.delete(id); for (const item of itemsByOrder.get(id) ?? []) draftPrices.delete(item.id); draftPrices.delete(`discount:${id}`); render(); return; }
  const savePricesBtn = target?.closest<HTMLElement>('[data-save-prices]');
  if (savePricesBtn) { await savePrices(savePricesBtn.dataset.savePrices!); return; }
  const del = target?.closest<HTMLElement>('[data-delete-order]');
  if (del) { await deleteOrder(del.dataset.deleteOrder!); return; }
  const print = target?.closest<HTMLElement>('[data-print]');
  if (print) { const o = orders.find((x) => x.id === print.dataset.print); if (o) { await loadItems(o.id); printInvoice(o); } return; }
  const copy = target?.closest<HTMLElement>('[data-copy-link]');
  if (copy) { const o = orders.find((x) => x.id === copy.dataset.copyLink); if (o) { try { await navigator.clipboard.writeText(trackingLink(o)); toast('Tracking link copied.'); } catch { toast(trackingLink(o)); } } }
});
document.addEventListener('change', (event) => {
  const select = event.target instanceof HTMLSelectElement && event.target.dataset.status ? event.target : null;
  if (select) setStatus(select.dataset.status!, select.value);
});
document.addEventListener('input', (event) => {
  const input = event.target instanceof HTMLInputElement && event.target.dataset.priceOrder ? event.target : null;
  if (input) { draftPrices.set(input.dataset.priceItem!, input.value); showEditedTotals(input.dataset.priceOrder!); }
  const discountInput = event.target instanceof HTMLInputElement && event.target.dataset.discountOrder ? event.target : null;
  if (discountInput) { draftPrices.set(`discount:${discountInput.dataset.discountOrder}`, discountInput.value); showEditedTotals(discountInput.dataset.discountOrder!); }
});
document.addEventListener('keydown', (event) => {
  const input = event.target instanceof HTMLInputElement ? event.target : null;
  const orderId = input?.dataset.priceOrder || input?.dataset.discountOrder;
  if (orderId && event.key === 'Enter') { event.preventDefault(); savePrices(orderId); }
});
['#order-search', '#date-from', '#date-to', '#order-sort'].forEach((sel) => $(sel).addEventListener('input', () => { visible = PAGE_SIZE; render(); }));
$('#load-more').addEventListener('click', () => { visible += PAGE_SIZE; render(); });
$('#export-xlsx').addEventListener('click', exportExcel);
$('#refresh').addEventListener('click', async () => { itemsByOrder.clear(); await load(); markOrdersSeen(); toast('Orders refreshed.'); });
// Browser pop-ups for new orders (while any admin page is open). The badge and sound work without this.
const alertsButton = $<HTMLButtonElement>('#enable-alerts');
if ('Notification' in window && Notification.permission === 'granted') alertsButton.textContent = '🔔 Alerts on';
alertsButton.addEventListener('click', async () => {
  const ok = await enableOrderNotifications();
  alertsButton.textContent = ok ? '🔔 Alerts on' : '🔔 Order alerts';
  toast(ok ? 'You will get a pop-up here when a new order arrives.' : 'Your browser blocked notifications. Allow them in the site settings.', ok ? 'success' : 'error');
});

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#auth-config');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = `/login?next=${encodeURIComponent('/admin/orders')}`; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><a class="button" href="/">Back to store</a>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'orders', 'Orders'))) return;
    const can = await supabase.rpc('admin_can_delete_orders');
    canDelete = !can.error && can.data === true;
    guard.hidden = true;
    $('#orders-app').hidden = false;
    await load();
    markOrdersSeen();
  } catch (error) {
    guard.hidden = false;
    guard.textContent = error instanceof Error ? error.message : 'Could not load orders.';
  }
}
init();
</script>

