---
/**
 * Admin → Team: list, add and remove admin accounts. Needs supabase/accounts_and_admins.sql.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Team | Clever Toys Admin</title>
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Access</p>
        <h1>Team</h1>
        <p>Choose who can open this admin panel, and what each person can do.</p>
      </div>
    </div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>

    <div id="app" hidden>
      <div id="setup-notice" class="acc-notice" hidden>
        Team management needs one database update. In Supabase, open <strong>SQL Editor</strong>, paste the contents of <code>supabase/accounts_and_admins.sql</code> and press <strong>Run</strong>. Then reload this page.
      </div>

      <div class="team-layout">
        <section class="admin-panel" aria-labelledby="add-title">
          <h2 id="add-title">Add an admin</h2>
          <ol class="team-steps">
            <li>Ask the person to <a href="/register" target="_blank" rel="noopener">create an account</a> on the store and confirm their email.</li>
            <li>Enter the email they signed up with below.</li>
            <li>They sign out and back in, and the admin panel opens for them.</li>
          </ol>
          <form id="add-form" class="team-form">
            <label for="add-email" class="acc-label">Account email</label>
            <div class="team-form-row">
              <input id="add-email" class="admin-input" type="email" required autocomplete="off" placeholder="name@example.com" />
            </div>
            <label for="add-role" class="acc-label">Role</label>
            <div class="team-form-row">
              <select id="add-role" class="admin-input">
                <option value="manager">Manager: everything except the team and backups</option>
                <option value="orders">Orders staff: orders and customers only</option>
                <option value="content">Content editor: products, pages, banners, discount codes, SEO, reviews</option>
                <option value="owner">Owner: everything, including the team</option>
              </select>
              <button id="add-button" class="button" type="submit">Add to team</button>
            </div>
            <p id="add-message" class="team-message" role="status"></p>
          </form>
          <div class="team-roles">
            <h3>What each role can do</h3>
            <table class="team-role-table">
              <thead><tr><th></th><th>Owner</th><th><span class="role-full">Manager</span><abbr class="role-short" title="Manager">Mgr.</abbr></th><th>Orders</th><th>Content</th></tr></thead>
              <tbody>
                <tr><th>Orders, customers</th><td>✓</td><td>✓</td><td>✓</td><td></td></tr>
                <tr><th>Products, reviews</th><td>✓</td><td>✓</td><td></td><td>✓</td></tr>
                <tr><th>Pages, banners, menus, SEO</th><td>✓</td><td>✓</td><td></td><td>✓</td></tr>
                <tr><th>Discount codes</th><td>✓</td><td>✓</td><td></td><td>✓</td></tr>
                <tr><th>Delivery fees, settings</th><td>✓</td><td>✓</td><td></td><td></td></tr>
                <tr><th>Accounting, visitors, activity log</th><td>✓</td><td>✓</td><td></td><td></td></tr>
                <tr><th>Team, backups</th><td>✓</td><td></td><td></td><td></td></tr>
              </tbody>
            </table>
          </div>
          <p class="team-warning">Only add people you trust. The database enforces these roles, so staff cannot get around them.</p>
        </section>

        <section class="admin-panel" aria-labelledby="list-title">
          <div class="team-list-head"><h2 id="list-title">Current admins</h2><span id="admin-count" class="chip"></span></div>
          <div id="admin-list" class="team-list"></div>
        </section>
      </div>
    </div>
  </div>
</main>

<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { allowPage } from '../../scripts/admin-access';

type Admin = { user_id: string; email: string; role?: string; added_at: string | null; last_sign_in_at: string | null; is_you: boolean };
const ROLES: Record<string, string> = { owner: 'Owner', manager: 'Manager', orders: 'Orders staff', content: 'Content editor' };
// Roles need supabase/cms.sql; before that every admin has full access.
let rolesReady = true;
const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const toast = (message: string, tone = 'success') => (window as any).adminToast?.(message, tone);
const when = (v: string | null) => v ? new Date(v).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Never';
// PostgREST reports a missing function as PGRST202 (or 42883 from Postgres).
const missingFunction = (error: { code?: string; message?: string } | null) => Boolean(error && (error.code === 'PGRST202' || error.code === '42883' || /could not find the function/i.test(error.message || '')));

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let admins: Admin[] = [];

function render() {
  $('#admin-count').textContent = `${admins.length} ${admins.length === 1 ? 'admin' : 'admins'}`;
  $('#admin-list').innerHTML = admins.map((a) => `
    <div class="team-row">
      <span class="team-avatar" aria-hidden="true">${esc((a.email || '?').charAt(0).toUpperCase())}</span>
      <div class="team-info">
        <strong>${esc(a.email)}${a.is_you ? ' <span class="team-you">You</span>' : ''}</strong>
        <small>Admin since ${esc(when(a.added_at))} · Last sign-in ${esc(when(a.last_sign_in_at))}</small>
      </div>
      ${rolesReady && a.role ? `<label class="sr-only" for="role-${esc(a.user_id)}">Role for ${esc(a.email)}</label><select id="role-${esc(a.user_id)}" class="admin-input team-role-select" data-role-for="${esc(a.user_id)}" data-email="${esc(a.email)}"${a.is_you ? ' disabled title="Ask another owner to change your role"' : ''}>${Object.entries(ROLES).map(([value, label]) => `<option value="${value}"${a.role === value ? ' selected' : ''}>${label}</option>`).join('')}</select>` : ''}
      ${a.is_you || admins.length <= 1 ? '' : `<button type="button" class="small-button danger-button" data-remove="${esc(a.user_id)}" data-email="${esc(a.email)}">Remove</button>`}
    </div>`).join('') || '<p class="muted">No admins found.</p>';
  document.querySelectorAll<HTMLSelectElement>('[data-role-for]').forEach((select) => {
    select.onchange = async () => {
      const previous = admins.find((a) => a.user_id === select.dataset.roleFor)?.role || '';
      select.disabled = true;
      const { error } = await supabase.rpc('admin_set_role', { p_user_id: select.dataset.roleFor, p_role: select.value });
      select.disabled = false;
      if (error) { select.value = previous; toast(error.message, 'error'); return; }
      toast(`${select.dataset.email} is now ${ROLES[select.value]}. They see the change on their next page load.`);
      await load();
    };
  });
  document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => {
    button.onclick = () => remove(button.dataset.remove || '', button.dataset.email || '', button);
  });
}

async function load() {
  const { data, error } = await supabase.rpc('admin_list_admins');
  if (missingFunction(error)) {
    $('#setup-notice').hidden = false;
    $<HTMLButtonElement>('#add-button').disabled = true;
    $('#admin-list').innerHTML = '<p class="muted">The admin list appears here after the database update.</p>';
    return;
  }
  if (error) throw new Error(error.message);
  admins = (data as Admin[]) || [];
  rolesReady = admins.some((a) => typeof a.role === 'string');
  $<HTMLSelectElement>('#add-role').disabled = !rolesReady;
  render();
}

async function remove(userId: string, email: string, button: HTMLButtonElement) {
  if (!userId || !confirm(`Remove admin access for ${email}? Their customer account stays active.`)) return;
  button.disabled = true;
  const { error } = await supabase.rpc('admin_remove_admin', { p_user_id: userId });
  if (error) { button.disabled = false; toast(error.message, 'error'); return; }
  toast(`${email} is no longer an admin.`);
  await load();
}

$('#add-form').addEventListener('submit', async (event) => {
  event.preventDefault();
  const input = $<HTMLInputElement>('#add-email');
  const button = $<HTMLButtonElement>('#add-button');
  const message = $('#add-message');
  const email = input.value.trim();
  if (!email) return;
  button.disabled = true;
  message.textContent = 'Adding…';
  let { data, error } = await supabase.rpc('admin_add_admin', rolesReady ? { p_email: email, p_role: $<HTMLSelectElement>('#add-role').value } : { p_email: email });
  // Older database without roles: add with full access.
  if (missingFunction(error)) ({ data, error } = await supabase.rpc('admin_add_admin', { p_email: email }));
  button.disabled = false;
  if (error) { message.textContent = error.message; toast('Could not add admin.', 'error'); return; }
  if (data === 'already_admin') { message.textContent = `${email} is already an admin.`; return; }
  message.textContent = `${email} is now on the team${rolesReady ? ` as ${ROLES[$<HTMLSelectElement>('#add-role').value]}` : ''}. They need to sign out and back in.`;
  toast(`${email} added as admin.`);
  input.value = '';
  await load();
});

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#auth-config');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = `/login?next=${encodeURIComponent('/admin/team')}`; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><a class="button" href="/">Back to store</a>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'team', 'Team'))) return;
    guard.hidden = true;
    $('#app').hidden = false;
    await load();
  } catch (error) {
    guard.hidden = false;
    guard.innerHTML = `<h2>Team could not load</h2><p>${esc(error instanceof Error ? error.message : 'Unknown error')}</p>`;
  }
}
init();
</script>

<style is:global>
.acc-notice{margin-bottom:16px;padding:14px 16px;border:1.5px solid #f0b429;border-radius:14px;background:#fff9e8;color:#6b4a00;font-weight:600}
.acc-notice code{padding:1px 6px;border-radius:6px;background:rgba(0,0,0,.06)}
.acc-label{color:var(--muted);font-size:.75rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
.team-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:18px;align-items:start}
.team-layout h2{margin:0 0 12px;font-size:1.15rem}
.team-steps{margin:0 0 18px;padding-left:20px;display:grid;gap:6px;color:var(--muted);line-height:1.5}
.team-form{display:grid;gap:8px}
.team-form-row{display:flex;gap:10px;flex-wrap:wrap}
.team-form-row .admin-input{flex:1 1 220px;min-width:0;max-width:100%}
.team-form>*{min-width:0}
.team-message{margin:0;min-height:1.4em;font-weight:700}
.team-roles{margin-top:18px}
.team-roles h3{margin:0 0 8px;font-size:.95rem}
.team-role-table{width:100%;min-width:0;border-collapse:collapse;font-size:.84rem;table-layout:fixed}
.team-role-table th{background:none;letter-spacing:0;text-transform:none;font-size:.78rem}
.team-role-table thead th:first-child{width:38%}
.team-role-table tbody th{overflow-wrap:anywhere}
.team-role-table thead th{font-size:.7rem;padding:6px 2px}
.role-short{display:none;text-decoration:none}
@media(max-width:480px){.team-role-table thead th:first-child{width:32%}.role-full{display:none}.role-short{display:inline}}
.team-role-table th,.team-role-table td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:center}
.team-role-table tbody th{text-align:left;font-weight:600;color:var(--muted)}
.team-role-table td{color:var(--success);font-weight:900}
.team-role-select{width:auto;min-width:150px}
.team-warning{margin:14px 0 0;padding:12px 14px;border-radius:12px;background:var(--surface-2);color:var(--muted);font-size:.88rem;line-height:1.5}
.team-list-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}
.team-list-head h2{margin:0}
.team-list{display:grid}
.team-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--line)}
.team-row:first-child{border-top:0}
.team-avatar{flex:0 0 40px;height:40px;display:grid;place-items:center;border-radius:50%;background:var(--brand-gradient,var(--brand-primary));color:#fff;font-weight:900}
.team-info{flex:1;min-width:0;display:grid;gap:2px}
.team-info strong{overflow-wrap:anywhere}
.team-info small{color:var(--muted)}
.team-you{margin-left:6px;padding:1px 8px;border-radius:99px;background:var(--brand-soft);color:var(--primary-strong);font-size:.72rem}
@media(max-width:860px){.team-layout{grid-template-columns:minmax(0,1fr)}.team-row{flex-wrap:wrap}.team-role-select{flex:1 1 100%}}
.team-layout>*{min-width:0}
.team-roles{overflow-x:auto}
</style>
