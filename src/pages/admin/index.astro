---
import '../../styles/global.css';
---
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/">Store</a><a href="/products">Products</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><h1>Admin Dashboard</h1><p>Manage products, categories and inventory.</p></div><button id="logout" class="button secondary-button">Sign Out</button></div><div id="guard" class="empty-state">Checking admin access…</div><div id="admin-app" hidden><div class="admin-tabs"><button class="tab active" data-tab="products">Products</button><button class="tab" data-tab="categories">Categories</button></div><section id="products-tab" class="admin-panel"><div class="admin-grid"><form id="product-form" class="form-card"><h2 id="product-form-title">Add Product</h2><input type="hidden" name="id"><label>Product name<input name="name" required></label><label>Slug<input name="slug" required placeholder="toy-name"></label><label>SKU<input name="sku"></label><label>Category<select name="category_id" id="category-select"><option value="">No category</option></select></label><label>Price (USD)<input name="price" type="number" step="0.01" min="0" required></label><label>Sale price<input name="sale_price" type="number" step="0.01" min="0"></label><label>Stock quantity<input name="stock_quantity" type="number" min="0" value="0" required></label><label>Age minimum<input name="age_min" type="number" min="0"></label><label>Age maximum<input name="age_max" type="number" min="0"></label><label>Short description<textarea name="short_description" rows="2"></textarea></label><label>Description<textarea name="description" rows="5"></textarea></label><label>Primary image<input id="image-file" type="file" accept="image/jpeg,image/png,image/webp"></label><label class="check"><input name="is_featured" type="checkbox"> Featured product</label><label class="check"><input name="is_active" type="checkbox" checked> Active</label><div class="form-actions"><button class="button" type="submit">Save Product</button><button id="cancel-edit" class="button secondary-button" type="button">Clear</button></div><p id="product-message"></p></form><div><div class="panel-title"><h2>Products</h2><input id="product-search" placeholder="Search products…"></div><div id="product-list" class="admin-list"></div></div></div></section><section id="categories-tab" class="admin-panel" hidden><div class="admin-grid"><form id="category-form" class="form-card"><h2>Add Category</h2><label>Name<input name="name" required></label><label>Slug<input name="slug" required></label><label>Description<textarea name="description" rows="3"></textarea></label><button class="button" type="submit">Add Category</button><p id="category-message"></p></form><div><h2>Categories</h2><div id="category-list" class="admin-list"></div></div></div></section></div></div></main>
<script>
import { supabase } from '../../lib/supabase';
const guard=document.querySelector('#guard');const app=document.querySelector('#admin-app');const productForm=document.querySelector('#product-form');const productMessage=document.querySelector('#product-message');const categoryMessage=document.querySelector('#category-message');const productList=document.querySelector('#product-list');const categoryList=document.querySelector('#category-list');const categorySelect=document.querySelector('#category-select');let categories=[];let products=[];
const slugify=s=>String(s).toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
async function load(){const [c,p]=await Promise.all([supabase.from('categories').select('*').order('sort_order').order('name'),supabase.from('products').select('*').order('created_at',{ascending:false})]);if(c.error||p.error){guard.textContent=(c.error||p.error).message;return;}categories=c.data||[];products=p.data||[];categorySelect.innerHTML='<option value="">No category</option>'+categories.map(x=>`<option value="${x.id}">${x.name}</option>`).join('');renderProducts();renderCategories();}
function renderProducts(){const q=(document.querySelector('#product-search').value||'').toLowerCase();const list=products.filter(p=>p.name.toLowerCase().includes(q)||String(p.sku||'').toLowerCase().includes(q));productList.innerHTML=list.length?list.map(p=>`<div class="admin-item"><div><strong>${p.name}</strong><small>${p.sku||'No SKU'} · $${Number(p.sale_price??p.price).toFixed(2)} · stock ${p.stock_quantity}</small></div><div class="item-actions"><button class="small-button" data-edit="${p.id}">Edit</button><button class="small-button danger-button" data-delete="${p.id}">Delete</button></div></div>`).join(''):'<p>No products found.</p>';productList.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editProduct(b.dataset.edit));productList.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>deleteProduct(b.dataset.delete));}
function renderCategories(){categoryList.innerHTML=categories.length?categories.map(c=>`<div class="admin-item"><div><strong>${c.name}</strong><small>/${c.slug}</small></div><button class="small-button danger-button" data-cat-delete="${c.id}">Delete</button></div>`).join(''):'<p>No categories.</p>';categoryList.querySelectorAll('[data-cat-delete]').forEach(b=>b.onclick=()=>deleteCategory(b.dataset.catDelete));}
function editProduct(id){const p=products.find(x=>x.id===id);if(!p)return;for(const [k,v] of Object.entries(p)){const el=productForm.elements.namedItem(k);if(!el)continue;if(el.type==='checkbox')el.checked=Boolean(v);else if(k==='category_id')el.value=v||'';else el.value=v??'';}document.querySelector('#product-form-title').textContent='Edit Product';window.scrollTo({top:0,behavior:'smooth'});}
async function deleteProduct(id){if(!confirm('Delete this product?'))return;const {error}=await supabase.from('products').delete().eq('id',id);if(error)alert(error.message);else await load();}
async function deleteCategory(id){if(!confirm('Delete this category? Products will keep their records with no category.'))return;const {error}=await supabase.from('categories').delete().eq('id',id);if(error)alert(error.message);else await load();}
async function webp(file){const bitmap=await createImageBitmap(file);const max=1800;const scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement('canvas');canvas.width=Math.round(bitmap.width*scale);canvas.height=Math.round(bitmap.height*scale);canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);return await new Promise(r=>canvas.toBlob(r,'image/webp',0.82));}
productForm.addEventListener('submit',async e=>{e.preventDefault();productMessage.textContent='Saving…';const fd=new FormData(productForm);const id=String(fd.get('id')||'');const name=String(fd.get('name'));const data={name,slug:String(fd.get('slug')||slugify(name)),sku:String(fd.get('sku')||'')||null,category_id:String(fd.get('category_id')||'')||null,price:Number(fd.get('price')||0),sale_price:fd.get('sale_price')?Number(fd.get('sale_price')):null,stock_quantity:Number(fd.get('stock_quantity')||0),age_min:fd.get('age_min')?Number(fd.get('age_min')):null,age_max:fd.get('age_max')?Number(fd.get('age_max')):null,short_description:String(fd.get('short_description')||''),description:String(fd.get('description')||''),is_featured:fd.get('is_featured')==='on',is_active:fd.get('is_active')==='on',updated_at:new Date().toISOString()};let result=id?await supabase.from('products').update(data).eq('id',id).select().single():await supabase.from('products').insert(data).select().single();if(result.error){productMessage.textContent=result.error.message;return;}const file=document.querySelector('#image-file').files?.[0];if(file){const blob=await webp(file);const path=`${result.data.id}/${Date.now()}.webp`;const up=await supabase.storage.from('product-images').upload(path,blob,{contentType:'image/webp',upsert:true});if(up.error){productMessage.textContent=up.error.message;return;}const {data:url}=supabase.storage.from('product-images').getPublicUrl(path);await supabase.from('products').update({primary_image_url:url.publicUrl}).eq('id',result.data.id);}productMessage.textContent='Saved successfully.';clearForm();await load();});
function clearForm(){productForm.reset();productForm.elements.namedItem('id').value='';productForm.elements.namedItem('is_active').checked=true;document.querySelector('#product-form-title').textContent='Add Product';}
document.querySelector('#cancel-edit').onclick=clearForm;document.querySelector('#product-search').oninput=renderProducts;document.querySelector('#logout').onclick=async()=>{await supabase.auth.signOut();location.href='/login';};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.admin-panel').forEach(x=>x.hidden=true);document.querySelector(`#${b.dataset.tab}-tab`).hidden=false;});
const {data:{user}}=await supabase.auth.getUser();if(!user){location.href='/login';}else{const {data:isAdmin,error}=await supabase.rpc('is_admin');if(error||!isAdmin){guard.innerHTML='<h2>Access denied</h2><p>This account is not an administrator.</p><a class="button" href="/">Back to store</a>';}else{guard.hidden=true;app.hidden=false;await load();}}
</script>