---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';

const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/admin" class="logo">Clever Toys Admin</a>
    <nav class="main-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/orders">Orders</a>
      <a href="/">Store</a>
    </nav>
  </div>
</header>

<main class="section">
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Store management</p>
        <h1>Products &amp; Categories</h1>
        <p>Add products, images, variants and inventory, or import products from Excel.</p>
      </div>
      <button id="logout" class="button secondary-button" type="button">Sign Out</button>
    </div>

    <div id="admin-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>
    <div id="admin-error" class="empty-state" hidden></div>

    <div id="admin-app" hidden>
      <section class="import-card">
        <div>
          <h2>Excel import</h2>
          <p>Columns: name, slug, sku, category, price, sale_price, stock_quantity, age_min, age_max, brand, short_description, description, primary_image_url, image_1, image_2, image_3, seo_title, seo_description, is_active, is_featured.</p>
          <small>For local image files, import the product first, then upload images in its editor.</small>
        </div>
        <div class="import-actions">
          <input id="excel-file" type="file" accept=".xlsx,.xls,.csv" />
          <button id="import-btn" class="button" type="button">Import Excel</button>
        </div>
        <p id="import-message"></p>
      </section>

      <div class="admin-tabs">
        <button class="tab active" data-tab="products" type="button">Products</button>
        <button class="tab" data-tab="categories" type="button">Categories</button>
      </div>

      <section id="products-tab" class="admin-panel">
        <div class="admin-grid">
          <form id="product-form" class="form-card">
            <h2 id="product-form-title">Add Product</h2>
            <input type="hidden" name="id" />
            <label>Product name<input name="name" required /></label>
            <label>Slug<input name="slug" required placeholder="toy-name" /></label>
            <label>SKU<input name="sku" /></label>
            <label>Category<select name="category_id" id="category-select"><option value="">No category</option></select></label>
            <label>Price (USD)<input name="price" type="number" step="0.01" min="0" required /></label>
            <label>Sale price<input name="sale_price" type="number" step="0.01" min="0" /></label>
            <label>Stock quantity<input name="stock_quantity" type="number" min="0" value="0" required /></label>

            <div class="variant-box">
              <div class="panel-title">
                <h3>Variants</h3>
                <button id="add-variant" class="small-button" type="button">+ Add variant</button>
              </div>
              <div id="variant-list"></div>
              <small>Use variants for size, color, model or pack size.</small>
            </div>

            <label>Age minimum<input name="age_min" type="number" min="0" /></label>
            <label>Age maximum<input name="age_max" type="number" min="0" /></label>
            <label>Brand<input name="brand" /></label>
            <label>Short description<textarea name="short_description" rows="2"></textarea></label>
            <label>Description<textarea name="description" rows="5"></textarea></label>
            <label>Product images<input id="image-files" type="file" accept="image/jpeg,image/png,image/webp" multiple /></label>
            <label class="check"><input name="is_featured" type="checkbox" /> Featured product</label>
            <label class="check"><input name="is_active" type="checkbox" checked /> Active</label>
            <div class="form-actions">
              <button class="button" type="submit">Save Product</button>
              <button id="cancel-edit" class="button secondary-button" type="button">Clear</button>
            </div>
            <p id="product-message"></p>
          </form>

          <div>
            <div class="panel-title">
              <h2>Products</h2>
              <input id="product-search" placeholder="Search products…" />
            </div>
            <div id="product-list" class="admin-list"></div>
          </div>
        </div>
      </section>

      <section id="categories-tab" class="admin-panel" hidden>
        <div class="admin-grid">
          <form id="category-form" class="form-card">
            <h2>Add Category</h2>
            <label>Name<input name="name" required /></label>
            <label>Slug<input name="slug" required /></label>
            <label>Description<textarea name="description" rows="3"></textarea></label>
            <button class="button" type="submit">Add Category</button>
            <p id="category-message"></p>
          </form>
          <div>
            <h2>Categories</h2>
            <div id="category-list" class="admin-list"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>

<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
  import { createClient } from '@supabase/supabase-js';

  const config = document.querySelector('#admin-config');
  const url = config?.dataset.url;
  const key = config?.dataset.key;
  const guard = document.querySelector('#guard');
  const app = document.querySelector('#admin-app');
  const adminError = document.querySelector('#admin-error');
  const productForm = document.querySelector('#product-form');
  const productMessage = document.querySelector('#product-message');
  const categoryMessage = document.querySelector('#category-message');
  const productList = document.querySelector('#product-list');
  const categoryList = document.querySelector('#category-list');
  const categorySelect = document.querySelector('#category-select');
  let supabase;
  let categories = [];
  let products = [];
  let variants = [];

  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const slugify = (value) => String(value || '').toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');

  function showError(message) {
    guard.hidden = true;
    app.hidden = true;
    adminError.hidden = false;
    adminError.innerHTML = `<h2>Admin access could not be verified</h2><p>${esc(message)}</p><button class="button" id="retry-admin" type="button">Try again</button>`;
    document.querySelector('#retry-admin').onclick = () => location.reload();
  }

  async function withTimeout(promise, ms = 12000) {
    return Promise.race([
      promise,
      new Promise((_, reject) => setTimeout(() => reject(new Error('Supabase did not respond within 12 seconds.')), ms))
    ]);
  }

  async function load() {
    const [c, p] = await Promise.all([
      supabase.from('categories').select('*').order('sort_order').order('name'),
      supabase.from('products').select('*').order('created_at', { ascending: false })
    ]);
    if (c.error || p.error) throw new Error((c.error || p.error).message);
    categories = c.data || [];
    products = p.data || [];
    categorySelect.innerHTML = '<option value="">No category</option>' + categories.map((x) => `<option value="${x.id}">${esc(x.name)}</option>`).join('');
    renderProducts();
    renderCategories();
  }

  function renderProducts() {
    const q = (document.querySelector('#product-search').value || '').toLowerCase();
    const list = products.filter((p) => p.name.toLowerCase().includes(q) || String(p.sku || '').toLowerCase().includes(q));
    productList.innerHTML = list.length ? list.map((p) => `<div class="admin-item"><div><strong>${esc(p.name)}</strong><small>${esc(p.sku || 'No SKU')} · $${Number(p.sale_price ?? p.price).toFixed(2)} · stock ${p.stock_quantity} ${p.is_active ? '' : '· inactive'}</small></div><div class="item-actions"><button class="small-button" data-edit="${p.id}" type="button">Edit</button><button class="small-button danger-button" data-delete="${p.id}" type="button">Delete</button></div></div>`).join('') : '<p>No products found.</p>';
    productList.querySelectorAll('[data-edit]').forEach((b) => b.onclick = () => editProduct(b.dataset.edit));
    productList.querySelectorAll('[data-delete]').forEach((b) => b.onclick = () => deleteProduct(b.dataset.delete));
  }

  function renderCategories() {
    categoryList.innerHTML = categories.length ? categories.map((c) => `<div class="admin-item"><div><strong>${esc(c.name)}</strong><small>/${esc(c.slug)}</small></div><button class="small-button danger-button" data-cat-delete="${c.id}" type="button">Delete</button></div>`).join('') : '<p>No categories.</p>';
    categoryList.querySelectorAll('[data-cat-delete]').forEach((b) => b.onclick = () => deleteCategory(b.dataset.catDelete));
  }

  async function editProduct(id) {
    const p = products.find((x) => x.id === id);
    if (!p) return;
    for (const [k, v] of Object.entries(p)) {
      const el = productForm.elements.namedItem(k);
      if (!el) continue;
      if (el.type === 'checkbox') el.checked = Boolean(v); else el.value = v ?? '';
    }
    productForm.elements.namedItem('category_id').value = p.category_id || '';
    productForm.elements.namedItem('id').value = p.id;
    const r = await supabase.from('product_variants').select('*').eq('product_id', id).order('created_at');
    if (r.error) { productMessage.textContent = r.error.message; return; }
    variants = r.data || [];
    renderVariants();
    document.querySelector('#product-form-title').textContent = 'Edit Product';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderVariants() {
    const box = document.querySelector('#variant-list');
    box.innerHTML = variants.map((v, i) => `<div class="variant-row" data-i="${i}"><input placeholder="Name" data-v="name" value="${esc(v.name)}"><input placeholder="SKU" data-v="sku" value="${esc(v.sku || '')}"><input placeholder="Price" type="number" step="0.01" min="0" data-v="price" value="${v.price ?? ''}"><input placeholder="Sale" type="number" step="0.01" min="0" data-v="sale_price" value="${v.sale_price ?? ''}"><input placeholder="Stock" type="number" min="0" data-v="stock_quantity" value="${v.stock_quantity ?? 0}"><button class="small-button danger-button" type="button" data-remove-variant="${i}">×</button></div>`).join('');
    box.querySelectorAll('[data-remove-variant]').forEach((b) => b.onclick = () => { variants.splice(Number(b.dataset.removeVariant), 1); renderVariants(); });
  }

  function readVariants() {
    document.querySelectorAll('.variant-row').forEach((row) => {
      const i = Number(row.dataset.i);
      row.querySelectorAll('[data-v]').forEach((el) => variants[i][el.dataset.v] = el.value);
    });
  }

  async function deleteProduct(id) {
    if (!confirm('Delete this product?')) return;
    const { error } = await supabase.from('products').delete().eq('id', id);
    if (error) alert(error.message); else await load();
  }

  async function deleteCategory(id) {
    if (!confirm('Delete this category? Products will keep their records with no category.')) return;
    const { error } = await supabase.from('categories').delete().eq('id', id);
    if (error) alert(error.message); else await load();
  }

  async function webp(file) {
    const bitmap = await createImageBitmap(file);
    const max = 1800;
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    return await new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not convert image to WebP.')), 'image/webp', 0.82));
  }

  async function uploadImages(productId, files) {
    for (let i = 0; i < files.length; i++) {
      const blob = await webp(files[i]);
      const path = `${productId}/${Date.now()}-${i}.webp`;
      const up = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false });
      if (up.error) throw new Error(up.error.message);
      const { data: urlData } = supabase.storage.from('product-images').getPublicUrl(path);
      const ins = await supabase.from('product_images').insert({ product_id: productId, image_url: urlData.publicUrl, alt_text: files[i].name.replace(/\.[^.]+$/, ''), sort_order: i, is_primary: i === 0 });
      if (ins.error) throw new Error(ins.error.message);
      if (i === 0) {
        const upProduct = await supabase.from('products').update({ primary_image_url: urlData.publicUrl }).eq('id', productId);
        if (upProduct.error) throw new Error(upProduct.error.message);
      }
    }
  }

  productForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    productMessage.textContent = 'Saving…';
    readVariants();
    const fd = new FormData(productForm);
    const id = String(fd.get('id') || '');
    const name = String(fd.get('name') || '').trim();
    const data = {
      name,
      slug: String(fd.get('slug') || slugify(name)),
      sku: String(fd.get('sku') || '') || null,
      category_id: String(fd.get('category_id') || '') || null,
      price: Number(fd.get('price') || 0),
      sale_price: fd.get('sale_price') ? Number(fd.get('sale_price')) : null,
      stock_quantity: Number(fd.get('stock_quantity') || 0),
      age_min: fd.get('age_min') ? Number(fd.get('age_min')) : null,
      age_max: fd.get('age_max') ? Number(fd.get('age_max')) : null,
      brand: String(fd.get('brand') || '') || null,
      short_description: String(fd.get('short_description') || ''),
      description: String(fd.get('description') || ''),
      is_featured: fd.get('is_featured') === 'on',
      is_active: fd.get('is_active') === 'on',
      updated_at: new Date().toISOString()
    };
    const result = id ? await supabase.from('products').update(data).eq('id', id).select().single() : await supabase.from('products').insert(data).select().single();
    if (result.error) { productMessage.textContent = result.error.message; return; }
    const pid = result.data.id;
    try {
      const files = [...document.querySelector('#image-files').files];
      if (files.length) await uploadImages(pid, files);
      if (id) {
        const old = await supabase.from('product_variants').select('id').eq('product_id', pid);
        if (old.error) throw new Error(old.error.message);
        for (const row of old.data || []) if (!variants.some((v) => v.id === row.id)) await supabase.from('product_variants').delete().eq('id', row.id);
      }
      for (const v of variants) {
        if (!String(v.name || '').trim()) continue;
        const vd = { product_id: pid, name: String(v.name), sku: String(v.sku || '') || null, price: v.price === '' ? null : Number(v.price), sale_price: v.sale_price === '' ? null : Number(v.sale_price), stock_quantity: Number(v.stock_quantity || 0), attributes: v.attributes || {}, is_active: v.is_active !== false, updated_at: new Date().toISOString() };
        const vr = v.id ? await supabase.from('product_variants').update(vd).eq('id', v.id) : await supabase.from('product_variants').insert(vd);
        if (vr.error) throw new Error(vr.error.message);
      }
      productMessage.textContent = 'Saved successfully.';
      clearForm();
      await load();
    } catch (err) {
      productMessage.textContent = err?.message || 'Save failed.';
    }
  });

  function clearForm() {
    productForm.reset();
    productForm.elements.namedItem('id').value = '';
    productForm.elements.namedItem('is_active').checked = true;
    variants = [];
    renderVariants();
    document.querySelector('#product-form-title').textContent = 'Add Product';
  }

  document.querySelector('#add-variant').onclick = () => { readVariants(); variants.push({ name: '', sku: '', price: null, sale_price: null, stock_quantity: 0, attributes: {}, is_active: true }); renderVariants(); };
  document.querySelector('#cancel-edit').onclick = clearForm;
  document.querySelector('#product-search').oninput = renderProducts;
  document.querySelector('#logout').onclick = async () => { await supabase.auth.signOut(); location.href = '/login'; };

  document.querySelectorAll('.tab').forEach((b) => b.onclick = () => {
    document.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    document.querySelectorAll('.admin-panel').forEach((x) => x.hidden = true);
    document.querySelector(`#${b.dataset.tab}-tab`).hidden = false;
  });

  document.querySelector('#category-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.currentTarget);
    const name = String(fd.get('name') || '').trim();
    const { error } = await supabase.from('categories').insert({ name, slug: String(fd.get('slug') || slugify(name)), description: String(fd.get('description') || '') });
    categoryMessage.textContent = error?.message || 'Category added.';
    if (!error) { e.currentTarget.reset(); await load(); }
  });

  document.querySelector('#import-btn').onclick = async () => {
    const file = document.querySelector('#excel-file').files?.[0];
    const msg = document.querySelector('#import-message');
    if (!file) { msg.textContent = 'Choose an Excel or CSV file first.'; return; }
    if (!window.XLSX) { msg.textContent = 'Excel reader is still loading. Please try again.'; return; }
    msg.textContent = 'Importing…';
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type: 'array' });
      const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: '' });
      let created = 0, updated = 0, failed = 0;
      for (const row of rows) {
        try {
          const name = String(row.name || row.Name || '').trim();
          if (!name) throw new Error('Missing name');
          const slug = slugify(row.slug || row.Slug || name);
          const catName = String(row.category || row.Category || '').trim();
          const categoryId = categories.find((x) => x.name.toLowerCase() === catName.toLowerCase())?.id || null;
          const payload = { name, slug, sku: String(row.sku || row.SKU || '').trim() || null, category_id: categoryId, price: Number(row.price || row.Price || 0), sale_price: (row.sale_price ?? row.SalePrice ?? '') === '' ? null : Number(row.sale_price ?? row.SalePrice), stock_quantity: Number(row.stock_quantity ?? row.Stock ?? 0), age_min: row.age_min === '' ? null : Number(row.age_min), age_max: row.age_max === '' ? null : Number(row.age_max), brand: String(row.brand || '').trim() || null, short_description: String(row.short_description || '').trim(), description: String(row.description || ''), primary_image_url: String(row.primary_image_url || '').trim() || null, seo_title: String(row.seo_title || '').trim() || null, seo_description: String(row.seo_description || '').trim() || null, is_active: String(row.is_active).toLowerCase() !== 'false', is_featured: String(row.is_featured).toLowerCase() === 'true', updated_at: new Date().toISOString() };
          const existing = products.find((p) => p.slug === slug);
          const r = existing ? await supabase.from('products').update(payload).eq('id', existing.id).select().single() : await supabase.from('products').insert(payload).select().single();
          if (r.error) throw r.error;
          const product = r.data;
          const urls = [row.image_1, row.image_2, row.image_3].map((x) => String(x || '').trim()).filter(Boolean);
          if (urls.length) await supabase.from('product_images').insert(urls.map((image_url, i) => ({ product_id: product.id, image_url, alt_text: name, sort_order: i, is_primary: i === 0 })));
          if (existing) updated++; else created++;
        } catch { failed++; }
      }
      msg.textContent = `Import complete: ${created} created, ${updated} updated, ${failed} failed.`;
      await load();
    } catch (err) { msg.textContent = err?.message || 'Import failed.'; }
  };

  async function initAdmin() {
    try {
      if (!url || !key) throw new Error('Supabase browser configuration is missing on the Worker.');
      supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
      const { data: { user }, error: userError } = await withTimeout(supabase.auth.getUser());
      if (userError) throw new Error(userError.message);
      if (!user) { location.href = '/login'; return; }
      const { data: isAdmin, error: adminErrorResult } = await withTimeout(supabase.rpc('is_admin'));
      if (adminErrorResult) throw new Error(adminErrorResult.message);
      if (!isAdmin) { showError('This account is not registered as an administrator.'); return; }
      guard.hidden = true;
      adminError.hidden = true;
      app.hidden = false;
      await load();
    } catch (error) {
      console.error('Admin initialization failed:', error);
      showError(error?.message || 'Unknown error while checking admin access.');
    }
  }

  initAdmin();
</script>

<style>
  .import-card{display:flex;justify-content:space-between;gap:24px;align-items:center;margin-bottom:24px;padding:22px;border:1px solid #e5e7eb;border-radius:16px;background:#fff}.import-card h2{margin:0 0 8px}.import-card p{margin:0;color:#64748b}.import-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.variant-box{margin:8px 0;padding:16px;border:1px solid #e5e7eb;border-radius:14px;background:#f8fafc}.variant-row{display:grid;grid-template-columns:1.3fr 1fr .8fr .8fr .7fr auto;gap:7px;margin:8px 0}.variant-row input{min-width:0;padding:9px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}.variant-box small{color:#64748b}.panel-title{display:flex;justify-content:space-between;gap:12px;align-items:center}.panel-title h2,.panel-title h3{margin:0}.admin-item{display:flex;justify-content:space-between;gap:16px;align-items:center}.item-actions{display:flex;gap:8px}.empty-state{padding:28px;border:1px dashed #cbd5e1;border-radius:16px;text-align:center}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.form-card{background:#fff}.tab{cursor:pointer}@media(max-width:850px){.import-card{display:block}.import-actions{margin-top:14px}.variant-row{grid-template-columns:1fr 1fr}.admin-head{align-items:flex-start}}
</style>