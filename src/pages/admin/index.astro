// ----- events -----
document.addEventListener('click', async (event) => {
  const t = event.target instanceof Element ? event.target : null;
  if (!t) return;
  const tab = t.closest<HTMLElement>('.tab'); if (tab) { switchTab(tab.dataset.tab!); return; }
  const filter = t.closest<HTMLElement>('[data-filter]'); if (filter) { productFilter = filter.dataset.filter!; renderProducts(); return; }
  const edit = t.closest<HTMLElement>('[data-edit]'); if (edit) { editProduct(edit.dataset.edit!); return; }
  const dup = t.closest<HTMLElement>('[data-duplicate]'); if (dup) { duplicateProduct(dup.dataset.duplicate!); return; }
  const del = t.closest<HTMLElement>('[data-del]');
  if (del) {
    const p = products.find((x) => x.id === del.dataset.del);
    if (!p || !confirm(`Delete "${p.name}"? This cannot be undone. Tip: hide it instead to keep its order history tidy.`)) return;
    const r = await supabase.from('products').delete().eq('id', p.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    if (field('id').value === p.id) clearForm(false);
    await load(); toast(`Deleted ${p.name}.`); return;
  }
  const rm = t.closest<HTMLElement>('[data-rm]'); if (rm) { readVariants(); variants.splice(Number(rm.dataset.rm), 1); renderVariants(); return; }
  const primary = t.closest<HTMLElement>('[data-primary-img]');
  if (primary) {
    const img = images.find((x) => x.id === primary.dataset.primaryImg); const id = field('id').value;
    if (!img || !id) return;
    const r = await supabase.from('products').update({ primary_image_url: img.image_url }).eq('id', id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    await supabase.from('product_images').update({ is_primary: false }).eq('product_id', id);
    await supabase.from('product_images').update({ is_primary: true }).eq('id', img.id);
    const p = products.find((x) => x.id === id); if (p) p.primary_image_url = img.image_url;
    renderImages(); renderProducts(); toast('Main image updated.'); return;
  }
  const delImg = t.closest<HTMLElement>('[data-del-img]');
  if (delImg) {
    const img = images.find((x) => x.id === delImg.dataset.delImg); const id = field('id').value;
    if (!img || !id || !confirm('Remove this image from the product?')) return;
    const r = await supabase.from('product_images').delete().eq('id', img.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    images = images.filter((x) => x.id !== img.id);
    const p = products.find((x) => x.id === id);
    if (p && p.primary_image_url === img.image_url) {
      const next = images[0]?.image_url || null;
      await supabase.from('products').update({ primary_image_url: next }).eq('id', id);
      p.primary_image_url = next;
    }
    renderImages(); renderProducts(); toast('Image removed.'); return;
  }
  const move = t.closest<HTMLElement>('[data-move]'); if (move) { moveCategory(move.dataset.move!, Number(move.dataset.dir)); return; }
  const editCat = t.closest<HTMLElement>('[data-edit-cat]'); if (editCat) { editCategory(editCat.dataset.editCat!); return; }
  const delCat = t.closest<HTMLElement>('[data-cat]');
  if (delCat) {
    const c = categories.find((x) => x.id === delCat.dataset.cat);
    if (!c || !confirm(`Delete category "${c.name}"? Products stay, they just leave this category.`)) return;
    const r = await supabase.from('categories').delete().eq('id', c.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    await load(); toast(`Deleted ${c.name}.`);
  }
});

