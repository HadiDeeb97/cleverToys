// A new photo waits in categoryPhotoFile until the category is saved; the hidden image_url field holds the current one.
let categoryPhotoFile: File | null = null;
let categoryPhotoPreviewUrl = '';
function setCategoryPhoto(url: string, file: File | null = null) {
  const f = $<HTMLFormElement>('#category-form');
  categoryPhotoFile = file;
  if (categoryPhotoPreviewUrl) URL.revokeObjectURL(categoryPhotoPreviewUrl);
  categoryPhotoPreviewUrl = file ? URL.createObjectURL(file) : '';
  (f.elements.namedItem('image_url') as HTMLInputElement).value = file ? '' : url;
  const shown = categoryPhotoPreviewUrl || url;
  $('#cat-photo-preview').innerHTML = shown ? `<img src="${esc(shown)}" alt="" />` : '🗂️';
  $('#cat-photo-pick').textContent = shown ? 'Change photo' : 'Upload photo';
  $('#cat-photo-remove').hidden = !shown;
}
async function uploadCategoryPhoto(id: string, file: File) {
  const blob = await toWebp(file);
  const path = `categories/${id}/${Date.now()}.webp`;
  const up = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false });
  if (up.error) throw new Error(up.error.message);
  return supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;
}
function removeStoredCategoryPhoto(url: string) {
  const marker = '/storage/v1/object/public/product-images/';
  const at = url.indexOf(marker);
  const path = at >= 0 ? decodeURIComponent(url.slice(at + marker.length)) : '';
  if (path.startsWith('categories/')) supabase.storage.from('product-images').remove([path]).catch(() => {});
}
