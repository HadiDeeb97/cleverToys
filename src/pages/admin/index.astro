// ---------- Related toys (supabase/related_products.sql) ----------
// Hand-picked toys shown first in "You may also like". The box stays hidden until the SQL file is run.
let relatedIds: string[] = [];
// Products have the "Show in Google & Meta" and "Ad group label" columns (supabase/catalog_controls.sql).
let adFieldsReady = false;
let relationsReady = false;
function renderRelated() {
  $('#related-box').hidden = !relationsReady;
  const byId = new Map(products.map((p) => [String(p.id), p]));
  $('#related-list').innerHTML = relatedIds.length
    ? relatedIds.map((rid, i) => {
        const p = byId.get(rid);
        return `<li class="related-item"><span>${esc(p?.name || 'Removed toy')}${p && p.is_active === false ? ' <small class="muted">(hidden)</small>' : ''}</span><span class="related-actions"><button type="button" class="small-button" data-related-move="${i}" data-dir="-1" aria-label="Move up"${i === 0 ? ' disabled' : ''}>↑</button><button type="button" class="small-button" data-related-move="${i}" data-dir="1" aria-label="Move down"${i === relatedIds.length - 1 ? ' disabled' : ''}>↓</button><button type="button" class="small-button danger-button" data-related-remove="${i}" aria-label="Remove">×</button></span></li>`;
      }).join('')
    : '<li class="muted related-empty">None chosen: only automatic matches are shown.</li>';
}
function renderRelatedResults() {
  const box = $('#related-results');
  const q = $<HTMLInputElement>('#related-search').value.trim().toLowerCase();
  const current = field('id').value;
  const found = q ? products.filter((p) => p.id !== current && !relatedIds.includes(p.id) && [p.name, p.sku].some((v) => String(v || '').toLowerCase().includes(q))).slice(0, 8) : [];
  box.hidden = !q;
  box.innerHTML = found.length ? found.map((p) => `<li><button type="button" data-related-add="${p.id}">${esc(p.name)}${p.sku ? ` <small class="muted">${esc(p.sku)}</small>` : ''}</button></li>`).join('') : '<li class="muted">No toy matches.</li>';
}
async function loadRelated(id: string) {
  const r = await supabase.from('product_relations').select('related_id,sort_order').eq('product_id', id).order('sort_order');
  if (field('id').value !== id) return;
  relationsReady = !r.error;
  relatedIds = ((r.data ?? []) as Row[]).map((x) => String(x.related_id));
  renderRelated();
}
async function saveRelated(id: string) {
  if (!relationsReady) return;
  const del = await supabase.from('product_relations').delete().eq('product_id', id);
  if (del.error) throw new Error(del.error.message);
  const rows = relatedIds.filter((rid) => rid !== id).map((related_id, sort_order) => ({ product_id: id, related_id, sort_order }));
  if (rows.length) { const ins = await supabase.from('product_relations').insert(rows); if (ins.error) throw new Error(ins.error.message); }
}
$('#related-search').addEventListener('input', renderRelatedResults);
$('#related-search').addEventListener('keydown', (event) => {
  if ((event as KeyboardEvent).key === 'Enter') { event.preventDefault(); $<HTMLButtonElement>('#related-results [data-related-add]')?.click(); }
  if ((event as KeyboardEvent).key === 'Escape') { $<HTMLInputElement>('#related-search').value = ''; renderRelatedResults(); }
});
document.addEventListener('click', (event) => {
  const t = event.target instanceof Element ? event.target : null;
  const add = t?.closest<HTMLElement>('[data-related-add]');
  if (add) { if (relatedIds.length < 12) relatedIds.push(add.dataset.relatedAdd!); else toast('Up to 12 related toys.', 'error'); $<HTMLInputElement>('#related-search').value = ''; renderRelatedResults(); renderRelated(); $<HTMLInputElement>('#related-search').focus(); return; }
  const move = t?.closest<HTMLElement>('[data-related-move]');
  if (move) { const i = Number(move.dataset.relatedMove), j = i + Number(move.dataset.dir); if (j >= 0 && j < relatedIds.length) { [relatedIds[i], relatedIds[j]] = [relatedIds[j], relatedIds[i]]; renderRelated(); } return; }
  const remove = t?.closest<HTMLElement>('[data-related-remove]');
  if (remove) { relatedIds.splice(Number(remove.dataset.relatedRemove), 1); renderRelated(); return; }
  if (!t?.closest('.related-search')) $('#related-results').hidden = true;
});

async function saveProductCategories(id: string, ids: string[]) {
  const unique = [...new Set(ids.filter(Boolean))];
  const del = await supabase.from('product_categories').delete().eq('product_id', id);
  if (del.error) throw new Error(del.error.message);
  if (unique.length) { const ins = await supabase.from('product_categories').insert(unique.map((category_id) => ({ product_id: id, category_id }))); if (ins.error) throw new Error(ins.error.message); }
  const up = await supabase.from('products').update({ category_id: unique[0] || null, updated_at: new Date().toISOString() }).eq('id', id);
  if (up.error) throw new Error(up.error.message);
}

// Product photos are resized to at most 1400 px and saved as WebP before upload. That is sharp on
// phones and big screens (the photo is shown at most ~700 px wide) while keeping pages light.
async function toWebp(file: Blob) {
  const bmp = await createImageBitmap(file);
  const scale = Math.min(1, 1400 / Math.max(bmp.width, bmp.height));
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(bmp.width * scale));
  canvas.height = Math.max(1, Math.round(bmp.height * scale));
  canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
  return new Promise<Blob>((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('WebP conversion failed'))), 'image/webp', 0.82));
}

async function uploadImages(id: string, files: File[]) {
  const product = products.find((p) => p.id === id);
  let hasPrimary = Boolean(product?.primary_image_url);
  const start = images.length;
  for (let i = 0; i < files.length; i++) {
    const blob = await toWebp(files[i]);
    const path = `${id}/${Date.now()}-${i}.webp`;
    const up = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false });
    if (up.error) throw new Error(up.error.message);
    const pub = supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;
    const ins = await supabase.from('product_images').insert({ product_id: id, image_url: pub, alt_text: files[i].name.replace(/\.[^.]+$/, ''), sort_order: start + i, is_primary: !hasPrimary && i === 0 });
    if (ins.error) throw new Error(ins.error.message);
    if (!hasPrimary) { const r = await supabase.from('products').update({ primary_image_url: pub }).eq('id', id); if (r.error) throw new Error(r.error.message); hasPrimary = true; }
  }
}

async function saveVariants(id: string) {
  readVariants();
  const old = await supabase.from('product_variants').select('id').eq('product_id', id);
  if (old.error) throw new Error(old.error.message);
  for (const o of (old.data ?? []) as Row[]) if (!variants.some((v) => v.id === o.id)) { const d = await supabase.from('product_variants').delete().eq('id', o.id); if (d.error) throw new Error(d.error.message); }
  for (const v of variants) {
    if (!String(v.name || '').trim()) continue;
    const data = { product_id: id, name: String(v.name).trim(), sku: String(v.sku || '').trim() || null, price: num(v.price), sale_price: num(v.sale_price), cost_price: num(v.cost_price), stock_quantity: int(v.stock_quantity, 0), attributes: v.attributes || {}, image_url: v.image_url || null, is_active: true, updated_at: new Date().toISOString() };
    const r = v.id ? await supabase.from('product_variants').update(data).eq('id', v.id) : await supabase.from('product_variants').insert(data);
    if (r.error) throw new Error(friendly(r.error.message));
  }
}

async function quickUpdate(id: string, changes: Row, message: string) {
  const p = products.find((x) => x.id === id);
  if (!p) return;
  const before = { ...p };
  Object.assign(p, changes);
  renderProducts();
  const r = await supabase.from('products').update({ ...changes, updated_at: new Date().toISOString() }).eq('id', id);
  if (r.error) { Object.assign(p, before); renderProducts(); toast(r.error.message, 'error'); return; }
  toast(message);
}

async function duplicateProduct(id: string) {
  const p = products.find((x) => x.id === id);
  if (!p) return;
  let slug = `${p.slug}-copy`; let n = 2;
  while (products.some((x) => x.slug === slug)) slug = `${p.slug}-copy-${n++}`;
  const { id: _id, created_at, updated_at, ...rest } = p;
  const r = await supabase.from('products').insert({ ...rest, name: `${p.name} (copy)`, slug, sku: null, is_active: false, is_featured: false }).select().single();
  if (r.error) { toast(friendly(r.error.message), 'error'); return; }
  const copyId = (r.data as Row).id;
  const cats = links.filter((l) => l.product_id === id).map((l) => l.category_id);
  if (cats.length) await supabase.from('product_categories').insert(cats.map((category_id) => ({ product_id: copyId, category_id })));
  await load();
  toast('Copied as a hidden product. Edit it, then make it visible.');
  editProduct(copyId);
}

async function moveCategory(id: string, dir: number) {
  const i = categories.findIndex((c) => c.id === id);
  const j = i + dir;
  if (i < 0 || j < 0 || j >= categories.length) return;
  [categories[i], categories[j]] = [categories[j], categories[i]];
  renderCategories();
  const updates = categories.map((c, index) => supabase.from('categories').update({ sort_order: index }).eq('id', c.id));
  const results = await Promise.all(updates);
  const failed = results.find((r) => r.error);
  if (failed?.error) { toast(failed.error.message, 'error'); await load(); return; }
  categories.forEach((c, index) => { c.sort_order = index; });
  toast('Category order saved.');
}

function editCategory(id: string) {
  const c = categories.find((x) => x.id === id);
  if (!c) return;
  const f = $<HTMLFormElement>('#category-form');
  for (const name of ['id', 'name', 'slug', 'description', 'seo_title', 'seo_description']) (f.elements.namedItem(name) as HTMLInputElement).value = c[name] ?? '';
  setCategoryPhoto(c.image_url || '');
  (f.elements.namedItem('is_active') as HTMLInputElement).checked = c.is_active !== false;
  (f.elements.namedItem('slug') as HTMLInputElement).dataset.auto = '';
  $('#category-form-title').textContent = `Edit: ${c.name}`;
  f.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
function clearCategoryForm() {
  const f = $<HTMLFormElement>('#category-form');
  f.reset();
  (f.elements.namedItem('id') as HTMLInputElement).value = '';
  (f.elements.namedItem('slug') as HTMLInputElement).dataset.auto = '1';
  $('#category-form-title').textContent = 'Add category';
  $('#category-msg').textContent = '';
  setCategoryPhoto('');
}

function switchTab(tab: string) {
  document.querySelectorAll<HTMLElement>('.tab').forEach((x) => { x.classList.toggle('active', x.dataset.tab === tab); x.setAttribute('aria-selected', String(x.dataset.tab === tab)); });
  $('#products-tab').hidden = tab !== 'products';
  $('#categories-tab').hidden = tab !== 'categories';
  $('#import-tab').hidden = tab !== 'import';
}

// ----- events -----
document.addEventListener('click', async (event) => {
  const t = event.target instanceof Element ? event.target : null;
  if (!t) return;
  const tab = t.closest<HTMLElement>('.tab'); if (tab) { switchTab(tab.dataset.tab!); return; }
  const filter = t.closest<HTMLElement>('[data-filter]'); if (filter) { productFilter = filter.dataset.filter!; renderProducts(); return; }
  const edit = t.closest<HTMLElement>('[data-edit]'); if (edit) { editProduct(edit.dataset.edit!); return; }
  const dup = t.closest<HTMLElement>('[data-duplicate]'); if (dup) { duplicateProduct(dup.dataset.duplicate!); return; }
  const notDup = t.closest<HTMLButtonElement>('[data-not-dup]');
  if (notDup) {
    const [product_a, product_b] = notDup.dataset.notDup!.split('|');
    notDup.disabled = true;
    const r = await supabase.from('product_not_duplicates').upsert({ product_a, product_b }, { onConflict: 'product_a,product_b', ignoreDuplicates: true });
    if (r.error) { notDup.disabled = false; toast(r.error.message, 'error'); return; }
    notDuplicates.add(pairKey(product_a, product_b));
    findProductDuplicates();
    renderProducts();
    toast('Marked as different toys. See them under “Not duplicates”.');
    return;
  }
  const undoNotDup = t.closest<HTMLButtonElement>('[data-undo-not-dup]');
  if (undoNotDup) {
    const [product_a, product_b] = undoNotDup.dataset.undoNotDup!.split('|');
    undoNotDup.disabled = true;
    const r = await supabase.from('product_not_duplicates').delete().eq('product_a', product_a).eq('product_b', product_b);
    if (r.error) { undoNotDup.disabled = false; toast(r.error.message, 'error'); return; }
    notDuplicates.delete(pairKey(product_a, product_b));
    findProductDuplicates();
    renderProducts();
    toast('Undone: the pair is back in Possible duplicates (if their names still look alike).');
    return;
  }
  const del = t.closest<HTMLElement>('[data-del]');
  if (del) {
    const p = products.find((x) => x.id === del.dataset.del);
    if (!p || !confirm(`Delete "${p.name}"? This cannot be undone. Tip: hide it instead to keep its order history tidy.`)) return;
    const r = await supabase.from('products').delete().eq('id', p.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    if (field('id').value === p.id) clearForm(false);
    await load(); toast(`Deleted ${p.name}.`); return;
  }
  const rm = t.closest<HTMLElement>('[data-rm]'); if (rm) { readVariants(); variants.splice(Number(rm.dataset.rm), 1); renderVariants(); return; }
  const vphoto = t.closest<HTMLElement>('[data-vphoto]'); if (vphoto) { readVariants(); variants[Number(vphoto.dataset.vphoto)].image_url = vphoto.dataset.url || null; renderVariants(); return; }
  const primary = t.closest<HTMLElement>('[data-primary-img]');
  if (primary) {
    const img = images.find((x) => x.id === primary.dataset.primaryImg); const id = field('id').value;
    if (!img || !id) return;
    const r = await supabase.from('products').update({ primary_image_url: img.image_url }).eq('id', id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    await supabase.from('product_images').update({ is_primary: false }).eq('product_id', id);
    await supabase.from('product_images').update({ is_primary: true }).eq('id', img.id);
    const p = products.find((x) => x.id === id); if (p) p.primary_image_url = img.image_url;
    renderImages(); renderProducts(); toast('Main image updated.'); return;
  }
  const delImg = t.closest<HTMLElement>('[data-del-img]');
  if (delImg) {
    const img = images.find((x) => x.id === delImg.dataset.delImg); const id = field('id').value;
    if (!img || !id || !confirm('Remove this image from the product?')) return;
    const r = await supabase.from('product_images').delete().eq('id', img.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    images = images.filter((x) => x.id !== img.id);
    const p = products.find((x) => x.id === id);
    if (p && p.primary_image_url === img.image_url) {
      const next = images[0]?.image_url || null;
      await supabase.from('products').update({ primary_image_url: next }).eq('id', id);
      p.primary_image_url = next;
    }
    renderImages(); renderProducts(); toast('Image removed.'); return;
  }
  const move = t.closest<HTMLElement>('[data-move]'); if (move) { moveCategory(move.dataset.move!, Number(move.dataset.dir)); return; }
  const editCat = t.closest<HTMLElement>('[data-edit-cat]'); if (editCat) { editCategory(editCat.dataset.editCat!); return; }
  const delCat = t.closest<HTMLElement>('[data-cat]');
  if (delCat) {
    const c = categories.find((x) => x.id === delCat.dataset.cat);
    if (!c || !confirm(`Delete category "${c.name}"? Products stay, they just leave this category.`)) return;
    const r = await supabase.from('categories').delete().eq('id', c.id);
    if (r.error) { toast(r.error.message, 'error'); return; }
    await load(); toast(`Deleted ${c.name}.`);
  }
});

