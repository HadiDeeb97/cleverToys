---
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<header class="site-header"><div class="container header-inner"><a class="logo" href="/admin">Clever Toys Admin</a><nav class="main-nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/orders">Orders</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><p class="eyebrow">Store management</p><h1>Products &amp; Categories</h1><p>Create, edit, delete products, manage variants, categories and images.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div>
<div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><div id="guard" class="empty-state">Checking admin access…</div><div id="error" class="empty-state" hidden></div>
<div id="app" hidden>
<section class="import-card"><h2>Excel import</h2><p>Download the template, fill it, then import your products. Use comma-separated category names in the <strong>categories</strong> column.</p><div class="import-actions"><button id="template" class="button secondary-button" type="button">Download Excel Template</button><input id="file" type="file" accept=".xlsx,.xls,.csv" /><button id="import" class="button" type="button">Import Excel</button></div><p id="msg" role="status"></p><div id="errors" class="import-errors" hidden></div></section>
<div class="admin-tabs"><button class="tab active" data-tab="products" type="button">Products</button><button class="tab" data-tab="categories" type="button">Categories</button></div>
<section id="products-tab"><div class="admin-grid"><form id="product-form" class="form-card"><h2 id="form-title">Add Product</h2><input type="hidden" name="id"/><label>Name<input name="name" required/></label><label>Slug<input name="slug" required/></label><label>SKU<input name="sku"/></label><label>Categories<select name="category_ids" id="category-select" multiple size="6"></select><small class="field-help">Hold Ctrl/Cmd to select multiple categories.</small></label><label>Price (USD)<input name="price" type="number" min="0" step="0.01" required/></label><label>Sale price<input name="sale_price" type="number" min="0" step="0.01"/></label><label>Stock quantity<input name="stock_quantity" type="number" min="0" value="0" required/></label><div class="variant-box"><div class="panel-title"><h3>Variants</h3><button id="add-variant" class="small-button" type="button">+ Add variant</button></div><div id="variant-list"></div><small>Use variants for size, color, model or pack size.</small></div><label>Age minimum<input name="age_min" type="number" min="0"/></label><label>Age maximum<input name="age_max" type="number" min="0"/></label><label>Brand<input name="brand"/></label><label>Short description<textarea name="short_description" rows="2"></textarea></label><label>Description<textarea name="description" rows="5"></textarea></label><label>SEO title<input name="seo_title" maxlength="70"/></label><label>SEO description<textarea name="seo_description" rows="3" maxlength="170"></textarea></label><label>Product images<input id="image-files" type="file" accept="image/jpeg,image/png,image/webp" multiple/></label><label class="check"><input name="is_featured" type="checkbox"/> Featured</label><label class="check"><input name="is_active" type="checkbox" checked/> Active</label><div class="form-actions"><button class="button" type="submit">Save Product</button><button id="clear" class="button secondary-button" type="button">Clear</button></div><p id="product-msg" role="status"></p></form><div><div class="panel-title"><h2>Products</h2><input id="search" placeholder="Search products…"/></div><div id="products" class="admin-list"></div></div></div></section>
<section id="categories-tab" hidden><div class="admin-grid"><form id="category-form" class="form-card"><h2>Add Category</h2><label>Name<input name="name" required/></label><label>Slug<input name="slug" required/></label><label>Description<textarea name="description" rows="3"></textarea></label><button class="button" type="submit">Add Category</button><p id="category-msg" role="status"></p></form><div><h2>Categories</h2><div id="categories" class="admin-list"></div></div></div></section>
</div></div></main>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#cfg');const url=cfg?.dataset.url,key=cfg?.dataset.key;const guard=document.querySelector('#guard'),app=document.querySelector('#app'),errorBox=document.querySelector('#error');let supabase,categories=[],products=[],variants=[];
const esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));
const slugify=v=>String(v||'').toLowerCase().trim().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const num=(v,d=null)=>{if(v===null||v===undefined||String(v).trim()==='')return d;const n=Number(String(v).replace(/[$,]/g,'').trim());return Number.isFinite(n)?n:d};
const int=(v,d=null)=>{const n=num(v,d);return n===null?d:Math.trunc(n)};
function showError(t){guard.hidden=true;app.hidden=true;errorBox.hidden=false;errorBox.innerHTML='<h2>Admin access could not be verified</h2><p>'+esc(t)+'</p><button class="button" onclick="location.reload()">Try again</button>';}
function renderCategoryOptions(selected=[]){const s=new Set(selected);document.querySelector('#category-select').innerHTML=categories.map(c=>'<option value="'+c.id+'" '+(s.has(c.id)?'selected':'')+'>'+esc(c.name)+'</option>').join('');}
async function load(){const[c,p]=await Promise.all([supabase.from('categories').select('*').order('sort_order').order('name'),supabase.from('products').select('*').order('created_at',{ascending:false})]);if(c.error||p.error)throw new Error((c.error||p.error).message);categories=c.data||[];products=p.data||[];renderCategoryOptions();renderProducts();renderCategories();}
function renderProducts(){const q=document.querySelector('#search').value.toLowerCase();const list=products.filter(p=>p.name.toLowerCase().includes(q)||String(p.sku||'').toLowerCase().includes(q));document.querySelector('#products').innerHTML=list.length?list.map(p=>'<div class="admin-item"><div><strong>'+esc(p.name)+'</strong><small>'+esc(p.sku||'No SKU')+' · $'+Number(p.sale_price??p.price).toFixed(2)+' · stock '+p.stock_quantity+(p.is_active?'':' · inactive')+'</small></div><div class="item-actions"><button class="small-button" data-edit="'+p.id+'" type="button">Edit</button><button class="small-button danger-button" data-del="'+p.id+'" type="button">Delete</button></div></div>').join(''):'<p>No products found.</p>';document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editProduct(b.dataset.edit));document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>deleteProduct(b.dataset.del));}
function renderCategories(){document.querySelector('#categories').innerHTML=categories.length?categories.map(c=>'<div class="admin-item"><div><strong>'+esc(c.name)+'</strong><small>/'+esc(c.slug)+'</small></div><button class="small-button danger-button" data-cat="'+c.id+'" type="button">Delete</button></div>').join(''):'<p>No categories.</p>';document.querySelectorAll('[data-cat]').forEach(b=>b.onclick=()=>deleteCategory(b.dataset.cat));}
function renderVariants(){const box=document.querySelector('#variant-list');box.innerHTML=variants.map((v,i)=>'<div class="variant-row" data-i="'+i+'"><input placeholder="Name" data-v="name" value="'+esc(v.name)+'"><input placeholder="SKU" data-v="sku" value="'+esc(v.sku||'')+'"><input placeholder="Price" type="number" step="0.01" data-v="price" value="'+(v.price??'')+'"><input placeholder="Sale" type="number" step="0.01" data-v="sale_price" value="'+(v.sale_price??'')+'"><input placeholder="Stock" type="number" min="0" data-v="stock_quantity" value="'+(v.stock_quantity??0)+'"><button class="small-button danger-button" type="button" data-rm="'+i+'">×</button></div>').join('');document.querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{variants.splice(Number(b.dataset.rm),1);renderVariants()});}
function readVariants(){document.querySelectorAll('.variant-row').forEach(row=>{const i=Number(row.dataset.i);row.querySelectorAll('[data-v]').forEach(el=>variants[i][el.dataset.v]=el.value)});}
async function getProductCategoryIds(id){const r=await supabase.from('product_categories').select('category_id').eq('product_id',id);if(r.error)throw new Error(r.error.message);return (r.data||[]).map(x=>x.category_id);}
async function saveProductCategories(id,ids){const unique=[...new Set(ids.filter(Boolean))];const del=await supabase.from('product_categories').delete().eq('product_id',id);if(del.error)throw new Error(del.error.message);if(unique.length){const rows=unique.map(category_id=>({product_id:id,category_id}));const ins=await supabase.from('product_categories').insert(rows);if(ins.error)throw new Error(ins.error.message);}const primary=unique[0]||null;const up=await supabase.from('products').update({category_id:primary,updated_at:new Date().toISOString()}).eq('id',id);if(up.error)throw new Error(up.error.message);}
async function editProduct(id){const p=products.find(x=>x.id===id);if(!p)return;const f=document.querySelector('#product-form');for(const[k,v] of Object.entries(p)){const e=f.elements.namedItem(k);if(!e||k==='category_id')continue;if(e.type==='checkbox')e.checked=Boolean(v);else e.value=v??'';}f.elements.namedItem('id').value=p.id;let categoryIds=[];try{categoryIds=await getProductCategoryIds(id);}catch(e){document.querySelector('#product-msg').textContent=e.message;return;}if(!categoryIds.length&&p.category_id)categoryIds=[p.category_id];renderCategoryOptions(categoryIds);const r=await supabase.from('product_variants').select('*').eq('product_id',id).order('created_at');if(r.error){document.querySelector('#product-msg').textContent=r.error.message;return;}variants=r.data||[];renderVariants();document.querySelector('#form-title').textContent='Edit Product';window.scrollTo({top:0,behavior:'smooth'});}
async function deleteProduct(id){if(!confirm('Delete this product?'))return;const r=await supabase.from('products').delete().eq('id',id);if(r.error)alert(r.error.message);else{await load();clearForm();}}
async function deleteCategory(id){if(!confirm('Delete this category?'))return;const r=await supabase.from('categories').delete().eq('id',id);if(r.error)alert(r.error.message);else await load();}
async function toWebp(file){const bmp=await createImageBitmap(file),max=1800,scale=Math.min(1,max/Math.max(bmp.width,bmp.height)),c=document.createElement('canvas');c.width=Math.max(1,Math.round(bmp.width*scale));c.height=Math.max(1,Math.round(bmp.height*scale));c.getContext('2d').drawImage(bmp,0,0,c.width,c.height);return await new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('WebP conversion failed')),'image/webp',.82));}
async function uploadImages(id,files){for(let i=0;i<files.length;i++){const blob=await toWebp(files[i]);const path=id+'/'+Date.now()+'-'+i+'.webp';const up=await supabase.storage.from('product-images').upload(path,blob,{contentType:'image/webp',upsert:false});if(up.error)throw new Error(up.error.message);const pub=supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;const ins=await supabase.from('product_images').insert({product_id:id,image_url:pub,alt_text:files[i].name.replace(/\.[^.]+$/,''),sort_order:i,is_primary:i===0});if(ins.error)throw new Error(ins.error.message);if(i===0){const r=await supabase.from('products').update({primary_image_url:pub}).eq('id',id);if(r.error)throw new Error(r.error.message);}}}
async function saveVariants(id){readVariants();const old=await supabase.from('product_variants').select('*').eq('product_id',id);if(old.error)throw new Error(old.error.message);for(const o of old.data||[]){if(!variants.some(v=>v.id===o.id)){const d=await supabase.from('product_variants').delete().eq('id',o.id);if(d.error)throw new Error(d.error.message);}}for(const v of variants){if(!String(v.name||'').trim())continue;const data={product_id:id,name:String(v.name).trim(),sku:String(v.sku||'').trim()||null,price:num(v.price),sale_price:num(v.sale_price),stock_quantity:int(v.stock_quantity,0),attributes:v.attributes||{},is_active:true,updated_at:new Date().toISOString()};const r=v.id?await supabase.from('product_variants').update(data).eq('id',v.id):await supabase.from('product_variants').insert(data);if(r.error)throw new Error(r.error.message);}}
function clearForm(){const f=document.querySelector('#product-form');f.reset();f.elements.namedItem('id').value='';f.elements.namedItem('is_active').checked=true;renderCategoryOptions([]);variants=[];renderVariants();document.querySelector('#form-title').textContent='Add Product';document.querySelector('#product-msg').textContent='';}
document.querySelector('#search').oninput=renderProducts;document.querySelector('#clear').onclick=clearForm;document.querySelector('#add-variant').onclick=()=>{variants.push({name:'',sku:'',price:'',sale_price:'',stock_quantity:0});renderVariants()};document.querySelector('#logout').onclick=async()=>{await supabase.auth.signOut();location.href='/login';};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');const productsTab=document.querySelector('#products-tab'),catsTab=document.querySelector('#categories-tab');productsTab.hidden=b.dataset.tab!=='products';catsTab.hidden=b.dataset.tab!=='categories';});
document.querySelector('#product-form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,msg=document.querySelector('#product-msg');msg.textContent='Saving…';const fd=new FormData(f),id=String(fd.get('id')||''),name=String(fd.get('name')||'').trim(),selectedCategoryIds=fd.getAll('category_ids').map(String);const data={name,slug:String(fd.get('slug')||slugify(name)),sku:String(fd.get('sku')||'').trim()||null,category_id:selectedCategoryIds[0]||null,price:num(fd.get('price'),0),sale_price:num(fd.get('sale_price')),stock_quantity:int(fd.get('stock_quantity'),0),age_min:int(fd.get('age_min')),age_max:int(fd.get('age_max')),brand:String(fd.get('brand')||'').trim()||null,short_description:String(fd.get('short_description')||''),description:String(fd.get('description')||''),seo_title:String(fd.get('seo_title')||'').trim()||null,seo_description:String(fd.get('seo_description')||'').trim()||null,is_featured:fd.get('is_featured')==='on',is_active:fd.get('is_active')==='on',updated_at:new Date().toISOString()};const r=id?await supabase.from('products').update(data).eq('id',id).select().single():await supabase.from('products').insert(data).select().single();if(r.error){msg.textContent=r.error.message;return;}try{await saveProductCategories(r.data.id,selectedCategoryIds);const files=[...document.querySelector('#image-files').files];if(files.length)await uploadImages(r.data.id,files);await saveVariants(r.data.id);msg.textContent='Saved successfully.';clearForm();await load();}catch(err){msg.textContent=err?.message||'Save failed.';}};
document.querySelector('#category-form').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.currentTarget),name=String(fd.get('name')||'').trim(),r=await supabase.from('categories').insert({name,slug:String(fd.get('slug')||slugify(name)),description:String(fd.get('description')||'')}).select().single();document.querySelector('#category-msg').textContent=r.error?r.error.message:'Category added.';if(!r.error){e.currentTarget.reset();await load();}};
document.querySelector('#template').onclick=()=>{if(!window.XLSX)return;const h=['name','slug','sku','categories','price','sale_price','stock_quantity','age_min','age_max','brand','short_description','description','primary_image_url','seo_title','seo_description','is_active','is_featured'];const ws=XLSX.utils.aoa_to_sheet([h,['Example Toy','example-toy','CT-001','Educational Toys, Outdoor Toys',9.99,'',10,3,8,'Clever Toys','Short description','Description','','Example Toy | Clever Toys','Shop toys in Lebanon.',true,false]]);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Products');XLSX.writeFile(wb,'Clever_Toys_Product_Import_Template.xlsx');};
document.querySelector('#import').onclick=async()=>{const file=document.querySelector('#file').files?.[0],msg=document.querySelector('#msg'),errBox=document.querySelector('#errors');if(!file){msg.textContent='Choose a file first.';return;}if(!window.XLSX){msg.textContent='Excel tools still loading.';return;}msg.textContent='Importing…';const errors=[];try{const wb=XLSX.read(await file.arrayBuffer(),{type:'array'}),rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''});let created=0,updated=0;for(let i=0;i<rows.length;i++){try{const row=rows[i],name=String(row.name||row.Name||'').trim();if(!name)throw new Error('Missing name');const slug=slugify(row.slug||name),price=num(row.price,null);if(price===null||price<0)throw new Error('Invalid price');const rawCats=String(row.categories||row.category||'').split(',').map(x=>x.trim()).filter(Boolean);const matchedCats=rawCats.map(name=>categories.find(c=>c.name.toLowerCase()===name.toLowerCase()||c.slug.toLowerCase()===slugify(name))).filter(Boolean);const payload={name,slug,sku:String(row.sku||'').trim()||null,category_id:matchedCats[0]?.id||null,price,sale_price:num(row.sale_price),stock_quantity:int(row.stock_quantity,0),age_min:int(row.age_min),age_max:int(row.age_max),brand:String(row.brand||'').trim()||null,short_description:String(row.short_description||''),description:String(row.description||''),primary_image_url:String(row.primary_image_url||'').trim()||null,seo_title:String(row.seo_title||'').trim()||null,seo_description:String(row.seo_description||'').trim()||null,is_active:String(row.is_active).toLowerCase()!=='false',is_featured:String(row.is_featured).toLowerCase()==='true',updated_at:new Date().toISOString()};let ex=products.find(p=>p.slug===slug);if(!ex&&payload.sku)ex=products.find(p=>p.sku===payload.sku);const r=ex?await supabase.from('products').update(payload).eq('id',ex.id).select().single():await supabase.from('products').insert(payload).select().single();if(r.error)throw new Error(r.error.message);await saveProductCategories(r.data.id,matchedCats.map(c=>c.id));ex?updated++:created++;}catch(x){errors.push('Row '+(i+2)+': '+(x?.message||'Unknown error'));}}msg.textContent='Import complete: '+created+' created, '+updated+' updated, '+errors.length+' failed.';if(errors.length){errBox.hidden=false;errBox.innerHTML='<strong>Import errors</strong>'+errors.slice(0,50).map(x=>'<p>'+esc(x)+'</p>').join('');}else errBox.hidden=true;await load();}catch(x){msg.textContent=x?.message||'Import failed.';}};
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const s=await supabase.auth.getSession();if(s.error)throw new Error(s.error.message);if(!s.data.session?.user){location.href='/login?next=%2Fadmin';return;}const a=await supabase.rpc('is_admin');if(a.error)throw new Error(a.error.message);if(!a.data){showError('This account is not an administrator.');return;}guard.hidden=true;app.hidden=false;await load();}catch(x){showError(x?.message||'Unknown admin error.');}}
init();
</script>
<style>.admin-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.import-card{display:grid;gap:14px;margin-bottom:24px;padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff}.import-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.import-errors{padding:14px;border-radius:12px;background:var(--danger-soft);color:var(--danger)}.import-errors p{margin:6px 0}.admin-tabs{display:flex;gap:8px;margin:20px 0}.tab{border:1px solid #ddd;background:#fff;padding:10px 16px;border-radius:10px;cursor:pointer}.tab.active{font-weight:700}.variant-row{display:grid;grid-template-columns:1.4fr 1fr .8fr .8fr .8fr auto;gap:8px;margin:8px 0}.variant-row input{min-width:0}.item-actions{display:flex;gap:8px}.field-help{display:block;color:var(--muted);font-size:.8rem;margin-top:-2px}@media(max-width:800px){.variant-row{grid-template-columns:1fr 1fr}.admin-head{flex-direction:column}}</style>
