---
/**
 * Admin → Products (/admin): add and edit toys, photos, options (variants), cost prices and categories,
 * bulk import from Excel, and quick visibility toggles.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Products | Clever Toys Admin</title>
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Catalog</p>
        <h1>Products &amp; categories</h1>
        <p id="catalog-summary">Loading catalog…</p>
      </div>
      <div class="quick-actions">
        <button id="export-catalog" class="button secondary-button" type="button" title="Products (same columns as the import template), options and categories">Export Excel</button>
        <button id="new-product" class="button" type="button">+ Add product</button>
      </div>
    </div>
    <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>
    <div id="app" hidden>
      <div class="admin-tabs" role="tablist">
        <button class="tab active" data-tab="products" type="button" role="tab">Products</button>
        <button class="tab" data-tab="categories" type="button" role="tab">Categories</button>
        <button class="tab" data-tab="import" type="button" role="tab">Excel import</button>
      </div>
      <!-- Photos still loaded from other websites (older imports): copy them into the store's storage. -->
      <div id="outside-photos" class="outside-photos" hidden>
        <p id="outside-text"></p>
        <div class="outside-actions"><button id="outside-copy" class="button" type="button">Copy photos to my storage</button><button id="outside-stop" class="small-button" type="button" hidden>Stop</button></div>
        <p id="outside-msg" class="muted" role="status"></p>
        <div id="outside-errors" class="import-errors" hidden></div>
      </div>

      <section id="products-tab" class="catalog-layout">
        <div class="catalog-list admin-panel">
          <div class="list-toolbar">
            <label class="sr-only" for="search">Search products</label>
            <input id="search" class="admin-input" type="search" placeholder="Search by name, SKU or brand" />
            <select id="category-filter" class="admin-input" aria-label="Filter by category"><option value="">All categories</option></select>
            <button id="more-filters-toggle" class="button secondary-button" type="button" aria-expanded="false" aria-controls="more-filters">Filters</button>
          </div>
          <div id="more-filters" class="more-filters" hidden>
            <label>Sort by<select id="f-sort" class="admin-input"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">Name A–Z</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="stock-asc">Stock: low to high</option><option value="stock-desc">Stock: high to low</option></select></label>
            <label>Show only<select id="f-only" class="admin-input"><option value="">Everything</option><option value="sale">On sale</option><option value="no-sale">Not on sale</option><option value="options">With options (colour, size…)</option><option value="no-options">Without options</option><option value="no-photo">No photo</option><option value="no-cost">No cost price</option><option value="no-sku">No SKU</option><option value="no-category">No category</option><option value="no-feed">Not in Google &amp; Meta</option></select></label>
            <label>Price from<input id="f-price-min" class="admin-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Any" /></label>
            <label>Price to<input id="f-price-max" class="admin-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Any" /></label>
            <label>For age<input id="f-age" class="admin-input" type="number" inputmode="numeric" min="0" max="18" step="1" placeholder="Any" /></label>
            <label>Brand<select id="f-brand" class="admin-input"><option value="">All brands</option></select></label>
            <label>Ad group label<select id="f-label" class="admin-input"><option value="">All labels</option></select></label>
            <div class="more-filters-foot"><span id="filter-result"></span><button id="f-clear" class="small-button" type="button">Clear filters</button></div>
          </div>
          <div id="product-filters" class="chip-row" role="tablist" aria-label="Filter products"></div>
          <div id="products" class="product-rows"></div>
        </div>

        <form id="product-form" class="form-card product-editor" novalidate>
          <div class="editor-head"><h2 id="form-title">Add product</h2><a id="view-on-store" class="text-link" target="_blank" rel="noopener" hidden>View on store ↗</a></div>
          <input type="hidden" name="id" />
          <label>Name<input name="name" required maxlength="160" /></label>
          <div class="field-row"><label>Slug<input name="slug" required pattern="[a-z0-9\-]+" /></label><label>SKU<input name="sku" /></label></div>
          <div class="field-row four"><label>Price (USD)<input name="price" type="number" min="0" step="0.01" required /></label><label>Sale price<input name="sale_price" type="number" min="0" step="0.01" /></label><label>Cost price<input name="cost_price" type="number" min="0" step="0.01" placeholder="What it costs you" /></label><label>Stock<input name="stock_quantity" type="number" min="0" value="0" required /></label></div>
          <p id="profit-hint" class="profit-hint" aria-live="polite"></p>
          <fieldset class="category-picker"><legend>Categories</legend><div id="category-checks" class="check-grid"></div></fieldset>
          <fieldset class="category-picker catalog-box" id="catalog-box" hidden>
            <legend>Google &amp; Meta</legend>
            <label class="catalog-toggle"><input class="toggle" name="in_feed" type="checkbox" checked /> Show in Google &amp; Meta catalogs and ads</label>
            <label>Ad group label <span>(optional)</span><input name="ad_label" maxlength="100" list="group-label-list" placeholder="e.g. Bestseller, Clearance, New" autocomplete="off" /></label>
            <datalist id="group-label-list"></datalist>
            <small class="field-help">Off keeps the toy on your website but out of the product feed. The label lets you group toys in Google Ads and Meta (custom label 1).</small>
          </fieldset>
          <fieldset class="category-picker related-picker" id="related-box" hidden>
            <legend>Related toys</legend>
            <small class="field-help">Shown first in “You may also like” on this toy’s page, in this order. The rest is filled automatically with the best matches.</small>
            <ol id="related-list" class="related-list"></ol>
            <div class="related-search"><input id="related-search" type="search" placeholder="Search a toy to add…" autocomplete="off" aria-label="Search a toy to add" /><ul id="related-results" class="related-results" hidden></ul></div>
          </fieldset>
          <div class="variant-box">
            <div class="panel-title"><h3>Variants</h3><button id="add-variant" class="small-button" type="button">+ Add variant</button></div>
            <p id="stock-from-options" class="muted stock-note" hidden>This toy’s stock is the total of its options’ stock (shown in the Stock field above).</p>
                        <div id="variant-list"></div>
            <small class="field-help">Sizes, colors or packs. Leave price empty to use the product price.</small>
          </div>
          <div class="image-box">
            <h3>Images</h3>
            <div id="image-list" class="image-list"></div>
            <label>Add images<input id="image-files" type="file" accept="image/jpeg,image/png,image/webp" multiple /></label>
            <small class="field-help">Images are converted to WebP. The first new image becomes the main image if there is none.</small>
          </div>
          <details class="more-fields">
            <summary>Details, ages &amp; SEO</summary>
            <div class="field-row"><label>Age minimum<input name="age_min" type="number" min="0" /></label><label>Age maximum<input name="age_max" type="number" min="0" /></label></div>
            <label>Brand<input name="brand" /></label>
            <label>Short description<textarea name="short_description" rows="2" maxlength="300"></textarea></label>
            <label>Description<textarea name="description" rows="5"></textarea></label>
            <label>SEO title <span>(max 70)</span><input name="seo_title" maxlength="70" /></label>
            <label>SEO description <span>(max 170)</span><textarea name="seo_description" rows="3" maxlength="170"></textarea></label>
          </details>
          <details class="more-fields" id="stock-history-box" hidden>
            <summary>Stock history <small class="muted">(last 15 days)</small></summary>
            <div id="stock-history"><small class="muted">Loading…</small></div>
          </details>
          <div class="switch-line"><label><input class="toggle" name="is_active" type="checkbox" checked /> Visible in store</label><label><input class="toggle" name="is_featured" type="checkbox" /> Featured on home page</label></div>
          <div class="form-actions"><button class="button" type="submit" id="save-product">Save product</button><button id="clear" class="button secondary-button" type="button">Clear</button></div>
          <p id="product-msg" role="status"></p>
        </form>
      </section>

      <section id="categories-tab" class="catalog-layout" hidden>
        <div class="admin-panel">
          <div class="panel-title"><h2>Categories</h2><small class="muted">Use ↑ ↓ to set the order shown in the store.</small></div>
          <div id="categories" class="category-rows"></div>
        </div>
        <form id="category-form" class="form-card product-editor">
          <h2 id="category-form-title">Add category</h2>
          <input type="hidden" name="id" />
          <label>Name<input name="name" required /></label>
          <label>Slug<input name="slug" required pattern="[a-z0-9\-]+" /></label>
          <label>Description<textarea name="description" rows="3"></textarea></label>
          <!-- Category photo: shown on the home page "Shop by category" tiles, /categories and the Shop menu. -->
          <div class="cat-photo">
            <span class="cat-photo-title">Photo <span>(optional)</span></span>
            <div class="cat-photo-box">
              <div id="cat-photo-preview" class="cat-photo-preview" aria-hidden="true">🗂️</div>
              <div class="cat-photo-actions">
                <div class="form-actions"><button id="cat-photo-pick" class="small-button" type="button">Upload photo</button><button id="cat-photo-remove" class="small-button danger-button" type="button" hidden>Remove</button></div>
                <small class="muted">JPG, PNG or WebP. Portrait or square photos look best; saved as a light WebP.</small>
              </div>
            </div>
            <input id="cat-photo-file" type="file" accept="image/jpeg,image/png,image/webp" hidden />
            <input type="hidden" name="image_url" />
          </div>
          <label>SEO title <span>(optional)</span><input name="seo_title" maxlength="70" /></label>
          <label>SEO description <span>(optional)</span><textarea name="seo_description" rows="2" maxlength="170"></textarea></label>
          <div class="switch-line"><label><input class="toggle" name="is_active" type="checkbox" checked /> Visible in store</label></div>
          <div class="form-actions"><button class="button" type="submit">Save category</button><button id="clear-category" class="button secondary-button" type="button">Clear</button></div>
          <p id="category-msg" role="status"></p>
        </form>
      </section>

      <section id="import-tab" class="admin-panel import-card" hidden>
        <h2>Excel import</h2>
        <p>Download the template, fill it in, then import. Each row is matched to the toy on your site with the same slug or SKU, or a similar name; in the preview you choose what to update, skip or add. Empty cells keep what the toy already has. Put comma-separated category names in the <strong>categories</strong> column.</p>
        <p><strong>Photos:</strong> put pictures in the <strong>image_1</strong>, <strong>image_2</strong>… columns (as many as you want: add <strong>image_6</strong>, <strong>image_7</strong>… columns for more): inside the cell (Excel: Insert → Pictures → Place in Cell) or over the cell, or type a web link (the photo is downloaded and saved in your own storage as WebP). <strong>image_1</strong> becomes the main photo. A row with pictures replaces that product’s photos; a row without keeps them.</p>
        <div class="import-actions"><button id="template" class="button secondary-button" type="button">Download Excel template</button><input id="file" type="file" accept=".xlsx,.xls,.csv" /><button id="import" class="button" type="button">Preview import</button></div>
        <p id="msg" role="status"></p>
        <div id="undo-box" class="undo-box" hidden><span id="undo-text"></span><button id="undo-import" class="button secondary-button" type="button">↩ Undo last import</button><button id="undo-keep" class="small-button" type="button" title="Keep the import and free the old photos">Keep changes</button></div>
        <!-- Preview: what the file will do, before anything is saved. -->
        <div id="import-preview" class="import-preview" hidden>
          <div class="import-summary" id="import-summary"></div>
          <div class="import-options" id="import-options" hidden></div>
          <div class="import-toolbar"><div id="import-tabs" class="chip-row" aria-label="Show rows"></div><div class="import-bulk"><span>For all rows shown:</span><button type="button" class="small-button" data-import-bulk="update">Update</button><button type="button" class="small-button" data-import-bulk="new">Add as new</button><button type="button" class="small-button" data-import-bulk="skip">Skip</button></div></div>
          <div class="import-table-wrap"><table class="import-table"><thead><tr><th>Row</th><th>Photos</th><th>In your file</th><th>On your site</th><th>What changes</th><th>Do</th></tr></thead><tbody id="import-rows"></tbody></table></div>
          <div class="import-actions"><button id="import-confirm" class="button" type="button">Confirm import</button><button id="import-cancel" class="button secondary-button" type="button">Cancel</button></div>
        </div>
        <div id="errors" class="import-errors" hidden></div>
      </section>
    </div>
  </div>
</main>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js" defer></script>
<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { allowPage } from '../../scripts/admin-access';
import { smartFilter } from '../../scripts/smart-search';
import { readSheetPictures, type SheetPicture } from '../../scripts/xlsx-images';
import { exactMatch, rankCandidates, findDuplicates, POSSIBLE_MATCH, STRONG_MATCH, type Candidate } from '../../scripts/import-match';
import { downloadImportTemplate, headersWithImages } from '../../scripts/import-template';
import { exportXlsxSheets, exportName } from '../../scripts/table-export';

type Row = Record<string, any>;
const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const slugify = (v: unknown) => String(v || '').toLowerCase().trim().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
const num = (v: unknown, d: number | null = null) => { if (v === null || v === undefined || String(v).trim() === '') return d; const n = Number(String(v).replace(/[$,]/g, '').trim()); return Number.isFinite(n) ? n : d; };
const int = (v: unknown, d: number | null = null) => { const n = num(v, d); return n === null ? d : Math.trunc(n); };
const money = (n: unknown) => `$${Number(n || 0).toFixed(2)}`;
const toast = (message: string, tone = 'success') => (window as any).adminToast?.(message, tone);
const friendly = (message: string) => /duplicate key|unique/i.test(message) ? 'That slug or SKU is already used by another item. Choose a different one.' : message;

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let categories: Row[] = [];
let products: Row[] = [];
let links: Row[] = [];
let variants: Row[] = [];
let images: Row[] = [];
let productFilter = 'all';
// Possible duplicates: products whose names look like the same toy (src/scripts/import-match.ts).
// Pairs marked "Not a duplicate" are saved in product_not_duplicates (supabase/product_duplicates.sql).
const DUPLICATE_MATCH = 0.8;
let duplicates = new Map<string, Candidate<Row>[]>();
let notDuplicates = new Set<string>();
// Product → the products it was marked "Not a duplicate" of (the Not duplicates view).
let notDuplicateOf = new Map<string, string[]>();
let notDuplicatesReady = false;
const pairKey = (a: string, b: string) => (a < b ? `${a}|${b}` : `${b}|${a}`);
function findProductDuplicates() {
  duplicates = new Map();
  notDuplicateOf = new Map();
  const known = new Set(products.map((p) => String(p.id)));
  for (const key of notDuplicates) {
    const [a, b] = key.split('|');
    if (!known.has(a) || !known.has(b)) continue;
    notDuplicateOf.set(a, [...(notDuplicateOf.get(a) || []), b]);
    notDuplicateOf.set(b, [...(notDuplicateOf.get(b) || []), a]);
  }
  for (const [id, list] of findDuplicates(products, DUPLICATE_MATCH)) {
    const left = list.filter((c) => !notDuplicates.has(pairKey(id, c.product.id)));
    if (left.length) duplicates.set(id, left);
  }
}
// Products with visible options: their stock is the options' total (kept by supabase/variant_stock.sql).
let withOptions = new Set<string>();
// "Low stock" limit from Admin → Branding & settings (supabase/cms.sql); 5 before that.
let lowStockAt = 5;
// Public address of the store's own photo storage (set in init); other addresses are outside photos.
let storageBase = '';
const isOwnPhoto = (url: unknown) => Boolean(storageBase) && String(url || '').startsWith(storageBase);
const params = new URLSearchParams(location.search);
if (['active', 'hidden', 'featured', 'low', 'out', 'duplicates', 'not-duplicates'].includes(params.get('filter') || '')) productFilter = String(params.get('filter'));
// ?q= (from the admin search) starts with that text in the search box.
if (params.get('q')) (document.getElementById('search') as HTMLInputElement).value = params.get('q') || '';

const form = $<HTMLFormElement>('#product-form');
const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

/**
 * Every row of a query. The database sends at most 1000 rows per request, so bigger lists (photos,
 * category links…) are read 1000 at a time. The query needs an order that ends on a unique column.
 */
async function selectAll(query: () => any): Promise<{ data: Row[]; error: { message: string } | null }> {
  const data: Row[] = [];
  for (let from = 0; ; from += 1000) {
    const r = await query().range(from, from + 999);
    if (r.error) return { data, error: r.error };
    data.push(...((r.data ?? []) as Row[]));
    if ((r.data ?? []).length < 1000) return { data, error: null };
  }
}

async function load() {
  const [c, p, l, st, vo] = await Promise.all([
    supabase.from('categories').select('*').order('sort_order').order('name'),
    selectAll(() => supabase.from('products').select('*').order('created_at', { ascending: false }).order('id')),
    selectAll(() => supabase.from('product_categories').select('product_id,category_id').order('product_id').order('category_id')),
    supabase.from('store_settings').select('*').eq('id', 'default').maybeSingle(),
    supabase.from('product_variants').select('product_id').eq('is_active', true)
  ]);
  withOptions = new Set(((vo.data ?? []) as Row[]).map((v) => String(v.product_id)));
  lowStockAt = Math.max(0, Number((st.data as Row | null)?.low_stock_threshold ?? 5));
  const error = c.error || p.error;
  if (error) throw new Error(error.message);
  categories = (c.data ?? []) as Row[];
  products = (p.data ?? []) as Row[];
  links = (l.data ?? []) as Row[];
  const nd = await selectAll(() => supabase.from('product_not_duplicates').select('product_a,product_b').order('product_a').order('product_b'));
  notDuplicatesReady = !nd.error;
  notDuplicates = new Set(nd.data.map((r) => pairKey(String(r.product_a), String(r.product_b))));
  findProductDuplicates();
  $('#category-filter').innerHTML = '<option value="">All categories</option>' + categories.map((cat) => `<option value="${cat.id}">${esc(cat.name)}</option>`).join('');
  renderCategoryChecks(currentCategoryIds());
  // Google & Meta box: available once supabase/catalog_controls.sql has added its columns.
  const adCheck = await supabase.from('products').select('in_feed,ad_label').limit(1);
  adFieldsReady = !adCheck.error;
  $('#catalog-box').hidden = !adFieldsReady;
  const labels = [...new Set(products.map((x) => String(x.ad_label || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b));
  $('#group-label-list').innerHTML = labels.map((label) => `<option value="${esc(label)}"></option>`).join('');
  // Filter lists: brands and ad group labels in use (keeps the current choice).
  const fill = (sel: string, first: string, values: string[]) => { const el = $<HTMLSelectElement>(sel); const was = el.value; el.innerHTML = `<option value="">${first}</option>` + values.map((v) => `<option value="${esc(v)}">${esc(v)}</option>`).join(''); el.value = values.includes(was) ? was : ''; };
  fill('#f-brand', 'All brands', [...new Set(products.map((x) => String(x.brand || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b)));
  fill('#f-label', 'All labels', labels);
  $('#f-brand').closest('label')!.hidden = $<HTMLSelectElement>('#f-brand').options.length < 2;
  $('#f-label').closest('label')!.hidden = !labels.length;
  // Related toys picker: available once supabase/related_products.sql has been run.
  const rel = await supabase.from('product_relations').select('product_id').limit(1);
  relationsReady = !rel.error;
  renderRelated();
  renderProducts();
  renderCategories();
  const active = products.filter((x) => x.is_active).length;
  $('#catalog-summary').textContent = `${products.length} products (${active} visible) · ${categories.length} categories`;
  await renderOutsidePhotos();
}

const currentCategoryIds = () => [...form.querySelectorAll<HTMLInputElement>('#category-checks input:checked')].map((x) => x.value);
function renderCategoryChecks(selected: string[] = []) {
  const set = new Set(selected);
  $('#category-checks').innerHTML = categories.length ? categories.map((cat) => `<label class="check-pill"><input type="checkbox" name="category_ids" value="${cat.id}"${set.has(cat.id) ? ' checked' : ''} /> ${esc(cat.name)}</label>`).join('') : '<small class="muted">Create a category first.</small>';
}

const FILTERS: Array<[string, string, (p: Row) => boolean]> = [
  ['all', 'All', () => true],
  ['active', 'Visible', (p) => p.is_active],
  ['hidden', 'Hidden', (p) => !p.is_active],
  ['featured', 'Featured', (p) => p.is_featured],
  ['low', 'Low stock', (p) => p.stock_quantity > 0 && p.stock_quantity <= lowStockAt],
  ['out', 'Out of stock', (p) => p.stock_quantity <= 0],
  ['duplicates', 'Possible duplicates', (p) => duplicates.has(p.id)],
  ['not-duplicates', 'Not duplicates', (p) => notDuplicateOf.has(p.id)]
];

// The "Filters" panel: extra filters and sorting on top of the chips, the search and the category.
const ONLY: Record<string, (p: Row) => boolean> = {
  sale: (p) => p.sale_price != null,
  'no-sale': (p) => p.sale_price == null,
  options: (p) => withOptions.has(p.id),
  'no-options': (p) => !withOptions.has(p.id),
  'no-photo': (p) => !p.primary_image_url,
  'no-cost': (p) => p.cost_price == null || p.cost_price === '',
  'no-sku': (p) => !String(p.sku || '').trim(),
  'no-category': (p) => !p.category_id && !links.some((l) => l.product_id === p.id),
  'no-feed': (p) => p.in_feed === false
};
const shownPrice = (p: Row) => Number(p.sale_price ?? p.price ?? 0);
function moreFilters() {
  const value = (sel: string) => $<HTMLInputElement>(sel).value.trim();
  const numberOrNull = (sel: string) => (value(sel) === '' || !Number.isFinite(Number(value(sel))) ? null : Number(value(sel)));
  return { sort: value('#f-sort') || 'newest', only: value('#f-only'), priceMin: numberOrNull('#f-price-min'), priceMax: numberOrNull('#f-price-max'), age: numberOrNull('#f-age'), brand: value('#f-brand'), label: value('#f-label') };
}
function passesMore(p: Row, f: ReturnType<typeof moreFilters>) {
  if (f.only && ONLY[f.only] && !ONLY[f.only](p)) return false;
  if (f.priceMin !== null && shownPrice(p) < f.priceMin) return false;
  if (f.priceMax !== null && shownPrice(p) > f.priceMax) return false;
  // A toy suits an age when it is inside its age range (an empty end means no limit).
  if (f.age !== null && ((p.age_min != null && Number(p.age_min) > f.age) || (p.age_max != null && Number(p.age_max) < f.age))) return false;
  if (f.brand && String(p.brand || '').trim() !== f.brand) return false;
  if (f.label && String(p.ad_label || '').trim() !== f.label) return false;
  return true;
}
const SORTS: Record<string, (a: Row, b: Row) => number> = {
  oldest: (a, b) => String(a.created_at).localeCompare(String(b.created_at)),
  name: (a, b) => String(a.name).localeCompare(String(b.name)),
  'price-asc': (a, b) => shownPrice(a) - shownPrice(b),
  'price-desc': (a, b) => shownPrice(b) - shownPrice(a),
  'stock-asc': (a, b) => Number(a.stock_quantity) - Number(b.stock_quantity),
  'stock-desc': (a, b) => Number(b.stock_quantity) - Number(a.stock_quantity)
};

function renderProducts() {
  // The duplicates chips only show when there are some.
  const chipShown = (id: string) => (id === 'duplicates' ? duplicates.size > 0 : id === 'not-duplicates' ? notDuplicateOf.size > 0 : true);
  if (!chipShown(productFilter)) productFilter = 'all';
  $('#product-filters').innerHTML = FILTERS.filter(([id]) => chipShown(id)).map(([id, label, test]) => `<button type="button" class="chip${productFilter === id ? ' active' : ''}${id === 'duplicates' ? ' dup-chip' : ''}" data-filter="${id}">${id === 'duplicates' ? '⚠ ' : ''}${label} <b>${products.filter(test).length}</b></button>`).join('');
  const q = $<HTMLInputElement>('#search').value.trim().toLowerCase();
  const cat = $<HTMLSelectElement>('#category-filter').value;
  const test = FILTERS.find(([id]) => id === productFilter)?.[2] ?? (() => true);
  const inCategory = cat ? new Set(links.filter((l) => l.category_id === cat).map((l) => l.product_id)) : null;
  // Smart search: any word order, small typos and plurals, name first (src/scripts/smart-search.ts).
  const catName = new Map(categories.map((c: any) => [c.id, c.name]));
  const more = moreFilters();
  const list = smartFilter(products.filter((p) => test(p) && (!inCategory || inCategory.has(p.id) || p.category_id === cat) && passesMore(p, more)), q, (p: any) => [[p.name, 3], [p.sku, 2], [p.brand, 2], [catName.get(p.category_id), 1], [p.short_description, 1]]);
  // Search results stay in best-match order unless a sort is chosen.
  if (SORTS[more.sort]) list.sort(SORTS[more.sort]);
  else if (productFilter === 'duplicates' && !q) list.splice(0, list.length, ...pairOrder(list, (id) => (duplicates.get(id) || []).map((c) => c.product.id), (p) => duplicates.get(p.id)?.[0]?.score ?? 0));
  else if (productFilter === 'not-duplicates' && !q) list.splice(0, list.length, ...pairOrder(list, (id) => notDuplicateOf.get(id) || [], () => 0));
  const extra = ['only', 'priceMin', 'priceMax', 'age', 'brand', 'label'].filter((k) => (more as any)[k] !== null && (more as any)[k] !== '').length + (more.sort !== 'newest' ? 1 : 0);
  $('#more-filters-toggle').textContent = extra ? `Filters (${extra})` : 'Filters';
  $('#filter-result').textContent = `Showing ${list.length} of ${products.length} products`;
  const editingId = field('id').value;
  $('#products').innerHTML = list.length ? list.map((p) => {
    const price = Number(p.sale_price ?? p.price);
    const stockClass = p.stock_quantity <= 0 ? 'out' : p.stock_quantity <= lowStockAt ? 'low' : '';
    return `<div class="product-row${editingId === p.id ? ' editing' : ''}${p.is_active ? '' : ' is-hidden'}">
      <div class="product-thumb">${p.primary_image_url ? `<img src="${esc(p.primary_image_url)}" alt="" loading="lazy" />` : '🧸'}</div>
      <div class="product-main"><button type="button" class="product-name" data-edit="${p.id}">${esc(p.name)}</button><small>${esc(p.sku || 'No SKU')} · ${money(price)}${p.sale_price != null ? ` <s>${money(p.price)}</s>` : ''}${p.cost_price != null && p.cost_price !== '' ? ` · cost ${money(p.cost_price)}${price ? ` (${Math.round(((price - Number(p.cost_price)) / price) * 100)}% margin)` : ''}` : ' · <span class="no-cost">no cost set</span>'}${p.is_featured ? ' · ⭐ Featured' : ''}${p.in_feed === false ? ' · <span class="off-catalog">not in Google/Meta</span>' : ''}${p.ad_label ? ` · 🏷️ ${esc(p.ad_label)}` : ''}${duplicates.has(p.id) && productFilter !== 'duplicates' ? ' · <span class="dup-flag">possible duplicate</span>' : ''}</small>${productFilter === 'duplicates' ? duplicateNote(p) : productFilter === 'not-duplicates' ? notDuplicateNote(p) : ''}</div>
      ${withOptions.has(p.id)
        ? `<label class="stock-edit ${stockClass} from-options" title="Total of this toy's options. Change the stock in its options.">Stock<input type="number" value="${Number(p.stock_quantity)}" readonly tabindex="-1" aria-label="Stock for ${esc(p.name)}: total of its options" /></label>`
        : `<label class="stock-edit ${stockClass}" title="Stock">Stock<input type="number" min="0" value="${Number(p.stock_quantity)}" data-stock="${p.id}" aria-label="Stock for ${esc(p.name)}" /></label>`}
      <label class="row-toggle" title="Visible in store"><input class="toggle" type="checkbox" data-active="${p.id}"${p.is_active ? ' checked' : ''} aria-label="Visible: ${esc(p.name)}" /></label>
      <div class="item-actions"><button class="small-button" data-edit="${p.id}" type="button">Edit</button><button class="small-button" data-duplicate="${p.id}" type="button" title="Duplicate">Copy</button>${p.is_active === false ? '' : `<a class="small-button" href="/product/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener" title="View on store" aria-label="View ${esc(p.name)} on the store">↗</a>`}<button class="small-button danger-button" data-del="${p.id}" type="button" aria-label="Delete ${esc(p.name)}">Delete</button></div>
    </div>`;
  }).join('') : '<div class="empty-state"><h2>No products here</h2><p>Try another filter or add a product.</p></div>';
}

/** The duplicates lists: each product followed by the products it is paired with, the best pairs first. */
function pairOrder(list: Row[], partners: (id: string) => string[], best: (p: Row) => number) {
  const shown = new Map(list.map((p) => [p.id, p]));
  const out: Row[] = [];
  const placed = new Set<string>();
  for (const p of [...list].sort((a, b) => best(b) - best(a) || String(a.name).localeCompare(String(b.name)))) {
    if (placed.has(p.id)) continue;
    out.push(p); placed.add(p.id);
    for (const id of partners(p.id)) if (shown.has(id) && !placed.has(id)) { out.push(shown.get(id)!); placed.add(id); }
  }
  return out;
}
/** "Marked different from" line in the Not duplicates list, with Undo (the pair is suggested again). */
function notDuplicateNote(p: Row) {
  const others = (notDuplicateOf.get(p.id) || []).map((id) => products.find((x) => x.id === id)).filter(Boolean) as Row[];
  return others.length ? `<div class="dup-note not-dup-note"><span>Marked different from</span>${others.map((o) => `<span class="dup-match"><button type="button" class="text-link" data-edit="${o.id}">${esc(o.name)}</button>${o.is_active ? '' : ' <small>hidden</small>'}<button type="button" class="small-button" data-undo-not-dup="${pairKey(p.id, o.id)}" title="Show this pair in Possible duplicates again">Undo</button></span>`).join('')}</div>` : '';
}
/** "Looks like" line under a product in the Possible duplicates list. */
function duplicateNote(p: Row) {
  const list = duplicates.get(p.id) || [];
  return list.length ? `<div class="dup-note"><span>Looks like</span>${list.map((c) => `<span class="dup-match"><button type="button" class="text-link" data-edit="${c.product.id}">${esc(c.product.name)}</button> <small>${Math.round(c.score * 100)}%${c.product.is_active ? '' : ' · hidden'}</small>${notDuplicatesReady ? `<button type="button" class="small-button" data-not-dup="${pairKey(p.id, c.product.id)}" title="These are different toys: stop suggesting this pair">Not a duplicate</button>` : ''}</span>`).join('')}</div>` : '';
}

function renderCategories() {
  const counts = new Map<string, number>();
  for (const l of links) counts.set(l.category_id, (counts.get(l.category_id) || 0) + 1);
