function renderVariants() {
  const field = (label: string, key: string, v: Row, attrs: string, cls = '') => `<label class="v-field ${cls}"><span>${label}</span><input data-v="${key}" value="${esc(v[key] ?? '')}" ${attrs}></label>`;
