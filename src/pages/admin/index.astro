}

async function editProduct(id: string) {
  const p = products.find((x) => x.id === id);
  if (!p) return;
  switchTab('products');
  clearForm(false);
  for (const [k, v] of Object.entries(p)) { const e = form.elements.namedItem(k) as HTMLInputElement | null; if (!e || k === 'category_id') continue; if (e.type === 'checkbox') e.checked = Boolean(v); else e.value = v ?? ''; }
  field('slug').dataset.auto = '';
  const ids = links.filter((l) => l.product_id === id).map((l) => l.category_id);
  renderCategoryChecks(ids.length ? ids : p.category_id ? [p.category_id] : []);
  updateProfitHint();
  $('#form-title').textContent = `Edit: ${p.name}`;
  // Hidden products have no public page, so only offer the link for visible ones.
  const view = $<HTMLAnchorElement>('#view-on-store'); view.href = `/product/${encodeURIComponent(p.slug)}`; view.hidden = p.is_active === false;
  const [v, im] = await Promise.all([
    supabase.from('product_variants').select('*').eq('product_id', id).order('created_at'),
    supabase.from('product_images').select('*').eq('product_id', id).order('sort_order')
  ]);
  variants = (v.data ?? []) as Row[];
  images = (im.data ?? []) as Row[];
  renderVariants();
  renderImages();
  loadStockHistory(id);
  loadRelated(id);
  renderProducts();
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  field('name').focus({ preventScroll: true });
}

// Every stock change for the product being edited: orders, cancellations and manual edits (supabase/cms.sql).
const STOCK_REASONS: Record<string, string> = { order: 'Sold', order_cancelled: 'Order cancelled', order_restored: 'Order re-opened', manual: 'Edited by admin', created: 'Added' };
async function loadStockHistory(productId: string) {
  const box = $('#stock-history-box');
  const r = await supabase.from('stock_movements').select('change,stock_after,reason,variant_id,order_id,created_at,orders(order_number)').eq('product_id', productId).order('created_at', { ascending: false }).limit(40);
  if (field('id').value !== productId) return; // another product was opened meanwhile
  if (r.error) { box.hidden = true; return; } // table not created yet
  box.hidden = false;
  const rows = (r.data ?? []) as Row[];
  const variantName = new Map(variants.map((v) => [v.id, v.name]));
  $('#stock-history').innerHTML = rows.length ? `<table class="stock-history"><thead><tr><th>When</th><th>Change</th><th>Left</th><th>Why</th></tr></thead><tbody>${rows.map((m) => `<tr><td>${new Date(m.created_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })}</td><td class="${m.change < 0 ? 'neg' : 'pos'}">${m.change > 0 ? '+' : ''}${m.change}</td><td>${m.stock_after}</td><td>${esc(STOCK_REASONS[m.reason] || m.reason)}${m.variant_id ? ` · ${esc(variantName.get(m.variant_id) || 'option')}` : ''}${m.orders?.order_number ? ` · <a class="text-link" href="/admin/orders?q=${encodeURIComponent(m.orders.order_number)}">${esc(m.orders.order_number)}</a>` : ''}</td></tr>`).join('')}</tbody></table>` : '<small class="muted">No stock changes in the last 15 days.</small>';
}

function clearForm(focus = true) {
  form.reset();
  $('#stock-history-box').hidden = true;
  field('id').value = '';
  field('is_active').checked = true;
  field('slug').dataset.auto = '1';
  renderCategoryChecks([]);
  relatedIds = []; renderRelated();
  variants = []; images = [];
