---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<header class="site-header"><div class="container header-inner"><a class="logo" href="/admin">Clever Toys Admin</a><nav class="main-nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/orders">Orders</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><p class="eyebrow">Store management</p><h1>Products &amp; Categories</h1><p>Manage products and bulk-import your Excel catalog.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div>
<div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><div id="guard" class="empty-state">Checking admin access…</div><div id="error" class="empty-state" hidden></div>
<div id="app" hidden><section class="import-card"><h2>Excel import</h2><p>Download the template, fill it, then import your products.</p><div class="import-actions"><button id="template" class="button secondary-button" type="button">Download Excel Template</button><input id="file" type="file" accept=".xlsx,.xls,.csv" /><button id="import" class="button" type="button">Import Excel</button></div><p id="msg" role="status"></p><div id="errors" class="import-errors" hidden></div></section><section class="admin-panel"><div class="panel-title"><h2>Products</h2><input id="search" placeholder="Search products…" /></div><div id="products" class="admin-list"></div></section></div></div></main>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#cfg'); const url=cfg?.dataset.url; const key=cfg?.dataset.key; const guard=document.querySelector('#guard'); const app=document.querySelector('#app'); const errorBox=document.querySelector('#error'); const msg=document.querySelector('#msg'); const errorsBox=document.querySelector('#errors'); const productsBox=document.querySelector('#products'); let supabase; let products=[];
const esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));
const slugify=v=>String(v||'').toLowerCase().trim().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const num=(v,d=null)=>{if(v===null||v===undefined||String(v).trim()==='')return d;const n=Number(String(v).replace(/[$,]/g,'').trim());return Number.isFinite(n)?n:d;};
const int=(v,d=null)=>{const n=num(v,d);return n===null?d:Math.trunc(n);};
const bool=(v,d=false)=>{if(v===true||v===1)return true;if(v===false||v===0||v===null||v===undefined||String(v).trim()==='')return d;return ['true','1','yes','y'].includes(String(v).trim().toLowerCase());};
async function load(){const r=await supabase.from('products').select('*').order('created_at',{ascending:false});if(r.error)throw new Error(r.error.message);products=r.data||[];render();}
function render(){const q=(document.querySelector('#search').value||'').toLowerCase();const list=products.filter(p=>p.name.toLowerCase().includes(q)||String(p.sku||'').toLowerCase().includes(q));productsBox.innerHTML=list.length?list.map(p=>'<div class="admin-item"><div><strong>'+esc(p.name)+'</strong><small>'+esc(p.sku||'No SKU')+' · $'+Number(p.sale_price??p.price).toFixed(2)+' · stock '+p.stock_quantity+'</small></div></div>').join(''):'<p>No products found.</p>';}
function showError(text){guard.hidden=true;app.hidden=true;errorBox.hidden=false;errorBox.innerHTML='<h2>Admin access could not be verified</h2><p>'+esc(text)+'</p><button class="button" onclick="location.reload()">Try again</button>';}
document.querySelector('#search').oninput=render;
document.querySelector('#logout').onclick=async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';};
document.querySelector('#template').onclick=()=>{if(!window.XLSX){msg.textContent='Excel tools are still loading.';return;}const h=['name','slug','sku','category','price','sale_price','stock_quantity','age_min','age_max','brand','short_description','description','primary_image_url','image_1','image_2','image_3','seo_title','seo_description','is_active','is_featured'];const r=[h,['Piano Game','piano-game','CT-001','Educational Toys',8.8,'',30,3,8,'Clever Toys','Example short description','Example full description','','','','','Piano Game for Kids | Clever Toys','Shop toys in Lebanon.',true,false]];const ws=XLSX.utils.aoa_to_sheet(r);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Products');XLSX.writeFile(wb,'Clever_Toys_Product_Import_Template.xlsx');};
document.querySelector('#import').onclick=async()=>{const file=document.querySelector('#file').files?.[0];if(!file){msg.textContent='Choose an Excel or CSV file first.';return;}if(!window.XLSX){msg.textContent='Excel reader is still loading.';return;}msg.textContent='Importing…';errorsBox.hidden=true;errorsBox.innerHTML='';try{const wb=XLSX.read(await file.arrayBuffer(),{type:'array',cellDates:false});const rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''});if(!rows.length)throw new Error('No product rows found.');let created=0,updated=0;const errors=[];for(let i=0;i<rows.length;i++){const row=rows[i];try{const name=String(row.name??row.Name??'').trim();if(!name)throw new Error('Missing name');const slug=slugify(row.slug??row.Slug??name);const price=num(row.price??row.Price,null);if(price===null||price<0)throw new Error('Invalid price');const rawSale=row.sale_price??row.SalePrice??'';const sale=num(rawSale,null);if(sale!==null&&(sale<0||sale>price))throw new Error('Invalid sale_price');const stock=int(row.stock_quantity??row.Stock,0);if(stock<0)throw new Error('Invalid stock_quantity');const ageMin=int(row.age_min,null);const ageMax=int(row.age_max,null);if(ageMin!==null&&ageMax!==null&&ageMax<ageMin)throw new Error('age_max is smaller than age_min');const payload={name,slug,sku:String(row.sku??row.SKU??'').trim()||null,price,sale_price:sale,stock_quantity:stock,age_min:ageMin,age_max:ageMax,brand:String(row.brand??'').trim()||null,short_description:String(row.short_description??''),description:String(row.description??''),primary_image_url:String(row.primary_image_url??'').trim()||null,seo_title:String(row.seo_title??'').trim()||null,seo_description:String(row.seo_description??'').trim()||null,is_active:bool(row.is_active,true),is_featured:bool(row.is_featured,false),updated_at:new Date().toISOString()};let existing=products.find(p=>p.slug===slug);if(!existing&&payload.sku)existing=products.find(p=>p.sku===payload.sku);const r=existing?await supabase.from('products').update(payload).eq('id',existing.id).select().single():await supabase.from('products').insert(payload).select().single();if(r.error)throw new Error(r.error.message);if(existing)updated++;else created++;}catch(e){errors.push('Row '+(i+2)+': '+(e?.message||'Unknown error'));}}msg.textContent='Import complete: '+created+' created, '+updated+' updated, '+errors.length+' failed.';if(errors.length){errorsBox.hidden=false;errorsBox.innerHTML='<strong>Import errors</strong>'+errors.slice(0,20).map(e=>'<p>'+esc(e)+'</p>').join('');}await load();}catch(e){msg.textContent=e?.message||'Import failed.';}};
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const s=await supabase.auth.getSession();if(s.error)throw new Error(s.error.message);if(!s.data.session?.user){location.href='/login?next=%2Fadmin';return;}const a=await supabase.rpc('is_admin');if(a.error)throw new Error(a.error.message);if(!a.data){showError('This account is not an administrator.');return;}guard.hidden=true;app.hidden=false;await load();}catch(e){showError(e?.message||'Unknown admin error.');}}
init();
</script>
<style>.import-card{display:grid;gap:14px;margin-bottom:24px;padding:22px;border:1px solid #e5e7eb;border-radius:16px;background:#fff}.import-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.import-errors{margin-top:12px;padding:14px;border-radius:12px;background:#fef2f2;color:#991b1b}.import-errors p{margin:6px 0}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.admin-item{display:flex;justify-content:space-between;gap:16px;align-items:center}@media(max-width:700px){.admin-head{align-items:flex-start}}</style>
