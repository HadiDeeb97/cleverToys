}
$('#variant-list').addEventListener('input', (event) => { if ((event.target as HTMLElement).dataset.v === 'stock_quantity') syncProductStockField(); });
const readVariants = () => document.querySelectorAll<HTMLElement>('.variant-row').forEach((row) => { const i = Number(row.dataset.i); row.querySelectorAll<HTMLInputElement>('[data-v]').forEach((el) => { variants[i][el.dataset.v!] = el.value; }); });

