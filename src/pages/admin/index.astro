    <div class="product-main"><button type="button" class="product-name" data-edit-cat="${c.id}">${esc(c.name)}</button><small>/${esc(c.slug)} · ${counts.get(c.id) || 0} products${c.image_url ? '' : ' · no photo'}${c.is_active === false ? ' · hidden' : ''}</small></div>
