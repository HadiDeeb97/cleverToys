// The product's own photos (main first), for choosing an option's photo (supabase/variant_images.sql).
function productPhotos() {
  const product = products.find((p) => p.id === field('id').value);
  return [product?.primary_image_url, ...images.map((img) => img.image_url)].filter((url, i, all): url is string => Boolean(url) && all.indexOf(url) === i);
}
/** "Photo" strip under an option: None, or one of the product's photos (shown when the shopper picks it). */
function variantPhotoPicker(v: Row, i: number) {
  const photos = productPhotos();
  const chosen = v.image_url || '';
  const tiles = photos.map((url, n) => `<button type="button" class="v-photo${chosen === url ? ' chosen' : ''}" data-vphoto="${i}" data-url="${esc(url)}" aria-pressed="${chosen === url}" aria-label="Use photo ${n + 1}"><img src="${esc(url)}" alt="" loading="lazy" /></button>`).join('');
  return `<div class="v-photos"><span>Photo</span>${photos.length
    ? `<button type="button" class="v-photo v-photo-none${chosen ? '' : ' chosen'}" data-vphoto="${i}" data-url="" aria-pressed="${!chosen}">None</button>${tiles}`
    : '<small class="muted">Add product photos below and save, then choose one here.</small>'}</div>`;
}
// With options, the product's Stock field shows their total and can't be typed in.
function syncProductStockField() {
  const stock = field('stock_quantity');
  const rows = [...document.querySelectorAll<HTMLElement>('.variant-row')].filter((row) => variants[Number(row.dataset.i)]?.is_active !== false);
