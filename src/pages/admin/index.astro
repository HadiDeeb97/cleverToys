// An empty or missing cost_price cell keeps the cost already saved, so older files never erase costs.
const costFromRow = (row: Row) => { const cost = num(row.cost_price ?? row['cost price'] ?? row.cost); return cost === null ? {} : { cost_price: Math.max(0, cost) }; };

// ---------- Photos in the Excel file (src/scripts/xlsx-images.ts) ----------
type ImportPhoto = { slot: number; order: number; picture?: SheetPicture; url?: string };
const BROWSER_IMAGE = /^(png|jpeg|gif|webp|bmp|avif)$/;

/** image_1…image_5 (also "Image 2", "photo_3", "picture 4"; a plain "image" or "main image" is 1) → photo number. */
function photoSlot(header: string) {
  const h = header.trim().toLowerCase();
  const m = /^(?:image|photo|picture|img)[\s_-]*([1-9])$/.exec(h);
  if (m) return Number(m[1]);
  return /^(?:main[\s_-]*)?(?:image|photo|picture)$/.test(h) ? 1 : 0;
}

/**
 * Photos for each sheet row, in order: image_1 first (the main photo), then image_2… Pictures in other
 * columns of the row come last. Web links typed in the image cells (or the older primary_image_url
 * column) count too.
 */
function photosByRow(ws: any, XLSX: any, pictures: SheetPicture[], rows: Row[]) {
  const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
  const headerRow = range.s.r;
  const slotOfCol = new Map<number, number>();
  const headerOfCol = new Map<number, string>();
  for (let c = range.s.c; c <= range.e.c; c++) {
    const text = String(ws[XLSX.utils.encode_cell({ r: headerRow, c })]?.v ?? '');
    headerOfCol.set(c, text);
    const slot = photoSlot(text);
    if (slot) slotOfCol.set(c, slot);
  }
  const byRow = new Map<number, ImportPhoto[]>();
  const add = (row: number, photo: ImportPhoto) => { if (!byRow.has(row)) byRow.set(row, []); byRow.get(row)!.push(photo); };
  for (const picture of pictures) {
    if (picture.row <= headerRow) continue;
    // A floating picture that spills into the next column still belongs to its image column.
    const col = slotOfCol.has(picture.col) ? picture.col : picture.cols.find((c) => slotOfCol.has(c));
    const slot = col !== undefined ? slotOfCol.get(col)! : 100 + picture.col;
    add(picture.row, { slot, order: picture.col, picture: picture.url ? undefined : picture, url: picture.url });
  }
  for (const row of rows) {
    const sheetRow = Number(row.__rowNum__);
    for (const [col, slot] of slotOfCol) {
      const text = String(row[headerOfCol.get(col) || ''] ?? '').trim();
      if (/^https?:\/\//i.test(text)) add(sheetRow, { slot, order: col, url: text });
    }
    const legacy = String(row.primary_image_url || '').trim();
    if (/^https?:\/\//i.test(legacy) && !(byRow.get(sheetRow) || []).some((p) => p.slot === 1)) add(sheetRow, { slot: 1, order: -1, url: legacy });
  }
  for (const list of byRow.values()) list.sort((a, b) => a.slot - b.slot || a.order - b.order);
  return byRow;
}

/** Uploads one photo (resized to WebP) and returns its address; web links are kept as they are. */
async function uploadImportPhoto(productId: string, photo: ImportPhoto, n: number) {
  if (photo.url) return photo.url;
  const picture = photo.picture!;
  if (!BROWSER_IMAGE.test(picture.type || '')) throw new Error(`picture ${n} is a .${picture.type} file, which can't be used on the website. Insert it as a PNG or JPG picture.`);
  const blob = await toWebp(new Blob([picture.data as BlobPart], { type: `image/${picture.type}` }));
  const path = `${productId}/${Date.now()}-${n}.webp`;
  const up = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false });
  if (up.error) throw new Error(up.error.message);
  return supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;
}

/** The product's photos become exactly these, the first one as the main photo. */
async function replaceProductPhotos(productId: string, name: string, urls: string[]) {
  const old = await supabase.from('product_images').select('image_url').eq('product_id', productId);
  const del = await supabase.from('product_images').delete().eq('product_id', productId);
  if (del.error) throw new Error(del.error.message);
  const ins = await supabase.from('product_images').insert(urls.map((image_url, i) => ({ product_id: productId, image_url, alt_text: name, sort_order: i, is_primary: i === 0 })));
  if (ins.error) throw new Error(ins.error.message);
  const up = await supabase.from('products').update({ primary_image_url: urls[0] }).eq('id', productId);
  if (up.error) throw new Error(up.error.message);
  // Old uploaded files that are no longer used are removed from storage (best effort).
  const marker = '/storage/v1/object/public/product-images/';
  const unused = ((old.data ?? []) as Row[]).map((r) => String(r.image_url)).filter((u) => !urls.includes(u) && u.includes(marker)).map((u) => decodeURIComponent(u.slice(u.indexOf(marker) + marker.length)));
  if (unused.length) supabase.storage.from('product-images').remove(unused).catch(() => {});
}

// ---------- Export: products (same columns as the import template), options and categories ----------
// The Products sheet can be edited and imported back (photos are kept as web links).
$('#export-catalog').addEventListener('click', async () => {
  const button = $<HTMLButtonElement>('#export-catalog');
  button.disabled = true;
  try {
    const [im, va] = await Promise.all([
      supabase.from('product_images').select('product_id,image_url,sort_order').order('sort_order'),
      supabase.from('product_variants').select('*').order('created_at')
    ]);
    if (im.error) throw new Error(im.error.message);
    const photosOf = new Map<string, string[]>();
    for (const img of (im.data ?? []) as Row[]) { const list = photosOf.get(img.product_id) || []; list.push(img.image_url); photosOf.set(img.product_id, list); }
    const catName = new Map(categories.map((c) => [c.id, c.name]));
    const productName = new Map(products.map((p) => [p.id, p.name]));
    const productRows = products.map((p) => {
      const photos = [...new Set([p.primary_image_url, ...(photosOf.get(p.id) || [])].filter(Boolean))];
      const cats = [...new Set([p.category_id, ...links.filter((l) => l.product_id === p.id).map((l) => l.category_id)].filter(Boolean))].map((id) => catName.get(id)).filter(Boolean).join(', ');
      const value: Record<string, unknown> = {
        ...p, categories: cats, is_active: p.is_active !== false, is_featured: Boolean(p.is_featured),
        image_1: photos[0] || '', image_2: photos[1] || '', image_3: photos[2] || '', image_4: photos[3] || '', image_5: photos[4] || ''
      };
      return TEMPLATE_HEADERS.map((h) => { const v = value[h]; return typeof v === 'number' ? v : typeof v === 'boolean' ? (v ? 'TRUE' : 'FALSE') : v == null ? '' : String(v); });
    });
    const variantRows = ((va.data ?? []) as Row[]).map((v) => [productName.get(v.product_id) || '', v.name, v.sku || '', num(v.price), num(v.sale_price), num(v.cost_price), int(v.stock_quantity, 0), v.is_active === false ? 'Hidden' : 'Visible']);
    const counts = new Map<string, number>();
    for (const l of links) counts.set(l.category_id, (counts.get(l.category_id) || 0) + 1);
    await exportXlsxSheets(exportName('products'), [
      { name: 'Products', columns: TEMPLATE_HEADERS.map((h) => ({ header: h, width: /description/.test(h) ? 50 : /^image_/.test(h) ? 40 : h === 'name' || h === 'categories' || h === 'seo_title' ? 30 : 14 })), rows: productRows },
      { name: 'Options', columns: [{ header: 'Product', width: 32 }, { header: 'Option', width: 22 }, { header: 'SKU' }, { header: 'Price' }, { header: 'Sale price' }, { header: 'Cost price' }, { header: 'Stock' }, { header: 'Status' }], rows: variantRows },
      { name: 'Categories', columns: [{ header: 'Order', width: 8 }, { header: 'Name', width: 28 }, { header: 'Slug', width: 26 }, { header: 'Description', width: 50 }, { header: 'Products', width: 10 }, { header: 'Status', width: 10 }, { header: 'Photo', width: 40 }],
        rows: categories.map((c, i) => [i + 1, c.name, c.slug, c.description || '', counts.get(c.id) || 0, c.is_active === false ? 'Hidden' : 'Visible', c.image_url || '']) }
    ]);
    toast(`Exported ${products.length} products, ${variantRows.length} options and ${categories.length} categories.`);
  } catch (error) {
    toast(error instanceof Error ? error.message : 'Export failed.', 'error');
  } finally {
    button.disabled = false;
  }
});

// ---------- Import: read → preview → confirm ----------
type ImportItem = {
  sheetRow: number; row: Row; name: string; slug: string; price: number | null; sku: string;
  matched: Row[]; unknownCategories: string[]; existing?: Row; photos: ImportPhoto[];
  problems: string[]; warnings: string[];
};
let pendingImport: ImportItem[] | null = null;
let previewUrls: string[] = [];

/** Checks every row of the file without saving anything. */
function prepareImport(rows: Row[], photos: Map<number, ImportPhoto[]>): ImportItem[] {
  const seen = new Map<string, number>();
  return rows.map((row, i) => {
    const sheetRow = Number(row.__rowNum__ ?? i + 1);
    const name = String(row.name || row.Name || '').trim();
    const slug = slugify(row.slug || name);
    const price = num(row.price, null);
    const sku = String(row.sku || '').trim();
    const names = String(row.categories || row.category || '').split(',').map((x) => x.trim()).filter(Boolean);
    const matched: Row[] = [];
    const unknownCategories: string[] = [];
    for (const n of names) {
      const c = categories.find((x) => x.name.toLowerCase() === n.toLowerCase() || x.slug === slugify(n));
      if (c) { if (!matched.includes(c)) matched.push(c); } else unknownCategories.push(n);
    }
    const rowPhotos = (photos.get(sheetRow) || []).slice(0, 10);
    const problems: string[] = [];
    const warnings: string[] = [];
    if (!name) problems.push('Missing name');
    if (price === null || price < 0) problems.push('Missing or invalid price');
    if (name && seen.has(slug)) problems.push(`Same product as row ${seen.get(slug)! + 1}`);
    if (name) seen.set(slug, sheetRow);
    if (unknownCategories.length) warnings.push(`Unknown categories skipped: ${unknownCategories.join(', ')}`);
    rowPhotos.forEach((p, n) => { if (p.picture && !BROWSER_IMAGE.test(p.picture.type || '')) warnings.push(`Picture ${n + 1} is a .${p.picture.type} file and will be skipped`); });
    const existing = name ? products.find((p) => p.slug === slug) || (sku ? products.find((p) => p.sku === sku) : undefined) : undefined;
    return { sheetRow, row, name, slug, price, sku, matched, unknownCategories, existing, photos: rowPhotos, problems, warnings };
  });
}

function clearImportPreview() {
  previewUrls.forEach((u) => URL.revokeObjectURL(u));
  previewUrls = [];
  pendingImport = null;
  $('#import-preview').hidden = true;
  $('#import-rows').innerHTML = '';
}

function renderImportPreview(items: ImportItem[]) {
  clearImportPreview();
  pendingImport = items;
  const ok = items.filter((x) => !x.problems.length);
  const created = ok.filter((x) => !x.existing).length;
  const updated = ok.length - created;
  const skipped = items.length - ok.length;
  const photoCount = ok.reduce((n, x) => n + x.photos.filter((p) => p.url || BROWSER_IMAGE.test(p.picture?.type || '')).length, 0);
  const warned = ok.filter((x) => x.warnings.length).length;
  const chip = (cls: string, n: number, label: string) => `<span class="import-chip ${cls}"><b>${n}</b> ${label}</span>`;
  $('#import-summary').innerHTML = chip('new', created, 'new') + chip('update', updated, `update${updated === 1 ? '' : 's'}`) + chip('photos', photoCount, `photo${photoCount === 1 ? '' : 's'}`) + (warned ? chip('warn', warned, `with notes`) : '') + (skipped ? chip('skip', skipped, 'skipped (problems)') : '');
  const thumb = (p: ImportPhoto) => {
    if (p.url) return `<img src="${esc(p.url)}" alt="" loading="lazy" />`;
    const pic = p.picture!;
    if (!BROWSER_IMAGE.test(pic.type || '')) return `<span class="import-thumb-bad">.${esc(pic.type || '?')}</span>`;
    const url = URL.createObjectURL(new Blob([pic.data as BlobPart], { type: `image/${pic.type}` }));
    previewUrls.push(url);
    return `<img src="${url}" alt="" />`;
  };
  $('#import-rows').innerHTML = items.map((x) => {
    const status = x.problems.length ? '<span class="import-status skip">Skipped</span>' : x.existing ? '<span class="import-status update">Update</span>' : '<span class="import-status new">New</span>';
    const notes = [...x.problems.map((t) => `<li class="bad">${esc(t)}</li>`), ...x.warnings.map((t) => `<li>${esc(t)}</li>`)].join('');
    const price = x.price === null ? '—' : `$${x.price.toFixed(2)}${num(x.row.sale_price) !== null ? `<small>Sale $${Number(num(x.row.sale_price)).toFixed(2)}</small>` : ''}`;
    const photosCell = x.photos.length
      ? `<div class="import-thumbs">${x.photos.slice(0, 5).map((p, n) => `<span class="import-thumb${n === 0 ? ' main' : ''}" title="${n === 0 ? 'Main photo' : `Photo ${n + 1}`}">${thumb(p)}</span>`).join('')}${x.photos.length > 5 ? `<span class="import-more">+${x.photos.length - 5}</span>` : ''}</div>`
      : `<small class="muted">${x.existing ? 'Keeps current photos' : 'No photos'}</small>`;
    return `<tr class="${x.problems.length ? 'is-skipped' : ''}">
      <td class="import-rownum">${x.sheetRow + 1}</td>
      <td>${photosCell}</td>
      <td><strong>${esc(x.name || '(no name)')}</strong><small>/${esc(x.slug || '')}${x.sku ? ` · ${esc(x.sku)}` : ''}</small></td>
      <td>${price}</td>
      <td>${int(x.row.stock_quantity, 0)}</td>
      <td>${x.matched.map((c) => `<span class="import-cat">${esc(c.name)}</span>`).join('')}${x.unknownCategories.map((c) => `<span class="import-cat unknown" title="Not found, will be skipped">${esc(c)}</span>`).join('')}${!x.matched.length && !x.unknownCategories.length ? '<small class="muted">None</small>' : ''}</td>
      <td>${status}${notes ? `<ul class="import-notes">${notes}</ul>` : ''}</td>
    </tr>`;
  }).join('');
  const button = $<HTMLButtonElement>('#import-confirm');
  button.disabled = ok.length === 0;
  button.textContent = ok.length ? `Confirm import (${ok.length} product${ok.length === 1 ? '' : 's'})` : 'Nothing to import';
  $('#import-preview').hidden = false;
  $('#import-preview').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Step 1: read the file and show the preview (nothing is saved yet).
$('#import').addEventListener('click', async () => {
  const XLSX = (window as any).XLSX;
  const file = $<HTMLInputElement>('#file').files?.[0];
  const msg = $('#msg'), errBox = $('#errors');
  errBox.hidden = true;
  if (!file) { msg.textContent = 'Choose a file first.'; return; }
  if (!XLSX) { msg.textContent = 'Excel tools are still loading. Try again in a moment.'; return; }
  msg.textContent = 'Reading the file…';
  try {
    const buffer = await file.arrayBuffer();
    const wb = XLSX.read(buffer, { type: 'array' });
    const ws = wb.Sheets[wb.SheetNames[0]];
    const rows = (XLSX.utils.sheet_to_json(ws, { defval: '' }) as Row[]).filter((r) => Object.entries(r).some(([k, v]) => k !== '__rowNum__' && String(v ?? '').trim() !== ''));
    if (!rows.length) { clearImportPreview(); msg.textContent = 'The file has no product rows.'; return; }
    const photos = photosByRow(ws, XLSX, readSheetPictures(buffer), rows);
    renderImportPreview(prepareImport(rows, photos));
    msg.textContent = 'Check the preview below, then press Confirm import. Nothing has been saved yet.';
  } catch (error) { clearImportPreview(); msg.textContent = error instanceof Error ? error.message : 'The file could not be read.'; }
});
$('#file').addEventListener('change', () => { clearImportPreview(); $('#msg').textContent = ''; $('#errors').hidden = true; });
$('#import-cancel').addEventListener('click', () => { clearImportPreview(); $('#msg').textContent = 'Import cancelled. Nothing was saved.'; });

// Step 2: save the rows that passed the checks.
$('#import-confirm').addEventListener('click', async () => {
  const items = (pendingImport || []).filter((x) => !x.problems.length);
  if (!items.length) return;
  const msg = $('#msg'), errBox = $('#errors');
  const confirmButton = $<HTMLButtonElement>('#import-confirm'), cancelButton = $<HTMLButtonElement>('#import-cancel');
  confirmButton.disabled = cancelButton.disabled = true;
  const errors: string[] = [];
  let created = 0, updated = 0, photoCount = 0;
  for (let i = 0; i < items.length; i++) {
    const x = items[i];
    const row = x.row;
    try {
      msg.textContent = `Importing ${i + 1} of ${items.length}${x.photos.length ? ` · ${x.photos.length} photo${x.photos.length === 1 ? '' : 's'}` : ''}…`;
      const payload = { name: x.name, slug: x.slug, sku: x.sku || null, category_id: x.matched[0]?.id || null, price: x.price, sale_price: num(row.sale_price), stock_quantity: int(row.stock_quantity, 0), ...costFromRow(row), age_min: int(row.age_min), age_max: int(row.age_max), brand: String(row.brand || '').trim() || null, short_description: String(row.short_description || ''), description: String(row.description || ''), seo_title: String(row.seo_title || '').trim() || null, seo_description: String(row.seo_description || '').trim() || null, is_active: String(row.is_active).toLowerCase() !== 'false', is_featured: String(row.is_featured).toLowerCase() === 'true', updated_at: new Date().toISOString() };
      // Looked up again: an earlier row of this file may have just created it.
      const existing = products.find((p) => p.slug === x.slug) || (x.sku ? products.find((p) => p.sku === x.sku) : undefined);
      const r = existing ? await supabase.from('products').update(payload as Row).eq('id', existing.id).select().single() : await supabase.from('products').insert(payload as Row).select().single();
      if (r.error) throw new Error(friendly(r.error.message));
      const productId = String((r.data as Row).id);
      if (!existing) products.push(r.data as Row);
      await saveProductCategories(productId, x.matched.map((c) => c.id));
      if (existing) updated++; else created++;
      // Photos: uploaded first, then they replace the product's photos (image_1 = main photo).
      if (x.photos.length) {
        const urls: string[] = [];
        for (let n = 0; n < x.photos.length; n++) {
          const photo = x.photos[n];
          if (photo.picture && !BROWSER_IMAGE.test(photo.picture.type || '')) continue; // shown in the preview notes
          try { urls.push(await uploadImportPhoto(productId, photo, n + 1)); }
          catch (error) { errors.push(`Row ${x.sheetRow + 1} (${x.name}): ${error instanceof Error ? error.message : 'a picture could not be uploaded'}`); }
        }
        const unique = [...new Set(urls)];
        if (unique.length) { await replaceProductPhotos(productId, x.name, unique); photoCount += unique.length; }
      }
    } catch (error) { errors.push(`Row ${x.sheetRow + 1} (${x.name}): ${error instanceof Error ? error.message : 'Unknown error'}`); }
  }
  const skipped = (pendingImport || []).length - items.length;
  clearImportPreview();
  confirmButton.disabled = cancelButton.disabled = false;
  $<HTMLInputElement>('#file').value = '';
  msg.textContent = `Import complete: ${created} created, ${updated} updated${photoCount ? `, ${photoCount} photo${photoCount === 1 ? '' : 's'} added` : ''}${skipped ? `, ${skipped} skipped` : ''}${errors.length ? `, ${errors.length} problem${errors.length === 1 ? '' : 's'}` : ''}.`;
  errBox.hidden = errors.length === 0;
  errBox.innerHTML = errors.length ? '<strong>Import problems</strong>' + errors.slice(0, 50).map((t) => `<p>${esc(t)}</p>`).join('') : '';
  await load();
});

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#cfg');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = '/login?next=%2Fadmin'; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><p>This account is not an administrator.</p>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'products', 'Products'))) return;
    guard.hidden = true;
    $('#app').hidden = false;
    await load();
    const editId = params.get('edit');
    if (editId) editProduct(editId);
    else if (params.get('new')) clearForm();
  } catch (error) {
    guard.hidden = false;
    guard.innerHTML = `<h2>Admin could not load</h2><p>${esc(error instanceof Error ? error.message : 'Unknown error')}</p><button class="button" type="button" onclick="location.reload()">Try again</button>`;
  }
}
init();
</script>
