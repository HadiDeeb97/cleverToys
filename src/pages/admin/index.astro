// An empty or missing cost_price cell keeps the cost already saved, so older files never erase costs.
const costFromRow = (row: Row) => { const cost = num(row.cost_price ?? row['cost price'] ?? row.cost); return cost === null ? {} : { cost_price: Math.max(0, cost) }; };

// ---------- Photos in the Excel file (src/scripts/xlsx-images.ts) ----------
type ImportPhoto = { slot: number; order: number; picture?: SheetPicture; url?: string };
const BROWSER_IMAGE = /^(png|jpeg|gif|webp|bmp|avif)$/;

/** image_1, image_2 … image_25 … (also "Image 2", "photo_3", "picture 14"; a plain "image" or "main image" is 1) → photo number. */
function photoSlot(header: string) {
  const h = header.trim().toLowerCase();
  const m = /^(?:image|photo|picture|img)[\s_-]*(\d{1,3})$/.exec(h);
  if (m && Number(m[1]) === 0) return 0;
  if (m) return Number(m[1]);
  return /^(?:main[\s_-]*)?(?:image|photo|picture)$/.test(h) ? 1 : 0;
}

// Web links in a cell: several may share one cell (separated by spaces, commas or new lines).
const LINKS = /https?:\/\/[^\s,;|"'<>]+/gi;
// Extra photo columns may be named anything with image/photo/picture/img/pic/gallery, or have no name.
const PHOTO_HEADER = /image|photo|picture|\bimg|\bpic|gallery|صور/i;

/**
 * Photos for each sheet row, in order: image_1 first (the main photo), then image_2… Pictures and links
 * in other photo columns (named image/photo/… without a number, or with no name) come last.
 * Web links count too: typed in the cell (several per cell is fine), a cell's hyperlink, or the older
 * primary_image_url column. Cells are read straight from the sheet, so columns with the same name or
 * with no name are not lost.
 */
function photosByRow(ws: any, XLSX: any, pictures: SheetPicture[], rows: Row[]) {
  const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
  const headerRow = range.s.r;
  const slotOfCol = new Map<number, number>();
  const headerOfCol = new Map<number, string>();
  for (let c = range.s.c; c <= range.e.c; c++) {
    const text = String(ws[XLSX.utils.encode_cell({ r: headerRow, c })]?.v ?? '').trim();
    headerOfCol.set(c, text);
    const slot = photoSlot(text);
    if (slot) slotOfCol.set(c, slot);
  }
  const byRow = new Map<number, ImportPhoto[]>();
  const add = (row: number, photo: ImportPhoto) => { if (!byRow.has(row)) byRow.set(row, []); byRow.get(row)!.push(photo); };
  for (const picture of pictures) {
    if (picture.row <= headerRow) continue;
    // A floating picture that spills into the next column still belongs to its image column.
    const col = slotOfCol.has(picture.col) ? picture.col : picture.cols.find((c) => slotOfCol.has(c));
    const slot = col !== undefined ? slotOfCol.get(col)! : 100000 + picture.col;
    add(picture.row, { slot, order: picture.col * 1000, picture: picture.url ? undefined : picture, url: picture.url });
  }
  for (const row of rows) {
    const sheetRow = Number(row.__rowNum__);
    for (let c = range.s.c; c <= range.e.c; c++) {
      const header = headerOfCol.get(c) || '';
      const slot = slotOfCol.get(c);
      if (/^primary_image_url$/i.test(header) || (slot === undefined && header && !PHOTO_HEADER.test(header))) continue;
      const cell = ws[XLSX.utils.encode_cell({ r: sheetRow, c })];
      const text = String(cell?.v ?? '').trim();
      const links = text.match(LINKS) || [];
      const target = String(cell?.l?.Target || '').trim();
      if (/^https?:\/\//i.test(target) && !links.includes(target)) links.push(target);
      // A column without an image_N name only counts when the cell holds nothing but links.
      if (slot === undefined && text.replace(LINKS, '').replace(/[\s,;|]+/g, '') && !target) continue;
      links.forEach((url, k) => add(sheetRow, { slot: slot ?? 100000 + c, order: c * 1000 + k + 1, url }));
    }
    const legacy = String(row.primary_image_url || '').trim();
    if (/^https?:\/\//i.test(legacy) && !(byRow.get(sheetRow) || []).some((p) => p.slot === 1)) add(sheetRow, { slot: 1, order: -1, url: legacy });
  }
  for (const list of byRow.values()) list.sort((a, b) => a.slot - b.slot || a.order - b.order);
  return byRow;
}

/**
 * Downloads a photo from another website through the store's server (/api/admin/fetch-image), since
 * browsers may not read pictures from other sites themselves.
 */
async function fetchOutsidePhoto(url: string) {
  const { data } = await supabase.auth.getSession();
  const token = data.session?.access_token;
  if (!token) throw new Error('Please sign in again.');
  const response = await fetch('/api/admin/fetch-image', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` }, body: JSON.stringify({ url }) });
  if (!response.ok) {
    const body = await response.json().catch(() => ({})) as { error?: string };
    throw new Error(`${body.error || `the photo could not be downloaded (${response.status})`} ${url}`);
  }
  return response.blob();
}

/** Resizes a photo to WebP, saves it in the store's storage under the product and returns its address. */
async function storeProductPhoto(productId: string, source: Blob, n: number | string) {
  const blob = await toWebp(source);
  const path = `${productId}/${Date.now()}-${n}.webp`;
  const up = await supabase.storage.from('product-images').upload(path, blob, { contentType: 'image/webp', upsert: false });
  if (up.error) throw new Error(up.error.message);
  return supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;
}

/**
 * Saves one photo of an import row and returns its address. Pictures in the file and web links are
 * both saved in the store's own storage as WebP; only links to photos already in that storage (for
 * example from "Export Excel") are kept as they are.
 */
async function uploadImportPhoto(productId: string, photo: ImportPhoto, n: number) {
  if (photo.url) return isOwnPhoto(photo.url) ? photo.url : storeProductPhoto(productId, await fetchOutsidePhoto(photo.url), n);
  const picture = photo.picture!;
  if (!BROWSER_IMAGE.test(picture.type || '')) throw new Error(`picture ${n} is a .${picture.type} file, which can't be used on the website. Insert it as a PNG or JPG picture.`);
  return storeProductPhoto(productId, new Blob([picture.data as BlobPart], { type: `image/${picture.type}` }), n);
}

// ---------- Photos loaded from other websites → the store's own storage ----------
let copyingOutside = false, stopOutside = false;
const outsideHost = (url: string) => { try { return new URL(url).hostname; } catch { return 'another website'; } };

/** Shows the "Copy photos to my storage" box when some products still use photos from other websites. */
async function renderOutsidePhotos() {
  if (copyingOutside || !storageBase) return;
  const box = $('#outside-photos');
  const q = await supabase.from('product_images').select('id', { count: 'exact', head: true }).not('image_url', 'like', `${storageBase}%`);
  const outsideProducts = products.filter((p) => p.primary_image_url && !isOwnPhoto(p.primary_image_url));
  const count = q.error ? 0 : q.count || 0;
  box.hidden = !count && !outsideProducts.length;
  if (box.hidden) return;
  const hosts = [...new Set(outsideProducts.map((p) => outsideHost(p.primary_image_url)))].slice(0, 3).join(', ');
  $('#outside-text').innerHTML = `<strong>${count.toLocaleString()} photo${count === 1 ? '' : 's'}</strong> of <strong>${outsideProducts.length} product${outsideProducts.length === 1 ? '' : 's'}</strong> are loaded from other websites${hosts ? ` (${esc(hosts)})` : ''}. If those sites change or remove them, the photos disappear from your store. Copy them into your own storage (saved as WebP, smaller and faster).`;
}

/**
 * Copies every outside photo into the store's storage as WebP and points the product, its photo list
 * and its options at the copy. Photos that fail stay as they are, so pressing the button again
 * continues with what is left.
 */
$('#outside-copy').addEventListener('click', async () => {
  if (copyingOutside) return;
  const button = $<HTMLButtonElement>('#outside-copy'), stop = $<HTMLButtonElement>('#outside-stop'), msg = $('#outside-msg');
  copyingOutside = true; stopOutside = false;
  button.disabled = true; stop.hidden = false;
  const leaveWarning = (e: BeforeUnloadEvent) => { e.preventDefault(); e.returnValue = ''; };
  window.addEventListener('beforeunload', leaveWarning);
  const errors: string[] = [];
  let done = 0, copied = 0;
  try {
    msg.textContent = 'Finding the photos…';
    const found = await selectAll(() => supabase.from('product_images').select('id,product_id,image_url,sort_order').not('image_url', 'like', `${storageBase}%`).order('product_id').order('sort_order').order('id'));
    if (found.error) throw new Error(found.error.message);
    const rows = found.data;
    // Main photos that are not in the photo list are copied too.
    const listed = new Set(rows.map((r) => `${r.product_id} ${r.image_url}`));
    for (const p of products) if (p.primary_image_url && !isOwnPhoto(p.primary_image_url) && !listed.has(`${p.id} ${p.primary_image_url}`)) rows.push({ id: null, product_id: p.id, image_url: p.primary_image_url });
    const total = rows.length;
    // The same address is downloaded once, even when several products use it (kept only until its last use).
    const copies = new Map<string, Promise<Blob>>();
    const uses = new Map<string, number>();
    for (const r of rows) uses.set(String(r.image_url), (uses.get(String(r.image_url)) || 0) + 1);
    let next = 0;
    const worker = async () => {
      while (!stopOutside && next < rows.length) {
        const index = next++;
        const row = rows[index];
        const old = String(row.image_url);
        try {
          if (!copies.has(old)) copies.set(old, fetchOutsidePhoto(old));
          const source = copies.get(old)!;
          const left = (uses.get(old) || 1) - 1;
          uses.set(old, left);
          if (!left) copies.delete(old);
          const url = await storeProductPhoto(row.product_id, await source, `c${index}`);
          if (row.id) { const u = await supabase.from('product_images').update({ image_url: url }).eq('id', row.id); if (u.error) throw new Error(u.error.message); }
          else { const i = await supabase.from('product_images').insert({ product_id: row.product_id, image_url: url, alt_text: products.find((p) => p.id === row.product_id)?.name || '', sort_order: 0, is_primary: true }); if (i.error) throw new Error(i.error.message); }
          const main = await supabase.from('products').update({ primary_image_url: url }).eq('id', row.product_id).eq('primary_image_url', old);
          if (main.error) throw new Error(main.error.message);
          // Options with their own photo (older databases have no option photos: nothing to do).
          const opt = await supabase.from('product_variants').update({ image_url: url }).eq('product_id', row.product_id).eq('image_url', old);
          if (opt.error && !/image_url/.test(opt.error.message)) throw new Error(opt.error.message);
          copied++;
        } catch (error) {
          const name = products.find((p) => p.id === row.product_id)?.name || 'A product';
          errors.push(`${name}: ${error instanceof Error ? error.message : 'the photo could not be copied'}`);
        }
        done++;
        msg.textContent = `Copying photo ${done} of ${total}…${errors.length ? ` (${errors.length} could not be copied)` : ''}`;
      }
    };
    await Promise.all(Array.from({ length: 4 }, worker));
    msg.textContent = `${stopOutside ? 'Stopped. ' : ''}${copied} photo${copied === 1 ? '' : 's'} copied to your storage${errors.length ? `, ${errors.length} could not be copied (they still show from the other website; press the button again to retry)` : ''}.`;
    toast(msg.textContent, errors.length ? 'error' : 'success');
  } catch (error) {
    msg.textContent = error instanceof Error ? error.message : 'Copying failed.';
  } finally {
    window.removeEventListener('beforeunload', leaveWarning);
    copyingOutside = false;
    button.disabled = false; stop.hidden = true;
    const errBox = $('#outside-errors');
    errBox.hidden = !errors.length;
    errBox.innerHTML = errors.length ? '<strong>Photos that could not be copied</strong>' + errors.slice(0, 50).map((t) => `<p>${esc(t)}</p>`).join('') : '';
    await load();
  }
});
$('#outside-stop').addEventListener('click', () => { stopOutside = true; $('#outside-msg').textContent = 'Stopping after the photos in progress…'; });

/**
 * The product's photos become exactly these, the first one as the main photo. Old uploaded files are
 * deleted unless `removeOld` is false (the Excel import keeps them so the import can be undone).
 */
async function replaceProductPhotos(productId: string, name: string, urls: string[], removeOld = true) {
  const old = await supabase.from('product_images').select('image_url').eq('product_id', productId);
  const del = await supabase.from('product_images').delete().eq('product_id', productId);
  if (del.error) throw new Error(del.error.message);
  const ins = await supabase.from('product_images').insert(urls.map((image_url, i) => ({ product_id: productId, image_url, alt_text: name, sort_order: i, is_primary: i === 0 })));
  if (ins.error) throw new Error(ins.error.message);
  const up = await supabase.from('products').update({ primary_image_url: urls[0] }).eq('id', productId);
  if (up.error) throw new Error(up.error.message);
  // Old uploaded files that are no longer used are removed from storage (best effort).
  const marker = '/storage/v1/object/public/product-images/';
  const unused = ((old.data ?? []) as Row[]).map((r) => String(r.image_url)).filter((u) => !urls.includes(u) && u.includes(marker)).map((u) => decodeURIComponent(u.slice(u.indexOf(marker) + marker.length)));
  if (removeOld && unused.length) supabase.storage.from('product-images').remove(unused).catch(() => {});
}

// ---------- Export: products (same columns as the import template), options and categories ----------
// The Products sheet can be edited and imported back (photos are kept as web links).
$('#export-catalog').addEventListener('click', async () => {
