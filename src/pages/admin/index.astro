  }
});

// ---------- Import: read → preview (match, choose, see the changes) → confirm → undo ----------
// Each row is matched to a product on the site: exactly (same slug or SKU) or possibly (similar name,
// src/scripts/import-match.ts). The admin chooses per row: update it, skip it, or add it as a new product.
// For products already on the site, empty cells keep what is there.
type ImportAction = 'update' | 'skip' | 'new';
type ImportKind = 'new' | 'exact' | 'possible';
type FieldGroup = 'prices' | 'stock' | 'texts' | 'ages' | 'categories' | 'photos' | 'seo' | 'visibility';
type ImportChange = { group: FieldGroup; label: string; field?: string; value?: unknown };
type ImportItem = {
  id: number; sheetRow: number; row: Row; name: string; slug: string; price: number | null; sku: string;
  matched: Row[]; unknownCategories: string[]; photos: ImportPhoto[]; thumbs?: string[];
  problems: string[]; warnings: string[];
  kind: ImportKind; site?: Row; how?: 'slug' | 'sku' | 'name'; score?: number; canAdd: boolean; action: ImportAction;
  /** Site toys with a similar name, best first (src/scripts/import-match.ts); the admin can pick one. */
  candidates: Array<{ product: Row; score: number }>;
};
type ImportBucket = 'problems' | 'new' | 'possible' | 'updates' | 'nochange';

const FIELD_GROUPS: Array<[FieldGroup, string]> = [['prices', 'Prices'], ['stock', 'Stock'], ['texts', 'Names & descriptions'], ['ages', 'Ages'], ['categories', 'Categories'], ['photos', 'Photos'], ['seo', 'SEO'], ['visibility', 'Visible / featured']];
const FIELD_GROUP: Record<string, FieldGroup> = { price: 'prices', sale_price: 'prices', cost_price: 'prices', stock_quantity: 'stock', name: 'texts', sku: 'texts', brand: 'texts', short_description: 'texts', description: 'texts', age_min: 'ages', age_max: 'ages', seo_title: 'seo', seo_description: 'seo', is_active: 'visibility', is_featured: 'visibility' };
const FIELD_LABEL: Record<string, string> = { price: 'Price', sale_price: 'Sale price', cost_price: 'Cost', stock_quantity: 'Stock', name: 'Name', sku: 'SKU', brand: 'Brand', short_description: 'Short description', description: 'Description', age_min: 'Age from', age_max: 'Age to', seo_title: 'SEO title', seo_description: 'SEO description', is_active: 'Visible', is_featured: 'Featured' };
const importOptions = { groups: new Set<FieldGroup>(FIELD_GROUPS.map(([g]) => g)), stockMode: 'set' as 'set' | 'add' };
let pendingImport: ImportItem[] | null = null;
let previewUrls: string[] = [];
let importTab: 'all' | ImportBucket = 'all';
let importFileName = '';
// Each product's current photos (main first), to tell whether the file's photos are different.
let sitePhotos = new Map<string, string[]>();

/** A cell's text (the first of these columns that is filled in), or ''. */
const cellText = (row: Row, ...keys: string[]) => {
  for (const k of keys) { const v = row[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).replace(/\r\n?/g, '\n').trim(); }
  return '';
};
/** TRUE / FALSE style cells (also yes / no, 1 / 0); empty or unclear = not given. */
const yesNo = (v: unknown) => {
  const t = String(v ?? '').trim().toLowerCase();
  if (['true', 'yes', 'y', '1', 'on', 'visible'].includes(t)) return true;
  if (['false', 'no', 'n', '0', 'off', 'hidden'].includes(t)) return false;
  return null;
};
/** The values a row gives (filled-in cells only). "none" in sale_price removes the sale price. */
function fileValues(row: Row): Row {
  const v: Row = {};
  const put = (key: string, value: unknown) => { if (value !== null && value !== undefined && value !== '') v[key] = value; };
  put('name', cellText(row, 'name', 'Name'));
  put('sku', cellText(row, 'sku', 'SKU'));
  put('brand', cellText(row, 'brand'));
  put('short_description', cellText(row, 'short_description'));
  put('description', cellText(row, 'description'));
  put('price', num(row.price, null));
  const sale = cellText(row, 'sale_price');
  if (/^(none|no|-|remove|clear)$/i.test(sale)) v.sale_price = null; else put('sale_price', num(sale, null));
  const cost = costFromRow(row);
  if ('cost_price' in cost) v.cost_price = cost.cost_price;
  put('stock_quantity', int(row.stock_quantity, null));
  put('age_min', int(row.age_min, null));
  put('age_max', int(row.age_max, null));
  put('seo_title', cellText(row, 'seo_title'));
  put('seo_description', cellText(row, 'seo_description'));
  const active = yesNo(row.is_active); if (active !== null) v.is_active = active;
  const featured = yesNo(row.is_featured); if (featured !== null) v.is_featured = featured;
  return v;
}

const isMoneyField = (field: string) => ['price', 'sale_price', 'cost_price'].includes(field);
function sameValue(field: string, current: unknown, next: unknown) {
  if (typeof next === 'boolean') return Boolean(current) === next;
  if (next === null || current === null || current === undefined || current === '') return (next === null || next === '') && (current === null || current === undefined || current === '');
  if (typeof next === 'number') return Math.abs(Number(current) - next) < (isMoneyField(field) ? 0.005 : 0.5);
  return String(current).replace(/\r\n?/g, '\n').trim() === String(next).trim();
}
function showValue(field: string, value: unknown) {
  if (value === null || value === undefined || value === '') return 'none';
  if (typeof value === 'boolean') return value ? 'Yes' : 'No';
  if (isMoneyField(field)) return money(value);
  return String(value);
}
function describeChange(field: string, current: unknown, next: unknown) {
  const label = FIELD_LABEL[field] || field;
  const long = ['short_description', 'description', 'seo_description'].includes(field) || String(current ?? '').length > 40 || String(next ?? '').length > 40;
  if (long) return `${label}: ${current ? 'changed' : 'added'}`;
  return `${label}: ${showValue(field, current)} → ${showValue(field, next)}`;
}
const productCategoryIds = (p: Row) => {
  const ids = links.filter((l) => l.product_id === p.id).map((l) => String(l.category_id));
  return [...new Set([...(p.category_id ? [String(p.category_id)] : []), ...ids])];
};
const usablePhotos = (x: ImportItem) => x.photos.filter((ph) => ph.url || BROWSER_IMAGE.test(ph.picture?.type || ''));

/** What updating this row's site product would change, with the chosen options. */
function plannedChanges(x: ImportItem): ImportChange[] {
  const p = x.site;
  if (!p) return [];
  const on = (g: FieldGroup) => importOptions.groups.has(g);
  const out: ImportChange[] = [];
  for (const [field, value] of Object.entries(fileValues(x.row))) {
    const group = FIELD_GROUP[field];
    if (!group || !on(group)) continue;
    if (field === 'stock_quantity') {
      if (withOptions.has(p.id)) continue; // its stock is the total of its options
      const current = Number(p.stock_quantity || 0);
      const next = importOptions.stockMode === 'add' ? current + Number(value) : Number(value);
      if (next !== current) out.push({ group, field, value: next, label: `Stock: ${current} → ${next}${importOptions.stockMode === 'add' ? ` (+${value})` : ''}` });
      continue;
    }
    // A similar-name match keeps the name it has on the site.
    if (field === 'name' && x.how === 'name') continue;
    if (field === 'sku' && String(value).toLowerCase() === String(p.sku || '').trim().toLowerCase()) continue;
    if (sameValue(field, p[field], value)) continue;
    out.push({ group, field, value, label: describeChange(field, p[field], value) });
  }
  if (on('categories') && x.matched.length) {
    const current = productCategoryIds(p);
    const wanted = x.matched.map((c) => String(c.id));
    const name = (id: string) => categories.find((c) => String(c.id) === id)?.name || 'category';
    const added = wanted.filter((id) => !current.includes(id)).map(name);
    const removed = current.filter((id) => !wanted.includes(id)).map(name);
    const parts = [...added.map((n) => `+ ${n}`), ...removed.map((n) => `− ${n}`)];
    if (!parts.length && current[0] !== wanted[0]) parts.push(`main: ${name(wanted[0])}`);
    if (parts.length) out.push({ group: 'categories', label: `Categories: ${parts.join(', ')}` });
  }
  if (on('photos')) {
    const photos = usablePhotos(x);
    const current = sitePhotos.get(p.id) || [];
    const sameLinks = photos.every((ph) => ph.url) && photos.map((ph) => ph.url).join('\n') === current.join('\n');
    if (photos.length && !sameLinks) out.push({ group: 'photos', label: `Photos replaced: ${current.length} → ${photos.length}` });
  }
  return out;
}
function bucketOf(x: ImportItem, changes: ImportChange[]): ImportBucket {
  if (x.problems.length) return 'problems';
  if (x.kind === 'new') return 'new';
  if (x.kind === 'possible') return 'possible';
  return changes.length ? 'updates' : 'nochange';
}
/** What will really happen to the row: add it, update it, or nothing. */
function effective(x: ImportItem, changes: ImportChange[]): 'add' | 'update' | 'none' {
  if (x.problems.length) return 'none';
  if (x.action === 'new' && x.canAdd) return 'add';
  if (x.action === 'update' && x.site && changes.length) return 'update';
  return 'none';
}

/**
 * The whole plan: each row's changes, list (tab) and what will really happen. Only one row may update
 * a product: a later row choosing the same product is held back with a note (conflictWith).
 */
function planImport() {
  const updating = new Map<string, number>();
  return (pendingImport || []).map((x) => {
    const changes = plannedChanges(x);
    let does = effective(x, changes);
    let conflictWith: number | undefined;
    if (does === 'update') {
      const earlier = updating.get(x.site!.id);
      if (earlier !== undefined) { conflictWith = earlier; does = 'none'; } else updating.set(x.site!.id, x.sheetRow);
    }
    return { x, changes, bucket: bucketOf(x, changes), does, conflictWith };
  });
}

/** Checks every row of the file and finds its product on the site, without saving anything. */
function prepareImport(rows: Row[], photos: Map<number, ImportPhoto[]>): ImportItem[] {
  const seenNew = new Map<string, number>();
  const usedSite = new Map<string, number>();
  return rows.map((row, i) => {
    const sheetRow = Number(row.__rowNum__ ?? i + 1);
    const name = cellText(row, 'name', 'Name');
    const slug = slugify(row.slug || name);
    const priceText = cellText(row, 'price');
    const price = num(priceText, null);
    const sku = cellText(row, 'sku', 'SKU');
    const names = cellText(row, 'categories', 'category').split(',').map((x) => x.trim()).filter(Boolean);
    const matched: Row[] = [];
    const unknownCategories: string[] = [];
    for (const n of names) {
      const c = categories.find((x) => x.name.toLowerCase() === n.toLowerCase() || x.slug === slugify(n));
      if (c) { if (!matched.includes(c)) matched.push(c); } else unknownCategories.push(n);
    }
    const rowPhotos = photos.get(sheetRow) || [];
    const problems: string[] = [];
    const warnings: string[] = [];
    if (priceText && (price === null || price < 0)) problems.push('Invalid price');
    const canAdd = Boolean(name) && price !== null && price >= 0;

    // Which product on the site is it?
    const exact = name || sku ? exactMatch(products as Array<Row & { id: string; name: string }>, name ? slug : '', sku) : null;
    let kind: ImportKind = 'new', site: Row | undefined, how: ImportItem['how'], score: number | undefined;
    let candidates: ImportItem['candidates'] = [];
    if (exact) { kind = 'exact'; site = exact.product; how = exact.how; }
    else if (name) {
      // Similar names: a good one makes a possible match (starts on Skip); weaker ones are only
      // offered in the row's choices, and the row starts as a new toy.
      candidates = rankCandidates(products as Array<Row & { id: string; name: string }>, name, price);
      const best = candidates[0];
      if (best && best.score >= POSSIBLE_MATCH) { kind = 'possible'; site = best.product; how = 'name'; score = best.score; }
    }
    if (kind === 'exact' && site) {
      const earlier = usedSite.get(site.id);
      if (earlier !== undefined) problems.push(`Same product as row ${earlier + 1}`); else usedSite.set(site.id, sheetRow);
      // A new SKU that another product already has would be refused by the database.
      const other = sku ? products.find((p) => p.id !== site!.id && String(p.sku || '').trim().toLowerCase() === sku.toLowerCase()) : undefined;
      if (other) problems.push(`SKU ${sku} already belongs to “${other.name}”`);
    } else {
      if (!name) problems.push('Missing name, and no product on the site has this SKU');
      else if (kind === 'new' && !canAdd) problems.push('Missing price (needed to add a new product)');
      if (name) { const earlier = seenNew.get(slug); if (earlier !== undefined) problems.push(`Same product as row ${earlier + 1}`); else seenNew.set(slug, sheetRow); }
    }
    if (unknownCategories.length) warnings.push(`Unknown categories skipped: ${unknownCategories.join(', ')}`);
    rowPhotos.forEach((p, n) => { if (p.picture && !BROWSER_IMAGE.test(p.picture.type || '')) warnings.push(`Picture ${n + 1} is a .${p.picture.type} file and will be skipped`); });
    if (site && withOptions.has(site.id) && cellText(row, 'stock_quantity')) warnings.push('Its stock comes from its options, so the stock cell is not used');
    const action: ImportAction = problems.length ? 'skip' : kind === 'exact' ? 'update' : kind === 'possible' ? 'skip' : 'new';
    return { id: i, sheetRow, row, name, slug, price, sku, matched, unknownCategories, photos: rowPhotos, problems, warnings, kind, site, how, score, canAdd, action, candidates };
  });
}

function clearImportPreview() {
  previewUrls.forEach((u) => URL.revokeObjectURL(u));
  previewUrls = [];
  pendingImport = null;
  importTab = 'all';
  $('#import-preview').hidden = true;
  $('#import-rows').innerHTML = '';
}

/** Small pictures for the preview (made once per row). */
function rowThumbs(x: ImportItem) {
  if (x.thumbs) return x.thumbs;
  x.thumbs = x.photos.map((p) => {
    if (p.url) return `<img src="${esc(p.url)}" alt="" loading="lazy" />`;
    const pic = p.picture!;
    if (!BROWSER_IMAGE.test(pic.type || '')) return `<span class="import-thumb-bad">.${esc(pic.type || '?')}</span>`;
    const url = URL.createObjectURL(new Blob([pic.data as BlobPart], { type: `image/${pic.type}` }));
    previewUrls.push(url);
    return `<img src="${url}" alt="" />`;
  });
  return x.thumbs;
}

const BUCKET_LABEL: Record<'all' | ImportBucket, string> = { all: 'All', new: 'New', updates: 'Updates', possible: 'Possible matches', nochange: 'No changes', problems: 'Problems' };

function renderImportPreview() {
  const items = pendingImport || [];
  const plan = planImport();
  const toAdd = plan.filter((p) => p.does === 'add');
  const toUpdate = plan.filter((p) => p.does === 'update');
  const photoCount = [...toAdd, ...toUpdate].filter((p) => p.does === 'add' || p.changes.some((c) => c.group === 'photos')).reduce((n, p) => n + usablePhotos(p.x).length, 0);
  const count = (b: ImportBucket) => plan.filter((p) => p.bucket === b).length;
  const chip = (cls: string, n: number, label: string) => `<span class="import-chip ${cls}"><b>${n}</b> ${label}</span>`;
  $('#import-summary').innerHTML = chip('new', toAdd.length, 'to add') + chip('update', toUpdate.length, `to update`) + chip('photos', photoCount, `photo${photoCount === 1 ? '' : 's'}`)
    + chip('skip-choice', items.length - toAdd.length - toUpdate.length, 'left as they are');

  // The update options only matter when some rows are on the site already.
  $('#import-options').hidden = !items.some((x) => x.site);
  if (importTab !== 'all' && !count(importTab)) importTab = 'all';
  $('#import-tabs').innerHTML = (['all', 'new', 'updates', 'possible', 'nochange', 'problems'] as const)
    .map((b) => ({ b, n: b === 'all' ? items.length : count(b) }))
    .filter(({ b, n }) => b === 'all' || n > 0)
    .map(({ b, n }) => `<button type="button" class="chip${importTab === b ? ' active' : ''}" data-import-tab="${b}">${BUCKET_LABEL[b]} <b>${n}</b></button>`).join('');

  const shown = plan.filter((p) => importTab === 'all' || p.bucket === importTab);
  $('#import-rows').innerHTML = shown.length ? shown.map(({ x, changes, bucket, does, conflictWith }) => {
    const thumbs = rowThumbs(x);
    const photosCell = thumbs.length
      ? `<div class="import-thumbs">${thumbs.slice(0, 5).map((t, n) => `<span class="import-thumb${n === 0 ? ' main' : ''}" title="${n === 0 ? 'Main photo' : `Photo ${n + 1}`}">${t}</span>`).join('')}${thumbs.length > 5 ? `<span class="import-more">+${thumbs.length - 5}</span>` : ''}</div>`
      : `<small class="muted">${x.site ? 'Keeps its photos' : 'No photos'}</small>`;
    const v = fileValues(x.row);
    const fileFacts = [x.sku && `SKU ${esc(x.sku)}`, x.price !== null && money(x.price), v.stock_quantity !== undefined && `stock ${v.stock_quantity}`].filter(Boolean).join(' · ');
    const p = x.site;
    const siteCell = p
      ? `<div class="import-site">${p.primary_image_url ? `<img src="${esc(p.primary_image_url)}" alt="" loading="lazy" />` : '<span class="import-site-ph">🧸</span>'}<div><strong>${esc(p.name)}</strong><small>${x.how === 'name' ? `<span class="import-match ${(x.score || 0) >= STRONG_MATCH ? 'strong' : 'possible'}">${(x.score || 0) >= STRONG_MATCH ? 'Strong match' : 'Similar name'} · ${Math.round((x.score || 0) * 100)}%</span>` : `<span class="import-match exact">Same ${x.how === 'sku' ? 'SKU' : 'web address'}</span>`} ${money(p.sale_price ?? p.price)} · stock ${Number(p.stock_quantity || 0)}</small><a class="text-link" href="/admin?edit=${esc(p.id)}" target="_blank" rel="noopener">Open ↗</a></div></div>`
      : `<span class="import-match new">Not on the site</span>${x.candidates.length ? `<small class="import-closest">Closest: ${x.candidates.map((c) => `${esc(c.product.name)} (${Math.round(c.score * 100)}%)`).join(', ')}</small>` : ''}`;
    const newFacts = [x.price !== null && `Price ${money(x.price)}`, `stock ${v.stock_quantity ?? 0}`, x.matched.length && x.matched.map((c) => esc(c.name)).join(', '), x.photos.length && `${usablePhotos(x).length} photo${usablePhotos(x).length === 1 ? '' : 's'}`].filter(Boolean).join(' · ');
    const changeList = x.problems.length
      ? `<ul class="import-notes">${x.problems.map((t) => `<li class="bad">${esc(t)}</li>`).join('')}</ul>`
      : x.action === 'new' ? `<p class="import-adds">Adds a new product: ${newFacts}</p>`
      : changes.length ? `<ul class="import-changes${does === 'update' ? '' : ' muted-list'}">${changes.map((c) => `<li>${esc(c.label)}</li>`).join('')}</ul>`
      : x.site ? '<span class="import-status nochange">No changes</span>' : '';
    const notes = (x.warnings.length || conflictWith !== undefined) ? `<ul class="import-notes">${conflictWith !== undefined ? `<li class="bad">Row ${conflictWith + 1} already updates this product. Choose Skip${x.canAdd && x.kind !== 'exact' ? ' or Add as new' : ''}.</li>` : ''}${x.warnings.map((t) => `<li>${esc(t)}</li>`).join('')}</ul>` : '';
    // Choices: for a similar name, which of the closest toys it is ("match:0" = the best one).
    const short = (t: string) => (t.length > 34 ? `${t.slice(0, 32)}…` : t);
    const sameAs = x.candidates.map((c, i): [string, string] => [`match:${i}`, `Same toy as: ${short(c.product.name)} (${Math.round(c.score * 100)}%)`]);
    const choices: Array<[string, string]> = x.problems.length ? []
      : x.kind === 'exact' ? [['update', 'Update it'], ['skip', 'Skip']]
      : x.kind === 'possible' ? [['skip', 'Skip'], ...sameAs, ...(x.canAdd ? [['new', 'Different toy: add as new'] as [string, string]] : [])]
      : [['new', 'Add it as a new toy'], ['skip', 'Skip'], ...sameAs];
    const selected = x.action === 'update' && x.how === 'name' ? `match:${Math.max(0, x.candidates.findIndex((c) => c.product.id === x.site?.id))}` : x.action;
    const actionCell = choices.length
      ? `<label class="sr-only" for="import-action-${x.id}">What to do with row ${x.sheetRow + 1}</label><select id="import-action-${x.id}" class="admin-input import-action" data-import-action="${x.id}">${choices.map(([value, label]) => `<option value="${value}"${selected === value ? ' selected' : ''}>${esc(label)}</option>`).join('')}</select>${x.kind === 'exact' && !changes.length ? '<small class="muted">Nothing to update</small>' : ''}`
      : '<span class="import-status skip">Skipped</span>';
    return `<tr class="import-${does}${bucket === 'problems' ? ' is-skipped' : ''}${bucket === 'possible' ? ' is-possible' : ''}">
      <td class="import-rownum">${x.sheetRow + 1}</td>
      <td>${photosCell}</td>
      <td><strong>${esc(x.name || '(no name)')}</strong><small>${fileFacts}</small></td>
      <td>${siteCell}</td>
      <td>${changeList}${notes}</td>
      <td>${actionCell}</td>
    </tr>`;
  }).join('') : '<tr><td colspan="6" class="muted">Nothing in this list.</td></tr>';

  const button = $<HTMLButtonElement>('#import-confirm');
  const total = toAdd.length + toUpdate.length;
  button.disabled = total === 0;
  button.textContent = total ? `Confirm import (${[toAdd.length && `${toAdd.length} new`, toUpdate.length && `${toUpdate.length} update${toUpdate.length === 1 ? '' : 's'}`].filter(Boolean).join(', ')})` : 'Nothing to import';
  $('#import-preview').hidden = false;
}

// Choices in the preview: the action of a row, the tabs, "for all shown", and the update options.
$('#import-preview').addEventListener('change', (event) => {
  const el = event.target as HTMLInputElement;
  if (el.dataset.importAction) {
    const x = pendingImport?.find((i) => i.id === Number(el.dataset.importAction));
    if (x) {
      const pick = /^match:(\d+)$/.exec(el.value);
      const c = pick ? x.candidates[Number(pick[1])] : undefined;
      if (c) { x.action = 'update'; x.site = c.product; x.how = 'name'; x.score = c.score; }
      else {
        x.action = el.value as ImportAction;
        // A row added as new again: forget the toy that was picked for it.
        if (x.kind === 'new') { x.site = undefined; x.how = undefined; x.score = undefined; }
      }
    }
  }
  else if (el.dataset.importGroup) { if (el.checked) importOptions.groups.add(el.dataset.importGroup as FieldGroup); else importOptions.groups.delete(el.dataset.importGroup as FieldGroup); }
  else if (el.name === 'import-stock-mode') importOptions.stockMode = el.value === 'add' ? 'add' : 'set';
  else return;
  renderImportPreview();
});
$('#import-preview').addEventListener('click', (event) => {
  const target = event.target instanceof Element ? event.target : null;
  const tab = target?.closest<HTMLElement>('[data-import-tab]');
  if (tab) { importTab = tab.dataset.importTab as typeof importTab; renderImportPreview(); return; }
  const bulk = target?.closest<HTMLElement>('[data-import-bulk]');
  if (!bulk || !pendingImport) return;
  const want = bulk.dataset.importBulk as ImportAction;
  for (const x of pendingImport) {
    if (x.problems.length) continue;
    if (importTab !== 'all' && bucketOf(x, plannedChanges(x)) !== importTab) continue;
    if (want === 'skip') x.action = 'skip';
    else if (want === 'update' && x.site) x.action = 'update';
    else if (want === 'new' && x.kind !== 'exact' && x.canAdd) x.action = 'new';
  }
  renderImportPreview();
});
$('#import-options').innerHTML = `<div class="import-option-row"><strong>Update on existing products:</strong>${FIELD_GROUPS.map(([g, label]) => `<label class="check-pill"><input type="checkbox" data-import-group="${g}" checked /> ${label}</label>`).join('')}</div>
  <div class="import-option-row"><strong>Stock:</strong><label class="check-pill"><input type="radio" name="import-stock-mode" value="set" checked /> Set to the number in the file</label><label class="check-pill"><input type="radio" name="import-stock-mode" value="add" /> Add it to the current stock (new delivery)</label></div>
  <small class="field-help">Empty cells never erase anything: the product keeps what it has.</small>`;

// Step 1: read the file and show the preview (nothing is saved yet).
$('#import').addEventListener('click', async () => {
  const XLSX = (window as any).XLSX;
  const file = $<HTMLInputElement>('#file').files?.[0];
  const msg = $('#msg'), errBox = $('#errors');
  errBox.hidden = true;
  if (!file) { msg.textContent = 'Choose a file first.'; return; }
  if (!XLSX) { msg.textContent = 'Excel tools are still loading. Try again in a moment.'; return; }
  msg.textContent = 'Reading the file…';
  try {
    const buffer = await file.arrayBuffer();
    const wb = XLSX.read(buffer, { type: 'array' });
    const ws = wb.Sheets[wb.SheetNames[0]];
    const rows = (XLSX.utils.sheet_to_json(ws, { defval: '' }) as Row[]).filter((r) => Object.entries(r).some(([k, v]) => k !== '__rowNum__' && String(v ?? '').trim() !== ''));
    if (!rows.length) { clearImportPreview(); msg.textContent = 'The file has no product rows.'; return; }
    const photos = photosByRow(ws, XLSX, readSheetPictures(buffer), rows);
    // Current photos of every product, to see whether the file's photos are new.
    const im = await selectAll(() => supabase.from('product_images').select('product_id,image_url,sort_order').order('sort_order').order('id'));
    sitePhotos = new Map();
    for (const p of products) sitePhotos.set(p.id, p.primary_image_url ? [p.primary_image_url] : []);
    for (const r of (im.data ?? []) as Row[]) { const list = sitePhotos.get(r.product_id); if (list && !list.includes(r.image_url)) list.push(r.image_url); }
    clearImportPreview();
    importFileName = file.name;
    pendingImport = prepareImport(rows, photos);
    renderImportPreview();
    $('#import-preview').scrollIntoView({ behavior: 'smooth', block: 'start' });
    const possible = pendingImport.filter((x) => x.kind === 'possible' && !x.problems.length).length;
    msg.textContent = `Check the preview below${possible ? `: ${possible} row${possible === 1 ? ' looks' : 's look'} like a toy already on the site, choose what to do with ${possible === 1 ? 'it' : 'them'}` : ''}, then press Confirm import. Nothing has been saved yet.`;
  } catch (error) { clearImportPreview(); msg.textContent = error instanceof Error ? error.message : 'The file could not be read.'; }
});
$('#file').addEventListener('change', () => { clearImportPreview(); $('#msg').textContent = ''; $('#errors').hidden = true; });
$('#import-cancel').addEventListener('click', () => { clearImportPreview(); $('#msg').textContent = 'Import cancelled. Nothing was saved.'; });

// ---------- Undo the last import ----------
// Before saving, the import keeps (in this browser) how the products it changes were, and which
// products it added. "Undo last import" puts them back. Stock keeps the sales made since: only the
// import's own change is reversed. Photos replaced by the import stay in storage until the undo is
// no longer possible (the next import, or "Keep changes").
type UndoProduct = { id: string; name: string; fields: Row; stockBefore?: number; stockAfter?: number; categories?: string[]; images?: Row[]; primary?: string | null };
type UndoSnapshot = { at: string; file: string; created: Array<{ id: string; name: string }>; updated: UndoProduct[]; uploaded: string[] };
const UNDO_KEY = 'clevertoys-import-undo';
const PHOTO_MARKER = '/storage/v1/object/public/product-images/';
function readUndo(): UndoSnapshot | null { try { const s = JSON.parse(localStorage.getItem(UNDO_KEY) || 'null'); return s && Array.isArray(s.updated) ? s : null; } catch { return null; } }
function writeUndo(s: UndoSnapshot | null) {
  try { if (s) localStorage.setItem(UNDO_KEY, JSON.stringify(s)); else localStorage.removeItem(UNDO_KEY); return true; } catch { return false; }
}
/** Deletes uploaded photo files that no product, photo or option uses any more (best effort). */
async function removeUnusedPhotoFiles(urls: string[]) {
  const ours = [...new Set(urls.filter((u) => u && u.includes(PHOTO_MARKER)))];
  for (let i = 0; i < ours.length; i += 80) {
    const chunk = ours.slice(i, i + 80);
    const [a, b, c] = await Promise.all([
      supabase.from('product_images').select('image_url').in('image_url', chunk),
      supabase.from('products').select('primary_image_url').in('primary_image_url', chunk),
      supabase.from('product_variants').select('image_url').in('image_url', chunk)
    ]);
    if (a.error || b.error) continue; // could not check: keep the files
    const used = new Set([...(a.data ?? []).map((r: Row) => r.image_url), ...(b.data ?? []).map((r: Row) => r.primary_image_url), ...((c.data ?? []) as Row[]).map((r) => r.image_url)]);
    const unused = chunk.filter((u) => !used.has(u)).map((u) => decodeURIComponent(u.slice(u.indexOf(PHOTO_MARKER) + PHOTO_MARKER.length)));
    if (unused.length) await supabase.storage.from('product-images').remove(unused).catch(() => {});
  }
}
/** The undo is no longer needed: clean up the photos the import replaced. */
async function discardUndo() {
  const s = readUndo();
  writeUndo(null);
  renderUndoBox();
  if (s) await removeUnusedPhotoFiles(s.updated.flatMap((u) => [...(u.images || []).map((r) => String(r.image_url)), ...(u.primary ? [u.primary] : [])]));
}
function renderUndoBox() {
  const s = readUndo();
  $('#undo-box').hidden = !s;
  if (!s) return;
  const when = new Date(s.at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
  $('#undo-text').innerHTML = `<strong>Last import</strong> (${esc(s.file || 'Excel file')}, ${esc(when)}): ${s.created.length} added, ${s.updated.length} updated.`;
}
$('#undo-keep').addEventListener('click', async () => { await discardUndo(); toast('Import kept. Undo is no longer available for it.'); });
$('#undo-import').addEventListener('click', async () => {
  const s = readUndo();
  if (!s) return;
  if (!confirm(`Undo the import of ${s.file || 'the Excel file'}?\n\n• ${s.updated.length} product${s.updated.length === 1 ? '' : 's'} go back to how they were before it (stock keeps the sales made since).\n• ${s.created.length} product${s.created.length === 1 ? '' : 's'} it added ${s.created.length === 1 ? 'is' : 'are'} removed (hidden instead if already ordered).\n\nOther edits made to these products since the import are lost.`)) return;
  const button = $<HTMLButtonElement>('#undo-import');
  button.disabled = true;
  const errors: string[] = [];
  let restored = 0, removed = 0, hidden = 0;
  for (const u of s.updated) {
    try {
      const payload: Row = { ...u.fields, updated_at: new Date().toISOString() };
      if (u.stockAfter !== undefined && u.stockBefore !== undefined) {
        const now = await supabase.from('products').select('stock_quantity').eq('id', u.id).maybeSingle();
        const current = Number((now.data as Row | null)?.stock_quantity ?? u.stockAfter);
        payload.stock_quantity = Math.max(0, current - (u.stockAfter - u.stockBefore));
      }
      const r = await supabase.from('products').update(payload).eq('id', u.id);
      if (r.error) throw new Error(friendly(r.error.message));
      if (u.categories) await saveProductCategories(u.id, u.categories);
      if (u.images) {
        const del = await supabase.from('product_images').delete().eq('product_id', u.id);
        if (del.error) throw new Error(del.error.message);
        if (u.images.length) { const ins = await supabase.from('product_images').insert(u.images); if (ins.error) throw new Error(ins.error.message); }
        const up = await supabase.from('products').update({ primary_image_url: u.primary ?? null }).eq('id', u.id);
        if (up.error) throw new Error(up.error.message);
      }
      restored++;
    } catch (error) { errors.push(`${u.name}: ${error instanceof Error ? error.message : 'could not be put back'}`); }
  }
  for (const c of s.created) {
    const del = await supabase.from('products').delete().eq('id', c.id);
    if (!del.error) { removed++; continue; }
    // Already in an order: hide it instead of deleting it.
    const hide = await supabase.from('products').update({ is_active: false, updated_at: new Date().toISOString() }).eq('id', c.id);
    if (hide.error) errors.push(`${c.name}: ${del.error.message}`); else hidden++;
  }
  await removeUnusedPhotoFiles(s.uploaded);
  writeUndo(null);
  renderUndoBox();
  button.disabled = false;
  const errBox = $('#errors');
  errBox.hidden = errors.length === 0;
  errBox.innerHTML = errors.length ? '<strong>Undo problems</strong>' + errors.slice(0, 50).map((t) => `<p>${esc(t)}</p>`).join('') : '';
  $('#msg').textContent = `Import undone: ${restored} product${restored === 1 ? '' : 's'} put back, ${removed} removed${hidden ? `, ${hidden} hidden (already ordered)` : ''}${errors.length ? `, ${errors.length} problem${errors.length === 1 ? '' : 's'}` : ''}.`;
  await load();
});

/** Uploads a row's photos; returns their addresses (and remembers the uploaded ones for undo). */
async function importRowPhotos(x: ImportItem, productId: string, uploaded: string[], errors: string[]) {
  const urls: string[] = [];
  for (let n = 0; n < x.photos.length; n++) {
    const photo = x.photos[n];
    if (photo.picture && !BROWSER_IMAGE.test(photo.picture.type || '')) continue; // shown in the preview notes
    try { const url = await uploadImportPhoto(productId, photo, n + 1); urls.push(url); if (url !== photo.url) uploaded.push(url); }
    catch (error) { errors.push(`Row ${x.sheetRow + 1} (${x.name}): ${error instanceof Error ? error.message : 'a picture could not be uploaded'}`); }
  }
  return [...new Set(urls)];
}

// Step 2: save what the preview shows.
$('#import-confirm').addEventListener('click', async () => {
  const plan = planImport();
  const toAdd = plan.filter((p) => p.does === 'add');
  const toUpdate = plan.filter((p) => p.does === 'update');
  if (!toAdd.length && !toUpdate.length) return;
  const msg = $('#msg'), errBox = $('#errors');
  const confirmButton = $<HTMLButtonElement>('#import-confirm'), cancelButton = $<HTMLButtonElement>('#import-cancel');
  confirmButton.disabled = cancelButton.disabled = true;
  const errors: string[] = [];
  let created = 0, updated = 0, photoCount = 0;

  // The previous import can no longer be undone; this one can.
  await discardUndo();
  const snapshot: UndoSnapshot = { at: new Date().toISOString(), file: importFileName, created: [], updated: [], uploaded: [] };
  const ids = toUpdate.map((p) => String(p.x.site!.id));
  const fresh = new Map<string, Row>();
  const freshImages = new Map<string, Row[]>();
  for (let i = 0; i < ids.length; i += 80) {
    const chunk = ids.slice(i, i + 80);
    const [pr, im] = await Promise.all([
      supabase.from('products').select('*').in('id', chunk),
      supabase.from('product_images').select('*').in('product_id', chunk).order('sort_order')
    ]);
    for (const r of (pr.data ?? []) as Row[]) fresh.set(r.id, r);
    for (const r of (im.data ?? []) as Row[]) { const list = freshImages.get(r.product_id) || []; list.push(r); freshImages.set(r.product_id, list); }
  }
  const total = toAdd.length + toUpdate.length;
  let step = 0;

  for (const { x, changes } of toUpdate) {
    step++;
    const p = fresh.get(x.site!.id) || x.site!;
    const undo: UndoProduct = { id: p.id, name: p.name, fields: {} };
    try {
      msg.textContent = `Updating ${step} of ${total}: ${p.name}…`;
      const payload: Row = { updated_at: new Date().toISOString() };
      const v = fileValues(x.row);
      for (const c of changes) {
        if (!c.field) continue;
        if (c.field === 'stock_quantity') {
          // Worked out again from the latest stock (an order may have come in meanwhile).
          const current = Number(p.stock_quantity || 0);
          const next = importOptions.stockMode === 'add' ? current + Number(v.stock_quantity) : Number(v.stock_quantity);
          undo.stockBefore = current; undo.stockAfter = next; payload.stock_quantity = next;
        } else { undo.fields[c.field] = p[c.field] ?? null; payload[c.field] = c.value; }
      }
      if (Object.keys(payload).length > 1) {
        const r = await supabase.from('products').update(payload).eq('id', p.id);
        if (r.error) throw new Error(friendly(r.error.message));
      }
      if (changes.some((c) => c.group === 'categories')) {
        undo.categories = productCategoryIds(p);
        await saveProductCategories(p.id, x.matched.map((c) => c.id));
      }
      if (changes.some((c) => c.group === 'photos')) {
        const urls = await importRowPhotos(x, p.id, snapshot.uploaded, errors);
        if (urls.length) {
          undo.images = (freshImages.get(p.id) || []).map(({ id: _id, ...rest }) => rest);
          undo.primary = p.primary_image_url ?? null;
          await replaceProductPhotos(p.id, p.name, urls, false);
          photoCount += urls.length;
        }
      }
      updated++;
    } catch (error) { errors.push(`Row ${x.sheetRow + 1} (${x.name || p.name}): ${error instanceof Error ? error.message : 'Unknown error'}`); }
    // Kept even when only part of the update worked, so undo can still put back what changed.
    if (Object.keys(undo.fields).length || undo.stockAfter !== undefined || undo.categories || undo.images) snapshot.updated.push(undo);
  }

  for (const { x } of toAdd) {
    step++;
    try {
      msg.textContent = `Adding ${step} of ${total}: ${x.name}${x.photos.length ? ` · ${x.photos.length} photo${x.photos.length === 1 ? '' : 's'}` : ''}…`;
      const v = fileValues(x.row);
      // A different toy with a similar name: give it its own web address if the usual one is taken.
      let slug = x.slug;
      for (let n = 2; products.some((p) => p.slug === slug); n++) slug = `${x.slug}-${n}`;
      const payload: Row = { name: x.name, slug, sku: x.sku || null, category_id: x.matched[0]?.id || null, price: x.price, sale_price: v.sale_price ?? null, stock_quantity: v.stock_quantity ?? 0, ...('cost_price' in v ? { cost_price: v.cost_price } : {}), age_min: v.age_min ?? null, age_max: v.age_max ?? null, brand: v.brand ?? null, short_description: v.short_description ?? '', description: v.description ?? '', seo_title: v.seo_title ?? null, seo_description: v.seo_description ?? null, is_active: v.is_active ?? true, is_featured: v.is_featured ?? false, updated_at: new Date().toISOString() };
      const r = await supabase.from('products').insert(payload).select().single();
      if (r.error) throw new Error(friendly(r.error.message));
      const productId = String((r.data as Row).id);
      products.push(r.data as Row);
      snapshot.created.push({ id: productId, name: x.name });
      await saveProductCategories(productId, x.matched.map((c) => c.id));
      created++;
      if (x.photos.length) {
        const urls = await importRowPhotos(x, productId, snapshot.uploaded, errors);
        if (urls.length) { await replaceProductPhotos(productId, x.name, urls, false); photoCount += urls.length; }
      }
    } catch (error) { errors.push(`Row ${x.sheetRow + 1} (${x.name}): ${error instanceof Error ? error.message : 'Unknown error'}`); }
  }

  const undoSaved = snapshot.created.length || snapshot.updated.length ? writeUndo(snapshot) : false;
  renderUndoBox();
  const leftAlone = plan.length - toAdd.length - toUpdate.length;
  clearImportPreview();
  confirmButton.disabled = cancelButton.disabled = false;
  $<HTMLInputElement>('#file').value = '';
  msg.textContent = `Import complete: ${created} added, ${updated} updated${photoCount ? `, ${photoCount} photo${photoCount === 1 ? '' : 's'} saved` : ''}${leftAlone ? `, ${leftAlone} left as they are` : ''}${errors.length ? `, ${errors.length} problem${errors.length === 1 ? '' : 's'}` : ''}.${undoSaved ? ' You can undo it with “Undo last import”.' : ''}`;
  errBox.hidden = errors.length === 0;
  errBox.innerHTML = errors.length ? '<strong>Import problems</strong>' + errors.slice(0, 50).map((t) => `<p>${esc(t)}</p>`).join('') : '';
  await load();
});
renderUndoBox();

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#cfg');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    storageBase = `${url.replace(/\/$/, '')}/storage/v1/object/public/product-images/`;
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = '/login?next=%2Fadmin'; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><p>This account is not an administrator.</p>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'products', 'Products'))) return;
    guard.hidden = true;
    $('#app').hidden = false;
    await load();
    const editId = params.get('edit');
    if (editId) editProduct(editId);
    else if (params.get('new')) clearForm();
  } catch (error) {
    guard.hidden = false;
    guard.innerHTML = `<h2>Admin could not load</h2><p>${esc(error instanceof Error ? error.message : 'Unknown error')}</p><button class="button" type="button" onclick="location.reload()">Try again</button>`;
  }
}
init();
</script>
