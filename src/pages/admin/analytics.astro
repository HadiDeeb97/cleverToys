---
/**
 * Admin → Visitors: who is on the site now, visits over time, top pages, sources and devices,
 * with a sortable visits table that exports to Excel/PDF. Data comes from public/visitor-analytics.js.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Visitors | Clever Toys Admin</title>
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Traffic</p>
        <h1>Visitors</h1>
        <p id="period-label">Who visits the store, where they come from and what they look at.</p>
      </div>
      <div class="quick-actions visitors-actions">
        <div class="chip-row" id="range-chips" role="radiogroup" aria-label="Date range">
          <button type="button" class="chip" data-range="1" role="radio">Today</button>
          <button type="button" class="chip" data-range="7" role="radio">7 days</button>
          <button type="button" class="chip" data-range="30" role="radio">30 days</button>
          <button type="button" class="chip" data-range="90" role="radio">90 days</button>
        </div>
        <label class="auto-refresh"><input class="toggle" type="checkbox" id="auto-refresh" /> Live</label>
        <button id="refresh" class="button secondary-button" type="button">Refresh</button>
      </div>
    </div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>
    <div id="app" hidden>
      <section class="v-kpis" aria-label="Key numbers">
        <article class="v-kpi live"><span><i class="live-dot" aria-hidden="true"></i>Active now</span><strong id="k-active">0</strong><small>Seen in the last 5 minutes</small></article>
        <article class="v-kpi"><span>Visitors</span><strong id="k-visitors">0</strong><small id="d-visitors"></small></article>
        <article class="v-kpi"><span>Sessions</span><strong id="k-sessions">0</strong><small id="d-sessions"></small></article>
        <article class="v-kpi"><span>Page views</span><strong id="k-views">0</strong><small id="d-views"></small></article>
        <article class="v-kpi"><span>Pages / session</span><strong id="k-depth">0</strong><small>Average browsing depth</small></article>
        <article class="v-kpi"><span>Avg. visit</span><strong id="k-duration">0s</strong><small>Time on site per session</small></article>
      </section>

      <div class="v-grid v-grid-main">
        <section class="admin-panel">
          <div class="panel-title"><h2>Traffic</h2><div class="legend"><span class="lg-visitors">Visitors</span><span class="lg-views">Page views</span></div></div>
          <div id="trend" class="trend" role="img" aria-label="Visitors and page views over time"></div>
        </section>
        <section class="admin-panel">
          <div class="panel-title"><h2>Devices</h2></div>
          <div class="donut-wrap"><div id="device-donut" class="donut" role="img"></div><ul id="device-legend" class="donut-legend"></ul></div>
        </section>
      </div>

      <div class="v-grid v-grid-3">
        <section class="admin-panel"><div class="panel-title"><h2>Traffic sources</h2></div><div id="sources" class="rank"></div></section>
        <section class="admin-panel"><div class="panel-title"><h2>Countries</h2></div><div id="countries" class="rank"></div></section>
        <section class="admin-panel"><div class="panel-title"><h2>Browsers</h2></div><div id="browsers" class="rank"></div></section>
      </div>
      <div class="v-grid v-grid-2">
        <section class="admin-panel"><div class="panel-title"><h2>Top pages</h2><small class="muted">Page views</small></div><div id="pages" class="rank"></div></section>
        <section class="admin-panel"><div class="panel-title"><h2>Landing pages</h2><small class="muted">Where visits start</small></div><div id="landing" class="rank"></div></section>
      </div>

      <section class="admin-panel visitors-table-panel">
        <div class="panel-title">
          <div><h2>Visitor sessions</h2><small class="muted" id="table-count"></small></div>
          <div class="export-actions">
            <button id="export-xlsx" class="button secondary-button" type="button">⬇ Excel (.xlsx)</button>
            <button id="export-pdf" class="button secondary-button" type="button">⬇ PDF</button>
          </div>
        </div>
        <div class="table-filters">
          <label class="sr-only" for="t-search">Search sessions</label>
          <input id="t-search" class="admin-input" type="search" placeholder="Search page, source, country, browser…" />
          <select id="t-device" class="admin-input" aria-label="Filter by device"><option value="">All devices</option></select>
          <select id="t-country" class="admin-input" aria-label="Filter by country"><option value="">All countries</option></select>
          <select id="t-source" class="admin-input" aria-label="Filter by source"><option value="">All sources</option></select>
        </div>
        <div class="table-wrap">
          <table class="visitors-table">
            <thead><tr>
              <th><button type="button" data-sort="last_seen_at">Last seen</button></th>
              <th><button type="button" data-sort="started_at">Started</button></th>
              <th><button type="button" data-sort="duration">Duration</button></th>
              <th><button type="button" data-sort="country">Country</button></th>
              <th><button type="button" data-sort="device">Device</button></th>
              <th><button type="button" data-sort="browser">Browser / OS</button></th>
              <th><button type="button" data-sort="source">Source</button></th>
              <th><button type="button" data-sort="landing_path">Landing page</button></th>
              <th><button type="button" data-sort="current_path">Last page</button></th>
              <th><button type="button" data-sort="page_count">Pages</button></th>
            </tr></thead>
            <tbody id="t-body"></tbody>
          </table>
        </div>
        <div class="table-pager"><button id="t-prev" class="small-button" type="button">← Previous</button><span id="t-page"></span><button id="t-next" class="small-button" type="button">Next →</button></div>
      </section>

      <p class="privacy-note"><strong>Privacy by design.</strong> Only anonymous visitor and session IDs, approximate country, device, browser, OS, pages and times are stored. No IP addresses, names or emails.</p>
    </div>
  </div>
</main>

<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { allowPage } from '../../scripts/admin-access';
import { exportPdf, exportXlsx, type ExportColumn } from '../../scripts/table-export';

type Session = { session_id: string; visitor_id: string; started_at: string; last_seen_at: string; landing_path: string; current_path: string; entry_referrer: string | null; country: string | null; device: string; browser: string; os: string; page_count: number; duration: number; source: string };
const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const fmt = (n: number) => new Intl.NumberFormat().format(Math.round(n || 0));
const toast = (message: string, tone = 'success') => (window as any).adminToast?.(message, tone);
const PAGE_SIZE = 25;
const regionNames = (() => { try { return new Intl.DisplayNames(undefined, { type: 'region' }); } catch { return null; } })();
const countryName = (code: string | null) => { if (!code || !/^[A-Z]{2}$/i.test(code)) return 'Unknown'; try { return regionNames?.of(code.toUpperCase()) || code.toUpperCase(); } catch { return code.toUpperCase(); } };
const flag = (code: string | null) => (code && /^[A-Z]{2}$/i.test(code) ? String.fromCodePoint(...[...code.toUpperCase()].map((c) => 127397 + c.charCodeAt(0))) : '🌐');
const deviceIcon = (d: string) => (d === 'mobile' ? '📱' : d === 'tablet' ? '📲' : d === 'desktop' ? '🖥️' : '❔');
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const sourceOf = (ref: string | null) => { if (!ref) return 'Direct'; try { const host = new URL(ref).hostname.replace(/^www\./, ''); if (host === location.hostname) return 'Direct'; if (/instagram/.test(host)) return 'Instagram'; if (/facebook|fb\.com/.test(host)) return 'Facebook'; if (/google\./.test(host)) return 'Google'; if (/tiktok/.test(host)) return 'TikTok'; if (/whatsapp|wa\.me/.test(host)) return 'WhatsApp'; return host; } catch { return 'Other'; } };
const duration = (secs: number) => { if (secs < 60) return `${Math.round(secs)}s`; const m = Math.floor(secs / 60); if (m < 60) return `${m}m ${Math.round(secs % 60)}s`; return `${Math.floor(m / 60)}h ${m % 60}m`; };
const when = (iso: string) => new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
const ago = (iso: string) => { const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); if (s < 60) return 'just now'; if (s < 3600) return `${Math.floor(s / 60)} min ago`; if (s < 86400) return `${Math.floor(s / 3600)} h ago`; return when(iso); };

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let range = Number(new URLSearchParams(location.search).get('range')) || 30;
if (![1, 7, 30, 90].includes(range)) range = 30;
let sessions: Session[] = [];
let sortKey: keyof Session = 'last_seen_at';
let sortDir = -1;
let page = 0;
let timer: number | undefined;

const periodStart = (days: number, offset = 0) => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - (days - 1) - offset * days); return d; };
const delta = (now: number, before: number) => { if (!before) return now ? '<span class="up">New activity</span>' : 'No change'; const pct = Math.round(((now - before) / before) * 100); return `<span class="${pct >= 0 ? 'up' : 'down'}">${pct >= 0 ? '▲' : '▼'} ${Math.abs(pct)}%</span> vs previous period`; };

function rank(id: string, entries: [string, number][], total: number, label: (k: string) => string = esc) {
  $(id).innerHTML = entries.length ? entries.slice(0, 7).map(([k, v]) => { const pct = total ? Math.round((v / total) * 100) : 0; return `<div class="rank-item"><div class="rank-top"><span title="${esc(k)}">${label(k)}</span><strong>${fmt(v)} <small>${pct}%</small></strong></div><div class="rank-bar"><i style="width:${Math.max(2, pct)}%"></i></div></div>`; }).join('') : '<p class="empty-mini">No data yet.</p>';
}
const countBy = <T,>(rows: T[], key: (r: T) => string) => { const m = new Map<string, number>(); for (const r of rows) { const k = key(r) || 'Unknown'; m.set(k, (m.get(k) || 0) + 1); } return [...m.entries()].sort((a, b) => b[1] - a[1]); };

function renderTrend(events: any[], start: Date) {
  const hourly = range === 1;
  const buckets = hourly ? 24 : range;
  const step = hourly ? 3600e3 : 864e5;
  const points = Array.from({ length: buckets }, (_, i) => ({ t: start.getTime() + i * step, visitors: new Set<string>(), views: 0 }));
  const index = (iso: string) => Math.floor((new Date(iso).getTime() - start.getTime()) / step);
  for (const e of events) { const i = index(e.created_at); if (points[i]) { points[i].views++; points[i].visitors.add(e.visitor_id); } }
  const W = 720, H = 240, P = { l: 36, r: 12, t: 12, b: 28 };
  const max = Math.max(4, ...points.map((p) => p.views));
  const x = (i: number) => P.l + (buckets === 1 ? 0 : (i / (buckets - 1)) * (W - P.l - P.r));
  const y = (v: number) => H - P.b - (v / max) * (H - P.t - P.b);
  const line = (vals: number[]) => vals.map((v, i) => { if (i === 0) return `M${x(0)},${y(v)}`; const cx = (x(i - 1) + x(i)) / 2; return `C${cx},${y(vals[i - 1])} ${cx},${y(v)} ${x(i)},${y(v)}`; }).join(' ');
  const views = points.map((p) => p.views), visitors = points.map((p) => p.visitors.size);
  const area = (vals: number[]) => `${line(vals)} L${x(buckets - 1)},${H - P.b} L${x(0)},${H - P.b} Z`;
  const label = (t: number) => new Date(t).toLocaleString(undefined, hourly ? { hour: 'numeric' } : { month: 'short', day: 'numeric' });
  const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(max * f));
  const every = Math.max(1, Math.ceil(buckets / 8));
  const colW = (W - P.l - P.r) / Math.max(1, buckets - 1);
  $('#trend').innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
    <defs><linearGradient id="g-views" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--brand-primary)" stop-opacity=".28"/><stop offset="1" stop-color="var(--brand-primary)" stop-opacity="0"/></linearGradient></defs>
    ${ticks.map((t) => `<line x1="${P.l}" x2="${W - P.r}" y1="${y(t)}" y2="${y(t)}" class="grid"/><text x="${P.l - 6}" y="${y(t) + 4}" text-anchor="end" class="axis">${t}</text>`).join('')}
    <path d="${area(views)}" fill="url(#g-views)"/>
    <path d="${line(views)}" class="ln-views"/>
    <path d="${line(visitors)}" class="ln-visitors"/>
    ${points.map((p, i) => ((i % every === 0 && buckets - 1 - i >= every / 2) || i === buckets - 1 ? `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" class="axis">${esc(label(p.t))}</text>` : '')).join('')}
    ${points.map((p, i) => `<rect x="${x(i) - colW / 2}" y="${P.t}" width="${colW}" height="${H - P.t - P.b}" class="hit"><title>${esc(label(p.t))}: ${p.visitors.size} visitors, ${p.views} page views</title></rect>`).join('')}
  </svg>`;
}

function renderDevices() {
  const entries = countBy(sessions, (s) => s.device);
  const total = sessions.length || 1;
  const colors = ['var(--brand-primary)', 'var(--brand-primary-2)', 'var(--theme-accent)', 'var(--line-strong)'];
  let acc = 0;
  const stops = entries.map(([, v], i) => { const from = acc; acc += (v / total) * 100; return `${colors[i % 4]} ${from}% ${acc}%`; });
  $('#device-donut').style.background = entries.length ? `conic-gradient(${stops.join(',')})` : 'var(--surface-2)';
  $('#device-donut').setAttribute('aria-label', entries.map(([k, v]) => `${k} ${Math.round((v / total) * 100)}%`).join(', ') || 'No data');
  $('#device-donut').innerHTML = `<span><strong>${fmt(sessions.length)}</strong><small>sessions</small></span>`;
  $('#device-legend').innerHTML = entries.length ? entries.map(([k, v], i) => `<li><i style="background:${colors[i % 4]}"></i>${deviceIcon(k)} ${esc(cap(k))}<strong>${Math.round((v / total) * 100)}%</strong></li>`).join('') : '<li class="muted">No data yet.</li>';
}

function filteredSessions() {
  const q = $<HTMLInputElement>('#t-search').value.trim().toLowerCase();
  const device = $<HTMLSelectElement>('#t-device').value, country = $<HTMLSelectElement>('#t-country').value, source = $<HTMLSelectElement>('#t-source').value;
  const rows = sessions.filter((s) => (!device || s.device === device) && (!country || (s.country || '') === country) && (!source || s.source === source) && (!q || [s.landing_path, s.current_path, s.source, countryName(s.country), s.browser, s.os, s.device].some((v) => String(v || '').toLowerCase().includes(q))));
  return rows.sort((a, b) => { const av = a[sortKey] ?? '', bv = b[sortKey] ?? ''; return (typeof av === 'number' && typeof bv === 'number' ? av - bv : String(av).localeCompare(String(bv))) * sortDir; });
}

function renderTable() {
  const rows = filteredSessions();
  const pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
  page = Math.min(page, pages - 1);
  $('#table-count').textContent = `${fmt(rows.length)} of ${fmt(sessions.length)} sessions`;
  $('#t-page').textContent = `Page ${page + 1} of ${pages}`;
  $<HTMLButtonElement>('#t-prev').disabled = page === 0;
  $<HTMLButtonElement>('#t-next').disabled = page >= pages - 1;
  document.querySelectorAll<HTMLElement>('[data-sort]').forEach((b) => { const active = b.dataset.sort === sortKey; b.closest('th')!.setAttribute('aria-sort', active ? (sortDir > 0 ? 'ascending' : 'descending') : 'none'); b.dataset.dir = active ? (sortDir > 0 ? '↑' : '↓') : ''; });
  $('#t-body').innerHTML = rows.length ? rows.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE).map((s) => `<tr>
    <td><strong>${esc(ago(s.last_seen_at))}</strong></td>
    <td>${esc(when(s.started_at))}</td>
    <td>${esc(duration(s.duration))}</td>
    <td>${flag(s.country)} ${esc(countryName(s.country))}</td>
    <td>${deviceIcon(s.device)} ${esc(cap(s.device))}</td>
    <td>${esc(s.browser)}<small>${esc(s.os)}</small></td>
    <td><span class="source-pill">${esc(s.source)}</span></td>
    <td class="path" title="${esc(s.landing_path)}">${esc(s.landing_path)}</td>
    <td class="path" title="${esc(s.current_path)}">${esc(s.current_path)}</td>
    <td>${fmt(s.page_count)}</td></tr>`).join('') : '<tr><td colspan="10" class="empty-mini">No sessions match these filters.</td></tr>';
}

const fillSelect = (id: string, values: string[], label: (v: string) => string) => { const el = $<HTMLSelectElement>(id); const current = el.value; el.innerHTML = el.options[0].outerHTML + values.map((v) => `<option value="${esc(v)}">${esc(label(v))}</option>`).join(''); el.value = values.includes(current) ? current : ''; };

async function load() {
  const start = periodStart(range);
  const prevStart = periodStart(range, 1);
  const now = new Date();
  document.querySelectorAll<HTMLElement>('[data-range]').forEach((c) => { const on = Number(c.dataset.range) === range; c.classList.toggle('active', on); c.setAttribute('aria-checked', String(on)); });
  $('#period-label').textContent = range === 1 ? `Today, ${now.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })}` : `${start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })} – ${now.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}`;
  const [s, e, prevS, prevE, active] = await Promise.all([
    supabase.from('visitor_sessions').select('session_id,visitor_id,started_at,last_seen_at,landing_path,current_path,entry_referrer,country,device,browser,os,page_count').gte('started_at', start.toISOString()).order('last_seen_at', { ascending: false }).limit(10000),
    supabase.from('visitor_events').select('visitor_id,path,created_at').gte('created_at', start.toISOString()).eq('event_type', 'pageview').limit(50000),
    supabase.from('visitor_sessions').select('visitor_id').gte('started_at', prevStart.toISOString()).lt('started_at', start.toISOString()).limit(10000),
    supabase.from('visitor_events').select('visitor_id', { count: 'exact', head: true }).gte('created_at', prevStart.toISOString()).lt('created_at', start.toISOString()).eq('event_type', 'pageview'),
    supabase.from('visitor_sessions').select('session_id', { count: 'exact', head: true }).gte('last_seen_at', new Date(Date.now() - 5 * 60e3).toISOString())
  ]);
  const error = s.error || e.error;
  if (error) throw new Error(error.message);
  sessions = ((s.data ?? []) as any[]).map((row) => ({ ...row, duration: Math.max(0, (new Date(row.last_seen_at).getTime() - new Date(row.started_at).getTime()) / 1000), source: sourceOf(row.entry_referrer) }));
  const events = (e.data ?? []) as any[];
  const prevSessions = (prevS.data ?? []) as any[];
  const visitors = new Set(sessions.map((x) => x.visitor_id)).size;
  $('#k-active').textContent = fmt(active.count ?? 0);
  $('#k-visitors').textContent = fmt(visitors);
  $('#d-visitors').innerHTML = delta(visitors, new Set(prevSessions.map((x) => x.visitor_id)).size);
  $('#k-sessions').textContent = fmt(sessions.length);
  $('#d-sessions').innerHTML = delta(sessions.length, prevSessions.length);
  $('#k-views').textContent = fmt(events.length);
  $('#d-views').innerHTML = delta(events.length, prevE.count ?? 0);
  $('#k-depth').textContent = sessions.length ? (events.length / sessions.length).toFixed(1) : '0';
  $('#k-duration').textContent = duration(sessions.length ? sessions.reduce((sum, x) => sum + x.duration, 0) / sessions.length : 0);

  renderTrend(events, start);
  renderDevices();
  rank('#sources', countBy(sessions, (x) => x.source), sessions.length);
  rank('#countries', countBy(sessions, (x) => x.country || ''), sessions.length, (k) => `${flag(k)} ${esc(countryName(k))}`);
  rank('#browsers', countBy(sessions, (x) => x.browser), sessions.length);
  rank('#pages', countBy(events, (x) => x.path), events.length, (k) => `<code>${esc(k)}</code>`);
  rank('#landing', countBy(sessions, (x) => x.landing_path), sessions.length, (k) => `<code>${esc(k)}</code>`);

  fillSelect('#t-device', [...new Set(sessions.map((x) => x.device))].sort(), (v) => cap(v));
  fillSelect('#t-country', [...new Set(sessions.map((x) => x.country || ''))].sort(), (v) => countryName(v));
  fillSelect('#t-source', [...new Set(sessions.map((x) => x.source))].sort(), (v) => v);
  renderTable();
}

// ----- export: the rows currently matching the table filters -----
const exportColumns: ExportColumn[] = [
  { header: 'Last seen', width: 18 }, { header: 'Started', width: 18 }, { header: 'Duration (s)', width: 12 }, { header: 'Country', width: 18 },
  { header: 'Device', width: 10 }, { header: 'Browser', width: 12 }, { header: 'OS', width: 12 }, { header: 'Source', width: 16 },
  { header: 'Landing page', width: 34 }, { header: 'Last page', width: 34 }, { header: 'Pages', width: 8 }
];
const exportRows = (forPdf: boolean) => filteredSessions().map((s) => [
  new Date(s.last_seen_at).toLocaleString(), new Date(s.started_at).toLocaleString(), forPdf ? duration(s.duration) : Math.round(s.duration),
  countryName(s.country), cap(s.device), s.browser, s.os, s.source, s.landing_path, s.current_path, s.page_count
]);
const fileStem = () => `clever-toys-visitors-${range === 1 ? 'today' : `${range}d`}-${new Date().toISOString().slice(0, 10)}`;
async function runExport(button: HTMLButtonElement, kind: 'xlsx' | 'pdf') {
  const rows = exportRows(kind === 'pdf');
  if (!rows.length) { toast('There are no sessions to export for these filters.', 'error'); return; }
  const label = button.textContent;
  button.disabled = true; button.textContent = 'Preparing…';
  try {
    if (kind === 'xlsx') await exportXlsx(`${fileStem()}.xlsx`, 'Visitor sessions', exportColumns, rows);
    else {
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--brand-primary').trim();
      await exportPdf(`${fileStem()}.pdf`, 'Visitor sessions report', `${$('#period-label').textContent} · ${rows.length} sessions · exported ${new Date().toLocaleString()}`, exportColumns.map((c) => (c.header === 'Duration (s)' ? { ...c, header: 'Duration' } : c)), rows, accent);
    }
    toast(`Exported ${rows.length} sessions.`);
  } catch (error) {
    toast(`Export failed: ${error instanceof Error ? error.message : 'unknown error'}`, 'error');
  } finally {
    button.disabled = false; button.textContent = label;
  }
}

// ----- events -----
document.querySelectorAll<HTMLElement>('[data-range]').forEach((chip) => chip.addEventListener('click', async () => {
  range = Number(chip.dataset.range);
  const u = new URL(location.href); u.searchParams.set('range', String(range)); history.replaceState(null, '', u);
  page = 0; await safeLoad();
}));
document.querySelectorAll<HTMLElement>('[data-sort]').forEach((b) => b.addEventListener('click', () => { const key = b.dataset.sort as keyof Session; if (sortKey === key) sortDir *= -1; else { sortKey = key; sortDir = ['started_at', 'last_seen_at', 'duration', 'page_count'].includes(key) ? -1 : 1; } renderTable(); }));
['#t-search', '#t-device', '#t-country', '#t-source'].forEach((sel) => $(sel).addEventListener('input', () => { page = 0; renderTable(); }));
$('#t-prev').addEventListener('click', () => { page = Math.max(0, page - 1); renderTable(); });
$('#t-next').addEventListener('click', () => { page += 1; renderTable(); });
$('#refresh').addEventListener('click', () => safeLoad(true));
$<HTMLButtonElement>('#export-xlsx').addEventListener('click', (e) => runExport(e.currentTarget as HTMLButtonElement, 'xlsx'));
$<HTMLButtonElement>('#export-pdf').addEventListener('click', (e) => runExport(e.currentTarget as HTMLButtonElement, 'pdf'));
$<HTMLInputElement>('#auto-refresh').addEventListener('change', (e) => {
  clearInterval(timer);
  if ((e.target as HTMLInputElement).checked) { timer = window.setInterval(() => { if (!document.hidden) safeLoad(); }, 60e3); toast('Live mode: refreshing every minute.'); }
});

async function safeLoad(announce = false) {
  try { await load(); if (announce) toast('Visitor data refreshed.'); }
  catch (error) { toast(error instanceof Error ? error.message : 'Could not load visitor data.', 'error'); }
}

async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#auth-config');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = `/login?next=${encodeURIComponent('/admin/analytics')}`; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><a class="button" href="/">Back to store</a>'; return; }
    // Staff roles (supabase/cms.sql): stop here if this role cannot open the page.
    if (!(await allowPage(supabase, 'analytics', 'Visitors'))) return;
    guard.hidden = true;
    $('#app').hidden = false;
    await load();
  } catch (error) {
    guard.hidden = false;
    guard.innerHTML = `<h2>Visitor data unavailable</h2><p>${esc(error instanceof Error ? error.message : 'Could not load analytics.')}</p>`;
  }
}
init();
</script>

