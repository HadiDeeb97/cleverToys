---
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<header class="site-header"><div class="container header-inner"><a href="/admin" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/orders">Orders</a><a href="/admin/analytics" aria-current="page">Visitors</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container">
  <div class="admin-head"><div><p class="eyebrow">Traffic &amp; customer insight</p><h1>Visitor Analytics</h1><p>Understand who visits, where they come from, what they browse and how active the store is.</p></div><div class="analytics-actions"><select id="range"><option value="7">Last 7 days</option><option value="30" selected>Last 30 days</option><option value="90">Last 90 days</option></select><button id="refresh" class="button secondary-button" type="button">Refresh</button></div></div>
  <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
  <div id="guard" class="empty-state">Checking admin access…</div>
  <div id="app" hidden>
    <section class="stats-grid analytics-stats">
      <article class="stat-card live-card"><div class="stat-heading"><span>Active now</span><i></i></div><strong id="active">0</strong><small>Seen in the last 5 minutes</small></article>
      <article class="stat-card"><span>Unique visitors</span><strong id="visitors">0</strong><small>Privacy-friendly browser visitors</small></article>
      <article class="stat-card"><span>Sessions</span><strong id="sessions">0</strong><small>Visits during selected period</small></article>
      <article class="stat-card"><span>Page views</span><strong id="pageviews">0</strong><small>Tracked storefront page views</small></article>
      <article class="stat-card"><span>Pages / session</span><strong id="pages-session">0</strong><small>Average navigation depth</small></article>
      <article class="stat-card"><span>Mobile share</span><strong id="mobile-share">0%</strong><small>Mobile sessions</small></article>
    </section>

    <section class="analytics-grid analytics-grid-main">
      <section class="admin-panel panel-large"><div class="panel-title"><div><h2>Traffic trend</h2><small>Daily visitors and page views</small></div><span id="period-label" class="muted"></span></div><div id="trend" class="trend-chart"></div></section>
      <section class="admin-panel"><div class="panel-title"><div><h2>Traffic sources</h2><small>Where sessions started</small></div></div><div id="sources" class="rank-list"></div></section>
    </section>

    <section class="analytics-grid analytics-grid-3">
      <section class="admin-panel"><div class="panel-title"><h2>Top pages</h2></div><div id="pages" class="rank-list"></div></section>
      <section class="admin-panel"><div class="panel-title"><h2>Countries</h2></div><div id="countries" class="rank-list"></div></section>
      <section class="admin-panel"><div class="panel-title"><h2>Devices</h2></div><div id="devices" class="rank-list"></div></section>
    </section>

    <section class="analytics-grid analytics-grid-2">
      <section class="admin-panel"><div class="panel-title"><h2>Browsers</h2></div><div id="browsers" class="rank-list"></div></section>
      <section class="admin-panel"><div class="panel-title"><h2>Operating systems</h2></div><div id="oss" class="rank-list"></div></section>
    </section>

    <section class="admin-panel"><div class="panel-title"><div><h2>Recent visitors</h2><small>Anonymous session-level detail. No raw IP addresses are stored.</small></div><span id="updated" class="muted"></span></div><div class="table-wrap"><table><thead><tr><th>Last seen</th><th>Location</th><th>Device</th><th>Browser</th><th>Current page</th><th>Pages</th><th>Session</th></tr></thead><tbody id="recent-visitors"></tbody></table></div></section>

    <section class="privacy-note"><strong>Privacy by design</strong><span>This analytics system stores anonymous visitor/session IDs, approximate country, device, browser, OS, pages and timestamps. It does not store raw IP addresses, names, emails or full user-agent strings.</span></section>
  </div>
</div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#auth-config');const url=cfg?.dataset.url;const key=cfg?.dataset.key;const guard=document.querySelector('#guard');const app=document.querySelector('#app');let supabase;
const fmtInt=n=>new Intl.NumberFormat().format(Number(n||0));
const fmtAgo=iso=>{const sec=Math.max(0,Math.floor((Date.now()-new Date(iso).getTime())/1000));if(sec<60)return `${sec}s ago`;const min=Math.floor(sec/60);if(min<60)return `${min}m ago`;const h=Math.floor(min/60);if(h<24)return `${h}h ago`;return new Date(iso).toLocaleDateString()};
const esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));
const countBy=(rows,keyFn)=>{const m=new Map();for(const row of rows){const k=keyFn(row)||'Unknown';m.set(k,(m.get(k)||0)+1)}return [...m.entries()].sort((a,b)=>b[1]-a[1]);};
const compactPath=p=>{const s=String(p||'/');return s.length>48?`${s.slice(0,46)}…`:s};
function renderRank(id,entries,total){const el=document.querySelector('#'+id);if(!entries.length){el.innerHTML='<div class="empty-mini">No data yet.</div>';return;}el.innerHTML=entries.slice(0,8).map(([label,value])=>{const pct=total?Math.round(value/total*100):0;return `<div class="rank-row"><div class="rank-label"><span title="${esc(label)}">${esc(label)}</span><strong>${fmtInt(value)}</strong></div><div class="rank-track"><i style="width:${Math.max(3,pct)}%"></i></div></div>`}).join('');}
function renderTrend(events,sessions,start,days){const byDay=new Map();for(let i=0;i<days;i++){const d=new Date(start);d.setDate(d.getDate()+i);const key=d.toISOString().slice(0,10);byDay.set(key,{visitors:new Set(),views:0,label:d.toLocaleDateString(undefined,{month:'short',day:'numeric'})})}for(const s of sessions){const key=new Date(s.started_at).toISOString().slice(0,10);if(byDay.has(key))byDay.get(key).visitors.add(s.visitor_id)}for(const e of events){const key=new Date(e.created_at).toISOString().slice(0,10);if(byDay.has(key))byDay.get(key).views++}const rows=[...byDay.values()];const max=Math.max(1,...rows.map(x=>Math.max(x.views,x.visitors.size)));document.querySelector('#trend').innerHTML=rows.map(x=>`<div class="trend-col" title="${x.label}: ${x.visitors.size} visitors, ${x.views} views"><div class="trend-bars"><i class="bar-visitors" style="height:${Math.max(4,Math.round(x.visitors.size/max*100))}%"></i><i class="bar-views" style="height:${Math.max(4,Math.round(x.views/max*100))}%"></i></div><span>${esc(x.label)}</span></div>`).join('');}
async function load(){const days=Number(document.querySelector('#range').value||30);const end=new Date();const start=new Date();start.setDate(start.getDate()-(days-1));const from=start.toISOString();document.querySelector('#period-label').textContent=`${start.toLocaleDateString()} – ${end.toLocaleDateString()}`;const [s,e,active]=await Promise.all([
  supabase.from('visitor_sessions').select('session_id,visitor_id,started_at,last_seen_at,landing_path,current_path,entry_referrer,country,device,browser,os,page_count').gte('started_at',from).order('last_seen_at',{ascending:false}).limit(10000),
  supabase.from('visitor_events').select('session_id,visitor_id,path,referrer,country,device,browser,os,event_type,created_at').gte('created_at',from).eq('event_type','pageview').order('created_at',{ascending:false}).limit(20000),
  supabase.from('visitor_sessions').select('session_id,last_seen_at,current_path,country,device,browser,os,page_count').gte('last_seen_at',new Date(Date.now()-5*60*1000).toISOString()).order('last_seen_at',{ascending:false}).limit(500)
]);
if(s.error||e.error||active.error)throw new Error((s.error||e.error||active.error).message);const sessions=s.data||[],events=e.data||[],activeNow=active.data||[];document.querySelector('#active').textContent=fmtInt(activeNow.length);document.querySelector('#visitors').textContent=fmtInt(new Set(sessions.map(x=>x.visitor_id)).size);document.querySelector('#sessions').textContent=fmtInt(sessions.length);document.querySelector('#pageviews').textContent=fmtInt(events.length);document.querySelector('#pages-session').textContent=sessions.length?(events.length/sessions.length).toFixed(1):'0.0';const mobile=sessions.filter(x=>x.device==='mobile').length;document.querySelector('#mobile-share').textContent=sessions.length?`${Math.round(mobile/sessions.length*100)}%`:'0%';renderTrend(events,sessions,start,days);renderRank('pages',countBy(events,e=>e.path),events.length);renderRank('countries',countBy(sessions,s=>s.country||'Unknown'),sessions.length);renderRank('devices',countBy(sessions,s=>s.device),sessions.length);renderRank('browsers',countBy(sessions,s=>s.browser),sessions.length);renderRank('oss',countBy(sessions,s=>s.os),sessions.length);renderRank('sources',countBy(sessions,s=>{if(!s.entry_referrer)return 'Direct';try{return new URL(s.entry_referrer).hostname.replace(/^www\./,'')}catch{return s.entry_referrer}}),sessions.length);const recent=sessions.slice(0,30);document.querySelector('#recent-visitors').innerHTML=recent.length?recent.map(s=>`<tr><td>${esc(fmtAgo(s.last_seen_at))}</td><td>${esc(s.country||'Unknown')}</td><td>${esc(s.device)}</td><td>${esc(s.browser)}<br><small>${esc(s.os)}</small></td><td title="${esc(s.current_path)}">${esc(compactPath(s.current_path))}</td><td>${fmtInt(s.page_count)}</td><td><code>${esc(String(s.session_id).slice(0,8))}</code></td></tr>`).join(''):'<tr><td colspan="7" class="empty-cell">No visitor sessions yet. Once tracking is installed, new visits will appear here.</td></tr>';document.querySelector('#updated').textContent=`Updated ${new Date().toLocaleTimeString()}`;}
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const{data:{session},error:sessionError}=await supabase.auth.getSession();if(sessionError)throw new Error(sessionError.message);if(!session?.user){location.href=`/login?next=${encodeURIComponent('/admin/analytics')}`;return;}const{data:isAdmin,error}=await supabase.rpc('is_admin');if(error)throw new Error(error.message);if(!isAdmin){guard.innerHTML='<h2>Access denied</h2><a class="button" href="/">Back to store</a>';return;}guard.hidden=true;app.hidden=false;await load();}catch(error){guard.innerHTML='<h2>Analytics unavailable</h2><p>'+esc(error?.message||'Could not load analytics.')+'</p>';}}
document.querySelector('#range').onchange=load;document.querySelector('#refresh').onclick=load;init();
</script>
<style>
.analytics-actions{display:flex;gap:10px;align-items:center}.analytics-actions select{min-height:48px;padding:0 14px;border:1px solid var(--line);border-radius:12px;background:#fff}.analytics-stats{grid-template-columns:repeat(6,minmax(0,1fr));margin-bottom:24px}.analytics-stats .stat-card{min-height:142px}.stat-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}.live-card .stat-heading i{width:9px;height:9px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 5px rgba(34,197,94,.12)}.analytics-grid{display:grid;gap:18px;margin-bottom:18px}.analytics-grid-main{grid-template-columns:minmax(0,2fr) minmax(320px,1fr)}.analytics-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.analytics-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-panel{padding:22px}.panel-title small,.muted{color:var(--muted)}.trend-chart{height:250px;display:flex;align-items:stretch;gap:7px;padding:20px 4px 0;overflow:hidden}.trend-col{flex:1;min-width:14px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:7px}.trend-bars{height:210px;width:100%;display:flex;align-items:flex-end;justify-content:center;gap:2px}.trend-bars i{width:42%;min-width:2px;border-radius:5px 5px 2px 2px}.bar-visitors{background:var(--brand-primary,#111827)}.bar-views{background:var(--line-strong)}.trend-col span{font-size:.68rem;color:var(--subtle);white-space:nowrap;transform:rotate(-35deg);transform-origin:top center;margin-top:4px}.rank-list{display:grid;gap:13px}.rank-row{display:grid;gap:7px}.rank-label{display:flex;justify-content:space-between;gap:10px;font-size:.88rem}.rank-label span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rank-label strong{font-size:.82rem}.rank-track{height:7px;border-radius:999px;background:var(--line);overflow:hidden}.rank-track i{display:block;height:100%;border-radius:inherit;background:var(--brand-primary,#111827)}.empty-mini,.empty-cell{color:var(--subtle);padding:20px;text-align:center}.privacy-note{display:flex;gap:10px;align-items:flex-start;padding:16px 18px;margin-top:18px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);color:var(--muted);font-size:.86rem;line-height:1.5}.privacy-note strong{color:var(--ink);white-space:nowrap}code{font-size:.75rem;color:var(--muted)}@media(max-width:1100px){.analytics-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.analytics-grid-main{grid-template-columns:1fr}.analytics-grid-3{grid-template-columns:1fr 1fr}.admin-head{align-items:flex-start}}@media(max-width:700px){.analytics-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.analytics-grid-3,.analytics-grid-2{grid-template-columns:1fr}.analytics-actions{width:100%;flex-wrap:wrap}.analytics-actions select{flex:1}.admin-head{gap:16px}.privacy-note{flex-direction:column}.trend-chart{overflow-x:auto}.trend-col{min-width:24px}}
</style>
