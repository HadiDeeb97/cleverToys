---
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<header class="site-header"><div class="container header-inner"><a class="logo" href="/admin">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/dashboard">Dashboard</a><a href="/admin/orders">Orders</a><a href="/admin/branding">Branding</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container seo-page">
  <div class="admin-head"><div><p class="eyebrow">Search visibility</p><h1>SEO Settings</h1><p>Edit the SEO title, description, cover image and keywords for every public page.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div>
  <div id="cfg" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
  <div id="auth-status" class="status" role="status">Checking admin access…</div>
  <div id="app" hidden>
    <div class="seo-layout">
      <aside class="form-card page-list-card"><div class="panel-title"><div><h2>Pages</h2><small>Select a page to edit.</small></div><button id="new-page" class="small-button" type="button">+ Add</button></div><input id="page-search" class="page-search" placeholder="Search pages…"/><div id="page-list" class="page-list"></div></aside>
      <section class="form-card editor-card">
        <div class="section-heading"><div><p class="eyebrow">SEO editor</p><h2 id="editor-heading">Select a page</h2><p id="editor-path" class="muted"></p></div><button id="delete-page" class="small-button danger-button" type="button" hidden>Delete</button></div>
        <form id="seo-form" hidden>
          <label>Page path<input id="path_key" name="path_key" required placeholder="/about or /product/*"/><small>Use an exact path for one page, or <code>*</code> for a dynamic fallback such as <code>/product/*</code>.</small></label>
          <label>SEO title<input id="title" name="title" required maxlength="70"/><small><span id="title-count">0</span>/70 characters</small></label>
          <label>Meta description<textarea id="description" name="description" rows="4" required maxlength="170"></textarea><small><span id="description-count">0</span>/170 characters</small></label>
          <label>Keywords<input id="keywords" name="keywords" placeholder="toys Lebanon, educational toys, kids toys"/><small>Separate keywords with commas.</small></label>
          <label>SEO cover image<input id="cover-file" type="file" accept="image/jpeg,image/png,image/webp"/><small>Used for social sharing (Open Graph/Twitter). Images are converted to WebP automatically.</small></label>
          <div id="cover-preview-wrap" class="cover-preview-wrap" hidden><img id="cover-preview" alt="SEO cover preview"/><button id="remove-cover" class="small-button secondary-button" type="button">Remove cover image</button></div>
          <div class="search-preview"><p class="eyebrow">Search preview</p><strong id="preview-title">Your SEO title</strong><span id="preview-url"></span><p id="preview-description">Your meta description will appear here.</p></div>
          <div class="form-actions"><button id="save" class="button" type="submit">Save SEO</button><button id="reset" class="button secondary-button" type="button">Reset</button></div>
          <p id="message" role="status"></p>
        </form>
        <div id="empty" class="empty-state"><h2>Choose a page</h2><p>Pick a page from the list to edit its SEO settings.</p></div>
      </section>
    </div>
  </div>
</div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const cfg=document.querySelector('#cfg');const url=cfg?.dataset.url||'',key=cfg?.dataset.key||'';let supabase=null,pages=[],selectedId=null,originalCover='';
const authStatus=document.querySelector('#auth-status'),app=document.querySelector('#app'),pageList=document.querySelector('#page-list'),form=document.querySelector('#seo-form'),empty=document.querySelector('#empty'),message=document.querySelector('#message'),coverPreviewWrap=document.querySelector('#cover-preview-wrap'),coverPreview=document.querySelector('#cover-preview');
const $=id=>document.getElementById(id);
const esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));
const labelPath=p=>p==='/'?'Home':p.replace(/^\//,'').replace(/\/$/,'').replace(/[-_*]+/g,' ').replace(/\b\w/g,m=>m.toUpperCase());
function updateCounts(){ $('title-count').textContent=$('title').value.length; $('description-count').textContent=$('description').value.length; const t=$('title').value.trim()||'Your SEO title'; const d=$('description').value.trim()||'Your meta description will appear here.'; $('preview-title').textContent=t; $('preview-description').textContent=d; $('preview-url').textContent=new URL($('path_key').value||'/',location.origin).href; }
function renderList(){const q=$('page-search').value.toLowerCase().trim();const list=pages.filter(p=>(p.path_key+' '+labelPath(p.path_key)+' '+p.title).toLowerCase().includes(q));pageList.innerHTML=list.map(p=>`<button type="button" class="page-choice ${p.id===selectedId?'selected':''}" data-id="${p.id}"><strong>${esc(labelPath(p.path_key))}</strong><span>${esc(p.path_key)}</span><small>${esc(p.title||'No title')}</small></button>`).join('')||'<p class="muted">No pages found.</p>';pageList.querySelectorAll('.page-choice').forEach(b=>b.onclick=()=>selectPage(b.dataset.id));}
function showEditor(page){selectedId=page?.id||null;form.hidden=!page;empty.hidden=Boolean(page);$('delete-page').hidden=!page||page.path_key==='/'||page.path_key==='/product/*'||page.path_key==='/category/*';if(!page)return;$('editor-heading').textContent=labelPath(page.path_key);$('editor-path').textContent=page.path_key;$('path_key').value=page.path_key;$('title').value=page.title||'';$('description').value=page.description||'';$('keywords').value=page.keywords||'';originalCover=page.cover_image_url||'';$('cover-file').value='';if(originalCover){coverPreview.src=originalCover+'?v='+Date.now();coverPreviewWrap.hidden=false}else coverPreviewWrap.hidden=true;message.textContent='';updateCounts();renderList();window.scrollTo({top:0,behavior:'smooth'});}
function selectPage(id){const p=pages.find(x=>x.id===id);if(p)showEditor(p)}
function resetForm(){if(selectedId)showEditor(pages.find(x=>x.id===selectedId));else{$('path_key').value='';$('title').value='';$('description').value='';$('keywords').value='';$('cover-file').value='';originalCover='';coverPreviewWrap.hidden=true;updateCounts();}}
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const s=await supabase.auth.getSession();if(s.error)throw new Error(s.error.message);if(!s.data.session?.user){location.href='/login?next=%2Fadmin%2Fseo';return;}const a=await supabase.rpc('is_admin');if(a.error)throw new Error(a.error.message);if(!a.data){authStatus.textContent='Access denied.';return;}const r=await supabase.from('seo_pages').select('*').order('path_key');if(r.error)throw new Error(r.error.message);pages=r.data||[];authStatus.textContent='Admin access verified';app.hidden=false;renderList();if(pages[0])showEditor(pages[0]);}catch(e){authStatus.textContent=e?.message||'Unable to load SEO settings.';}}
async function toWebp(file){const bmp=await createImageBitmap(file),max=1800,scale=Math.min(1,max/Math.max(bmp.width,bmp.height)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bmp.width*scale));canvas.height=Math.max(1,Math.round(bmp.height*scale));const ctx=canvas.getContext('2d');if(!ctx)throw new Error('Could not prepare the image.');ctx.drawImage(bmp,0,0,canvas.width,canvas.height);return await new Promise((res,rej)=>canvas.toBlob(b=>b?res(b):rej(new Error('WebP conversion failed')),'image/webp',.86));}
async function uploadCover(file){const blob=await toWebp(file);const safe=String($('path_key').value).replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'')||'page';const path=`branding/seo/${safe}-${Date.now()}.webp`;const up=await supabase.storage.from('product-images').upload(path,blob,{contentType:'image/webp',upsert:false});if(up.error)throw new Error(up.error.message);return supabase.storage.from('product-images').getPublicUrl(path).data.publicUrl;}
form.onsubmit=async e=>{e.preventDefault();if(!supabase)return;message.textContent='Saving…';const path=$('path_key').value.trim();if(!path.startsWith('/')){message.textContent='Page path must start with /.';return;}let cover=originalCover;try{const file=$('cover-file').files?.[0];if(file){message.textContent='Uploading cover image…';cover=await uploadCover(file);}const payload={path_key:path,title:$('title').value.trim(),description:$('description').value.trim(),keywords:$('keywords').value.trim(),cover_image_url:cover||null,updated_at:new Date().toISOString()};let r;if(selectedId){r=await supabase.from('seo_pages').update(payload).eq('id',selectedId).select().single();}else{r=await supabase.from('seo_pages').insert(payload).select().single();}if(r.error)throw new Error(r.error.message);if(!selectedId)selectedId=r.data.id;pages=pages.filter(p=>p.id!==r.data.id);pages.push(r.data);pages.sort((a,b)=>a.path_key.localeCompare(b.path_key));showEditor(r.data);message.textContent='SEO settings saved successfully.';}catch(err){message.textContent=err?.message||'Could not save SEO settings.';}};
$('new-page').onclick=()=>{selectedId=null;form.hidden=false;empty.hidden=true;$('delete-page').hidden=true;$('editor-heading').textContent='New SEO page';$('editor-path').textContent='';$('path_key').value='';$('title').value='';$('description').value='';$('keywords').value='';$('cover-file').value='';originalCover='';coverPreviewWrap.hidden=true;message.textContent='';updateCounts();renderList();$('path_key').focus();};
$('delete-page').onclick=async()=>{if(!selectedId||!confirm('Delete this SEO entry?'))return;const r=await supabase.from('seo_pages').delete().eq('id',selectedId);if(r.error){message.textContent=r.error.message;return;}pages=pages.filter(p=>p.id!==selectedId);selectedId=null;renderList();pages[0]?showEditor(pages[0]):showEditor(null);};
$('remove-cover').onclick=()=>{originalCover='';coverPreviewWrap.hidden=true;coverPreview.src='';$('cover-file').value='';};
$('reset').onclick=resetForm;$('page-search').oninput=renderList;$('title').oninput=updateCounts;$('description').oninput=updateCounts;$('path_key').oninput=()=>{$('preview-url').textContent=new URL($('path_key').value||'/',location.origin).href;};$('logout').onclick=async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';};
init();
</script>
<style>
.seo-page{max-width:1180px}.seo-page .admin-head{margin-bottom:22px}.seo-page .admin-head h1{margin:0 0 7px}.seo-page .admin-head p{margin:0;color:var(--muted)}.status{margin-bottom:18px;font-size:.9rem;font-weight:800;color:var(--brand-primary)}.seo-layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:20px;align-items:start}.page-list-card,.editor-card{min-width:0}.page-search{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--line-strong);border-radius:12px;font:inherit;margin:12px 0}.page-list{display:grid;gap:7px;max-height:650px;overflow:auto}.page-choice{appearance:none;text-align:left;width:100%;display:grid;gap:2px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fff;cursor:pointer}.page-choice:hover,.page-choice.selected{border-color:var(--brand-primary);background:var(--brand-soft)}.page-choice strong{font-size:.92rem}.page-choice span,.page-choice small{color:var(--muted)}.page-choice span{font-size:.78rem}.page-choice small{font-size:.76rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}.section-heading h2{margin:0 0 4px}.eyebrow{margin:0 0 5px;color:var(--muted);font-size:.74rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.muted,.form-card small{color:var(--muted)}.editor-card form{display:grid;gap:15px}.editor-card label{display:grid;gap:7px;font-weight:700}.editor-card input,.editor-card textarea{width:100%;box-sizing:border-box;border:1px solid var(--line-strong);border-radius:12px;padding:12px 13px;font:inherit;background:#fff}.editor-card input{min-height:48px}.editor-card textarea{resize:vertical}.editor-card code{background:var(--surface-2);padding:2px 5px;border-radius:5px}.cover-preview-wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center}.cover-preview{width:100%;max-height:240px;object-fit:contain;border:1px solid var(--line);border-radius:14px;background:var(--surface-2)}.search-preview{display:grid;gap:6px;padding:18px;border:1px solid #dbeafe;border-radius:15px;background:#eff6ff}.search-preview strong{font-size:1.1rem;color:#1d4ed8}.search-preview span{font-size:.78rem;color:var(--success);word-break:break-all}.search-preview p{margin:0;color:var(--muted);line-height:1.5}.form-actions{display:flex;gap:10px;flex-wrap:wrap}.danger-button{color:var(--danger)}@media(max-width:900px){.seo-layout{grid-template-columns:1fr}.page-list{max-height:300px}.cover-preview-wrap{grid-template-columns:1fr}}
</style>
