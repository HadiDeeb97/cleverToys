---
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<header class="site-header"><div class="container header-inner"><a href="/admin" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/orders">Orders</a><a href="/admin/analytics">Visitors</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><p class="eyebrow">Overview</p><h1>Dashboard</h1><p>Quick view of your store performance and inventory.</p></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div><div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><div id="guard" class="empty-state">Checking admin access…</div><div id="dashboard" hidden><div class="stats-grid"><article class="stat-card"><span>Sales</span><strong id="sales">$0.00</strong><small>Delivered orders</small></article><article class="stat-card"><span>Orders today</span><strong id="today">0</strong><small>All statuses</small></article><article class="stat-card"><span>Pending</span><strong id="pending">0</strong><small>Need attention</small></article><article class="stat-card"><span>Products</span><strong id="products">0</strong><small>Active products</small></article><article class="stat-card"><span>Low stock</span><strong id="low">0</strong><small>1–5 units</small></article><article class="stat-card"><span>Out of stock</span><strong id="out">0</strong><small>Active products</small></article></div><section class="admin-panel dashboard-panel"><div class="panel-title"><h2>Recent orders</h2><a href="/admin/orders">View all</a></div><div id="recent"></div></section></div></div></main>
<script>
import { createClient } from '@supabase/supabase-js';
// Order fields come from anonymous checkout input, so everything rendered as HTML is escaped.
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const config=document.querySelector('#auth-config');const url=config?.dataset.url;const key=config?.dataset.key;const guard=document.querySelector('#guard');const dash=document.querySelector('#dashboard');let supabase;
const money=n=>`$${Number(n||0).toFixed(2)}`;
async function load(){const [orders,products]=await Promise.all([supabase.from('orders').select('order_number,customer_name,total,status,created_at').order('created_at',{ascending:false}),supabase.from('products').select('id,stock_quantity,is_active')]);if(orders.error||products.error){guard.textContent=(orders.error||products.error).message;return;}const os=orders.data||[],ps=products.data||[],today=new Date().toDateString();document.querySelector('#sales').textContent=money(os.filter(o=>o.status==='delivered').reduce((s,o)=>s+Number(o.total),0));document.querySelector('#today').textContent=os.filter(o=>new Date(o.created_at).toDateString()===today).length;document.querySelector('#pending').textContent=os.filter(o=>o.status==='pending').length;document.querySelector('#products').textContent=ps.filter(p=>p.is_active).length;document.querySelector('#low').textContent=ps.filter(p=>p.is_active&&p.stock_quantity>0&&p.stock_quantity<=5).length;document.querySelector('#out').textContent=ps.filter(p=>p.is_active&&p.stock_quantity===0).length;document.querySelector('#recent').innerHTML=os.length?`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>${os.slice(0,8).map(o=>`<tr><td><strong>${esc(o.order_number)}</strong></td><td>${esc(o.customer_name)}</td><td>${money(o.total)}</td><td><span class="status-pill">${esc(o.status)}</span></td><td>${new Date(o.created_at).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty-state"><h2>No orders yet</h2></div>';}
async function init(){try{if(!url||!key)throw new Error('Supabase browser configuration is missing.');supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const {data:{session},error:sessionError}=await supabase.auth.getSession();if(sessionError)throw new Error(sessionError.message);if(!session?.user){location.href=`/login?next=${encodeURIComponent('/admin/dashboard')}`;return;}const {data:isAdmin,error}=await supabase.rpc('is_admin');if(error)throw new Error(error.message);if(!isAdmin){guard.innerHTML='<h2>Access denied</h2><a class="button" href="/">Back to store</a>';return;}guard.hidden=true;dash.hidden=false;await load();}catch(error){guard.textContent=error?.message||'Could not load dashboard.';}}
init();document.querySelector('#logout').onclick=async()=>{if(supabase)await supabase.auth.signOut();location.href='/login';};
</script>
<style>
.stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:28px}.stat-card{padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff}.stat-card span,.stat-card small{display:block;color:var(--muted)}.stat-card strong{display:block;margin:7px 0;font-size:2rem}.dashboard-panel{padding:22px}.status-pill{display:inline-block;padding:4px 8px;border-radius:999px;background:var(--surface-2);font-size:.8rem;font-weight:700}@media(max-width:700px){.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card strong{font-size:1.5rem}}
</style>