---
import '../../styles/global.css';
---
<header class="site-header"><div class="container header-inner"><a href="/admin" class="logo">Clever Toys Admin</a><nav class="main-nav"><a href="/admin">Products</a><a href="/admin/orders">Orders</a><a href="/">Store</a></nav></div></header>
<main class="section"><div class="container"><div class="admin-head"><div><p class="eyebrow">Overview</p><h1>Dashboard</h1><p>Quick view of your store performance and inventory.</p></div><button id="logout" class="button secondary-button">Sign Out</button></div><div id="guard" class="empty-state">Checking admin access…</div><div id="dashboard" hidden><div class="stats-grid"><article class="stat-card"><span>Sales</span><strong id="sales">$0.00</strong><small>Delivered orders</small></article><article class="stat-card"><span>Orders today</span><strong id="today">0</strong><small>All statuses</small></article><article class="stat-card"><span>Pending</span><strong id="pending">0</strong><small>Need attention</small></article><article class="stat-card"><span>Products</span><strong id="products">0</strong><small>Active products</small></article><article class="stat-card"><span>Low stock</span><strong id="low">0</strong><small>1–5 units</small></article><article class="stat-card"><span>Out of stock</span><strong id="out">0</strong><small>Active products</small></article></div><section class="admin-panel dashboard-panel"><div class="panel-title"><h2>Recent orders</h2><a href="/admin/orders">View all</a></div><div id="recent"></div></section></div></div></main>
<script>
import { supabase } from '../../lib/supabase';
const guard=document.querySelector('#guard');const dash=document.querySelector('#dashboard');
const money=n=>`$${Number(n||0).toFixed(2)}`;
async function load(){const [orders,products]=await Promise.all([supabase.from('orders').select('order_number,customer_name,total,status,created_at').order('created_at',{ascending:false}),supabase.from('products').select('id,stock_quantity,is_active')]);if(orders.error||products.error){guard.textContent=(orders.error||products.error).message;return;}const os=orders.data||[], ps=products.data||[];const today=new Date().toDateString();document.querySelector('#sales').textContent=money(os.filter(o=>o.status==='delivered').reduce((s,o)=>s+Number(o.total),0));document.querySelector('#today').textContent=os.filter(o=>new Date(o.created_at).toDateString()===today).length;document.querySelector('#pending').textContent=os.filter(o=>o.status==='pending').length;document.querySelector('#products').textContent=ps.filter(p=>p.is_active).length;document.querySelector('#low').textContent=ps.filter(p=>p.is_active&&p.stock_quantity>0&&p.stock_quantity<=5).length;document.querySelector('#out').textContent=ps.filter(p=>p.is_active&&p.stock_quantity===0).length;document.querySelector('#recent').innerHTML=os.length?`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>${os.slice(0,8).map(o=>`<tr><td><strong>${o.order_number}</strong></td><td>${o.customer_name}</td><td>${money(o.total)}</td><td><span class="status-pill">${o.status}</span></td><td>${new Date(o.created_at).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty-state"><h2>No orders yet</h2></div>';}
const {data:{user}}=await supabase.auth.getUser();if(!user){location.href='/login';}else{const {data:isAdmin}=await supabase.rpc('is_admin');if(!isAdmin){guard.innerHTML='<h2>Access denied</h2><a class="button" href="/">Back to store</a>';}else{guard.hidden=true;dash.hidden=false;await load();}}document.querySelector('#logout').onclick=async()=>{await supabase.auth.signOut();location.href='/login';};
</script>
<style>
.stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:28px}.stat-card{padding:22px;border:1px solid #e5e7eb;border-radius:16px;background:#fff}.stat-card span,.stat-card small{display:block;color:#64748b}.stat-card strong{display:block;margin:7px 0;font-size:2rem}.dashboard-panel{padding:22px}.status-pill{display:inline-block;padding:4px 8px;border-radius:999px;background:#f1f5f9;font-size:.8rem;font-weight:700}@media(max-width:700px){.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card strong{font-size:1.5rem}}
</style>