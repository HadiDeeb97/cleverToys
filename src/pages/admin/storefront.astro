---
/**
 * Admin → Storefront: how the store looks and what the home page says.
 *
 *  Style         fonts, corner shape, page background, button shape, floating buttons
 *  Home page     which sections show and in what order, plus every text, link and image in them
 *  Product page  the delivery / payment / returns notes under the Add to Cart button
 *  Footer        footer text, address and opening hours, and the shared contact details
 *
 * Saved to store_settings.design (needs supabase/storefront_design.sql). The storefront reads it
 * on every page load through src/lib/page-data.ts, and src/lib/design.ts cleans every value, so a
 * typo can never break the store. Contact phone/email/city are shared with Admin → SEO.
 * Colours, logo and website icon stay in Admin → Branding.
 */
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/config';
import { FONT_PRESETS } from '../../lib/design';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Storefront | Clever Toys Admin</title>
  {/* All four font pairs, so the typography choices can be previewed side by side. */}
  {Object.values(FONT_PRESETS).map((preset) => <link rel="stylesheet" href={preset.href} media="print" onload="this.media='all'" />)}
</head>
<header class="site-header"></header>
<main>
  <div class="container">
    <div class="admin-head">
      <div>
        <p class="eyebrow">Design</p>
        <h1>Storefront</h1>
        <p>Choose the look of your store and write your home page. Colours, logo and icon are in <a class="text-link" href="/admin/branding">Branding</a>.</p>
      </div>
      <a class="small-button" href="/" target="_blank" rel="noopener">View store ↗</a>
    </div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <div id="guard" class="empty-state">Checking admin access…</div>

    <div id="app" hidden>
      <div id="setup-notice" class="sf-notice" hidden>
        Saving needs one database update. In Supabase, open <strong>SQL Editor</strong>, paste <code>supabase/storefront_design.sql</code> and press <strong>Run</strong>, then reload this page. Until then the store uses the defaults shown here.
      </div>

      <div class="admin-tabs" role="tablist" aria-label="Storefront sections">
        <button class="tab active" data-tab="style" role="tab" aria-selected="true" type="button">Style</button>
        <button class="tab" data-tab="home" role="tab" aria-selected="false" type="button">Home page</button>
        <button class="tab" data-tab="product" role="tab" aria-selected="false" type="button">Product page</button>
        <button class="tab" data-tab="footer" role="tab" aria-selected="false" type="button">Footer &amp; contact</button>
      </div>

      <form id="design-form" novalidate>
        {/* ============ Style ============ */}
        <section class="sf-tab" id="tab-style">
          <div class="admin-panel sf-panel">
            <h2>Typography</h2>
            <p class="muted">The font pair used for headlines and text across the store.</p>
            <div class="sf-choices sf-fonts" id="font-choices"></div>
          </div>
          <div class="sf-two">
            <div class="admin-panel sf-panel">
              <h2>Corners</h2>
              <p class="muted">How rounded cards, photos and fields are.</p>
              <div class="sf-choices" data-choice="corners">
                <label class="sf-choice"><input type="radio" name="corners" value="sharp" /><span class="sf-shape" style="border-radius:6px"></span><b>Crisp</b></label>
                <label class="sf-choice"><input type="radio" name="corners" value="soft" /><span class="sf-shape" style="border-radius:16px"></span><b>Soft</b></label>
                <label class="sf-choice"><input type="radio" name="corners" value="round" /><span class="sf-shape" style="border-radius:26px"></span><b>Round</b></label>
              </div>
            </div>
            <div class="admin-panel sf-panel">
              <h2>Page background</h2>
              <p class="muted">The canvas behind everything.</p>
              <div class="sf-choices" data-choice="background">
                <label class="sf-choice"><input type="radio" name="background" value="cream" /><span class="sf-swatch" style="background:#fbf7f1"></span><b>Warm cream</b></label>
                <label class="sf-choice"><input type="radio" name="background" value="white" /><span class="sf-swatch" style="background:#fff"></span><b>Clean white</b></label>
                <label class="sf-choice"><input type="radio" name="background" value="tint" /><span class="sf-swatch" style="background:color-mix(in srgb,var(--brand-soft) 60%,#fff)"></span><b>Theme tint</b></label>
              </div>
            </div>
            <div class="admin-panel sf-panel">
              <h2>Buttons</h2>
              <p class="muted">The shape of buttons.</p>
              <div class="sf-choices" data-choice="buttons">
                <label class="sf-choice"><input type="radio" name="buttons" value="pill" /><span class="sf-button" style="border-radius:999px">Shop now</span><b>Pill</b></label>
                <label class="sf-choice"><input type="radio" name="buttons" value="rounded" /><span class="sf-button" style="border-radius:12px">Shop now</span><b>Rounded</b></label>
              </div>
            </div>
            <div class="admin-panel sf-panel">
              <h2>Floating buttons</h2>
              <p class="muted">Round buttons that stay in the corner while shopping.</p>
              <label class="sf-check"><input type="checkbox" class="toggle" data-path="floating_whatsapp" /> WhatsApp chat button</label>
              <label class="sf-check"><input type="checkbox" class="toggle" data-path="floating_cart" /> Cart button <small>(the header always has one)</small></label>
            </div>
          </div>
        </section>

        {/* ============ Home page ============ */}
        <section class="sf-tab" id="tab-home" hidden>
          <div class="admin-panel sf-panel">
            <h2>Sections</h2>
            <p class="muted">Switch sections on or off and use the arrows to change their order.</p>
            <ol class="sf-sections" id="section-list"></ol>
          </div>

          <details class="admin-panel sf-panel sf-details" open data-edit="hero">
            <summary><h2>Hero banner</h2><span class="muted">The first thing visitors see</span></summary>
            <div class="sf-grid">
              <label class="sf-field">Small title above<input class="admin-input" data-path="hero.eyebrow" maxlength="60" /></label>
              <label class="sf-field">Headline<input class="admin-input" data-path="hero.title" maxlength="80" /></label>
              <label class="sf-field">Highlighted words<input class="admin-input" data-path="hero.highlight" maxlength="60" /><small>Shown in your theme colour after the headline.</small></label>
              <label class="sf-field wide">Text<textarea class="admin-input" data-path="hero.text" rows="2" maxlength="260"></textarea></label>
              <label class="sf-field">Main button text<input class="admin-input" data-path="hero.primary_label" maxlength="40" /></label>
              <label class="sf-field">Main button link<input class="admin-input" data-path="hero.primary_link" data-link placeholder="/products" /></label>
              <label class="sf-field">Second button text<input class="admin-input" data-path="hero.secondary_label" maxlength="40" /><small>Leave empty to hide it.</small></label>
              <label class="sf-field">Second button link<input class="admin-input" data-path="hero.secondary_link" data-link placeholder="/categories" /></label>
              <div class="sf-field wide"><span class="sf-label">Hero picture</span><div class="sf-image" data-image="hero.image"></div><small>Optional. Without a picture, the hero shows your featured toys. Best: a square photo, 1200 × 1200.</small></div>
            </div>
          </details>

          <details class="admin-panel sf-panel sf-details" data-edit="trust">
            <summary><h2>Store promises</h2><span class="muted">Up to 4 short reasons to buy</span></summary>
            <div id="trust-list" class="sf-trust"></div>
            <button type="button" class="small-button" id="trust-add">+ Add a promise</button>
          </details>

          <details class="admin-panel sf-panel sf-details" data-edit="titles">
            <summary><h2>Section titles</h2><span class="muted">Categories, featured toys, new arrivals, shop by age</span></summary>
            <div class="sf-grid">
              <label class="sf-field">Categories title<input class="admin-input" data-path="titles.categories.title" maxlength="80" /></label>
              <label class="sf-field">Categories subtitle<input class="admin-input" data-path="titles.categories.subtitle" maxlength="160" /></label>
              <label class="sf-field">Featured title<input class="admin-input" data-path="titles.featured.title" maxlength="80" /></label>
              <label class="sf-field">Featured subtitle<input class="admin-input" data-path="titles.featured.subtitle" maxlength="160" /></label>
              <label class="sf-field">New arrivals title<input class="admin-input" data-path="titles.new.title" maxlength="80" /></label>
              <label class="sf-field">New arrivals subtitle<input class="admin-input" data-path="titles.new.subtitle" maxlength="160" /></label>
              <label class="sf-field">Shop by age title<input class="admin-input" data-path="titles.ages.title" maxlength="80" /></label>
              <label class="sf-field">Shop by age subtitle<input class="admin-input" data-path="titles.ages.subtitle" maxlength="160" /></label>
            </div>
          </details>

          <details class="admin-panel sf-panel sf-details" data-edit="promo">
            <summary><h2>Promotion banner</h2><span class="muted">A highlighted offer or collection</span></summary>
            <div class="sf-grid">
              <label class="sf-field">Small title<input class="admin-input" data-path="promo.eyebrow" maxlength="60" /></label>
              <label class="sf-field">Headline<input class="admin-input" data-path="promo.title" maxlength="90" /></label>
              <label class="sf-field wide">Text<textarea class="admin-input" data-path="promo.text" rows="2" maxlength="260"></textarea></label>
              <label class="sf-field">Button text<input class="admin-input" data-path="promo.button_label" maxlength="40" /></label>
              <label class="sf-field">Button link<input class="admin-input" data-path="promo.button_link" data-link placeholder="/products?category=…" /></label>
              <div class="sf-field wide"><span class="sf-label">Colour</span>
                <div class="sf-choices" data-choice="promo.style">
                  <label class="sf-choice"><input type="radio" name="promo.style" value="brand" /><span class="sf-swatch" style="background:var(--brand-gradient)"></span><b>Theme</b></label>
                  <label class="sf-choice"><input type="radio" name="promo.style" value="accent" /><span class="sf-swatch" style="background:var(--theme-accent)"></span><b>Accent</b></label>
                  <label class="sf-choice"><input type="radio" name="promo.style" value="dark" /><span class="sf-swatch" style="background:#1b1822"></span><b>Dark</b></label>
                </div>
              </div>
              <div class="sf-field wide"><span class="sf-label">Picture</span><div class="sf-image" data-image="promo.image"></div></div>
            </div>
          </details>

          <details class="admin-panel sf-panel sf-details" data-edit="story">
            <summary><h2>Our story</h2><span class="muted">A few words about the store</span></summary>
            <div class="sf-grid">
              <label class="sf-field">Small title<input class="admin-input" data-path="story.eyebrow" maxlength="60" /></label>
              <label class="sf-field">Headline<input class="admin-input" data-path="story.title" maxlength="90" /></label>
              <label class="sf-field wide">Text<textarea class="admin-input" data-path="story.text" rows="4" maxlength="900"></textarea></label>
              <label class="sf-field">Button text<input class="admin-input" data-path="story.button_label" maxlength="40" /></label>
              <label class="sf-field">Button link<input class="admin-input" data-path="story.button_link" data-link placeholder="/about" /></label>
              <div class="sf-field wide"><span class="sf-label">Picture</span><div class="sf-image" data-image="story.image"></div></div>
            </div>
          </details>

          <details class="admin-panel sf-panel sf-details" data-edit="help">
            <summary><h2>Help choosing</h2><span class="muted">The WhatsApp call to action</span></summary>
            <div class="sf-grid">
              <label class="sf-field">Title<input class="admin-input" data-path="help.title" maxlength="80" /></label>
              <label class="sf-field">Button text<input class="admin-input" data-path="help.button_label" maxlength="40" /></label>
              <label class="sf-field wide">Text<input class="admin-input" data-path="help.text" maxlength="200" /></label>
            </div>
            <p class="muted small">The button opens the WhatsApp link from Branding.</p>
          </details>
        </section>

        {/* ============ Product page ============ */}
        <section class="sf-tab" id="tab-product" hidden>
          <div class="admin-panel sf-panel">
            <h2>Notes under Add to Cart</h2>
            <p class="muted">Short reassurances on every product page. Leave a line empty to hide it.</p>
            <div class="sf-grid one">
              <label class="sf-field">🚚 Delivery<input class="admin-input" data-path="product.delivery" maxlength="120" /></label>
              <label class="sf-field">💵 Payment<input class="admin-input" data-path="product.payment" maxlength="120" /></label>
              <label class="sf-field">↩️ Returns<input class="admin-input" data-path="product.returns" maxlength="120" /></label>
            </div>
          </div>
        </section>

        {/* ============ Footer & contact ============ */}
        <section class="sf-tab" id="tab-footer" hidden>
          <div class="sf-two">
            <div class="admin-panel sf-panel">
              <h2>Footer</h2>
              <div class="sf-grid one">
                <label class="sf-field">About the store<textarea class="admin-input" data-path="footer.about" rows="3" maxlength="260"></textarea></label>
                <label class="sf-field">Street address<input class="admin-input" data-path="footer.address" maxlength="160" placeholder="Hamra Street, Beirut" /></label>
                <label class="sf-field">Opening hours<input class="admin-input" data-path="footer.hours" maxlength="120" placeholder="Mon–Sat, 9am–7pm" /></label>
                <label class="sf-field">Small note (bottom right)<input class="admin-input" data-path="footer.note" maxlength="80" /></label>
              </div>
            </div>
            <div class="admin-panel sf-panel">
              <h2>Contact details</h2>
              <p class="muted">Shown in the footer and on the Contact page. Shared with Admin → SEO → Business details.</p>
              <div class="sf-grid one">
                <label class="sf-field">Phone<input class="admin-input" id="c-phone" type="tel" maxlength="40" placeholder="+961 71 220 251" /></label>
                <label class="sf-field">Email<input class="admin-input" id="c-email" type="email" maxlength="120" /></label>
                <label class="sf-field">City<input class="admin-input" id="c-city" maxlength="80" placeholder="Beirut" /></label>
              </div>
              <p class="muted small">WhatsApp and Instagram links are set in <a class="text-link" href="/admin/branding">Branding</a>.</p>
            </div>
          </div>
        </section>

        <div class="sf-savebar">
          <span id="save-state" class="muted" role="status">All changes saved</span>
          <button type="button" class="small-button" id="reset-defaults">Reset to defaults</button>
          <button type="submit" class="button" id="save-design">Save &amp; publish</button>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { DEFAULT_DESIGN, FONT_PRESETS, HOME_SECTIONS, parseDesign, safeLink, type StoreDesign } from '../../lib/design';

const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const toast = (message: string, tone = 'success') => window.adminToast?.(message, tone);

// No generated database types in this project, so table rows are typed loosely.
let supabase: SupabaseClient<any, 'public', any>;
let design: StoreDesign = structuredClone(DEFAULT_DESIGN);
let seoSettings: Record<string, any> = {};
let columnReady = false;
let seoColumnReady = false; // store_settings.seo exists (supabase/seo_advanced.sql)
let dirty = false;

// ---------- Reading and writing values by path, e.g. "hero.title" ----------
const getPath = (obj: any, path: string) => path.split('.').reduce((o, k) => o?.[k], obj);
const setPath = (obj: any, path: string, value: unknown) => {
  const keys = path.split('.');
  const last = keys.pop()!;
  const target = keys.reduce((o, k) => (o[k] ??= {}), obj);
  target[last] = value;
};
const markDirty = () => { dirty = true; $('#save-state').textContent = 'Unsaved changes'; };

/** Puts the current design into every form control. */
function fillForm() {
  document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-path]').forEach((el) => {
    const value = getPath(design, el.dataset.path!);
    if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = Boolean(value);
    else el.value = value ?? '';
  });
  document.querySelectorAll<HTMLElement>('[data-choice]').forEach((group) => {
    const value = getPath(design, group.dataset.choice!);
    group.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => { r.checked = r.value === value; });
  });
  document.querySelectorAll<HTMLInputElement>('#font-choices input').forEach((r) => { r.checked = r.value === design.font; });
  document.querySelectorAll<HTMLElement>('[data-image]').forEach(renderImage);
  renderSections();
  renderTrust();
  ($('#c-phone') as HTMLInputElement).value = seoSettings.org_phone || '';
  ($('#c-email') as HTMLInputElement).value = seoSettings.org_email || '';
  ($('#c-city') as HTMLInputElement).value = seoSettings.org_city || '';
}

// ---------- Typography cards ----------
const FONT_FAMILIES: Record<string, [string, string]> = {
  premium: ['"Fraunces", Georgia, serif', '"Plus Jakarta Sans", system-ui, sans-serif'],
  modern: ['"Plus Jakarta Sans", system-ui, sans-serif', '"Plus Jakarta Sans", system-ui, sans-serif'],
  playful: ['"Fredoka", system-ui, sans-serif', '"Nunito", system-ui, sans-serif'],
  classic: ['"Playfair Display", Georgia, serif', '"DM Sans", system-ui, sans-serif']
};
$('#font-choices').innerHTML = Object.entries(FONT_PRESETS).map(([id, preset]) => `
  <label class="sf-choice sf-font">
    <input type="radio" name="font" value="${id}" />
    <span class="sf-font-sample" style="font-family:${FONT_FAMILIES[id][0]}">Toys that make childhood brighter</span>
    <span class="sf-font-body" style="font-family:${FONT_FAMILIES[id][1]}">Thoughtfully chosen toys, delivered across Lebanon.</span>
    <b>${esc(preset.label)}</b><small>${esc(preset.description)}</small>
  </label>`).join('');

// ---------- Home page sections: order and visibility ----------
function renderSections() {
  $('#section-list').innerHTML = design.sections.map((s, i) => `
    <li class="sf-section${s.enabled ? '' : ' is-off'}">
      <input type="checkbox" class="toggle" data-section-toggle="${i}" ${s.enabled ? 'checked' : ''} aria-label="Show ${esc(HOME_SECTIONS[s.id].label)}" />
      <div><strong>${esc(HOME_SECTIONS[s.id].label)}</strong><small>${esc(HOME_SECTIONS[s.id].description)}</small></div>
      <div class="sf-order">
        <button type="button" class="small-button" data-move="${i}" data-dir="-1" aria-label="Move ${esc(HOME_SECTIONS[s.id].label)} up" ${i === 0 ? 'disabled' : ''}>↑</button>
        <button type="button" class="small-button" data-move="${i}" data-dir="1" aria-label="Move ${esc(HOME_SECTIONS[s.id].label)} down" ${i === design.sections.length - 1 ? 'disabled' : ''}>↓</button>
      </div>
    </li>`).join('');
}
$('#section-list').addEventListener('click', (event) => {
  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
  if (!button) return;
  const i = Number(button.dataset.move), j = i + Number(button.dataset.dir);
  if (j < 0 || j >= design.sections.length) return;
  [design.sections[i], design.sections[j]] = [design.sections[j], design.sections[i]];
  renderSections();
  $<HTMLButtonElement>(`[data-move="${j}"][data-dir="${button.dataset.dir}"]`)?.focus();
  markDirty();
});
$('#section-list').addEventListener('change', (event) => {
  const toggle = (event.target as HTMLElement).closest<HTMLInputElement>('[data-section-toggle]');
  if (!toggle) return;
  design.sections[Number(toggle.dataset.sectionToggle)].enabled = toggle.checked;
  toggle.closest('li')?.classList.toggle('is-off', !toggle.checked);
  markDirty();
});

// ---------- Store promises (up to 4) ----------
function renderTrust() {
  $('#trust-list').innerHTML = design.trust.map((t, i) => `
    <div class="sf-trust-row">
      <input class="admin-input sf-emoji" data-trust="${i}" data-key="icon" value="${esc(t.icon)}" maxlength="8" aria-label="Icon (emoji)" />
      <input class="admin-input" data-trust="${i}" data-key="title" value="${esc(t.title)}" maxlength="60" placeholder="Title" aria-label="Title" />
      <input class="admin-input" data-trust="${i}" data-key="text" value="${esc(t.text)}" maxlength="90" placeholder="Short text" aria-label="Text" />
      <button type="button" class="small-button danger-button" data-trust-remove="${i}" aria-label="Remove">✕</button>
    </div>`).join('') || '<p class="muted">No promises. Add one, or switch the section off.</p>';
  $<HTMLButtonElement>('#trust-add').disabled = design.trust.length >= 4;
}
$('#trust-list').addEventListener('input', (event) => {
  const el = event.target as HTMLInputElement;
  if (!el.dataset.trust) return;
  (design.trust[Number(el.dataset.trust)] as any)[el.dataset.key!] = el.value;
  markDirty();
});
$('#trust-list').addEventListener('click', (event) => {
  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-trust-remove]');
  if (!button) return;
  design.trust.splice(Number(button.dataset.trustRemove), 1);
  renderTrust();
  markDirty();
});
$('#trust-add').addEventListener('click', () => {
  if (design.trust.length >= 4) return;
  design.trust.push({ icon: '✨', title: '', text: '' });
  renderTrust();
  $<HTMLInputElement>(`[data-trust="${design.trust.length - 1}"][data-key="title"]`)?.focus();
  markDirty();
});

// ---------- Pictures (hero, promotion, story) ----------
function renderImage(box: HTMLElement) {
  const path = box.dataset.image!;
  const url = getPath(design, path);
  box.innerHTML = `${url ? `<img src="${esc(url)}" alt="" />` : '<span class="sf-image-empty">No picture</span>'}
    <div class="sf-image-actions"><label class="small-button">${url ? 'Replace' : 'Upload'}<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-upload="${esc(path)}" /></label>${url ? `<button type="button" class="small-button" data-remove-image="${esc(path)}">Remove</button>` : ''}</div>`;
}
async function toWebp(file: File) {
  const bmp = await createImageBitmap(file);
  const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(bmp.width * scale));
  canvas.height = Math.max(1, Math.round(bmp.height * scale));
  canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
  return new Promise<Blob>((resolve, reject) => canvas.toBlob((b) => b ? resolve(b) : reject(new Error('Could not convert the picture.')), 'image/webp', 0.84));
}
document.addEventListener('change', async (event) => {
  const input = event.target as HTMLInputElement;
  if (!input.dataset.upload || !input.files?.[0]) return;
  const path = input.dataset.upload;
  const box = input.closest<HTMLElement>('[data-image]')!;
  box.classList.add('is-busy');
  try {
    const blob = await toWebp(input.files[0]);
    const file = `branding/design/${path.replace(/\W+/g, '-')}-${Date.now()}.webp`;
    const up = await supabase.storage.from('product-images').upload(file, blob, { contentType: 'image/webp', upsert: false, cacheControl: '31536000' });
    if (up.error) throw new Error(up.error.message);
    setPath(design, path, supabase.storage.from('product-images').getPublicUrl(file).data.publicUrl);
    renderImage(box);
    markDirty();
    toast('Picture uploaded. Press "Save & publish" to use it.');
  } catch (error) {
    toast(error instanceof Error ? error.message : 'Upload failed.', 'error');
  } finally {
    box.classList.remove('is-busy');
  }
});
document.addEventListener('click', (event) => {
  const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-image]');
  if (!button) return;
  setPath(design, button.dataset.removeImage!, '');
  renderImage(button.closest<HTMLElement>('[data-image]')!);
  markDirty();
});

// ---------- Simple fields and choices ----------
$('#design-form').addEventListener('input', (event) => {
  const el = event.target as HTMLInputElement;
  if (el.dataset.path) {
    setPath(design, el.dataset.path, el.type === 'checkbox' ? el.checked : el.value);
    if (el.dataset.link !== undefined) el.setCustomValidity(el.value.trim() && safeLink(el.value, '') === '' ? 'Use a page on this site (starting with /) or a full https:// link.' : '');
    markDirty();
  } else if (el.type === 'radio') {
    const name = el.name;
    if (name === 'font') design.font = el.value as StoreDesign['font'];
    else setPath(design, name, el.value);
    markDirty();
  } else if (['c-phone', 'c-email', 'c-city'].includes(el.id)) {
    markDirty();
  }
});

// ---------- Tabs ----------
function showTab(name: string) {
  document.querySelectorAll<HTMLElement>('.tab[data-tab]').forEach((t) => { t.classList.toggle('active', t.dataset.tab === name); t.setAttribute('aria-selected', String(t.dataset.tab === name)); });
  document.querySelectorAll<HTMLElement>('.sf-tab').forEach((s) => { s.hidden = s.id !== `tab-${name}`; });
  history.replaceState(null, '', `#${name}`);
}
document.querySelectorAll<HTMLButtonElement>('.tab[data-tab]').forEach((t) => t.addEventListener('click', () => showTab(t.dataset.tab!)));

// ---------- Save ----------
$('#design-form').addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!columnReady) { toast('Run supabase/storefront_design.sql first.', 'error'); return; }
  const invalid = [...document.querySelectorAll<HTMLInputElement>('[data-link]')].find((el) => !el.checkValidity());
  if (invalid) { invalid.closest('details')?.setAttribute('open', ''); showTab(invalid.closest('.sf-tab')!.id.replace('tab-', '')); invalid.reportValidity(); return; }
  const button = $<HTMLButtonElement>('#save-design');
  button.disabled = true;
  $('#save-state').textContent = 'Saving…';
  try {
    // Only clean, complete settings are stored (the same cleaning the storefront uses).
    design = parseDesign(design);
    const nextSeo = { ...seoSettings, org_phone: ($('#c-phone') as HTMLInputElement).value.trim(), org_email: ($('#c-email') as HTMLInputElement).value.trim(), org_city: ($('#c-city') as HTMLInputElement).value.trim() };
    const payload: Record<string, unknown> = { id: 'default', design, updated_at: new Date().toISOString() };
    // Contact details live in the SEO settings (one place for both pages); keep every other SEO value as it is.
    if (seoColumnReady) payload.seo = nextSeo;
    const r = await supabase.from('store_settings').upsert(payload, { onConflict: 'id' });
    if (r.error) throw new Error(r.error.message);
    seoSettings = nextSeo;
    dirty = false;
    fillForm();
    $('#save-state').textContent = 'Saved · live on the store now';
    toast('Storefront published.');
  } catch (error) {
    $('#save-state').textContent = 'Not saved';
    toast(error instanceof Error ? error.message : 'Could not save.', 'error');
  } finally {
    button.disabled = !columnReady;
  }
});
$('#reset-defaults').addEventListener('click', () => {
  if (!confirm('Reset every storefront setting on this page to the defaults? (Nothing is saved until you press "Save & publish".)')) return;
  design = structuredClone(DEFAULT_DESIGN);
  fillForm();
  markDirty();
});
window.addEventListener('beforeunload', (event) => { if (dirty) event.preventDefault(); });

// ---------- Start ----------
async function init() {
  const guard = $('#guard');
  try {
    const cfg = $('#auth-config');
    const url = cfg.dataset.url, key = cfg.dataset.key;
    if (!url || !key) throw new Error('Supabase browser configuration is missing.');
    supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { location.href = `/login?next=${encodeURIComponent('/admin/storefront')}`; return; }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error) throw new Error(error.message);
    if (!isAdmin) { guard.innerHTML = '<h2>Access denied</h2><a class="button" href="/">Back to store</a>'; return; }
    const settings = await supabase.from('store_settings').select('*').eq('id', 'default').maybeSingle();
    if (settings.error) throw new Error(settings.error.message);
    const row: Record<string, any> = settings.data || {};
    columnReady = 'design' in row || !settings.data;
    design = parseDesign(row.design);
    seoColumnReady = 'seo' in row;
    seoSettings = row.seo && typeof row.seo === 'object' ? { ...row.seo } : {};
    $('#setup-notice').hidden = columnReady;
    $<HTMLButtonElement>('#save-design').disabled = !columnReady;
    fillForm();
    guard.hidden = true;
    $('#app').hidden = false;
    const start = location.hash.slice(1);
    if (['style', 'home', 'product', 'footer'].includes(start)) showTab(start);
  } catch (error) {
    guard.hidden = false;
    guard.innerHTML = `<h2>Storefront settings could not load</h2><p>${esc(error instanceof Error ? error.message : 'Unknown error')}</p>`;
  }
}
init();
</script>

