---
/**
 * Not-found page, shown for any address that does not exist (Astro serves it with status 404).
 */
import '../styles/global.css';
---
<head><title>Page Not Found | Clever Toys</title><meta name="description" content="The page you requested could not be found." /></head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="empty-state"><p>404</p><h1>Page not found</h1><p>The page may have moved or the link may be incorrect.</p><div class="form-actions"><a class="button" href="/">Go Home</a><a class="button secondary-button" href="/products">Shop Toys</a></div></div></div></main>