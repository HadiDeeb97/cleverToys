---
/**
 * Not-found page, shown for any address that does not exist (Astro serves it with status 404).
 */
import '../styles/global.css';
---
<head><title>Page Not Found | Clever Toys</title><meta name="description" content="The page you requested could not be found." /></head>
<header class="site-header"></header>
<main class="section"><div class="container narrow"><div class="empty-state"><p class="eyebrow">Error 404</p><h1>This page wandered off</h1><p>The page may have moved or the link may be incorrect. Let's get you back to the toys.</p><div class="form-actions"><a class="button" href="/">Go Home</a><a class="button secondary-button" href="/products">Shop Toys</a></div></div></div></main>
<footer class="site-footer"></footer>
