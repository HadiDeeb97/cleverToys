---
import '../styles/global.css';
const title='Terms & Conditions | Clever Toys';
const description='Clever Toys terms and conditions for using the online store and placing orders.';
---
<head><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={`${Astro.url.origin}/terms`}/></head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Terms & Conditions</h1><p>Terms for using the Clever Toys store.</p></div><div class="form-card"><h2>Product information</h2><p>We make reasonable efforts to keep product names, descriptions, prices and stock information accurate. Availability can change before an order is confirmed.</p><h2>Orders</h2><p>Submitting an order is a request to purchase. Clever Toys may contact you to confirm availability and delivery details before fulfillment.</p><h2>Prices</h2><p>Prices shown on the website are in US dollars unless stated otherwise. The final order total is calculated by the store when the order is placed.</p><h2>Delivery</h2><p>Orders are normally handled using cash on delivery. Delivery details and any applicable fee are confirmed with the customer.</p></div></div></main>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>