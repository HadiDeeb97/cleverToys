---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<head>
  <title>Reset Password | Clever Toys</title>
  <meta name="description" content="Choose a new password for your Clever Toys account." />
</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Choose a new password</h1><p>Set a new password for your Clever Toys account.</p></div><div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><form id="reset-form" class="form-card"><label>New password<input name="password" type="password" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></label><button class="button" type="submit">Update Password</button><p id="message" role="status"></p></form></div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const config=document.querySelector('#auth-config'); const url=config?.dataset.url; const key=config?.dataset.key;
const form=document.querySelector('#reset-form'); const msg=document.querySelector('#message'); let supabase;
try{ if(!url||!key) throw new Error('Supabase browser configuration is missing.'); supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}}); }catch(error){ msg.textContent=error?.message||'Could not initialize password reset.'; }
form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!supabase)return;const data=Object.fromEntries(new FormData(form));const password=String(data.password||'');if(password!==String(data.confirm_password||'')){msg.textContent='Passwords do not match.';return;}msg.textContent='Updating password…';const {error}=await supabase.auth.updateUser({password});if(error){msg.textContent=error.message;return;}msg.textContent='Password updated successfully. Redirecting…';setTimeout(()=>location.href='/account',700);});
</script>