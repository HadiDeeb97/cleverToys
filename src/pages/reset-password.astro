---
/**
 * Reset password: /reset-password (opened from the password-reset email)
 *
 * The email link signs the customer in for a moment (Supabase puts a token in the address);
 * they then choose a new password here. Expired or reused links show a clear message.
 */
import '../styles/global.css';
import { supabaseConfig } from '../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Reset Password | Clever Toys</title>
  <meta name="description" content="Choose a new password for your Clever Toys account." />
</head>
<header class="site-header"></header>
<main class="section">
  <div class="container narrow">
    <div class="section-header"><h1>Choose a new password</h1><p>Set a new password for your Clever Toys account.</p></div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <form id="reset-form" class="form-card">
      <label>New password<input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
      <label>Confirm password<input name="confirm_password" type="password" required minlength="8" autocomplete="new-password" /></label>
      <button class="button" type="submit">Update Password</button>
      <p id="message" role="status"></p>
    </form>
  </div>
</main>
<footer class="site-footer"></footer>

<script>
import { createClient } from '@supabase/supabase-js';
import { authMessage } from '../scripts/auth-messages';

const config = document.querySelector<HTMLElement>('#auth-config');
const form = document.querySelector<HTMLFormElement>('#reset-form')!;
const msg = document.querySelector<HTMLElement>('#message')!;
const url = config?.dataset.url, key = config?.dataset.key;
const supabase = url && key ? createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } }) : null;

// An expired or already-used email link comes back with an error in the address.
const linkError = new URLSearchParams(location.hash.slice(1)).get('error_description') || new URLSearchParams(location.search).get('error_description');
if (!supabase) msg.textContent = 'Supabase browser configuration is missing.';
else if (linkError) msg.innerHTML = 'This reset link has expired or was already used. <a href="/forgot-password">Send a new link</a>.';

form.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!supabase) return;
  const data = new FormData(form);
  const password = String(data.get('password') || '');
  if (password !== String(data.get('confirm_password') || '')) { msg.textContent = 'Passwords do not match.'; return; }
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) { msg.innerHTML = 'Please open this page from the link in your reset email. <a href="/forgot-password">Send a new link</a>.'; return; }
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  button.disabled = true;
  msg.textContent = 'Updating password…';
  const { error } = await supabase.auth.updateUser({ password });
  button.disabled = false;
  if (error) { msg.textContent = authMessage(error, 'Could not update the password.'); return; }
  msg.textContent = 'Password updated. Taking you to your account…';
  setTimeout(() => { location.href = '/account'; }, 700);
});
</script>
