---
import '../styles/global.css';
---
<head>
  <title>Reset Password | Clever Toys</title>
  <meta name="description" content="Choose a new password for your Clever Toys account." />
</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Choose a new password</h1><p>Set a new password for your Clever Toys account.</p></div><form id="reset-form" class="form-card"><label>New password<input name="password" type="password" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></label><button class="button" type="submit">Update Password</button><p id="message" role="status"></p></form></div></main>
<script>
import { supabase } from '../lib/supabase';
const form=document.querySelector('#reset-form');const msg=document.querySelector('#message');
form?.addEventListener('submit',async(e)=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));const password=String(data.password||'');if(password!==String(data.confirm_password||'')){msg.textContent='Passwords do not match.';return;}msg.textContent='Updating password…';const {error}=await supabase.auth.updateUser({password});if(error){msg.textContent=error.message;return;}msg.textContent='Password updated successfully. Redirecting…';setTimeout(()=>location.href='/account',700);});
</script>