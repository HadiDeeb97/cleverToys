---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';

const slug = Astro.params.slug;

const { data: product, error } = await supabase
  .from('products')
  .select(`
    id,
    name,
    slug,
    sku,
    short_description,
    description,
    price,
    sale_price,
    stock_quantity,
    age_min,
    age_max,
    brand,
    primary_image_url,
    seo_title,
    seo_description,
    categories:category_id (
      id,
      name,
      slug
    ),
    product_images (
      id,
      image_url,
      alt_text,
      sort_order,
      is_primary
    )
  `)
  .eq('slug', slug)
  .eq('is_active', true)
  .maybeSingle();

if (error || !product) {
  Astro.response.status = 404;
}

const images = product
  ? [
      ...(product.primary_image_url
        ? [{
            id: 'primary',
            image_url: product.primary_image_url,
            alt_text: product.name,
            sort_order: -1,
            is_primary: true
          }]
        : []),
      ...(product.product_images ?? [])
    ]
      .filter(
        (image, index, all) =>
          all.findIndex((item) => item.image_url === image.image_url) === index
      )
      .sort((a, b) => a.sort_order - b.sort_order) : [];

const displayPrice = product ? Number(product.sale_price ?? product.price) : 0;
const originalPrice = product?.sale_price != null ? Number(product.price) : null;
const inStock = Boolean(product && product.stock_quantity > 0);

const pageTitle = product
  ? product.seo_title || `${product.name} | Clever Toys`
  : 'Product Not Found | Clever Toys';
const pageDescription = product
  ? product.seo_description || product.short_description || `Shop ${product.name} at Clever Toys.`
  : 'The requested product could not be found.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const productSchema = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.short_description || product.description || undefined,
      sku: product.sku || undefined,
      brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
      image: images.map((image) => image.image_url),
      offers: {
        '@type': 'Offer',
        url: canonicalUrl,
        priceCurrency: 'USD',
        price: displayPrice.toFixed(2),
        availability: inStock
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock'
      }
    }
  : null;
---

<head>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="product" />
  <meta property="og:url" content={canonicalUrl} />
  {images[0] && <meta property="og:image" content={images[0].image_url} />}
  {productSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  )}
</head>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">Clever Toys</a>

    <nav class="main-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/products">Shop</a>
      <a href="/categories">Categories</a>
      <a href="/cart" aria-label="Shopping cart">Cart</a>
    </nav>
  </div>
</header>

<main>
  {!product ? (
    <section class="section">
      <div class="container not-found">
        <p class="eyebrow">404</p>
        <h1>Product not found</h1>
        <p>Sorry, this toy is no longer available or the link is incorrect.</p>
        <a class="button" href="/products">Back to Shop</a>
      </div>
    </section>
  ) : (
    <section class="section product-detail">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/products">Shop</a>
          {product.categories && (
            <>
              <span>/</span>
              <a href={`/category/${product.categories.slug}`}>
                {product.categories.name}
              </a>
            </>
          )}
          <span>/</span>
          <span aria-current="page">{product.name}</span>
        </nav>

        <div class="product-layout">
          <div class="gallery">
            <div class="gallery-main">
              {images[0] ? (
                <img
                  id="main-product-image"
                  src={images[0].image_url}
                  alt={images[0].alt_text || product.name}
                />
              ) : (
                <div class="product-placeholder large"><span>No image yet</span></div>
              )}
            </div>

            {images.length > 1 && (
              <div class="gallery-thumbnails" aria-label="Product images">
                {images.map((image, index) => (
                  <button
                    type="button"
                    class:list={{ 'thumbnail active': index === 0, thumbnail: index !== 0 }}
                    data-image={image.image_url}
                    data-alt={image.alt_text || product.name}
                    aria-label={`View image ${index + 1}`}
                  >
                    <img src={image.image_url} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="product-details">
            {product.brand && <p class="eyebrow">{product.brand}</p>}
            <h1>{product.name}</h1>

            {product.short_description && (
              <p class="lead">{product.short_description}</p>
            )}

            <div class="price-row">
              <span class="detail-price">${displayPrice.toFixed(2)}</span>
              {originalPrice != null && (
                <span class="original-price">${originalPrice.toFixed(2)}</span>
              )}
            </div>

            <p class:list={{ stock: true, 'out-of-stock': !inStock }}>
              {inStock ? `${product.stock_quantity} available` : 'Out of stock'}
            </p>

            {product.description && (
              <div class="description">
                <h2>About this toy</h2>
                <div set:html={product.description.replace(/\n/g, '<br />')} />
              </div>
            )}

            {(product.age_min != null || product.age_max != null) && (
              <div class="detail-meta">
                <strong>Recommended age:</strong>
                <span>
                  {product.age_min != null && product.age_max != null
                    ? `${product.age_min}–${product.age_max} years`
                    : product.age_min != null
                      ? `${product.age_min}+ years`
                      : `Up to ${product.age_max} years`}
                </span>
              </div>
            )}

            {product.sku && (
              <div class="detail-meta">
                <strong>SKU:</strong>
                <span>{product.sku}</span>
              </div>
            )}

            <div class="purchase-box">
              <label for="quantity">Quantity</label>
              <div class="purchase-row">
                <input
                  id="quantity"
                  type="number"
                  min="1"
                  max={Math.max(product.stock_quantity, 1)}
                  value="1"
                  disabled={!inStock}
                />
                <button
                  id="add-to-cart"
                  class="button add-button"
                  type="button"
                  disabled={!inStock}
                  data-product-id={product.id}
                  data-product-name={product.name}
                  data-product-slug={product.slug}
                  data-product-price={displayPrice}
                  data-product-image={images[0]?.image_url || ''}
                  data-max-stock={product.stock_quantity}
                >
                  {inStock ? 'Add to Cart' : 'Out of Stock'}
                </button>
              </div>
              <p id="cart-message" class="cart-message" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}
</main>

<footer class="site-footer">
  <div class="container">
    <p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p>
  </div>
</footer>

{product && (
  <script>
    const mainImage = document.querySelector('#main-product-image');
    const thumbnails = document.querySelectorAll('.thumbnail');

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => {
        if (!mainImage) return;
        mainImage.src = thumbnail.dataset.image || '';
        mainImage.alt = thumbnail.dataset.alt || '';
        thumbnails.forEach((item) => item.classList.remove('active'));
        thumbnail.classList.add('active');
      });
    });

    const addButton = document.querySelector('#add-to-cart');
    const quantityInput = document.querySelector('#quantity');
    const cartMessage = document.querySelector('#cart-message');

    addButton?.addEventListener('click', () => {
      const quantity = Number(quantityInput?.value || 1);
      const maxStock = Number(addButton.dataset.maxStock || 0);

      if (!Number.isInteger(quantity) || quantity < 1 || quantity > maxStock) {
        if (cartMessage) cartMessage.textContent = `Please choose a quantity from 1 to ${maxStock}.`;
        return;
      }

      const item = {
        productId: addButton.dataset.productId,
        name: addButton.dataset.productName,
        slug: addButton.dataset.productSlug,
        price: Number(addButton.dataset.productPrice),
        image: addButton.dataset.productImage || '',
        quantity
      };

      const cart = JSON.parse(localStorage.getItem('cleverToysCart') || '[]');
      const existing = cart.find((cartItem) => cartItem.productId === item.productId);

      if (existing) {
        existing.quantity = Math.min(existing.quantity + quantity, maxStock);
      } else {
        cart.push(item);
      }

      localStorage.setItem('cleverToysCart', JSON.stringify(cart));

      if (cartMessage) cartMessage.textContent = 'Added to your cart.';
    });
  </script>
)}

<style>
  .product-detail {
    padding-top: 32px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    color: #64748b;
    font-size: 0.9rem;
  }

  .breadcrumbs a:hover {
    color: #111827;
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 64px;
    align-items: start;
  }

  .gallery-main {
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    background: #f8fafc;
  }

  .gallery-main img,
  .product-placeholder.large {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .product-placeholder.large {
    display: grid;
    place-items: center;
  }

  .gallery-thumbnails {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
  }

  .thumbnail {
    flex: 0 0 76px;
    width: 76px;
    height: 76px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 10px;
    background: #f8fafc;
    cursor: pointer;
  }

  .thumbnail.active {
    border-color: #111827;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-details h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .lead {
    margin: 18px 0 0;
    color: #64748b;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 24px 0 8px;
  }

  .detail-price {
    font-size: 2rem;
    font-weight: 900;
  }

  .original-price {
    color: #94a3b8;
    font-size: 1.1rem;
    text-decoration: line-through;
  }

  .stock {
    margin: 0 0 28px;
    color: #166534;
    font-weight: 700;
  }

  .stock.out-of-stock {
    color: #b91c1c;
  }

  .description {
    padding: 24px 0;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    line-height: 1.75;
  }

  .description h2 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }

  .detail-meta {
    display: flex;
    gap: 8px;
    padding-top: 16px;
    font-size: 0.92rem;
  }

  .purchase-box {
    margin-top: 28px;
    padding: 20px;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    background: #f8fafc;
  }

  .purchase-box label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .purchase-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 10px;
  }

  .purchase-row input {
    width: 100%;
    min-height: 48px;
    padding: 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #fff;
    font: inherit;
  }

  .add-button {
    width: 100%;
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .add-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .cart-message {
    min-height: 20px;
    margin: 10px 0 0;
    color: #166534;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .not-found {
    max-width: 680px;
    text-align: center;
  }

  .not-found .button {
    margin-top: 12px;
  }

  @media (max-width: 800px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 480px) {
    .purchase-row {
      grid-template-columns: 82px 1fr;
    }
  }
</style>
