---
/**
 * Product detail page: /product/<slug>
 *
 * Server side (this block): loads the product, its photos, options (variants) and
 * "You may also like" suggestions from Supabase, then builds the SEO tags.
 * Browser side (the script at the bottom): option buttons, quantity stepper, gallery thumbnails,
 * Add to Cart (which opens the cart drawer) and the sticky buy bar on phones.
 * Delivery / payment / returns notes come from Admin → Storefront.
 * The "Order on WhatsApp" button is rendered here and wired up by public/branding-ui.js.
 */
import { supabase } from '../../lib/supabase';
import { getPageData } from '../../lib/page-data';
import { placeholderFor } from '../../lib/design';
import ProductCard, { type CardProduct } from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import '../../styles/global.css';

const slug = Astro.params.slug;

// 1) The product itself, with its main category, extra photos, options and all category links.
const productFields = [
  'id,name,slug,sku,short_description,description,price,sale_price,stock_quantity,age_min,age_max,brand,primary_image_url,seo_title,seo_description',
  'categories:category_id(id,name,slug)',
  'product_images(id,image_url,alt_text,sort_order,is_primary)',
  'product_variants(id,name,sku,price,sale_price,stock_quantity,attributes,is_active)',
  'product_categories(category_id)'
].join(',');
type ProductImage = { id: string; image_url: string; alt_text: string | null; sort_order: number; is_primary: boolean };
type ProductVariant = { id: string; name: string; sku: string | null; price: number | null; sale_price: number | null; stock_quantity: number; attributes: unknown; is_active: boolean };
type Product = {
  id: string; name: string; slug: string; sku: string | null; short_description: string | null; description: string | null;
  price: number; sale_price: number | null; stock_quantity: number; age_min: number | null; age_max: number | null; brand: string | null;
  primary_image_url: string | null; seo_title: string | null; seo_description: string | null;
  categories: { id: string; name: string; slug: string } | null;
  product_images: ProductImage[] | null; product_variants: ProductVariant[] | null; product_categories: { category_id: string }[] | null;
};
const [{ data, error }, pageData] = await Promise.all([
  supabase.from('products').select(productFields).eq('slug', slug).eq('is_active', true).maybeSingle(),
  getPageData(Astro)
]);
const { design } = pageData;
const product = data as unknown as Product | null;
if (error || !product) Astro.response.status = 404;

// Photos: the main image first, then the gallery images, without duplicates.
const images = product
  ? [
      ...(product.primary_image_url ? [{ id: 'primary', image_url: product.primary_image_url, alt_text: product.name, sort_order: -1, is_primary: true }] : []),
      ...(product.product_images ?? [])
    ]
      .filter((image, index, all) => all.findIndex((item) => item.image_url === image.image_url) === index)
      .sort((a, b) => a.sort_order - b.sort_order)
  : [];

// Options (e.g. sizes or colours). Each option can have its own price and stock.
const variants = (product?.product_variants ?? [])
  .filter((v) => v.is_active)
  .map((v) => ({
    ...v,
    displayPrice: Number(v.sale_price ?? v.price ?? product?.sale_price ?? product?.price ?? 0),
    originalPrice: v.sale_price != null ? Number(v.price ?? product?.price ?? 0) : null
  }));
const baseDisplayPrice = product ? Number(product.sale_price ?? product.price) : 0;
const baseOriginalPrice = product?.sale_price != null ? Number(product.price) : null;
const inStock = Boolean(product && product.stock_quantity > 0);

// 2) "You may also like": active toys from the same categories (featured first), topped up with
//    other featured/new toys. Both queries run at the same time to keep the page fast.
type SimilarProduct = { id: string; name: string; slug: string; price: number; sale_price: number | null; stock_quantity: number; primary_image_url: string | null; is_active?: boolean; is_featured?: boolean; created_at?: string };
const similarFields = 'id,name,slug,price,sale_price,stock_quantity,primary_image_url,age_min,age_max,is_active,is_featured,created_at,product_variants(id,is_active,price,sale_price)';
let similarProducts: SimilarProduct[] = [];
if (product) {
  const categoryIds = [...new Set([...(product.product_categories ?? []).map((row: { category_id: string }) => row.category_id), ...(product.categories?.id ? [product.categories.id] : [])])];
  const [related, filler] = await Promise.all([
    categoryIds.length
      ? supabase.from('product_categories').select(`product_id,products:product_id(${similarFields})`).in('category_id', categoryIds).neq('product_id', product.id).limit(60)
      : Promise.resolve({ data: [] as any[] }),
    supabase.from('products').select(similarFields).eq('is_active', true).neq('id', product.id).order('is_featured', { ascending: false }).order('created_at', { ascending: false }).limit(8)
  ]);
  const byRank = (a: SimilarProduct, b: SimilarProduct) => Number(b.is_featured) - Number(a.is_featured) || String(b.created_at).localeCompare(String(a.created_at));
  const seen = new Set<string>([product.id]);
  const relatedProducts = ((related.data ?? []) as any[])
    .map((row) => row.products as SimilarProduct | null)
    .filter((item): item is SimilarProduct => Boolean(item && item.is_active))
    .sort(byRank);
  for (const item of [...relatedProducts, ...((filler.data ?? []) as SimilarProduct[])]) {
    if (similarProducts.length >= 8 || seen.has(item.id)) continue;
    seen.add(item.id);
    similarProducts.push(item);
  }
}

// 3) SEO: title/description, canonical link and structured data for Google.
const pageTitle = product ? product.seo_title || `${product.name} | Clever Toys` : 'Product Not Found | Clever Toys';
const pageDescription = product ? product.seo_description || product.short_description || `Shop ${product.name} at Clever Toys.` : 'The requested product could not be found.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const productSchema = product ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.short_description || product.description || undefined,
  sku: product.sku || undefined,
  brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
  image: images.map((image) => image.image_url),
  offers: {
    '@type': 'Offer',
    url: canonicalUrl,
    priceCurrency: 'USD',
    price: baseDisplayPrice.toFixed(2),
    itemCondition: 'https://schema.org/NewCondition',
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock'
  }
} : null;
const breadcrumbSchema = product ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', canonicalUrl).href },
    ...(product.categories ? [{ '@type': 'ListItem', position: 2, name: product.categories.name, item: new URL(`/category/${product.categories.slug}`, canonicalUrl).href }] : []),
    { '@type': 'ListItem', position: product.categories ? 3 : 2, name: product.name, item: canonicalUrl }
  ]
} : null;
// Tells the middleware which fields this product set itself, so the /product/* SEO template never overrides them.
const seoCustom = product ? [product.seo_title && 'title', (product.seo_description || product.short_description) && 'description'].filter(Boolean).join(',') : '';

const stockText = (stock: number) => stock <= 0 ? 'Out of stock' : stock <= 5 ? `Only ${stock} left, order soon!` : `${stock} available`;
const ageText = product && (product.age_min != null || product.age_max != null)
  ? product.age_min != null && product.age_max != null ? `${product.age_min}–${product.age_max} years` : product.age_min != null ? `${product.age_min}+ years` : `Up to ${product.age_max} years`
  : '';
const placeholder = placeholderFor(product?.name || 'toy');
const discount = baseOriginalPrice && baseOriginalPrice > baseDisplayPrice ? Math.round((1 - baseDisplayPrice / baseOriginalPrice) * 100) : 0;
// Also tag the toy as on sale when only some of its options are discounted.
const onSale = discount > 0 || variants.some((v) => v.originalPrice != null && v.originalPrice > v.displayPrice);
const perks = [['🚚', design.product.delivery], ['💵', design.product.payment], ['↩️', design.product.returns]].filter(([, text]) => text);
const similarCards = similarProducts as unknown as CardProduct[];
---
<head>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  {product ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex" />}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="product" />
  <meta property="og:url" content={canonicalUrl} />
  {images[0] && <meta property="og:image" content={images[0].image_url} />}
  {images[0] && <link rel="preload" as="image" href={images[0].image_url} fetchpriority="high" />}
  {product && <meta name="clever-seo-name" content={product.name} />}
  {product && <meta name="clever-seo-custom" content={seoCustom} />}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
</head>
<header class="site-header"></header>
<main>
  {!product ? (
    <section class="section">
      <div class="container narrow">
        <div class="empty-state">
          <p class="eyebrow">404</p>
          <h1>Product not found</h1>
          <p>Sorry, this toy is no longer available or the link is incorrect.</p>
          <a class="button" href="/products">Back to the shop</a>
        </div>
      </div>
    </section>
  ) : (
    <section class="section tight product-detail">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/products">Shop</a>
          {product.categories && <><span>/</span><a href={`/category/${product.categories.slug}`}>{product.categories.name}</a></>}
          <span>/</span><span aria-current="page">{product.name}</span>
        </nav>
        <div class="product-layout">
          {/* Photos */}
          <div class="gallery">
            <div class="gallery-main">
              {images[0]
                ? <img id="main-product-image" src={images[0].image_url} alt={images[0].alt_text || product.name} fetchpriority="high" decoding="async" width="800" height="800" />
                : <span class="product-placeholder" style={`--ph-h:${placeholder.hue}`}><span aria-hidden="true">{placeholder.emoji}</span></span>}
              {onSale && <span class="sale-badge">Sale{discount > 0 && ` −${discount}%`}</span>}
            </div>
            {images.length > 1 && (
              <div class="gallery-thumbnails" aria-label="Product images">
                {images.map((image, index) => (
                  <button type="button" class:list={['thumbnail', { active: index === 0 }]} data-image={image.image_url} data-alt={image.alt_text || product.name} aria-label={`View image ${index + 1}`}>
                    <img src={image.image_url} alt="" loading="lazy" decoding="async" width="78" height="78" />
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Name, price, options and buying */}
          <div class="product-details">
            <p class="eyebrow">{product.brand || product.categories?.name || 'Clever Toys'}</p>
            <h1>{product.name}</h1>
            <div class="price-row">
              <span id="detail-price" class="detail-price">${baseDisplayPrice.toFixed(2)}</span>
              <span id="original-price" class="original-price" hidden={baseOriginalPrice == null}>{baseOriginalPrice != null ? `$${baseOriginalPrice.toFixed(2)}` : ''}</span>
              {discount > 0 && <span class="save-badge">Save {discount}%</span>}
            </div>
            <p id="stock-label" class:list={['stock', { 'out-of-stock': !inStock }]}>{stockText(product.stock_quantity)}</p>
            {product.short_description && <p class="lead">{product.short_description}</p>}

            {variants.length > 0 && (
              <div class="variant-picker">
                <span class="option-label" id="variant-label">Choose an option</span>
                {/* Buttons for shoppers; the hidden select keeps the value for the scripts. */}
                <div class="variant-options" role="group" aria-labelledby="variant-label">
                  {variants.map((variant) => <button type="button" class="variant-option" data-variant={variant.id} aria-pressed="false" disabled={variant.stock_quantity <= 0}>{variant.name}</button>)}
                </div>
                <select id="variant-select" aria-labelledby="variant-label" tabindex="-1" aria-hidden="true">
                  <option value="">Select an option</option>
                  {variants.map((variant) => <option value={variant.id}>{variant.name}{variant.sku ? ` · ${variant.sku}` : ''}</option>)}
                </select>
              </div>
            )}

            <div class="purchase-box">
              <label for="quantity">Quantity</label>
              <div class="purchase-row">
                <div class="qty-stepper">
                  <button type="button" data-qty="-1" aria-label="Decrease quantity" disabled={!inStock}>−</button>
                  <input id="quantity" type="number" inputmode="numeric" min="1" max={Math.max(product.stock_quantity, 1)} value="1" disabled={!inStock} />
                  <button type="button" data-qty="1" aria-label="Increase quantity" disabled={!inStock}>+</button>
                </div>
                <button id="add-to-cart" class="button add-button" type="button" disabled={!inStock}>{inStock ? (variants.length ? 'Select an option' : 'Add to Cart') : 'Out of Stock'}</button>
              </div>
              <p id="cart-message" class="cart-message" aria-live="polite"></p>
              {/* Rendered on the server so it never pops in and moves the page; public/branding-ui.js makes it work. */}
              <div class="whatsapp-order" data-buy-whatsapp>
                <button type="button" class="button whatsapp-buy-button" disabled={!inStock}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41Z"/></svg>
                  <span>Order on WhatsApp</span>
                </button>
                <p class="whatsapp-order-note">We'll confirm availability and delivery time in chat · Cash on delivery</p>
              </div>
            </div>

            {perks.length > 0 && <ul class="product-perks">{perks.map(([icon, text]) => <li><span aria-hidden="true">{icon}</span>{text}</li>)}</ul>}

            <div class="product-accordion">
              {product.description && (
                <details open>
                  <summary>About this toy</summary>
                  {/* Shown as plain text; line breaks from the admin editor are kept by CSS (white-space: pre-line). */}
                  <div class="accordion-body description-text">{product.description}</div>
                </details>
              )}
              <details open={!product.description}>
                <summary>Details</summary>
                <dl class="accordion-body spec-list">
                  {ageText && <div><dt>Recommended age</dt><dd>{ageText}</dd></div>}
                  {product.brand && <div><dt>Brand</dt><dd>{product.brand}</dd></div>}
                  {product.categories && <div><dt>Category</dt><dd><a href={`/category/${product.categories.slug}`}>{product.categories.name}</a></dd></div>}
                  {product.sku && <div><dt>SKU</dt><dd>#{product.sku}</dd></div>}
                  <div><dt>Payment</dt><dd>Cash on delivery</dd></div>
                </dl>
              </details>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* You may also like */}
  {similarCards.length > 0 && (
    <section class="section similar-section" aria-labelledby="similar-title">
      <div class="container">
        <div class="section-header section-header-row">
          <div><h2 id="similar-title">You may also like</h2><p>More toys picked for the same kind of play.</p></div>
          <a href="/products" class="text-link">View all toys →</a>
        </div>
        <div class="product-grid similar-grid">{similarCards.map((item) => <ProductCard product={item} />)}</div>
      </div>
    </section>
  )}

  {/* Phones: price + Add to cart stay reachable after scrolling past the main button. */}
  {product && inStock && (
    <div class="buy-bar" id="buy-bar" aria-hidden="true">
      <div class="buy-bar-info"><strong>{product.name}</strong><span id="buy-bar-price">${baseDisplayPrice.toFixed(2)}</span></div>
      <button type="button" class="button" id="buy-bar-add" tabindex="-1">{variants.length ? 'Choose option' : 'Add to cart'}</button>
    </div>
  )}
</main>
<QuickView />
<footer class="site-footer"></footer>

{product && (
  <script is:inline define:vars={{
    productId: product.id,
    productName: product.name,
    productSlug: product.slug,
    basePrice: baseDisplayPrice,
    baseOriginalPrice,
    baseStock: product.stock_quantity,
    productImage: images[0]?.image_url || '',
    variantData: variants.map((v) => ({ id: v.id, name: v.name, sku: v.sku || '', price: v.displayPrice, originalPrice: v.originalPrice, stock: v.stock_quantity }))
  }}>
  // Runs straight away (inline), so the buttons work as soon as the page appears.
  const CART_KEY = 'cleverToysCart';
  const $ = (selector) => document.querySelector(selector);
  const mainImage = $('#main-product-image');
  const select = $('#variant-select');
  const qty = $('#quantity');
  const add = $('#add-to-cart');
  const price = $('#detail-price');
  const original = $('#original-price');
  const stock = $('#stock-label');
  const message = $('#cart-message');
  const buyBar = $('#buy-bar');
  const money = (n) => `$${Number(n).toFixed(2)}`;

  // Gallery: tapping a thumbnail shows it as the main photo.
  document.querySelectorAll('.thumbnail').forEach((thumb, _, all) => thumb.addEventListener('click', () => {
    if (!mainImage) return;
    mainImage.src = thumb.dataset.image || '';
    mainImage.alt = thumb.dataset.alt || '';
    all.forEach((item) => item.classList.toggle('active', item === thumb));
  }));

  const readCart = () => { try { const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]'); return Array.isArray(cart) ? cart : []; } catch { return []; } };
  const selectedVariant = () => variantData.find((v) => v.id === select?.value);

  // Update price, stock, quantity limits and the Add to Cart button for the chosen option.
  function sync() {
    const v = selectedVariant();
    const activeStock = v?.stock ?? baseStock;
    const activeOriginal = v ? v.originalPrice : baseOriginalPrice;
    const optionChosen = !variantData.length || Boolean(select?.value);
    price.textContent = money(v?.price ?? basePrice);
    original.hidden = activeOriginal == null;
    original.textContent = activeOriginal == null ? '' : money(activeOriginal);
    stock.textContent = activeStock <= 0 ? 'Out of stock' : activeStock <= 5 ? `Only ${activeStock} left, order soon!` : `${activeStock} available`;
    stock.classList.toggle('out-of-stock', activeStock <= 0);
    qty.max = String(Math.max(activeStock, 1));
    if (Number(qty.value) > activeStock && activeStock > 0) qty.value = String(activeStock);
    qty.disabled = activeStock <= 0;
    add.disabled = activeStock <= 0 || !optionChosen;
    add.textContent = activeStock <= 0 ? 'Out of Stock' : optionChosen ? 'Add to Cart' : 'Select an option';
    if (buyBar) $('#buy-bar-price').textContent = money(v?.price ?? basePrice);
    document.querySelectorAll('.variant-option').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.variant === select?.value)));
  }
  select?.addEventListener('change', () => { message.textContent = ''; sync(); });
  // Option buttons set the (hidden) select, so every other script sees the same choice.
  document.querySelectorAll('.variant-option').forEach((button) => button.addEventListener('click', () => {
    select.value = button.dataset.variant;
    select.dispatchEvent(new Event('change', { bubbles: true }));
  }));
  // Quantity − / +
  document.querySelectorAll('[data-qty]').forEach((button) => button.addEventListener('click', () => {
    const max = Number(qty.max) || 1;
    qty.value = String(Math.min(max, Math.max(1, (Number(qty.value) || 1) + Number(button.dataset.qty))));
    qty.dispatchEvent(new Event('input', { bubbles: true }));
  }));
  sync();

  // Add to Cart: save to this browser's cart (localStorage), then open the cart drawer (public/store-ui.js).
  add.addEventListener('click', () => {
    const v = selectedVariant();
    if (variantData.length && !v) { message.textContent = 'Please select an option first.'; return; }
    const maxStock = v?.stock ?? baseStock;
    const quantity = Number(qty.value || 1);
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > maxStock) { message.textContent = `Please choose a quantity from 1 to ${maxStock}.`; return; }
    const cart = readCart();
    const existing = cart.find((item) => item.productId === productId && (item.variantId || null) === (v?.id || null));
    if (existing) {
      existing.quantity = Math.min(Number(existing.quantity) + quantity, maxStock);
      existing.maxStock = maxStock;
      existing.price = Number(v?.price ?? basePrice);
    } else {
      cart.push({ productId, variantId: v?.id || null, variantName: v?.name || null, sku: v?.sku || null, name: productName, slug: productSlug, price: Number(v?.price ?? basePrice), image: productImage, quantity, maxStock });
    }
    try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch { message.textContent = 'Your browser blocked the cart. Please allow site storage and try again.'; return; }
    window.dispatchEvent(new CustomEvent('clever-cart-updated'));
    window.dispatchEvent(new CustomEvent('clever-cart-added', { detail: { trigger: add } }));
    message.innerHTML = `<span>${quantity} item${quantity === 1 ? '' : 's'} added to cart.</span> <a class="checkout-prompt" href="/checkout">Proceed to Checkout</a> <a class="checkout-prompt secondary" href="/cart">View Cart</a>`;
  });

  // Sticky buy bar (phones): shows when the main Add to Cart button is off screen.
  if (buyBar && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      buyBar.classList.toggle('is-visible', show);
      document.body.classList.toggle('has-buy-bar', show);
    }).observe(add);
    $('#buy-bar-add').addEventListener('click', () => {
      if (variantData.length && !select.value) { document.querySelector('.variant-picker').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      add.click();
    });
  }
  </script>
)}
