---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><div class="section-header"><h1>My Account</h1><p id="account-email">Loading…</p></div><div id="account-message" role="status"></div><div id="orders"></div><button id="logout" class="button secondary-button" type="button">Sign Out</button></div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const config=document.querySelector('#auth-config');
const url=config?.dataset.url; const key=config?.dataset.key;
const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const email=document.querySelector('#account-email'); const orders=document.querySelector('#orders'); const message=document.querySelector('#account-message');
let supabase;
async function init(){
  try{
    if(!url||!key) throw new Error('Supabase browser configuration is missing.');
    supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
    const {data:{session}}=await supabase.auth.getSession();
    if(!session?.user){ location.href='/login?next=/account'; return; }
    const user=session.user; email.textContent=user.email||'';
    const {data,error}=await supabase.from('orders').select('order_number,total,status,created_at').eq('customer_id',user.id).order('created_at',{ascending:false});
    if(error) throw new Error(error.message);
    orders.innerHTML=data?.length?`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>${data.map(o=>`<tr><td>${esc(o.order_number)}</td><td>${new Date(o.created_at).toLocaleDateString()}</td><td>$${Number(o.total).toFixed(2)}</td><td>${esc(o.status)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty-state"><h2>No orders yet</h2><a class="button" href="/products">Start Shopping</a></div>';
  }catch(error){ message.textContent=error?.message||'Could not load your account.'; }
}
init();
document.querySelector('#logout').onclick=async()=>{if(supabase) await supabase.auth.signOut();location.href='/';};
</script>