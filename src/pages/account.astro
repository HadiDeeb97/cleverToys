---
import '../styles/global.css';
---
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>My Account</h1><p id="account-email">Loading…</p></div><div id="orders"></div><button id="logout" class="button secondary-button">Sign Out</button></div></main>
<script>
import { supabase } from '../lib/supabase';
const email=document.querySelector('#account-email');const orders=document.querySelector('#orders');
const {data:{user}}=await supabase.auth.getUser(); if(!user){location.href='/login';} else {email.textContent=user.email||'';const {data}=await supabase.from('orders').select('order_number,total,status,created_at').eq('customer_id',user.id).order('created_at',{ascending:false});orders.innerHTML=data?.length?`<div class="table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>${data.map(o=>`<tr><td>${o.order_number}</td><td>${new Date(o.created_at).toLocaleDateString()}</td><td>$${Number(o.total).toFixed(2)}</td><td>${o.status}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty-state"><h2>No orders yet</h2><a class="button" href="/products">Start Shopping</a></div>';}
document.querySelector('#logout').onclick=async()=>{await supabase.auth.signOut();location.href='/';};
</script>