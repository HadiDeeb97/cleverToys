---
/**
 * Category page: /category/<slug>
 *
 * Shows one category (from Admin → Products → Categories) with the same shop listing as /products:
 * search, sale / option / age filters, sorting and paging, limited to toys in this category.
 * The listing is shared with /products: src/lib/shop.ts and src/components/ShopView.astro.
 */
import { supabase } from '../../lib/supabase';
import { loadShop } from '../../lib/shop';
import { getPageData } from '../../lib/page-data';
import ShopView from '../../components/ShopView.astro';
import QuickView from '../../components/QuickView.astro';
import '../../styles/global.css';

const slug = Astro.params.slug;
const { data: category, error: categoryError } = await supabase.from('categories').select('id, name, slug, description, image_url, seo_title, seo_description').eq('slug', slug).eq('is_active', true).maybeSingle();

// No real "sale" category: /category/sale opens the automatic Sale page instead.
if (!category && !categoryError && slug === 'sale') return Astro.redirect('/products?sale=1');
if (categoryError || !category) Astro.response.status = 404;
const title = category ? category.seo_title || `${category.name} Toys | Clever Toys` : 'Category Not Found | Clever Toys';
const description = category ? category.seo_description || category.description || `Shop ${category.name.toLowerCase()} toys at Clever Toys.` : 'The requested toy category could not be found.';
const canonicalUrl = new URL(`/category/${slug}`, Astro.site ?? Astro.url.origin).href;
const shop = category ? await loadShop(Astro, { basePath: `/category/${category.slug}`, fixedCategory: category }) : null;
if (shop && 'redirect' in shop) return Astro.redirect(shop.redirect ?? Astro.url.pathname);
// Started by the middleware for the header, so this is already loaded (no extra request).
const { hasSale } = await getPageData(Astro);
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  {category ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  {category?.image_url && <meta property="og:image" content={category.image_url} />}
  {/* Hints for the /category/* SEO template in src/middleware.ts */}
  {category && <meta name="clever-seo-name" content={category.name} />}
  {category && <meta name="clever-seo-custom" content={[category.seo_title && 'title', (category.seo_description || category.description) && 'description'].filter(Boolean).join(',')} />}
</head>
<header class="site-header"></header>
<main>
  {!category ? (
    <section class="section">
      <div class="container narrow">
        <div class="empty-state">
          <p class="eyebrow">404</p>
          <h1>Category not found</h1>
          <p>This category is no longer available or the link is incorrect.</p>
          <a class="button" href="/categories">Browse categories</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="page-hero shop-hero">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/categories">Categories</a><span>/</span><span aria-current="page">{category.name}</span>
          </nav>
          <h1>{category.name}</h1>
          <p>{category.description || 'Fun, educational and exciting toys for every child, with cash on delivery across Lebanon.'}</p>
        </div>
      </section>
      {shop && <ShopView shop={shop} hasSale={hasSale} />}
    </>
  )}
</main>
<QuickView />
<footer class="site-footer"></footer>
