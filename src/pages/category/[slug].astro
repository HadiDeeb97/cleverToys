---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';

const slug = Astro.params.slug;
const { data: category, error: categoryError } = await supabase.from('categories').select('id, name, slug, description, image_url, seo_title, seo_description').eq('slug', slug).eq('is_active', true).maybeSingle();

let products = null;
let productsError = null;
if (category) {
  const links = await supabase.from('product_categories').select('product_id').eq('category_id', category.id);
  if (links.error) productsError = links.error;
  const ids = (links.data || []).map(row => row.product_id);
  if (!links.error && ids.length) {
    const result = await supabase.from('products').select('id, name, slug, price, sale_price, stock_quantity, primary_image_url, short_description').in('id', ids).eq('is_active', true).order('created_at', { ascending: false });
    products = result.data;
    productsError = result.error;
  } else if (!links.error) {
    products = [];
  }
}

if (categoryError || !category) Astro.response.status = 404;
const title = category ? category.seo_title || `${category.name} Toys | Clever Toys` : 'Category Not Found | Clever Toys';
const description = category ? category.seo_description || category.description || `Shop ${category.name.toLowerCase()} toys at Clever Toys.` : 'The requested toy category could not be found.';
const canonicalUrl = new URL(`/category/${slug}`, Astro.site ?? Astro.url.origin).href;
---
<head><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonicalUrl}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonicalUrl}/>{category?.image_url&&<meta property="og:image" content={category.image_url}/>}</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav" aria-label="Main navigation"><a href="/">Home</a><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart" aria-label="Shopping cart">Cart</a></nav></div></header>
<main>{!category?<section class="section"><div class="container category-not-found"><p class="eyebrow">404</p><h1>Category not found</h1><p>This category is no longer available or the link is incorrect.</p><a class="button" href="/categories">Browse categories</a></div></section>:<><section class="category-detail-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/categories">Categories</a><span>/</span><span aria-current="page">{category.name}</span></nav><div class="category-heading"><div><p class="eyebrow">Toy category</p><h1>{category.name}</h1>{category.description&&<p>{category.description}</p>}<a class="button" href={`/products?category=${encodeURIComponent(category.slug)}`}>Shop all {category.name}</a></div>{category.image_url&&<img src={category.image_url} alt={category.name}/>}</div></div></section><section class="section"><div class="container"><div class="section-header category-products-header"><div><h2>{category.name}</h2><p>{products?.length??0} {products?.length===1?'toy':'toys'} available</p></div><a href="/products">View all toys →</a></div>{productsError?<div class="category-empty"><h2>We couldn't load the toys</h2><p>Please try again in a moment.</p></div>:products?.length?<div class="product-grid">{products.map(product=>{const displayPrice=Number(product.sale_price??product.price);const originalPrice=product.sale_price!=null?Number(product.price):null;const inStock=product.stock_quantity>0;return <article class="product-card"><a class="category-product-image" href={`/product/${product.slug}`}>{product.primary_image_url?<img class="product-image" src={product.primary_image_url} alt={product.name} loading="lazy"/>:<div class="product-placeholder"><span>No image yet</span></div>}{product.sale_price!=null&&<span class="sale-badge">Sale</span>}{!inStock&&<span class="stock-badge">Out of stock</span>}</a><div class="product-info"><h3><a href={`/product/${product.slug}`}>{product.name}</a></h3>{product.short_description&&<p>{product.short_description}</p>}<div class="category-price"><span class="price">${displayPrice.toFixed(2)}</span>{originalPrice!=null&&<span>${originalPrice.toFixed(2)}</span>}</div></div></article>;})}</div>:<div class="category-empty"><h2>No toys in this category yet</h2><p>Check back soon or explore our other categories.</p><a class="button" href="/categories">Browse categories</a></div>}</div></section></>}</main>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>
<style>
.category-detail-hero{padding:28px 0 56px;background:var(--page-hero-bg);border-bottom:1px solid var(--line)}.breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;color:var(--muted);font-size:.9rem}.category-heading{display:grid;grid-template-columns:1fr minmax(240px,380px);gap:48px;align-items:center}.category-heading h1{margin:0 0 14px;font-size:clamp(2.3rem,6vw,4rem);letter-spacing:-.02em}.category-heading p:not(.eyebrow){max-width:650px;margin:0 0 24px;color:var(--muted);line-height:1.7}.category-heading img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:20px;border:1px solid var(--line)}.eyebrow{margin:0 0 10px;color:var(--muted);font-size:.8rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.category-products-header{display:flex;justify-content:space-between;gap:20px;align-items:end}.category-products-header h2{margin-bottom:4px}.category-products-header p{margin:0}.category-products-header>a{font-weight:800}.category-product-image{position:relative;display:block}.sale-badge,.stock-badge{position:absolute;top:12px;padding:6px 9px;border-radius:999px;background:#fff;font-size:.72rem;font-weight:800;box-shadow:0 4px 12px rgba(15,23,42,.1)}.sale-badge{left:12px}.stock-badge{right:12px}.category-price{display:flex;gap:8px;align-items:baseline;margin-top:10px}.category-price span:not(.price){color:var(--subtle);text-decoration:line-through}.category-empty{padding:64px 20px;border:1px dashed var(--line-strong);border-radius:18px;text-align:center}.category-empty h2{margin:0 0 8px}.category-empty p{margin:0 0 20px;color:var(--muted)}.category-not-found{max-width:680px;text-align:center}@media(max-width:760px){.category-heading{grid-template-columns:1fr}.category-heading img{max-width:520px}}@media(max-width:560px){.category-products-header{align-items:flex-start;flex-direction:column}}
</style>
