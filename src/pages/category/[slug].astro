---
/**
 * Category page: /category/<slug>
 *
 * Shows one category (from Admin → Products → Categories) and the active toys in it.
 * Two quick requests: the category with its product links, then those products.
 */
import { supabase } from '../../lib/supabase';
import { placeholderFor } from '../../lib/design';
import ProductCard, { type CardProduct } from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import '../../styles/global.css';

const slug = Astro.params.slug;
// The category and the ids of its products in one request (product_categories is embedded).
const { data: category, error: categoryError } = await supabase.from('categories').select('id, name, slug, description, image_url, seo_title, seo_description, product_categories(product_id)').eq('slug', slug).eq('is_active', true).maybeSingle();

type CategoryProduct = CardProduct;
let products: CategoryProduct[] | null = null;
let productsError: unknown = null;
if (category) {
  const ids = ((category.product_categories || []) as { product_id: string }[]).map((row) => row.product_id);
  if (ids.length) {
    const result = await supabase.from('products').select('id, name, slug, price, sale_price, stock_quantity, primary_image_url, short_description, age_min, age_max, created_at, product_variants(id,is_active)').in('id', ids).eq('is_active', true).order('created_at', { ascending: false });
    products = result.data as CategoryProduct[] | null;
    productsError = result.error;
  } else {
    products = [];
  }
}

if (categoryError || !category) Astro.response.status = 404;
const title = category ? category.seo_title || `${category.name} Toys | Clever Toys` : 'Category Not Found | Clever Toys';
const description = category ? category.seo_description || category.description || `Shop ${category.name.toLowerCase()} toys at Clever Toys.` : 'The requested toy category could not be found.';
const canonicalUrl = new URL(`/category/${slug}`, Astro.site ?? Astro.url.origin).href;
const ph = placeholderFor(category?.name || 'toys');
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  {category ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  {category?.image_url && <meta property="og:image" content={category.image_url} />}
  {/* Hints for the /category/* SEO template in src/middleware.ts */}
  {category && <meta name="clever-seo-name" content={category.name} />}
  {category && <meta name="clever-seo-custom" content={[category.seo_title && 'title', (category.seo_description || category.description) && 'description'].filter(Boolean).join(',')} />}
</head>
<header class="site-header"></header>
<main>
  {!category ? (
    <section class="section">
      <div class="container narrow">
        <div class="empty-state">
          <p class="eyebrow">404</p>
          <h1>Category not found</h1>
          <p>This category is no longer available or the link is incorrect.</p>
          <a class="button" href="/categories">Browse categories</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="page-hero">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/categories">Categories</a><span>/</span><span aria-current="page">{category.name}</span>
          </nav>
          <div class="category-heading">
            <div>
              <p class="eyebrow">Toy category</p>
              <h1>{category.name}</h1>
              {category.description && <p>{category.description}</p>}
              <a class="button" href={`/products?category=${encodeURIComponent(category.slug)}`}>Filter & sort {category.name}</a>
            </div>
            <span class="tile-media" style={`--ph-h:${ph.hue}`}>
              {category.image_url ? <img src={category.image_url} alt="" fetchpriority="high" decoding="async" width="380" height="285" /> : <span aria-hidden="true">{ph.emoji}</span>}
            </span>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <div class="section-header section-header-row">
            <div><h2>{products?.length ?? 0} {products?.length === 1 ? 'toy' : 'toys'} in {category.name}</h2></div>
            <a href="/products" class="text-link">View all toys →</a>
          </div>
          {productsError ? (
            <div class="category-empty"><h2>We couldn't load the toys</h2><p>Please try again in a moment.</p></div>
          ) : products?.length ? (
            <div class="product-grid">{products.map((product, index) => <ProductCard product={product} eager={index < 4} />)}</div>
          ) : (
            <div class="category-empty"><h2>No toys in this category yet</h2><p>Check back soon or explore our other categories.</p><a class="button" href="/categories">Browse categories</a></div>
          )}
        </div>
      </section>
    </>
  )}
</main>
<QuickView />
<footer class="site-footer"></footer>
