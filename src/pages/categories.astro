---
/**
 * All categories: /categories
 * One card per active category (Admin → Products → Categories), linking to /category/<slug>.
 */
import { supabase } from '../lib/supabase';
import { placeholderFor } from '../lib/design';
import '../styles/global.css';

const { data: categories, error } = await supabase
  .from('categories')
  .select('id, name, slug, description, image_url')
  .eq('is_active', true)
  .order('sort_order', { ascending: true });

const title = 'Toy Categories | Clever Toys';
const description = 'Browse Clever Toys by category and find the right toys for every child.';
const canonicalUrl = new URL('/categories', Astro.site ?? Astro.url.origin).href;
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
</head>
<header class="site-header"></header>
<main>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Categories</span></nav>
      <h1>Shop by category</h1>
      <p>Explore our collection and find something perfect for every child.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {error ? (
        <div class="category-empty"><h2>We couldn't load the categories</h2><p>Please try again in a moment.</p></div>
      ) : categories?.length ? (
        <div class="category-page-grid">
          {categories.map((category) => {
            const ph = placeholderFor(category.name);
            return (
              <a class="category-page-card" href={`/category/${category.slug}`}>
                <span class="tile-media" style={`--ph-h:${ph.hue}`}>
                  {category.image_url ? <img src={category.image_url} alt="" loading="lazy" decoding="async" /> : <span aria-hidden="true">{ph.emoji}</span>}
                </span>
                <span>
                  <h2>{category.name}</h2>
                  {category.description && <p>{category.description}</p>}
                  <span class="text-link">Shop {category.name} →</span>
                </span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="category-empty"><h2>No categories yet</h2><p>New collections are coming soon.</p><a class="button" href="/products">Shop all toys</a></div>
      )}
    </div>
  </section>
</main>
<footer class="site-footer"></footer>
