---
import '../styles/global.css';
const title='Contact Clever Toys | Clever Toys';
const description='Contact Clever Toys for product questions, order help and delivery assistance.';
---
<head><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={`${Astro.url.origin}/contact`}/></head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Contact us</h1><p>Need help choosing a toy or checking an order? We’re happy to help.</p></div><div class="form-card"><h2>WhatsApp</h2><p>For the fastest response, contact Clever Toys through WhatsApp.</p><a class="button" href="https://wa.me/96100000000" rel="noopener">Message us on WhatsApp</a><p><small>Replace the WhatsApp number above with your business number before launch.</small></p></div></div></main>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>