---
/**
 * Contact page: /contact
 *
 * Everything on it is edited in the admin panel:
 *  - Heading, texts, which cards show and the Instagram section: Admin → Storefront & menus → Contact page
 *  - WhatsApp and Instagram links: Admin → Branding & settings
 *  - Phone, email and city: Admin → SEO → Settings → Business details (or Storefront → Footer & contact)
 *  - Street address and opening hours: Admin → Storefront → Footer & contact
 */
import '../styles/global.css';
import { getPageData, DEFAULT_WHATSAPP_URL, whatsappSendUrl } from '../lib/page-data';
import { parseSeoSettings } from '../lib/seo';
import { instagramUsername, DEFAULT_DESIGN } from '../lib/design';
import { ICONS } from '../lib/storefront-chrome';

const { storeSettings, design } = await getPageData(Astro);
const seo = parseSeoSettings(storeSettings.seo);
const c = design.contact;
const https = (value: unknown) => /^https:\/\/[^\s"<>]+$/i.test(String(value ?? '').trim()) ? String(value).trim() : '';
const whatsappUrl = whatsappSendUrl(https(storeSettings.whatsapp_url) || DEFAULT_WHATSAPP_URL);
const instagramLink = https(storeSettings.instagram_url);
const instagramUrl = storeSettings.show_instagram ? instagramLink : '';
// The Instagram section shows the profile from the Instagram link in Branding (Instagram's own profile embed).
const igUser = instagramUsername(instagramLink);
const showFeed = c.show_feed && Boolean(igUser);
const heading = c.title || DEFAULT_DESIGN.contact.title;
const title = 'Contact Clever Toys | Clever Toys';
const description = 'Contact Clever Toys for product questions, order help and delivery assistance.';
---
<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL('/contact', Astro.site ?? Astro.url.origin).href} />
</head>
<header class="site-header"></header>
<main>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Contact</span></nav>
      <h1>{heading}</h1>
      {c.text && <p>{c.text}</p>}
    </div>
  </section>
  <section class="section tight">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-card">
          <b class="brand-icon whatsapp-icon" aria-hidden="true" set:html={ICONS.whatsapp} />
          <strong>WhatsApp</strong>
          {c.whatsapp_text && <span>{c.whatsapp_text}</span>}
          <a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Fragment set:html={ICONS.whatsapp} /> Chat on WhatsApp</a>
        </div>
        {c.show_phone && seo.org_phone && (
          <div class="contact-card"><b aria-hidden="true">📞</b><strong>Phone</strong><a href={`tel:${seo.org_phone.replace(/[^+\d]/g, '')}`}>{seo.org_phone}</a></div>
        )}
        {c.show_email && seo.org_email && (
          <div class="contact-card"><b aria-hidden="true">✉️</b><strong>Email</strong><a href={`mailto:${seo.org_email}`}>{seo.org_email}</a></div>
        )}
        {c.show_place && (design.footer.address || seo.org_city || design.footer.hours) && (
          <div class="contact-card">
            <b aria-hidden="true">📍</b><strong>Where & when</strong>
            {(design.footer.address || seo.org_city) && <span>{design.footer.address || seo.org_city}</span>}
            {design.footer.hours && <span>{design.footer.hours}</span>}
          </div>
        )}
        {c.show_instagram && instagramUrl && (
          <div class="contact-card"><b class="brand-icon instagram-icon" aria-hidden="true" set:html={ICONS.instagram} /><strong>Instagram</strong>{c.instagram_text && <span>{c.instagram_text}</span>}<a class="button instagram-button" href={instagramUrl} target="_blank" rel="noopener noreferrer"><Fragment set:html={ICONS.instagram} /> Follow us</a></div>
        )}
        {c.show_order && (
          <div class="contact-card">
            <b aria-hidden="true">📦</b><strong>Your order</strong>{c.order_text && <span>{c.order_text}</span>}<a href="/track-order">Track your order</a>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* Instagram: the profile from the link in Branding, shown with Instagram's own profile preview. */}
  {showFeed && (
    <section class="section tight ig-section" aria-labelledby="ig-title">
      <div class="container">
        <div class="ig-card">
          <div class="ig-intro">
            <span class="ig-avatar" aria-hidden="true"><span set:html={ICONS.instagram} /></span>
            <p class="eyebrow">Instagram</p>
            <h2 id="ig-title">{c.feed_title || DEFAULT_DESIGN.contact.feed_title}</h2>
            {c.feed_text && <p class="ig-text">{c.feed_text}</p>}
            <a class="ig-handle" href={instagramLink} target="_blank" rel="noopener noreferrer">@{igUser}</a>
            <a class="button instagram-button" href={instagramLink} target="_blank" rel="noopener noreferrer"><Fragment set:html={ICONS.instagram} /> Follow @{igUser}</a>
          </div>
          <div class="ig-frame">
            <iframe src={`https://www.instagram.com/${igUser}/embed`} title={`Instagram profile @${igUser}`} loading="lazy" scrolling="no" allowtransparency="true" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
      </div>
    </section>
  )}
</main>
<footer class="site-footer"></footer>
