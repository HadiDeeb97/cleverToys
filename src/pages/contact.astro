---
/**
 * Contact page: /contact. Ways to reach the store (WhatsApp link comes from Admin → Branding).
 */
import '../styles/global.css';
const title='Contact Clever Toys | Clever Toys';
const description='Contact Clever Toys for product questions, order help and delivery assistance.';
---
<head><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL("/contact", Astro.site ?? Astro.url.origin).href}/></head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Contact us</h1><p>Need help choosing a toy or checking an order? We’re happy to help.</p></div><div class="form-card"><h2>Customer support</h2><p>For product questions, availability and order assistance, please use the same contact channel you normally use with Clever Toys.</p><p><strong>Before launch:</strong> add your business WhatsApp number, Instagram link or email address here.</p><a class="button" href="/products">Continue Shopping</a></div></div></main>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>