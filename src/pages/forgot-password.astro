---
import '../styles/global.css';
---
<head>
  <title>Forgot Password | Clever Toys</title>
  <meta name="description" content="Reset your Clever Toys account password." />
</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a><a href="/login">Sign in</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Forgot your password?</h1><p>Enter your email and we’ll send you a password reset link.</p></div><form id="reset-form" class="form-card"><label>Email<input name="email" type="email" required autocomplete="email"></label><button class="button" type="submit">Send Reset Link</button><p id="message" role="status"></p><p><a href="/login">Back to sign in</a></p></form></div></main>
<script>
import { supabase } from '../lib/supabase';
const form=document.querySelector('#reset-form');const msg=document.querySelector('#message');
form?.addEventListener('submit',async(e)=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));msg.textContent='Sending…';const redirectTo=`${location.origin}/reset-password`;const {error}=await supabase.auth.resetPasswordForEmail(String(data.email),{redirectTo});msg.textContent=error?error.message:'Check your email for the password reset link.';});
</script>