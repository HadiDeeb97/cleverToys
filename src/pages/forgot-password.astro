---
/**
 * Forgot password: /forgot-password
 *
 * Sends a password-reset email through Supabase. The link in the email opens /reset-password.
 * (In Supabase → Authentication → URL Configuration, /reset-password must be an allowed Redirect URL.)
 */
import '../styles/global.css';
import { supabaseConfig } from '../lib/config';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Forgot Password | Clever Toys</title>
  <meta name="description" content="Reset your Clever Toys account password." />
</head>
<header class="site-header"></header>
<main class="auth-shell">
  <div class="auth-art" aria-hidden="true"><p class="eyebrow">Clever Toys</p><h2>It happens to everyone</h2><p>We will email you a secure link to choose a new password.</p></div>
  <div class="auth-main"><div>
    <div class="section-header"><h1>Forgot your password?</h1><p>Enter your email and we’ll send you a password reset link.</p></div>
    <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
    <form id="reset-form" class="form-card">
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <button class="button" type="submit">Send Reset Link</button>
      <p id="message" role="status"></p>
      <p><a href="/login">Back to sign in</a></p>
    </form>
  </div></div>
</main>
<footer class="site-footer"></footer>

<script>
import { createClient } from '@supabase/supabase-js';
import { authMessage } from '../scripts/auth-messages';

const config = document.querySelector<HTMLElement>('#auth-config');
const form = document.querySelector<HTMLFormElement>('#reset-form')!;
const msg = document.querySelector<HTMLElement>('#message')!;
const url = config?.dataset.url, key = config?.dataset.key;
const supabase = url && key ? createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } }) : null;
if (!supabase) msg.textContent = 'Supabase browser configuration is missing.';

form.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!supabase) return;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const email = String(new FormData(form).get('email') || '').trim();
  button.disabled = true;
  msg.textContent = 'Sending…';
  const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: `${location.origin}/reset-password` });
  // Re-enable after 30 seconds so people cannot trigger the email rate limit by tapping repeatedly.
  setTimeout(() => { button.disabled = false; }, error ? 0 : 30000);
  msg.textContent = error ? authMessage(error, 'Could not send the reset email.') : `If an account uses ${email}, a reset link is on its way. Check your inbox and spam folder.`;
});
</script>
