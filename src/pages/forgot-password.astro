---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
const supabaseUrl = env.SUPABASE_URL || env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = env.SUPABASE_PUBLISHABLE_KEY || env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<head>
  <title>Forgot Password | Clever Toys</title>
  <meta name="description" content="Reset your Clever Toys account password." />
</head>
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/cart">Cart</a><a href="/login">Sign in</a></nav></div></header>
<main class="section"><div class="container narrow"><div class="section-header"><h1>Forgot your password?</h1><p>Enter your email and we’ll send you a password reset link.</p></div><div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div><form id="reset-form" class="form-card"><label>Email<input name="email" type="email" required autocomplete="email"></label><button class="button" type="submit">Send Reset Link</button><p id="message" role="status"></p><p><a href="/login">Back to sign in</a></p></form></div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const config=document.querySelector('#auth-config'); const url=config?.dataset.url; const key=config?.dataset.key;
const form=document.querySelector('#reset-form'); const msg=document.querySelector('#message');
let supabase;
try{ if(!url||!key) throw new Error('Supabase browser configuration is missing.'); supabase=createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}}); }catch(error){ msg.textContent=error?.message||'Could not initialize password reset.'; }
form?.addEventListener('submit',async(e)=>{ e.preventDefault(); if(!supabase)return; const data=Object.fromEntries(new FormData(form)); msg.textContent='Sending…'; const redirectTo=`${location.origin}/reset-password`; const {error}=await supabase.auth.resetPasswordForEmail(String(data.email).trim(),{redirectTo}); msg.textContent=error?error.message:'Check your email for the password reset link.'; });
</script>