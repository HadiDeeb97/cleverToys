---
/**
 * Checkout page: /checkout
 *
 * Shows the delivery form and an order summary built from the cart saved in this browser.
 * "Place Order" sends the order to /api/orders (src/pages/api/orders.ts), which recalculates
 * prices on the server, saves the order and notifies the shop on Telegram.
 * Signed-in customers get their saved details filled in automatically.
 */
import '../styles/global.css';
import { supabaseConfig } from '../lib/config';
import { LEBANON_GOVERNORATES } from '../lib/lebanon';
const { url: supabaseUrl, key: supabaseKey } = supabaseConfig();
---
<head>
  <title>Checkout | Clever Toys</title>
</head>
{/* Replaced by the shared store header in src/middleware.ts */}
<header class="site-header"></header>
<main class="section tight">
  <div class="container">
    <ol class="checkout-steps" aria-label="Checkout progress">
      <li class="done" data-step="1"><a href="/cart">Cart</a></li><span class="sep" aria-hidden="true"></span>
      <li class="current" data-step="2" aria-current="step">Delivery details</li><span class="sep" aria-hidden="true"></span>
      <li data-step="3">Confirmation</li>
    </ol>
    <div class="checkout-layout">
      <section>
        <div class="section-header"><h1>Checkout</h1><p>No card needed: you pay in cash when your toys arrive.</p></div>
        <div id="auth-config" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>
        {/* If "Place Order" is tapped before the page script has loaded (slow connection), this
            remembers the tap instead of reloading the page; the script then places the order. */}
        <form id="checkout-form" class="form-card" onsubmit="this.dataset.pending='1';return false">
          <h2 class="form-section-title">Contact</h2>
          <div class="form-grid">
            <label class="wide">Full name<input name="customer_name" required autocomplete="name" maxlength="120" /></label>
            <label>Phone number<input name="customer_phone" required type="tel" autocomplete="tel" maxlength="40" placeholder="+961 …" /></label>
            <label>Email <span>(optional)</span><input name="customer_email" type="email" autocomplete="email" maxlength="254" /></label>
          </div>
          <h2 class="form-section-title">Delivery address</h2>
          <div class="form-grid">
            <label>Governorate<select name="governorate" required autocomplete="address-level1"><option value="">Choose your governorate</option>{LEBANON_GOVERNORATES.map((g) => <option value={g}>{g}</option>)}</select></label>
            <label>City<input name="city" required autocomplete="address-level2" maxlength="80" /></label>
            <label class="wide">Area <span>(optional)</span><input name="area" autocomplete="address-level3" maxlength="120" /></label>
            <label class="wide">Full address<textarea name="address" required rows="3" autocomplete="street-address" maxlength="500" placeholder="Street, building, floor"></textarea></label>
            <label class="wide">Notes <span>(optional)</span><textarea name="notes" rows="2" maxlength="1000" placeholder="Best time to call, gift wrapping…"></textarea></label>
          </div>
          <h2 class="form-section-title">Payment</h2>
          <div class="payment-option"><b aria-hidden="true">💵</b><div><strong>Cash on delivery</strong><span>Pay the driver when your order arrives.</span></div></div>
          <button class="button" type="submit">Place order</button>
          <p id="form-message" role="status"></p>
        </form>
      </section>
      <aside id="checkout-summary" class="checkout-summary" aria-label="Order summary"></aside>
    </div>
  </div>
</main>
<footer class="site-footer"></footer>

<script>
import { getSession, getSupabase } from '../scripts/supabase-browser';
import { matchGovernorate } from '../lib/lebanon';

type CartItem = { productId: string; variantId?: string | null; variantName?: string | null; name: string; price: number; quantity: number; image?: string };

const CART_KEY = 'cleverToysCart';
const CUSTOMER_KEY = 'cleverToysCustomer';
const form = document.querySelector<HTMLFormElement>('#checkout-form')!;
const summary = document.querySelector<HTMLElement>('#checkout-summary')!;
const msg = document.querySelector<HTMLElement>('#form-message')!;
const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

const money = (n: number) => `$${Number(n || 0).toFixed(2)}`;
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
const readCart = (): CartItem[] => {
  try {
    const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    return Array.isArray(cart) ? cart.filter((i) => i && i.productId && Number(i.quantity) > 0) : [];
  } catch {
    return [];
  }
};

// Delivery pricing from Admin → Branding (written into the page by the server, so it is always current).
const branding = (window as any).__CLEVER_BRANDING__ || {};
const codDeliveryPrice = Math.max(0, Number(branding.codDeliveryPrice || 0));
const freeDeliveryThreshold = Math.max(0, Number(branding.freeDeliveryThreshold || 0));
const deliveryFeeFor = (subtotal: number) => freeDeliveryThreshold > 0 && subtotal >= freeDeliveryThreshold ? 0 : codDeliveryPrice;

/** Draws the order summary box and returns the totals shown in it. */
function renderSummary() {
  const cart = readCart();
  const subtotal = cart.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.quantity || 0), 0);
  const deliveryFee = deliveryFeeFor(subtotal);
  const total = subtotal + deliveryFee;
  if (!cart.length) {
    summary.innerHTML = '<h2>Order Summary</h2><p>Your cart is empty.</p><a href="/products" class="button">Shop Toys</a>';
    return { cart, subtotal, deliveryFee, total };
  }
  const lines = `<div class="summary-items">${cart.map((i) => `<div class="summary-item"><span class="summary-thumb">${i.image ? `<img src="${esc(i.image)}" alt="" loading="lazy">` : '🧸'}<b>${Number(i.quantity)}</b></span><span>${esc(i.name)}${i.variantName ? `<small>${esc(i.variantName)}</small>` : ''}</span><strong>${money(i.price * i.quantity)}</strong></div>`).join('')}</div>`;
  const freeNote = freeDeliveryThreshold > 0
    ? `<p class="delivery-note">${subtotal >= freeDeliveryThreshold ? '🎉 Free delivery unlocked!' : `Free delivery on orders of ${money(freeDeliveryThreshold)} or more.`}</p>`
    : '';
  summary.innerHTML = `<h2>Order summary</h2>${lines}<hr>
    <div class="summary-line"><span>Subtotal</span><strong>${money(subtotal)}</strong></div>
    <div class="summary-line"><span>COD delivery</span><strong>${deliveryFee === 0 ? 'Free' : money(deliveryFee)}</strong></div>
    ${freeNote}
    <div class="summary-line summary-total"><strong>Total</strong><strong>${money(total)}</strong></div>
    <a href="/cart" class="summary-cart-link">Edit Cart</a>`;
  return { cart, subtotal, deliveryFee, total };
}

/** Fills empty fields from this device's last order, then from the signed-in customer's profile. */
async function prefill() {
  const fill = (values: Record<string, string>) => {
    for (const [name, value] of Object.entries(values)) {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      // Saved governorates typed before the dropdown existed ("north", "Jbeil"…) pick the matching option.
      if (el && !el.value && value) el.value = name === 'governorate' ? matchGovernorate(value) : value;
    }
  };
  try {
    const saved = JSON.parse(localStorage.getItem(CUSTOMER_KEY) || '{}') || {};
    fill({ customer_name: saved.customer_name || saved.full_name || '', customer_phone: saved.customer_phone || saved.phone || '', customer_email: saved.customer_email || saved.email || '', governorate: saved.governorate || '', city: saved.city || '', area: saved.area || '', address: saved.address || '' });
  } catch {}
  const session = await getSession();
  if (!session?.user) return;
  const supabase = await getSupabase();
  const profile = supabase ? await supabase.from('customer_profiles').select('full_name,phone,governorate,city,area,address').eq('id', session.user.id).maybeSingle() : null;
  const source: Record<string, string> = profile?.data || {};
  fill({ customer_name: source.full_name || session.user.user_metadata?.full_name || '', customer_phone: source.phone || '', customer_email: session.user.email || '', governorate: source.governorate || '', city: source.city || '', area: source.area || '', address: source.address || '' });
}

let submitting = false;
form.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (submitting) return;
  const { cart, subtotal, deliveryFee, total } = renderSummary();
  if (!cart.length) { msg.textContent = 'Your cart is empty. Add a product before checkout.'; return; }
  if (!form.reportValidity()) return;

  const data = Object.fromEntries([...new FormData(form).entries()].map(([k, v]) => [k, String(v).trim()]));
  // Remember the delivery details on this device for next time (also used by "Order on WhatsApp").
  try {
    localStorage.setItem(CUSTOMER_KEY, JSON.stringify({
      full_name: data.customer_name, customer_name: data.customer_name,
      phone: data.customer_phone, customer_phone: data.customer_phone,
      email: data.customer_email, customer_email: data.customer_email,
      governorate: data.governorate, city: data.city, area: data.area, address: data.address
    }));
  } catch {}

  submitting = true;
  submitButton.disabled = true;
  msg.textContent = 'Placing your order…';
  try {
    // Signed-in customers send their login token so the order appears in their account.
    const headers: Record<string, string> = { 'content-type': 'application/json' };
    const session = await getSession();
    if (session?.access_token) headers.authorization = `Bearer ${session.access_token}`;
    const order = { ...data, items: cart, subtotal, delivery_fee: deliveryFee, total, payment_method: 'cash_on_delivery' };
    const res = await fetch('/api/orders', { method: 'POST', headers, body: JSON.stringify(order) });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(out.error || 'Unable to place order.');
    localStorage.removeItem(CART_KEY);
    location.href = out.order_number ? `/order-success?order=${encodeURIComponent(out.order_number)}` : '/order-success';
  } catch (error) {
    msg.textContent = error instanceof Error ? error.message : 'Unable to place order.';
    submitting = false;
    submitButton.disabled = false;
  }
});

renderSummary();
prefill();
// Place the order now if the shopper already tapped "Place Order" while the page was loading.
if (form.dataset.pending) {
  delete form.dataset.pending;
  form.requestSubmit(submitButton);
}
// Cart changed in another tab: refresh the summary.
window.addEventListener('storage', (event) => { if (event.key === CART_KEY) renderSummary(); });
</script>
