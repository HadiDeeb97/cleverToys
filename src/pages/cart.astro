---
import '../styles/global.css';
---
<header class="site-header"><div class="container header-inner"><a href="/" class="logo">Clever Toys</a><nav class="main-nav"><a href="/products">Shop</a><a href="/categories">Categories</a><a href="/cart">Cart</a></nav></div></header>
<main class="section"><div class="container"><div class="section-header"><h1>Your Cart</h1><p>Review your items before checkout.</p></div><div id="cart-root"></div></div></main>
<footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Clever Toys. All rights reserved.</p></div></footer>
<script>
const root = document.querySelector('#cart-root');
const read = () => { try { return JSON.parse(localStorage.getItem('clever-toys-cart') || '[]'); } catch { return []; } };
const save = (cart) => localStorage.setItem('clever-toys-cart', JSON.stringify(cart));
const money = (n) => `$${Number(n).toFixed(2)}`;
function render() {
 const cart = read();
 if (!cart.length) { root.innerHTML = '<div class="empty-state"><h2>Your cart is empty</h2><p>Add some toys to get started.</p><a class="button" href="/products">Continue Shopping</a></div>'; return; }
 const subtotal = cart.reduce((s,i)=>s + Number(i.price)*Number(i.quantity),0);
 root.innerHTML = `<div class="cart-list">${cart.map((i,idx)=>`<article class="cart-item"><div>${i.image ? `<img src="${i.image}" alt="${i.name}">` : '<div class="cart-placeholder">Toy</div>'}</div><div class="cart-item-info"><h2><a href="/product/${i.slug}">${i.name}</a></h2><p>${money(i.price)} each</p><div class="quantity-control"><button data-minus="${idx}">−</button><strong>${i.quantity}</strong><button data-plus="${idx}">+</button><button class="remove-link" data-remove="${idx}">Remove</button></div></div><strong class="line-total">${money(Number(i.price)*Number(i.quantity))}</strong></article>`).join('')}</div><div class="cart-summary"><div><span>Subtotal</span><strong>${money(subtotal)}</strong></div><p>Delivery fee will be calculated at checkout.</p><a class="button" href="/checkout">Checkout</a></div>`;
 root.querySelectorAll('[data-minus]').forEach(b=>b.onclick=()=>{const c=read();const i=Number(b.dataset.minus);c[i].quantity=Math.max(1,c[i].quantity-1);save(c);render();});
 root.querySelectorAll('[data-plus]').forEach(b=>b.onclick=()=>{const c=read();const i=Number(b.dataset.plus);c[i].quantity++;save(c);render();});
 root.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{const c=read();c.splice(Number(b.dataset.remove),1);save(c);render();});
}
render();
</script>